///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn capture(
  root : String,
  label : String,
  exe : String,
  args : Array[String],
) -> String {
  @fs.write_file(
    root + "/" + label + ".command.json",
    Json([exe, ..args]).stringify(),
    create_mode=CreateNew,
  )
  let output = @shell.Cmd(exe, args).output(max_output_bytes=16777216)
  @fs.write_file(
    root + "/" + label + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
  output.stdout()
}

///|
fn field(text : String, key : String) -> String raise {
  guard text.split("\n").filter(x => x.has_prefix(key + "=")).to_array()
    is [line] else {
    fail(key)
  }
  line[key.length() + 1:].to_owned()
}

///|
async fn main {
  guard @env.args() is [_, base, probe, root, mode, moon] else {
    fail("BASE PROBE NEW_ROOT export|build|run MOON")
  }
  if mode == "export" {
    // A rejected offline ablation stays in benchmark automation, not as an
    // unused public IR or production lowering option. Pin the input at build.
    let text = @fs.read_file(base).text()
    let marker = "    float tile_numerator[LF_ACCUMULATOR_ITEMS] = {};\n"
    guard text.split(marker).to_array() is [_, tail, _] else {
      fail("two value folds")
    }
    let body = tail.split("\n    __syncthreads();\n    stage_value").to_array()[0].to_owned()
    let old = "\n" + marker + body + "\n"
    assert_eq(text.split(old).length(), 3)
    let output = StringBuilder()
    for width in [4, 8] {
      output.write_string(
        "LUNA_WINDOW_BEGIN w\{width}\nLUNA_WINDOW_OLD\n" +
        old +
        "\nLUNA_WINDOW_NEW\n" +
        value_window(width) +
        "\nLUNA_WINDOW_END\n",
      )
    }
    @fs.write_file(
      root + "/windows-export.stdout",
      output.to_string(),
      create_mode=CreateNew,
    )
    return
  }
  let nvcc = "/usr/local/cuda-13.0/bin/nvcc"
  if mode == "build" {
    assert_true(
      capture(root, "nvcc-identity", "sha256sum", [nvcc]).has_prefix(
        "fbb111f057786ddd10ba723d993cc7dd43abf978b6baa32fedd3c9d806dc79e1 ",
      ),
    )
    let frozen = base + "/decode-selected"
    let text = @fs.read_file(frozen + "/kernel.cu").text()
    assert_true(
      capture(root, "source-identity", "sha256sum", [frozen + "/kernel.cu"]).has_prefix(
        "dc9f5a1a30e0d2f969f7a9e82cdcc7b8b9a8c80f2058c698b19ea9416e9d43b6 ",
      ),
    )
    let recipe = @fs.read_file(frozen + "/kernel.recipe").text()
    let exported = @fs.read_file(root + "/windows-export.stdout").text()
    let sources : Array[(String, String)] = [("baseline", text)]
    for width in [4, 8] {
      let label = "w\{width}"
      guard exported.split("LUNA_WINDOW_BEGIN " + label + "\n").to_array()
        is [_, tail] else {
        fail("window frame")
      }
      let frame = tail.split("\nLUNA_WINDOW_END").to_array()[0].to_owned()
      guard frame.split("LUNA_WINDOW_OLD\n").to_array() is [_, body] &&
        body.split("\nLUNA_WINDOW_NEW\n").to_array() is [old, fresh] else {
        fail("window bodies")
      }
      // Only the value fold is replaced, in ordinary and partial entries.
      // Reject missing/extra occurrences rather than patching a different build.
      let pieces = text.split(old).to_array()
      assert_eq(pieces.length(), 3)
      sources.push((label, pieces.join(fresh.to_owned())))
    }
    for (name, source) in sources {
      let directory = root + "/" + name
      @fs.mkdir(directory)
      @fs.write_file(directory + "/kernel.cu", source, create_mode=CreateNew)
      @fs.write_file(
        directory + "/kernel.recipe",
        recipe,
        create_mode=CreateNew,
      )
      ignore(
        capture(root, name + "-compile", nvcc, [
          "-O3",
          "-arch=sm_121",
          "--std=c++14",
          "--fmad=false",
          "--ftz=false",
          "--prec-div=true",
          "--prec-sqrt=true",
          "--Werror",
          "all-warnings",
          "--maxrregcount=" + field(recipe, "max_registers"),
          "-Xptxas=-v",
          "-cubin",
          directory + "/kernel.cu",
          "-o",
          directory + "/kernel.cubin",
        ]),
      )
      let digest = capture(root, name + "-identity", "sha256sum", [
        directory + "/kernel.cu",
        directory + "/kernel.cubin",
      ])
      if name == "baseline" {
        assert_true(
          digest.contains(
            "318d74ff5b8ebfb5e0a97ea6daea16501a98a5ef1b67116350cf8b737266c185 ",
          ),
        )
      }
    }
    @fs.write_file(
      root + "/BUILD_RESULT.txt",
      "baseline_bytes=identical-to-serving\nselection=diagnostic-only\n",
      create_mode=CreateNew,
    )
    return
  }
  guard mode == "run" else { fail("mode") }
  assert_true(@fs.exists(root + "/BUILD_RESULT.txt"))
  assert_true(
    capture(root, "probe-identity", "sha256sum", [probe + "/check-probe"]).has_prefix(
      "821fa177be7e30219dbaf92a58c7337af45529075dca84c9fe162017c7ee1b66 ",
    ),
  )
  let workloads : Array[Json] = []
  for width in [4, 8] {
    for
      (rows, envelope, history) in [(16, 16, 4095), (2, 8, 32767), (1, 1, 127)] {
      let name = "w\{width}-r\{rows}-e\{envelope}-h\{history}"
      let spec = @fs.read_file(base + "/calibration-spec/decode.spec").text()
      guard spec.split("maximum_rows=32\n").to_array() is [before, after] else {
        fail("envelope")
      }
      @fs.write_file(
        root + "/" + name + ".spec",
        before.to_owned() + "maximum_rows=\{envelope}\n" + after.to_owned(),
        create_mode=CreateNew,
      )
      workloads.push({
        "label": name,
        "args": [
          root + "/" + name + ".spec",
          root + "/baseline",
          root + "/w\{width}",
          rows.to_string(),
          rows.to_string(),
          history.to_string(),
          "--decode-envelope",
        ],
      })
    }
  }
  let contract : Json = {
    "schema": "lunaflux-ako-trial-v1",
    "gpu_uuid": "GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6",
    "reserve_kib": 33554432,
    "minimum_gain": 0.01,
    "require_bitwise": true,
    "program": probe + "/check-probe",
    "artifacts": [
      root + "/baseline/kernel.cubin",
      root + "/w4/kernel.cubin",
      root + "/w8/kernel.cubin",
    ],
    "workloads": workloads,
  }
  @fs.write_file(
    root + "/contract.json",
    contract.stringify(indent=2),
    create_mode=CreateNew,
  )
  ignore(
    capture(root, "paired", moon, [
      "run",
      root + "/ako_trial.mbtx",
      root + "/contract.json",
      root + "/paired",
    ]),
  )
}

///|
fn value_window(width : Int) -> String raise {
  assert_true(width == 4 || width == 8)
  "\n" +
  (
    $|    float tile_numerator[LF_ACCUMULATOR_ITEMS] = {};
    $|    // ordered-fold-windows-v1;items=32;width=\{width};state=shared;consume=ascending;publication=none
    $|    #pragma unroll 1
    $|    for (int first_key = 0; first_key < active_keys; first_key += \{width}) {
    $|      #pragma unroll
    $|      for (int within = 0; within < \{width}; ++within) {
    $|        const int key = first_key + within;
    $|        if (key < active_keys) {
    $|      const float probability = scores[key];
    $|      const uint2 packed = *reinterpret_cast<const uint2 *>(value_tile + key * LF_HEAD_DIMENSION + lane * 4);
    $|      const float values[4] = { __uint_as_float(packed.x << 16), __uint_as_float(packed.x & 0xffff0000U),
    $|                                __uint_as_float(packed.y << 16), __uint_as_float(packed.y & 0xffff0000U) };
    $|      #pragma unroll
    $|      for (int item = 0; item < 4; ++item)
    $|        tile_numerator[item] += probability * values[item];
    $|        }
    $|      }
    $|    }
  ) +
  "\n"
}

///|
test "value windows retain ascending updates without publication" {
  for width in [4, 8] {
    let text = value_window(width)
    assert_true(text.contains("first_key += \{width}"))
    assert_true(text.contains("first_key + within"))
    assert_true(
      text.contains("tile_numerator[item] += probability * values[item]"),
    )
    assert_false(text.contains("fmaf("))
    assert_false(text.contains("__syncthreads"))
    assert_false(text.contains("__syncwarp"))
  }
}
