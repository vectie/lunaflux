///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
}

///|
fn csv(line : StringView) -> Array[String] {
  let result = []
  let mut quoted = false
  let mut field = StringBuilder()
  for character in line {
    if character == '"' {
      quoted = !quoted
    } else if character == ',' && !quoted {
      result.push(field.to_string())
      field = StringBuilder()
    } else {
      field.write_char(character)
    }
  }
  result.push(field.to_string())
  result
}

///|
async fn main {
  guard @env.args() is [_, root] else {
    fail("COMPLETED_SELECTED_COUNTER_ROOT")
  }
  guard @fs.read_file(root + "/RESULT.txt")
    .text()
    .has_prefix("outcome=completed\n") else {
    fail("counters incomplete")
  }
  let wanted = [
    "gpu__time_duration.sum", "launch__grid_size", "launch__registers_per_thread",
    "smsp__inst_executed.sum", "sm__pipe_tensor_cycles_active.avg.pct_of_peak_sustained_elapsed",
    "dram__bytes_read.sum", "l1tex__t_sectors_pipe_lsu_mem_local_op_ld.sum", "l1tex__t_sectors_pipe_lsu_mem_local_op_st.sum",
    "smsp__warp_issue_stalled_long_scoreboard_per_warp_active.pct", "smsp__warp_issue_stalled_barrier_per_warp_active.pct",
  ]
  for kind in ["ingress", "prefill", "decode"] {
    if !@fs.exists(root + "/" + kind + ".stdout") {
      continue
    }
    let raw = @fs.read_file(root + "/" + kind + ".stdout")
      .text()
      .split("\n")
      .filter(x => x.has_prefix("\""))
      .to_array()
    guard raw.length() == 4 else {
      fail("two exact selected captures required")
    }
    let names = csv(raw[0])
    let before = csv(raw[2])
    let after = csv(raw[3])
    assert_eq(names.length(), before.length())
    assert_eq(names.length(), after.length())
    println(kind + " prior -> current (profiled replay, not serving latency)")
    for name in wanted {
      match names.search(name) {
        Some(index) =>
          println(name + "=" + before[index] + " -> " + after[index])
        None => println(name + "=unavailable")
      }
    }
  }
}
