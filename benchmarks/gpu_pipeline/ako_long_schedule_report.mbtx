///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn csv(line : StringView) -> Array[String] {
  let fields = []
  let mut value = StringBuilder()
  for i = 0, quoted = false; i < line.length(); {
    let c = line[i]
    if c == '"' {
      if quoted && i + 1 < line.length() && line[i + 1] == '"' {
        value.write_char('"')
        continue i + 2, quoted
      }
      continue i + 1, !quoted
    }
    if c == ',' && !quoted {
      fields.push(value.to_string())
      value = StringBuilder()
    } else {
      value.write_view(line[i:i + 1])
    }
    continue i + 1, quoted
  }
  fields.push(value.to_string())
  fields
}

///|
fn number(value : String) -> Double raise {
  @string.parse_double(value.split(",").join(""))
}

///|
fn counters(text : String) -> Array[Json] raise {
  guard text.split("\n").filter(x => x.has_prefix("\"")).to_array()
    is [header, _, a, b] else {
    fail("two selected launches")
  }
  let keys = csv(header)
  [a, b].map(line => {
    let values = csv(line)
    assert_eq(values.length(), keys.length())
    let out : Map[String, Json] = Map([])
    let latency = number(
      values[keys
      .search("smsp__average_warp_latency_per_inst_issued.ratio")
      .unwrap()],
    )
    guard latency > 0.0 else { fail("latency denominator") }
    for i, key in keys {
      if key == "gpu__time_duration.sum" ||
        key == "smsp__inst_executed.sum" ||
        key == "smsp__issue_active.avg.pct_of_peak_sustained_active" ||
        key.has_prefix("launch__occupancy_limit_") ||
        key.has_prefix("launch__registers_per_thread") ||
        key.has_prefix("launch__shared_mem_per_block") ||
        key == "sm__warps_active.avg.pct_of_peak_sustained_active" ||
        key == "smsp__average_warp_latency_per_inst_issued.ratio" {
        out[key] = Json(values[i])
      }
      if key.has_prefix("smsp__average_warps_issue_stalled_") {
        out[key + "/warp-latency-percent"] = Json(
          100.0 * number(values[i]) / latency,
        )
      }
    }
    Json::object(out)
  })
}

///|
fn opcodes(text : String) -> Array[Json] raise {
  let result = []
  let mut keys : Array[String] = []
  let mut totals : Map[String, Double] = Map([])
  for line in text.split("\n") {
    if !line.has_prefix("\"") {
      continue
    }
    let fields = csv(line)
    if fields[0] == "Kernel Name" {
      if !totals.is_empty() {
        result.push(Json::object(totals.map((_, x) => Json(x))))
      }
      totals = Map([])
      keys = []
    } else if fields[0] == "Address" {
      keys = fields
    } else if !keys.is_empty() {
      assert_eq(fields.length(), keys.length())
      let words = fields[keys.search("Source").unwrap()]
        .trim()
        .split(" ")
        .filter(x => !x.is_empty())
        .to_array()
      guard words is [first, .. rest] else { continue }
      let op = (if first.has_prefix("@") { rest[0] } else { first }).to_owned()
      let count = number(fields[keys.search("Instructions Executed").unwrap()])
      totals[op] = totals.get(op).unwrap_or(0.0) + count
    }
  }
  if !totals.is_empty() {
    result.push(Json::object(totals.map((_, x) => Json(x))))
  }
  assert_eq(result.length(), 2)
  result
}

///|
async fn main {
  guard @env.args() is [_, root, .. kind_args] else {
    fail("LOCAL_RESULTS_ROOT [query-lifetime-v1|epoch-local-v1|value-readiness-v1]")
  }
  let names = match kind_args {
    [] => ["kv128", "retain128"]
    ["query-lifetime-v1"] => ["retain64", "joint64", "joint128"]
    ["epoch-local-v1"] => ["epochjoint"]
    ["value-readiness-v1"] => ["valueoverlap"]
    ["unit-rescale-v1"] => ["unitrescale"]
    ["page-batch-v1"] => ["pagebatch"]
    _ => fail("bounded experiment kind")
  }
  let rows : Array[Json] = []
  for host in ["178", "179"] {
    guard @json.parse(@fs.read_file(root + "/summary" + host + ".json").text())
      is Array(records) &&
      records.length() == names.length() * 3 else {
      fail("complete cells per host")
    }
    for record in records {
      guard record
        is {
          "label": String(label),
          "metrics": {
            "baseline_median_us": old,
            "candidate_median_us": fresh,
            "median_paired_gain": gain,
            "decision": String(decision),
            ..
          },
          ..
        } else {
        fail("metrics")
      }
      assert_true(decision is ("regression" | "inconclusive" | "improved"))
      let row : Json = {
        "host": host,
        "label": label,
        "old_us": old,
        "new_us": fresh,
        "paired_gain": gain,
        "decision": decision,
      }
      rows.push(row)
      println(row.stringify())
    }
  }
  let profiles : Map[String, Json] = Map([])
  let compact : Map[String, Json] = Map([])
  for name in names {
    let measured = counters(
      @fs.read_file(root + "/" + name + "-raw.stdout").text(),
    )
    compact[name] = Json(measured)
    profiles[name] = {
      "baseline_then_candidate": measured,
      "sampled_dependency_sites": dependency_sites(
        @fs.read_file(root + "/" + name + "-source.stdout").text(),
      ),
      "opcodes": opcodes(
        @fs.read_file(root + "/" + name + "-source.stdout").text(),
      ),
    }
  }
  @fs.write_file(
    root + "/report.json",
    ({ "cells": rows, "profile179": Json::object(profiles) } : Json).stringify(
      indent=2,
    ),
    create_mode=CreateNew,
  )
  println(Json::object(compact).stringify(indent=2))
}

///|
/// Attribute sampled stalls to instruction PCs. Samples are observations, not
/// elapsed cycles or an additive allocation of a framework completion gap.
fn dependency_sites(text : String) -> Array[Json] raise {
  let kernels : Array[Json] = []
  let mut keys : Array[String] = []
  let mut sites : Array[(Double, Json)] = []
  let mut groups : Map[String, Double] = Map([])
  fn finish() -> Json {
    sites.sort_by((a, b) => b.0.compare(a.0))
    {
      "top_not_issued_dependency_pcs": sites.iter().take(12).map(x => x.1).to_array(),
      "opcode_sample_totals": Json::object(groups.map((_, x) => Json(x))),
    }
  }
  for line in text.split("\n") {
    if !line.has_prefix("\"") { continue }
    let values = csv(line)
    if values[0] == "Kernel Name" {
      if !keys.is_empty() { kernels.push(finish()) }
      keys = []
      sites = []
      groups = Map([])
    } else if values[0] == "Address" {
      keys = values
    } else if !keys.is_empty() {
      assert_eq(values.length(), keys.length())
      let source = values[keys.search("Source").unwrap()]
      let words = source.trim().split(" ").filter(x => !x.is_empty()).to_array()
      guard words is [first, ..rest] else { continue }
      let op = (if first.has_prefix("@") { rest[0] } else { first }).to_owned()
      let stalls : Map[String, Json] = Map([])
      let mut dependency = 0.0
      for metric in ["stall_wait", "stall_long_sb", "stall_short_sb", "stall_barrier", "stall_math"] {
        for key in [metric, metric + " (Not Issued)"] {
          let sample = number(values[keys.search(key).unwrap()])
          stalls[key] = Json(sample)
          groups[op + "/" + key] = groups.get(op + "/" + key).unwrap_or(0.0) + sample
          if key.has_suffix(" (Not Issued)") && metric != "stall_barrier" && metric != "stall_math" { dependency += sample }
        }
      }
      sites.push((dependency, {
        "address": values[0], "sass": source, "samples": Json::object(stalls),
        "executed": number(values[keys.search("Instructions Executed").unwrap()]),
      }))
    }
  }
  if !keys.is_empty() { kernels.push(finish()) }
  assert_eq(kernels.length(), 2)
  kernels
}

///|
test "CSV preserves grouped numeric values and escaped quotes" {
  assert_eq(csv("\"a,b\",\"c\"\"d\",\"\""), ["a,b", "c\"d", ""])
  assert_eq(number("1,234,567"), 1234567.0)
}

///|
test "dependency attribution retains two kernels and ranks sampled instruction PCs" {
  let labels = ["Address", "Source", "Instructions Executed"]
  for key in ["stall_wait", "stall_long_sb", "stall_short_sb", "stall_barrier", "stall_math"] {
    labels.push(key)
    labels.push(key + " (Not Issued)")
  }
  let header = labels.map(x => "\"" + x + "\"").join(",")
  let source = [
    "\"Kernel Name\",\"first\"", header,
    "\"0x0\",\" ISETP\",\"10\",\"0\",\"0\",\"15\",\"12\",\"0\",\"0\",\"0\",\"0\",\"0\",\"0\"",
    "\"Kernel Name\",\"second\"", header,
    "\"0x1\",\" MOV\",\"5\",\"4\",\"3\",\"0\",\"0\",\"0\",\"0\",\"0\",\"0\",\"0\",\"0\"",
  ].join("\n")
  let result = dependency_sites(source)
  assert_eq(result.length(), 2)
  assert_true(result[0].stringify().contains("\"ISETP/stall_long_sb (Not Issued)\":12"))
  assert_true(result[1].stringify().contains("\"MOV/stall_wait (Not Issued)\":3"))
}
