import {
  "moonbitlang/async@0.20.3",
  "moonbitlang/async@0.20.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

fn value(line : StringView, name : String) -> Double raise {
  guard line.split(" ").filter(x=>x.has_prefix(name+"=")).to_array() is [v] else {fail(name)}
  @string.parse_double(v[name.length()+1:])
}

async fn main {
  guard @env.args() is [_,root] else {fail("REPLAY_ROOT")}
  guard @json.parse(@fs.read_file(root+"/cases.json").text()) is Array(cases) else {fail("cases")}
  let mut old_total=0.0
  let mut new_total=0.0
  let mut count=0.0
  println("case\trows\ttokens\toccurrences\tbaseline_us\tvariant_us\tshape")
  for i,entry in cases {
    guard entry is {"rows":Number(rows,..),"tokens":Number(tokens,..),"occurrences":Number(n,..),"shape":String(shape),..} else {fail("case")}
    let old : Array[Double]=[];let now : Array[Double]=[]
    for line in @fs.read_file(root+"/case-\{i}.stdout").text().split("\n") {
      if !line.has_prefix("tokens=") {continue}
      old.push(value(line,"old_us"));now.push(value(line,"new_us"))
    }
    assert_eq(old.length(),5);assert_eq(now.length(),5)
    old.sort();now.sort()
    old_total+=old[2]*n;new_total+=now[2]*n;count+=n
    println("\{i}\t\{rows}\t\{tokens}\t\{n}\t\{old[2]}\t\{now[2]}\t"+shape.trim().split("\n").map(x=>x.to_owned()).to_array().join(";"))
  }
  println("weighted_steps=\{count} baseline_us=\{old_total} variant_us=\{new_total} reduction_percent=\{(old_total-new_total)/old_total*100.0}")
  println("scope=isolated-kernel, trace-weighted actual geometry, synthetic values, warm cache; not serving or model correctness")
}
