///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn csv(line : StringView) -> Array[String] {
  let out = []
  let text = StringBuilder()
  let mut quoted = false
  let chars = line.to_owned().to_array()
  let mut i = 0
  while i < chars.length() {
    let c = chars[i]
    if c == '"' {
      if quoted && i + 1 < chars.length() && chars[i + 1] == '"' {
        text.write_char('"')
        i += 1
      } else {
        quoted = !quoted
      }
    } else if c == ',' && !quoted {
      out.push(text.to_string())
      text.reset()
    } else {
      text.write_char(c)
    }
    i += 1
  }
  out.push(text.to_string())
  out
}

///|
async fn main {
  if @env.args() is [_, "--self-test"] {
    assert_eq(csv("\"ID\",\"Kernel, name\",\"1,234\",\"a\"\"b\""), [
      "ID", "Kernel, name", "1,234", "a\"b",
    ])
    assert_eq(csv("1,,3,"), ["1", "", "3", ""])
    println("counter CSV regression passed")
    return
  }
  guard @env.args() is [_, raw, output] else { fail("NCU_RAW_CSV NEW_JSON") }
  let records : Array[Json] = []
  let mut header : Array[String] = []
  for line in @fs.read_file(raw).text().split("\n") {
    let row = csv(line)
    if row.length() > 5 && row[0] == "ID" {
      header = row
      continue
    }
    if header.is_empty() || row.length() != header.length() || row[0].is_empty() {
      continue
    }
    let fields : Map[String, Json] = Map([])
    for i in 0..<header.length() {
      let value = row[i].split(",").to_array().join("")
      fields[header[i]] = Json(@string.parse_double(value)) catch {
        _ => Json(row[i])
      }
    }
    records.push(Json(fields))
  }
  guard !records.is_empty() else { fail("no counter rows") }
  @fs.write_file(
    output,
    Json(records).stringify(indent=2),
    create_mode=CreateNew,
  )
}
