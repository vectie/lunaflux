///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn field(text : String, key : String) -> String raise {
  guard text.split("\n").filter(x => x.has_prefix(key + "=")).to_array()
    is [line] else {
    fail("missing/duplicate " + key)
  }
  line[key.length() + 1:].to_owned()
}

///|
fn bucket_tokens(tokens : Int) -> Int {
  for bound = 1; bound < tokens; {
    continue bound * 2
  } nobreak {
    bound
  }
}

///|
async fn run(
  root : String,
  label : String,
  program : String,
  args : Array[String],
) -> String {
  println("starting " + label)
  let result = @shell.Cmd(program, args).output(max_output_bytes=16777216)
  @fs.write_file(
    root + "/" + label + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  @fs.write_file(root + "/" + label + ".exit", "0", create_mode=CreateNew)
  result.stdout()
}

///|
async fn sha(path : String) -> String {
  let result = @shell.Cmd("sha256sum", [path]).output()
  result.check()
  result.stdout().split(" ").to_array()[0].to_owned()
}

///|
async fn reserve() -> Unit {
  let text = @fs.read_file("/proc/meminfo").text()
  guard text.split("\n").filter(x => x.has_prefix("MemAvailable:")).to_array()
    is [line] else {
    fail("memory")
  }
  let cells = line.split(" ").filter(x => !x.is_empty()).to_array()
  guard @string.parse_int64(cells[1]) >= 33554432L else {
    fail("32 GiB memory reserve")
  }
  let gpu = @shell.Cmd("nvidia-smi", [
    "--query-compute-apps=pid", "--format=csv,noheader",
  ]).output()
  gpu.check()
  guard gpu.stdout().trim().is_empty() else { fail("GPU occupied") }
}

///|
async fn compile(
  root : String,
  name : String,
  directory : String,
  nvcc : String,
) -> Unit {
  let recipe = @fs.read_file(directory + "/kernel.recipe").text()
  ignore(
    run(root, "compile-" + name, nvcc, [
      "-O3",
      "-arch=" + field(recipe, "target"),
      "--std=c++14",
      "--fmad=false",
      "--ftz=false",
      "--prec-div=true",
      "--prec-sqrt=true",
      "--Werror",
      "all-warnings",
      "--maxrregcount=" + field(recipe, "max_registers"),
      "-Xptxas=-v",
      "-cubin",
      directory + "/kernel.cu",
      "-o",
      directory + "/kernel.cubin",
    ]),
  )
}

///|
async fn measure(
  root : String,
  name : String,
  spec : String,
  baseline : String,
  candidate : String,
  workloads : Array[(Int, Int, Int)],
) -> Array[(Int64, String, String)] {
  let measurements : Array[(Int64, String, String)] = []
  let mut registers = ""
  let mut residency = ""
  for (tokens, rows, history) in workloads {
    let trials : Array[Double] = []
    reserve()
    let output = run(
      root,
      name + "-q\{tokens}-r\{rows}-h\{history}",
      root + "/probe",
      [spec, baseline, candidate, "\{tokens}", "\{rows}", "\{history}"],
    )
    let lines = output
      .split("\n")
      .filter(x => x.has_prefix("tokens="))
      .to_array()
    guard lines.length() == 5 else { fail("five successful trials required") }
    guard output.contains("geometry mode=runtime-bucket ") else {
      fail("maximum-envelope probes cannot supply runtime-bucket records")
    }
    guard output.split("\n").filter(x => x.has_prefix("resources ")).to_array()
      is [resources] else {
      fail("resources")
    }
    for cell in resources.split(" ") {
      if cell.has_prefix("registers=") {
        registers = cell[10:].to_owned()
      }
      if cell.has_prefix("resident_blocks=") {
        residency = cell[16:].to_owned()
      }
    }
    for line in lines {
      guard line.split(" ").filter(x => x.has_prefix("new_us=")).to_array()
        is [time] else {
        fail("latency")
      }
      let latency = @string.parse_double(time[7:])
      guard latency > 0.0 && latency < 1.0e9 else { fail("invalid latency") }
      trials.push(latency)
    }
    trials.sort()
    measurements.push(((trials[2] * 1000.0).to_int64(), registers, residency))
  }
  measurements
}

///|
async fn main {
  guard @env.args()
    is [
      _,
      base,
      root,
      probe_source,
      performance_class,
      selected_cell,
      .. options,
    ] else {
    fail(
      "BENCHMARK_ROOT NEW_EMPTY_ROOT PROBE_SOURCE PERFORMANCE_CLASS SELECTED_CELL (e.g. prefill-q2048-r8-h2048); class must include SM/cache/memory and clock/power policy, not UUID or ISA alone",
    )
  }
  guard options.is_empty() ||
    options == ["--all-new-finalists"] ||
    options == ["--scratch-pipeline-finalists"] else {
    fail("optional mode: --all-new-finalists or --scratch-pipeline-finalists")
  }
  let all_new_finalists = options == ["--all-new-finalists"]
  let scratch_finalists = options == ["--scratch-pipeline-finalists"]
  guard performance_class.has_prefix("perf-v1:") &&
    performance_class.length() <= 512 &&
    !performance_class.contains("\t") &&
    !performance_class.contains("\n") else {
    fail("explicit versioned performance compatibility class required")
  }
  reserve()
  let nvcc = "/usr/local/cuda/bin/nvcc"
  let model = "/home/wlc004s/lunaflux-spark-test.5kAEkw/qwen3-0.6b"
  let cli = base + "/source/_build/native/release/build/cmd/"
  let exporter = cli +
    "lunaflux_qwen3_bf16_candidate_export/lunaflux_qwen3_bf16_candidate_export.exe"
  let converted = @fs.read_file(base + "/convert.stdout").text()
  let toolchain = sha(base + "/toolchain.v1")
  let identity = @shell.Cmd("nvidia-smi", [
    "--query-gpu=uuid", "--format=csv,noheader",
  ]).output()
  identity.check()
  let provenance = identity.stdout().trim().to_owned()
  guard !provenance.is_empty() && !provenance.contains("\n") else {
    fail("exactly one visible GPU required")
  }
  let device = performance_class
  let common = [
    model,
    "config.json",
    sha(model + "/config.json"),
    sha(model + "/model.safetensors"),
    "qwen.numeric",
    field(converted, "output_artifact_sha256"),
    field(converted, "route_manifest_sha256"),
    toolchain,
    "13",
    "0",
    "88",
    "8",
    "16384",
    "32",
    "2048",
    "16384",
  ]
  let args = common.copy()
  args.append([
    root + "/candidate",
    "--ingress-policy-search",
    "--query-metadata-v1",
  ])
  let exported = run(root, "export", exporter, args)
  ignore(
    run(root, "probe-build", nvcc, [
      "-O3",
      "-arch=sm_121",
      "--fmad=false",
      probe_source,
      "-lcuda",
      "-o",
      root + "/probe",
    ]),
  )
  let geometry = "query_heads=16\nkey_value_heads=8\nhead_dimension=128\ntokens_per_page=8\npage_stride_values=8192\nmaximum_rows=32\nmaximum_tokens=2048\nmaximum_pages=16384\nquery_metadata_version=1\n"
  for kind in ["ingress", "prefill", "decode"] {
    @fs.write_file(
      root + "/" + kind + ".spec",
      "kind=" +
      kind +
      "\ninput_width=" +
      (if kind == "ingress" { "1024" } else { "4096" }) +
      "\n" +
      geometry,
      create_mode=CreateNew,
    )
  }
  let workloads = [
    (128, 1, 0),
    (2048, 1, 0),
    (2048, 1, 2048),
    (2048, 8, 2048),
    (1, 1, 127),
    (8, 8, 127),
    (16, 16, 127),
    (1, 1, 4095),
    (8, 8, 4095),
    (16, 16, 4095),
  ]
  let ingress_base = root + "/candidate/reusable-qwen-full-ingress"
  compile(root, "ingress-baseline", ingress_base, nvcc)
  let prefill_base = root + "/candidate/reusable-qwen-prefill-attention"
  compile(root, "prefill-baseline", prefill_base, nvcc)
  let ingress_header = "luna-projection-resources-v2\nscope\t" +
    device +
    "\t" +
    toolchain +
    "\t" +
    field(exported, "ingress_policy_scope_shape") +
    "\t" +
    field(exported, "ingress_policy_scope_program") +
    "\nbudget\t128\t49152\t128\t1\n"
  let names : Array[String] = []
  let ingress : Array[String] = []
  for index, (tokens, rows, history) in workloads {
    let phase = if index < 4 { "prefill" } else { "decode" }
    names.push("\{phase}-q\{tokens}-r\{rows}-h\{history}")
    ingress.push(
      ingress_header +
      "workload\t\{phase}\t\{tokens}\t\{rows}\t\{history}\t\{bucket_tokens(tokens)}\t\{Int::min(32, bucket_tokens(tokens))}\nprovenance\t" +
      provenance +
      "\n",
    )
  }
  guard names.contains(selected_cell) else { fail("unknown selected cell") }
  for
    line in exported
    .split("\n")
    .filter(x => x.has_prefix("ingress_policy_candidate=")) {
    guard line[25:].split(",").to_array() is [id, source, directory] else {
      fail("variant")
    }
    let id = id.to_owned()
    if scratch_finalists &&
      ![
        "ingress-g4-a2-s2-t2-f1-r2", "ingress-g4-a4-s2-t1-f1-h2", "ingress-g4-a4-s2-t2-f1-h2",
        "ingress-g4-a4-s2-t1-f1-r2-h2", "ingress-g4-a4-s2-t2-f1-r2-h2", "ingress-g4-a4-s2-t4-f1-r2-h2",
        "ingress-g4-a8-s2-t1-f1-h4", "ingress-g4-a8-s2-t2-f1-h4", "ingress-g4-a2-s2-t1-f1-r4",
        "ingress-g4-a2-s2-t2-f1-r4",
      ].contains(id) &&
      id != field(exported, "ingress_policy_selected") {
      continue
    }
    if !(id.contains("-s2-") &&
      id.has_prefix("ingress-g4-") &&
      (id.contains("-t1-") || id.contains("-t2-") || id.contains("-t4-")) &&
      (id.has_suffix("-f1") || id.contains("-f1-"))) {
      continue
    }
    // Bounded all-new experiment: retain the measured reference and previous
    // row-packed winner, plus legal head-packed producer/consumer windows.
    // This is an explicit experiment subset, not a universal tuning rule.
    if all_new_finalists &&
      id != field(exported, "ingress_policy_selected") &&
      id != "ingress-g4-a2-s2-t2-f1-r2" &&
      !id.has_suffix("-h2") &&
      !id.has_suffix("-h4") {
      continue
    }
    compile(root, id, directory.to_owned(), nvcc)
    let measured = measure(
      root,
      id,
      root + "/ingress.spec",
      ingress_base,
      directory.to_owned(),
      workloads,
    )
    for index, (latency, registers, residency) in measured {
      ingress[index] += "record\t" +
        id +
        "\t" +
        source.to_owned() +
        "\t\{latency}\t5\t" +
        registers +
        "\t" +
        residency +
        "\n"
      println(id + " cell=" + names[index] + " median_ns=\{latency}")
    }
  }
  let attention_scope = "luna-attention-tuning-v2\nscope\t" +
    field(exported, "reusable_qwen_prefill_frontier_sha256") +
    "\t" +
    device +
    "\t" +
    toolchain +
    "\n"
  let attention : Array[String] = []
  for (tokens, rows, history) in workloads[:4] {
    attention.push(
      attention_scope +
      "workload\tprefill\t\{tokens}\t\{rows}\t\{history}\t\{bucket_tokens(tokens)}\t\{Int::min(32, bucket_tokens(tokens))}\nprovenance\t" +
      provenance +
      "\n",
    )
  }
  for
    id in [
      318, 319, 320, 321, 322, 323, 324, 1003, 1004, 1005, 1006, 1008, 2000, 2001,
      2003, 2004,
    ] {
    if scratch_finalists && ![318, 322, 2001].contains(id) {
      continue
    }
    let directory = root + "/candidate/reusable-qwen-prefill-attention-c\{id}"
    compile(root, "prefill-c\{id}", directory, nvcc)
    let measured = measure(
      root,
      "prefill-c\{id}",
      root + "/prefill.spec",
      prefill_base,
      directory,
      workloads[:4].to_owned(),
    )
    for index, (latency, _, _) in measured {
      attention[index] += "record\t\{id}\t\{latency}\t5\n"
      println("prefill-c\{id} cell=" + names[index] + " median_ns=\{latency}")
    }
  }
  let decode_base = root + "/candidate/reusable-qwen-decode-attention"
  compile(root, "decode-baseline", decode_base, nvcc)
  let decode_recipe = @fs.read_file(decode_base + "/kernel.recipe").text()
  let decode_scope = "luna-attention-tuning-v2\nscope\t" +
    field(decode_recipe, "frontier_sha256") +
    "\t" +
    device +
    "\t" +
    toolchain +
    "\n"
  let decode_workloads = workloads[4:].to_owned()
  let decode : Array[String] = []
  for (tokens, rows, history) in decode_workloads {
    decode.push(
      decode_scope +
      "workload\tdecode\t\{tokens}\t\{rows}\t\{history}\t\{bucket_tokens(tokens)}\t\{bucket_tokens(tokens)}\nprovenance\t" +
      provenance +
      "\n",
    )
  }
  for id in [400, 420, 430, 441, 450, 451, 452, 453] {
    let directory = root + "/candidate/reusable-qwen-decode-attention-c\{id}"
    compile(root, "decode-c\{id}", directory, nvcc)
    let measured = measure(
      root,
      "decode-c\{id}",
      root + "/decode.spec",
      decode_base,
      directory,
      decode_workloads,
    )
    for index, (latency, _, _) in measured {
      decode[index] += "record\t\{id}\t\{latency}\t5\n"
      println(
        "decode-c\{id} cell=" + names[index + 4] + " median_ns=\{latency}",
      )
    }
  }
  let mut index_text = "schema=luna-workload-calibration-v2\nperformance_class=" +
    device +
    "\nprovenance_uuid=" +
    provenance +
    "\nobjective=per-cell-median-kernel-latency\nselected_cell=" +
    selected_cell +
    "\nserving_mix_optimal=false\n"
  for index, name in names {
    let cell_root = root + "/" + name
    @fs.mkdir(cell_root)
    @fs.write_file(
      cell_root + "/ingress.records",
      ingress[index],
      create_mode=CreateNew,
    )
    let attention_name = if index < 4 {
      "attention.records"
    } else {
      "decode.records"
    }
    @fs.write_file(
      cell_root + "/" + attention_name,
      if index < 4 {
        attention[index]
      } else {
        decode[index - 4]
      },
      create_mode=CreateNew,
    )
    let tuned = common.copy()
    tuned.append([
      cell_root + "/selected",
      "--ingress-policy-records",
      cell_root + "/ingress.records",
      sha(cell_root + "/ingress.records"),
      device,
      if index < 4 {
        "--attention-tuning"
      } else {
        "--decode-tuning"
      },
      cell_root + "/" + attention_name,
      sha(cell_root + "/" + attention_name),
      device,
      "--query-metadata-v1",
    ])
    ignore(run(cell_root, "selected-export", exporter, tuned))
    @fs.write_file(
      cell_root + "/RESULT.txt",
      "outcome=passed\n",
      create_mode=CreateNew,
    )
    index_text += "cell=" + name + "\n"
    if name == selected_cell {
      // A real copy keeps downstream cubin compilation from mutating the
      // independently retained cell export through a symlink.
      @shell.Cmd("cp", ["-a", cell_root + "/selected", root + "/selected"]).run()
      for file in ["ingress.records", attention_name, "selected-export.stdout"] {
        @fs.write_file(
          root + "/" + file,
          @fs.read_file(cell_root + "/" + file),
          create_mode=CreateNew,
        )
      }
    }
  }
  @fs.write_file(root + "/workloads.v2", index_text, create_mode=CreateNew)
  @fs.write_file(
    root + "/RESULT.txt",
    "outcome=passed\n",
    create_mode=CreateNew,
  )
}
