import { "moonbitlang/async@0.20.3", "moonbitlang/async@0.20.3/fs", "moonbitlang/core/env", "moonbitlang/core/string" }

fn field(line : StringView, name : String) -> Double raise {
  for value in line.split(" ") {
    if value.has_prefix(name+"=") { return @string.parse_double(value[name.length()+1:]) }
  }
  fail("missing field "+name)
}
async fn summarize(path : String, label : String) -> Unit {
  let old : Array[Double] = []
  let fresh : Array[Double] = []
  for line in @fs.read_file(path).text().split("\n") {
    if line.has_prefix("tokens=") { old.push(field(line,"old_us")); fresh.push(field(line,"new_us")) }
  }
  assert_eq(old.length(),5); assert_eq(fresh.length(),5)
  old.sort(); fresh.sort()
  println("\{label} old_us=\{old[2]} new_us=\{fresh[2]} time_reduction_pct=\{100.0*(1.0-fresh[2]/old[2])}")
}
async fn main {
  guard @env.args() is [_,root] else { fail("EXTRACTED_RESULTS_ROOT") }
  for (id,cap) in [(318,"128"),(318,"default"),(319,"default"),(316,"128")] {
    for (q,rows,past) in [(32,1,0),(1528,1,0),(1528,8,0),(1528,8,4096)] {
      let label="latest-v\{id}-\{cap}-q\{q}-r\{rows}-p\{past}"
      summarize(root+"/followups-r8/campaign/"+label+".stdout",label)
    }
  }
  for id in [313,318,319] {
    for q in [127,128,129,130] {
      let label="v\{id}-q\{q}-p4096"
      summarize(root+"/followups-r8/campaign/"+label+".stdout",label)
    }
  }
  for tokens in [1,8,16,32,64,128,129,256,1024,1528,2048] {
    summarize(root+"/projection-followup-r3/campaign/tokens-\{tokens}.stdout","gemm-tokens-\{tokens}")
  }
}
