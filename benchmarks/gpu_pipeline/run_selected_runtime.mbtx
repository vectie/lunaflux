///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
async fn checked(
  root : String,
  name : String,
  program : String,
  args : Array[String],
) -> Unit {
  let out = @shell.Cmd(program, args).output(max_output_bytes=16777216)
  @fs.write_file(
    root + "/" + name + ".stdout",
    out.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    out.stderr(),
    create_mode=CreateNew,
  )
  println(out.stdout())
  out.check()
}

///|
async fn memory() -> Int64 {
  guard @fs.read_file("/proc/meminfo")
    .text()
    .split("\n")
    .filter(x => x.has_prefix("MemAvailable:"))
    .to_array()
    is [line] else {
    fail("MemAvailable")
  }
  @string.parse_int64(line.split(" ").filter(x => !x.is_empty()).to_array()[1])
}

///|
async fn main {
  guard @env.args() is [_, base, calibration, root, builder] else {
    fail("BASELINE_ROOT CALIBRATION_ROOT NEW_EMPTY_ROOT FIXED_FUSED_BUILDER")
  }
  guard @fs.read_file(calibration + "/RESULT.txt").text() == "outcome=passed\n" else {
    fail("calibration incomplete")
  }
  let all_new = @fs.exists(calibration + "/selection-plan.txt")
  let forced_new = all_new &&
    @fs.read_file(calibration + "/selection-plan.txt")
    .text()
    .contains("mode=forced-new-family-measured-finalist\n")
  if all_new {
    assert_eq(
      @fs.read_file(
        calibration + "/selected/reusable-qwen-prefill-attention/kernel.cu",
      ).text(),
      @fs.read_file(
        calibration +
        "/selected/reusable-qwen-prefill-wide-query-attention/kernel.cu",
      ).text(),
    )
    let ingress = @fs.read_file(
      calibration + "/selected/reusable-qwen-full-ingress/kernel.recipe",
    ).text()
    let decode = @fs.read_file(
      calibration + "/selected/reusable-qwen-decode-attention/kernel.recipe",
    ).text()
    guard !forced_new ||
      (
        (
          ingress.contains("\nheads_per_cta=2\n") ||
          ingress.contains("\nheads_per_cta=4\n")
        ) &&
        decode.contains(
          "function_symbol=lunaflux_attention_decode_tile_compiler_v1_blockwise_f32_v1\n",
        ) &&
        decode.contains("numeric_law=blockwise-f32-probability-v1\n")
      ) else {
      fail("all-new selection was not retained in AOT recipes")
    }
    @fs.write_file(
      root + "/selection-plan.txt",
      @fs.read_file(calibration + "/selection-plan.txt"),
      create_mode=CreateNew,
    )
  }
  let gpu = @shell.Cmd("nvidia-smi", [
    "--query-compute-apps=pid", "--format=csv,noheader",
  ]).output()
  gpu.check()
  guard gpu.stdout().trim().is_empty() && memory() >= 33554432L else {
    fail("GPU busy or insufficient memory")
  }
  // The base supplies the rebuilt launch-contract runtime; weights, base
  // kernels and workload generator remain those of the matched campaign.
  for name in ["source", "release"] {
    @fs.mkdir(root + "/" + name)
    // Copy directory contents, not a baseline's convenience symlink: the
    // deployment materializer requires its release root to be a real directory.
    @shell.Cmd("cp", ["-a", base + "/" + name + "/.", root + "/" + name + "/"]).run()
  }
  @shell.Cmd("ln", ["-s", base + "/toolchain", root + "/toolchain"]).run()
  @shell.Cmd("cp", ["-a", calibration + "/selected", root + "/candidate"]).run()
  for
    name in [
      "toolchain.v1", "convert.stdout", "bind.stdout", "benchmark.mbtx", "summarize.mbtx",
      "compare-outputs.mbtx", "selected_policy_probe.cu",
    ] {
    @fs.write_file(
      root + "/" + name,
      @fs.read_file(base + "/" + name),
      create_mode=CreateNew,
    )
  }
  @fs.write_file(
    root + "/export.stdout",
    @fs.read_file(calibration + "/selected-export.stdout"),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/fused-builder.mbtx",
    @fs.read_file(builder),
    create_mode=CreateNew,
  )
  let prepare = @fs.read_file(base + "/prepare-spark.mbtx")
    .text()
    .replace(
      old="source+\"/scripts/build-qwen3-reusable-fused-runtime.mbtx\"",
      new="root+\"/fused-builder.mbtx\"",
    )
  @fs.write_file(root + "/prepare-full.mbtx", prepare, create_mode=CreateNew)
  let unit = "lunaflux-calibrated-" +
    root.split("/").to_array().last().unwrap().to_owned()
  let measure = @fs.read_file(base + "/measure.mbtx")
    .text()
    .replace(
      old="lunaflux-bench-d13ac969-bridge.service",
      new=unit + "-bridge.service",
    )
  @fs.write_file(root + "/measure.mbtx", measure, create_mode=CreateNew)
  let moon = root + "/toolchain/bin/moon"
  checked(root, "prepare-fused", moon, [
    "run",
    root + "/prepare-full.mbtx",
    root,
    "fused",
  ])
  if forced_new {
    let bundle = @fs.read_file(root + "/fused/reusable-fused-runtime-bundle.v3").text()
    guard bundle.contains("heads_per_cta=2\n") ||
      bundle.contains("heads_per_cta=4\n") else {
      fail("head packing lost while packaging runtime bundle")
    }
    guard bundle.contains(
      "lunaflux_attention_decode_tile_compiler_v1_blockwise_f32_v1\n",
    ) else {
      fail("blockwise decode lost while packaging runtime bundle")
    }
  }
  checked(root, "probe-build", "/usr/local/cuda/bin/nvcc", [
    "-O3",
    "-arch=sm_121",
    "--fmad=false",
    root + "/selected_policy_probe.cu",
    "-lcuda",
    "-o",
    root + "/check-probe",
  ])
  // Check the exact cubins packaged by the fixed builder before serving.
  for
    (kind, directory, module_) in [
      ("ingress", "reusable-qwen-full-ingress", "ingress"),
      ("prefill", "reusable-qwen-prefill-attention", "prefill"),
      ("decode", "reusable-qwen-decode-attention", "attention"),
    ] {
    for
      (version, candidates, binaries) in [
        ("baseline", base + "/candidate", base + "/fused-full"),
        ("selected", root + "/candidate", root + "/fused"),
      ] {
      let destination = root + "/" + kind + "-" + version
      @fs.mkdir(destination)
      let reference = calibration + "/selected/default-" + directory
      @fs.write_file(
        destination + "/kernel.recipe",
        @fs.read_file(
          if all_new && version == "baseline" {
            reference + "/kernel.recipe"
          } else {
            candidates + "/" + directory + "/kernel.recipe"
          },
        ),
        create_mode=CreateNew,
      )
      @fs.write_file(
        destination + "/kernel.cubin",
        @fs.read_file(
          if all_new && version == "baseline" {
            reference + "/kernel.cubin"
          } else {
            binaries + "/" + module_ + ".cubin"
          },
        ),
        create_mode=CreateNew,
      )
    }
    for tool in ["memcheck", "racecheck", "synccheck"] {
      let args = ["--tool", tool, "--error-exitcode", "99"]
      if tool == "memcheck" {
        args.append(["--leak-check", "full"])
      }
      args.append([
        root + "/check-probe",
        calibration + "/" + kind + ".spec",
        root + "/" + kind + "-baseline",
        root + "/" + kind + "-selected",
        if kind == "decode" {
          "8"
        } else {
          "129"
        },
        "8",
        "2048",
        "--check-only",
      ])
      checked(
        root,
        "sanitizer-" + kind + "-" + tool,
        "/usr/local/cuda/bin/compute-sanitizer",
        args,
      )
    }
  }
  for phase in ["materialize", "capacity"] {
    checked(root, "prepare-" + phase, moon, [
      "run",
      root + "/prepare-full.mbtx",
      root,
      phase,
    ])
  }
  let units = [unit + "-bridge.service", unit + "-serve.service"]
  errdefer ignore(@shell.Cmd("systemctl", ["--user", "stop"] + units).output())
  for phase in ["serve", "bridge"] {
    @shell.Cmd("systemd-run", [
      "--user",
      "--unit=" + unit + "-" + phase,
      "--property=MemoryMax=64G",
      "--property=MemorySwapMax=0",
      "--property=RuntimeMaxSec=1800",
      moon,
      "run",
      root + "/prepare-full.mbtx",
      root,
      phase,
    ]).run()
  }
  let samples = StringBuilder()
  let mut done = false
  @async.with_task_group(group => {
    group.spawn_bg(() => {
      while !done {
        let available = memory()
        samples.write_string("\{@async.now()} \{available}\n")
        guard available >= 33554432L else { fail("32 GiB reserve breached") }
        @async.sleep(1000)
      }
    })
    checked(root, "measure", moon, [
      "run",
      root + "/measure.mbtx",
      root,
      "luna-full",
    ])
    done = true
  })
  @fs.write_file(
    root + "/memory-samples.txt",
    samples.to_string(),
    create_mode=CreateNew,
  )
  // The matched client requests drain itself. A completed transient unit may
  // already be unloaded; wait for the supervisor's terminal write instead of
  // stopping an absent unit or interrupting its successful cleanup.
  if !@fs.exists(root + "/drain-trigger") {
    @fs.write_file(
      root + "/drain-trigger",
      "benchmark complete\n",
      create_mode=CreateNew,
    )
  }
  let mut drained = false
  for _ in 0..<60 {
    if @fs.exists(root + "/supervisor.stdout") {
      drained = true
      break
    }
    @async.sleep(500)
  }
  guard drained else { fail("serving unit did not drain within 30 seconds") }
  let supervisor = @fs.read_file(root + "/supervisor.stdout").text()
  for field in ["drain_acknowledged=1", "child_exit_code=0", "child_closed=1"] {
    guard supervisor.contains(field) else { fail("missing " + field) }
  }
  guard @fs.read_file(root + "/runtime.stderr").text().is_empty() else {
    fail("runtime stderr")
  }
  @fs.write_file(
    root + "/RESULT.txt",
    "outcome=completed\nscope=matched-aot-selection-serving-retest\n",
    create_mode=CreateNew,
  )
}
