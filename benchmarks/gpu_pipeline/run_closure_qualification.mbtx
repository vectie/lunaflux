///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn field(text : String, key : String) -> String raise {
  guard text.split("\n").filter(x => x.has_prefix(key + "=")).to_array()
    is [line] else {
    fail("one field required: " + key)
  }
  line[key.length() + 1:].to_owned()
}

///|
fn overlay_path(path : String) -> Bool {
  !path.contains("..") &&
  !path.has_prefix("/") &&
  [
    "compiler/", "kernels/", "cmd/", "engine/", "device/", "internal/", "model/",
    "tests/", "scripts/",
  ].any(prefix => path.has_prefix(prefix)) &&
  (
    path.has_suffix(".mbt") ||
    path.has_suffix(".mbti") ||
    path.has_suffix(".c") ||
    path.has_suffix(".h") ||
    path.has_suffix("/moon.pkg") ||
    path == "scripts/materialize-qwen3-bf16-v12-launch.mbtx" ||
    path == "scripts/assemble-luna-kernel-root.mbtx"
  )
}

///|
test "scoped overlay excludes automation, parent traversal and absolute paths" {
  assert_true(overlay_path("compiler/attention_physical_ir/fold.mbt"))
  assert_true(overlay_path("kernels/new_rotary/moon.pkg"))
  for
    path in [
      "../source.mbt", "/compiler/a.mbt", "docs/PLAN.md", "kernels/x/a.mbtx", "internal/../a.c",
    ] {
    assert_false(overlay_path(path))
  }
}

///|
async fn record(
  root : String,
  label : String,
  exe : String,
  args : Array[String],
  cwd? : String = ".",
  export_partitions? : Bool = false,
  toolchain? : String = "",
) -> String {
  @fs.write_file(
    root + "/" + label + ".command.json",
    Json([exe, ..args]).stringify(),
    create_mode=CreateNew,
  )
  println("starting " + label)
  let out = @shell.Cmd(exe, args, cwd~, env={
    "PATH": (if toolchain.is_empty() { root + "/toolchain" } else { toolchain }) +
    "/bin:/usr/local/cuda-13.0/bin:/usr/local/bin:/usr/bin:/bin",
    "LUNA_EXPORT_BLOCKWISE_PARTITIONS": if export_partitions {
      "1"
    } else {
      "0"
    },
  }).output(max_output_bytes=33554432)
  @fs.write_file(
    root + "/" + label + ".stdout",
    out.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    out.stderr(),
    create_mode=CreateNew,
  )
  out.check()
  println("completed " + label)
  out.stdout()
}

///|
async fn reserve() -> Unit {
  guard @fs.read_file("/proc/meminfo")
    .text()
    .split("\n")
    .filter(x => x.has_prefix("MemAvailable:"))
    .to_array()
    is [line] else {
    fail("memory unavailable")
  }
  let words = line.split(" ").filter(x => !x.is_empty()).to_array()
  guard @string.parse_int64(words[1]) >= 33554432L else {
    fail("32 GiB reserve")
  }
  let idle = @shell.Cmd("nvidia-smi", [
    "--query-compute-apps=pid", "--format=csv,noheader",
  ]).output()
  idle.check()
  guard idle.stdout().trim().is_empty() else { fail("GPU occupied") }
  let identity = @shell.Cmd("nvidia-smi", [
    "--query-gpu=uuid", "--format=csv,noheader",
  ]).output()
  identity.check()
  assert_eq(
    identity.stdout().trim().to_owned(),
    "GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6",
  )
}

///|
async fn sha(path : String) -> String {
  let out = @shell.Cmd("sha256sum", [path]).output()
  out.check()
  out.stdout().split(" ").to_array()[0].to_owned()
}

///|
async fn prepare(base : String, overlay : String, root : String) -> Unit {
  reserve()
  guard !@fs.exists(root + "/source") else { fail("source already prepared") }
  guard @fs.read_file(base + "/RESULT.txt")
    .text()
    .has_prefix("outcome=completed\n") else {
    fail("incomplete frozen baseline")
  }
  let paths = @fs.read_file(overlay + "/FILES.txt")
    .text()
    .split("\n")
    .filter(x => !x.is_empty())
    .map(x => x.to_owned())
    .to_array()
  guard !paths.is_empty() && paths.all(overlay_path) else {
    fail("invalid scoped overlay")
  }
  @fs.mkdir(root + "/source")
  @shell.Cmd("cp", ["-a", base + "/source/.", root + "/source/"]).run()
  @shell.Cmd("ln", ["-s", base + "/toolchain", root + "/toolchain"]).run()
  for path in paths {
    let pieces = path.split("/").to_array()
    @shell.Cmd("mkdir", [
      "-p",
      root + "/source/" + pieces[:pieces.length() - 1].join("/"),
    ]).run()
    @shell.Cmd("cp", [overlay + "/" + path, root + "/source/" + path]).run()
  }
  ignore(
    record(
      root,
      "overlay-identities",
      "sha256sum",
      paths.map(x => root + "/source/" + x),
    ),
  )
  let moon = root + "/toolchain/bin/moon"
  ignore(
    record(
      root,
      "build-exporters",
      moon,
      [
        "build", "cmd/lunaflux_qwen3_bf16_candidate_export", "cmd/lunaflux_qwen3_fused_runtime_bundle_export",
        "--target", "native", "--release", "--deny-warn", "--warn-list", "-79-20-29-25-92-14",
        "-j", "2",
      ],
      cwd=root + "/source",
    ),
  )
  @fs.write_file(
    root + "/PREPARED.txt",
    "scope=current-compiler-scoped-overlay\n",
    create_mode=CreateNew,
  )
}

///|
fn same_decode_fold_geometry(before : String, after : String) -> Bool {
  let keys = ["LF_KEY_VALUE_TILE", "LF_HEAD_DIMENSION", "LF_SCORE_OWNERS"]
  keys.all(key => {
    let prefix = "#define " + key + " "
    let a = before.split("\n").filter(x => x.has_prefix(prefix)).to_array()
    let b = after.split("\n").filter(x => x.has_prefix(prefix)).to_array()
    !a.is_empty() &&
    !b.is_empty() &&
    a.all(x => x == a[0]) &&
    b.all(x => x == a[0])
  })
}

///|
fn same_prefill_fold_geometry(before : String, after : String) -> Bool {
  [
    "#define LF_KEY_VALUE_TILE ", "#define LF_HEAD_DIMENSION ", "#define LF_QUERY_TILE ",
  ].all(prefix => {
    let a = before.split("\n").filter(x => x.has_prefix(prefix)).to_array()
    let b = after.split("\n").filter(x => x.has_prefix(prefix)).to_array()
    !a.is_empty() &&
    !b.is_empty() &&
    a.all(x => x == a[0]) &&
    b.all(x => x == a[0])
  })
}

///|
test "prefill geometry changes require an envelope, not a bitwise claim" {
  let source = "#define LF_KEY_VALUE_TILE 64\n#define LF_HEAD_DIMENSION 128\n#define LF_QUERY_TILE 32\n"
  assert_true(same_prefill_fold_geometry(source, source))
  assert_false(
    same_prefill_fold_geometry(
      source,
      source.replace(old="TILE 64", new="TILE 128"),
    ),
  )
}

///|
test "same law is not bitwise identity across softmax tile boundaries" {
  let source = "#define LF_KEY_VALUE_TILE 32\n#define LF_HEAD_DIMENSION 128\n#define LF_SCORE_OWNERS 2\n"
  assert_true(same_decode_fold_geometry(source, source))
  assert_false(
    same_decode_fold_geometry(
      source,
      source.replace(old="TILE 32", new="TILE 64"),
    ),
  )
}

///|
async fn module_pair(
  root : String,
  label : String,
  source : String,
  baseline : String,
  spec : String,
  probe : String,
  kind : String,
) -> Unit {
  let decode = kind.has_prefix("decode")
  let partitioned = kind == "decode-partitioned"
  guard ["decode", "decode-partitioned", "prefill", "ingress"].contains(kind) &&
    !label.is_empty() &&
    !label.contains("/") &&
    !label.contains("..") else {
    fail("module pair arguments")
  }
  reserve()
  let recipe = @fs.read_file(source + "/kernel.recipe").text()
  let baseline_recipe = @fs.read_file(baseline + "/kernel.recipe").text()
  let same_law = recipe.contains("numeric_law=") &&
    baseline_recipe.contains("numeric_law=") &&
    field(recipe, "numeric_law") == field(baseline_recipe, "numeric_law")
  let same_fold = if !same_law || !@fs.exists(baseline + "/kernel.cu") {
    // Legacy serving directories can carry sealed cubins/recipes but no
    // source. The independent oracle remains mandatory; do not infer a
    // bitwise identity from an unavailable fold geometry.
    false
  } else {
    let before_source = @fs.read_file(baseline + "/kernel.cu").text()
    let after_source = @fs.read_file(source + "/kernel.cu").text()
    if decode {
      same_decode_fold_geometry(before_source, after_source)
    } else if kind == "prefill" {
      same_prefill_fold_geometry(before_source, after_source)
    } else { true }
  }
  assert_eq(field(recipe, "source_sha256"), sha(source + "/kernel.cu"))
  let directory = root + "/" + label
  guard !@fs.exists(directory) else { fail("module output exists") }
  @fs.mkdir(directory)
  for name in ["kernel.cu", "kernel.recipe"] {
    @fs.write_file(
      directory + "/" + name,
      @fs.read_file(source + "/" + name),
      create_mode=CreateNew,
    )
  }
  for suffix in ["first", "second"] {
    ignore(
      record(
        root,
        label + "-compile-" + suffix,
        "/usr/local/cuda-13.0/bin/nvcc",
        [
          "-O3",
          "-arch=sm_121",
          "--std=c++14",
          "--fmad=false",
          "--ftz=false",
          "--prec-div=true",
          "--prec-sqrt=true",
          "--maxrregcount=" + field(recipe, "max_registers"),
          "--Werror",
          "all-warnings",
          "-Xptxas=-v",
          "-cubin",
          directory + "/kernel.cu",
          "-o",
          directory + "/" + suffix + ".cubin",
        ],
      ),
    )
  }
  ignore(
    record(root, label + "-deterministic", "cmp", [
      directory + "/first.cubin",
      directory + "/second.cubin",
    ]),
  )
  @fs.write_file(
    directory + "/kernel.cubin",
    @fs.read_file(directory + "/first.cubin"),
    create_mode=CreateNew,
  )
  let workloads : Array[(Int, Int, Int, Bool)] = if decode {
    let histories = [0, 1, 31, 32, 127, 4096, 8191]
    let rows = [1, 8, 16]
    Array::makei(histories.length() * rows.length(), index => {
      let row_count = rows[index % rows.length()]
      (row_count, row_count, histories[index / rows.length()], false)
    })
  } else {
    [
      (2048, 1, 0, false),
      (2048, 1, 2048, false),
      (2048, 16, 4096, true),
      (129, 16, 4096, true),
      (2048, 16, 0, false),
      (1, 1, 4096, false),
    ]
  }
  for (tokens, rows, history, mixed) in workloads {
    reserve()
    let args = [
        spec,
        baseline,
        directory,
        tokens.to_string(),
        rows.to_string(),
        history.to_string(),
      ] +
      (if mixed { ["--mixed"] } else { [] }) +
      (if decode { ["--decode-envelope"] } else { [] }) +
      (if partitioned { ["--decode-partitioned"] } else { [] })
    let out = record(
      root,
      "\{label}-q\{tokens}-r\{rows}-h\{history}-m\{mixed}",
      probe,
      args,
    )
    guard out.contains("tokens=") && out.contains("oracle_maxabs=") else {
      fail("probe checks absent")
    }
    // Ingress and pure same-law rewrites are bitwise checked. Decode alternatives
    // can declare a different reduction law; the independent probe enforces its
    // differential/scalar error envelope, not a fake bitwise-equivalence claim.
    if kind == "ingress" || (same_law && same_fold) {
      guard !out.contains("bitwise=false") else {
        fail("ingress numeric regression")
      }
    }
  }
  for tool in ["memcheck", "racecheck", "synccheck"] {
    reserve()
    let args = ["--tool", tool, "--error-exitcode", "99"] +
      (if tool == "memcheck" { ["--leak-check", "full"] } else { [] }) +
      [
        probe,
        spec,
        baseline,
        directory,
        if decode {
          "16"
        } else {
          "129"
        },
        "16",
        "4096",
        "--check-only",
      ] +
      (if decode { ["--decode-envelope"] } else { ["--mixed"] }) +
      (if partitioned { ["--decode-partitioned"] } else { [] })
    ignore(
      record(
        root,
        label + "-" + tool,
        "/usr/local/cuda-13.0/bin/compute-sanitizer",
        args,
      ),
    )
  }
  @fs.write_file(
    directory + "/RESULT.txt",
    "outcome=passed\nscope=paired-kernel-not-serving\n",
    create_mode=CreateNew,
  )
}

///|
// Export the actual compiler physical frontier, never edit generated CUDA to
// make a test variant. The framing carries the exact runtime-bucket geometry.
async fn partition_export(
  root : String,
  origin : String,
  id : Int,
  partitions : Int,
) -> Unit {
  guard id > 0 && partitions > 0 else {
    fail("positive identity and partitions")
  }
  let label = "c\{id}-p\{partitions}"
  let text = record(
    root,
    label + "-export",
    origin + "/toolchain/bin/moon",
    [
      "test", "kernels/luna_cuda_attention_tile_source/blockwise_decode_wbtest.mbt",
      "--target", "native", "--deny-warn", "--warn-list", "-79-20-29-25-92-14",
    ],
    cwd=origin + "/source",
    export_partitions=true,
    toolchain=origin + "/toolchain",
  )
  ignore(extract_partition(root, text, id, partitions))
}

///|
async fn extract_partition(
  root : String,
  text : String,
  id : Int,
  partitions : Int,
) -> String {
  let label = "c\{id}-p\{partitions}"
  guard text.split("LUNA_PARTIAL_BEGIN ").to_array()[1:].filter(x => {
      x.has_prefix(label + "\n")
    })
    is [section] else {
    fail("exact physical variant absent")
  }
  guard section.split("\nLUNA_PARTIAL_SOURCE\n").to_array() is [header, body] else {
    fail("physical export framing")
  }
  guard body.split("\nLUNA_PARTIAL_END").to_array() is [source, _] else {
    fail("physical source framing")
  }
  let destination = root + "/exported-" + label
  @fs.mkdir(destination)
  @fs.write_file(
    destination + "/kernel.cu",
    source.to_owned(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    destination + "/kernel.recipe",
    header.split("\n").to_array()[1:].join("\n") +
    "\nsource_sha256=" +
    sha(destination + "/kernel.cu") +
    "\n",
    create_mode=CreateNew,
  )
  destination
}

///|
async fn main {
  match @env.args() {
    [_, "--prepare", base, overlay, root] => prepare(base, overlay, root)
    [_, "--module", root, label, source, baseline, spec, probe, kind] =>
      module_pair(root, label, source, baseline, spec, probe, kind)
    [_, "--partition-export", root, origin, id, partitions] =>
      partition_export(
        root,
        origin,
        @string.parse_int(id),
        @string.parse_int(partitions),
      )
    [_, "--export", root, base, label, prefill, decode, .. flags] => {
      guard !label.contains("/") &&
        !label.contains("..") &&
        flags.all(x => {
          ["--step-rotary-cache", "--prefill-approximate-exp2"].contains(x)
        }) else {
        fail("explicit export options")
      }
      guard @json.parse(@fs.read_file(base + "/export.command.json").text())
        is Array(values) else {
        fail("saved exporter command")
      }
      let argv = values.map(x => {
        guard x is String(s) else { fail("export argument") }
        s
      })
      let args = argv[1:].to_owned()
      guard args.length() > 16 && args[16] == base + "/candidate" else {
        fail("frozen export destination")
      }
      args[16] = root + "/" + label
      for i in 0..<(args.length() - 1) {
        if args[i] == "--prefill-candidate" {
          args[i + 1] = prefill
        }
        if args[i] == "--decode-candidate" {
          args[i + 1] = decode
        }
      }
      ignore(
        record(
          root,
          label + "-export",
          root +
          "/source/_build/native/release/build/cmd/lunaflux_qwen3_bf16_candidate_export/lunaflux_qwen3_bf16_candidate_export.exe",
          [..args, ..flags],
        ),
      )
    }
    [_, "--decode-sweep", root, saved, baseline, spec, probe, .. ids] => {
      let text = @fs.read_file(saved).text()
      for id in ids {
        let source = extract_partition(root, text, @string.parse_int(id), 8)
        module_pair(
          root,
          "decode-c" + id + "-p8",
          source,
          baseline,
          spec,
          probe,
          "decode",
        )
      }
    }
    _ =>
      fail(
        "--prepare BASE OVERLAY NEW_ROOT | --module ROOT LABEL SOURCE BASELINE SPEC PROBE KIND",
      )
  }
}
