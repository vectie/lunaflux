index 00000000..7ded13f6
--- /dev/null
+++ b/kernels/luna_cuda_attention_tile_source/register_score_wbtest.mbt
@@ -0,0 +1,76 @@
+///|
+test "register score rewrite preserves numerical law and removes shared exchange" {
+  let lowering = source_test_decode_lowering(candidate_id=468, alternative=true)
+  guard lowering.physical_program() is BlockwiseKeyProgram(fold, _) else {
+    fail("blockwise program required")
+  }
+  let fresh = fold.with_register_scores(subgroup_width=32).unwrap()
+  let body = cuda_blockwise_fold_body(fresh)
+  assert_false(body.contains("scores["))
+  assert_false(body.contains("__syncwarp"))
+  assert_true(body.contains("__shfl_sync(0xffffffffU, lane_probability, key)"))
+  assert_true(body.contains("lane < active_keys ? expf"))
+  assert_eq(fold.numeric_law(), fresh.numeric_law())
+}
+
+///|
+/// Offline experiment only: the conservative production launch contract is
+/// not changed. Compare both launch reservations before defining a new ABI.
+test "offline export register score residency experiment" {
+  if @env.get_env_var("LUNA_EXPORT_REGISTER_SCORES") != Some("1") {
+    return
+  }
+  let abi = CudaPagedAttentionTileAbi::new(
+    query_heads=16,
+    key_value_heads=8,
+    head_dimension=128,
+    tokens_per_page=8,
+    input_row_width=4096,
+    page_stride_values=8192L,
+    physical_page_capacity=16384L,
+    maximum_query_rows=32,
+    maximum_query_tokens=2048,
+    maximum_page_entries=16384,
+  )
+  let body = StringBuilder()
+  for partitions in [1, 8] {
+    let lowering = source_test_decode_lowering(
+      candidate_id=468,
+      alternative=true,
+      batch_rows=if partitions == 1 { 32 } else { 1 },
+      parallel_workgroup_target=64,
+      key_value_heads=8,
+      tokens_per_page=8,
+    )
+    assert_eq(lowering.key_value_partitions(), partitions)
+    guard lowering.physical_program() is BlockwiseKeyProgram(fold, effects) else {
+      fail("blockwise program required")
+    }
+    let fresh = fold.with_register_scores(subgroup_width=32).unwrap()
+    let source = emit_cuda_blockwise_decode_source(
+      lowering,
+      abi,
+      if partitions == 1 {
+        "register_decode"
+      } else {
+        "register_partial"
+      },
+      1048576,
+      fresh,
+      effects,
+    )
+    let text = @utf8.decode(source.bytes())
+    assert_false(text.contains("float *scores"))
+    assert_false(text.contains("int *tile_valid"))
+    body <+ "\{text}"
+    body <+ "\n"
+    if partitions == 8 {
+      let workspace = partitioned_workspace(lowering, abi, 16777216L)
+      body <+
+        "\{partitioned_merge_source(lowering, abi, workspace, "register_merge")}"
+    }
+  }
+  println("LUNA_REGISTER_SOURCE_BEGIN")
+  println(body.to_string())
+  println("LUNA_REGISTER_SOURCE_END")
+}
