+///|
+/// Pure optional physical rewrite. Unsupported tile/subgroup geometry keeps
+/// the existing shared exchange available rather than changing the fold.
+pub fn BlockwiseFold::with_register_scores(
+  self : BlockwiseFold,
+  subgroup_width~ : Int,
+) -> BlockwiseFold? {
+  RegisterScoreExchange::new(
+    keys=self.keys,
+    subgroup_width~,
+    score_owners=self.score_owners,
+  ).map(exchange => { ..self, register_scores: Some(exchange), })
+}
+
+///|
+pub fn BlockwiseFold::register_score_exchange(
+  self : BlockwiseFold,
+) -> RegisterScoreExchange? {
+  self.register_scores
+}
