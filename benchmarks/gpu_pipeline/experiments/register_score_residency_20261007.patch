diff --git a/compiler/attention_physical_ir/score_exchange.mbt b/compiler/attention_physical_ir/score_exchange.mbt
new file mode 100644
index 00000000..51e6ac5b
--- /dev/null
+++ b/compiler/attention_physical_ir/score_exchange.mbt
@@ -0,0 +1,45 @@
+///|
+/// A bijection from grouped dot-product owners to one score per subgroup
+/// lane. This changes storage/transport, not the reduction or numerical law.
+pub struct RegisterScoreExchange {
+  priv lanes : Int
+  priv owners : Int
+} derive(Debug, Eq)
+
+///|
+pub extend RegisterScoreExchange with Eq::{equal, not_equal}
+
+///|
+pub extend RegisterScoreExchange with @debug.Debug::{to_repr}
+
+///|
+pub fn RegisterScoreExchange::new(
+  keys~ : Int,
+  subgroup_width~ : Int,
+  score_owners~ : Int,
+) -> RegisterScoreExchange? {
+  guard keys == subgroup_width &&
+    subgroup_width > 0 &&
+    subgroup_width <= 128 &&
+    score_owners > 0 &&
+    subgroup_width % score_owners == 0 else {
+    return None
+  }
+  Some({ lanes: subgroup_width, owners: score_owners, })
+}
+
+///|
+pub fn RegisterScoreExchange::fragments(self : RegisterScoreExchange) -> Int {
+  self.lanes / self.owners
+}
+
+///|
+/// Producer lane and register slot for one score. Out-of-domain accesses
+/// cannot be converted into a device shuffle.
+pub fn RegisterScoreExchange::producer(
+  self : RegisterScoreExchange,
+  key : Int,
+) -> (Int, Int)? {
+  guard key >= 0 && key < self.lanes else { return None }
+  Some((key % self.owners * self.fragments(), key / self.owners))
+}
diff --git a/compiler/attention_physical_ir/score_exchange_test.mbt b/compiler/attention_physical_ir/score_exchange_test.mbt
new file mode 100644
index 00000000..3cf49165
--- /dev/null
+++ b/compiler/attention_physical_ir/score_exchange_test.mbt
@@ -0,0 +1,47 @@
+///|
+test "register score transport is a total bijection inside its domain" {
+  for width in [16, 32, 64] {
+    for owners in [2, 4, 8] {
+      let plan = @attention_physical_ir.RegisterScoreExchange::new(
+        keys=width,
+        subgroup_width=width,
+        score_owners=owners,
+      ).unwrap()
+      let seen : Array[(Int, Int)] = []
+      for key = 0; key < width; key = key + 1 {
+        let pair = plan.producer(key).unwrap()
+        assert_false(seen.contains(pair))
+        assert_eq(pair.0 / plan.fragments() + pair.1 * owners, key)
+        seen.push(pair)
+      }
+      assert_eq(plan.producer(-1), None)
+      assert_eq(plan.producer(width), None)
+    }
+  }
+  assert_eq(
+    @attention_physical_ir.RegisterScoreExchange::new(
+      keys=64,
+      subgroup_width=32,
+      score_owners=8,
+    ),
+    None,
+  )
+  let old = @attention_physical_ir.BlockwiseFold::new(
+    dimensions=128,
+    keys=32,
+    score_owners=8,
+  ).unwrap()
+  let fresh = old.with_register_scores(subgroup_width=32).unwrap()
+  assert_eq(old.numeric_law(), fresh.numeric_law())
+  assert_eq(old.steps(), fresh.steps())
+  let storage = @attention_physical_ir.BlockwiseTileStorage::new(
+    dimensions=128,
+    keys=32,
+    query_consumers=2,
+    stages=2,
+    validity_slots=0,
+    register_scores=true,
+  ).unwrap()
+  assert_eq(storage.region_sizes_bytes(), (32768L, 0L, 0L))
+  assert_eq(storage.minimum_bytes(), 32768L)
+}
diff --git a/kernels/luna_cuda_attention_tile_source/register_score_wbtest.mbt b/kernels/luna_cuda_attention_tile_source/register_score_wbtest.mbt
