///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn once(text : String, old : String, fresh : String) -> String raise {
  let parts = text.split(old).to_array()
  assert_eq(parts.length(), 2, msg=old)
  parts.join(fresh)
}

///|
fn object(value : Json) -> Map[String, Json] raise {
  guard value is Object(fields) else { fail("object required") }
  fields
}

///|
fn strings(value : Json) -> Array[String] raise {
  guard value is Array(values) else { fail("string array") }
  values.map(value => {
    guard value is String(text) else { fail("string") }
    text
  })
}

///|
fn field(text : String, key : String) -> String raise {
  guard text.split("\n").filter(s => s.has_prefix(key + "=")).to_array()
    is [line] else {
    fail(key)
  }
  line[key.length() + 1:].to_owned()
}

///|
// Keep one actual representative per bucket. The parser rejects duplicate
// candidates/buckets, missing baselines, unequal shapes or unequal samples.
fn routes(summary : Json, scope : String) -> String raise {
  guard summary is Array(records) else { fail("completed paired summary") }
  let mut text = "luna-attention-buckets-v1\nscope\t" + scope + "\n"
  for record in records {
    guard record is { "args": args, "metrics": metrics, .. } else {
      fail("paired record")
    }
    let args = strings(args)
    guard args.length() == 7 || args.length() == 10 else {
      fail("complete prefill or mixed-chain arguments")
    }
    let query = @string.parse_int(args[3])
    let rows = @string.parse_int(args[4])
    let history = @string.parse_int(args[5])
    guard query >= rows && rows > 0 && history >= 0 else { fail("shape") }
    guard metrics
      is {
        "baseline_median_us": Number(old, ..),
        "candidate_median_us": Number(fresh, ..),
        "samples": { "baseline_us": Array(a), "candidate_us": Array(b), .. },
        ..
      } &&
      a.length() == 5 &&
      b.length() == 5 &&
      old > 0.0 &&
      fresh > 0.0 else {
      fail("five completed paired measurements")
    }
    let (phase, context) = if args.length() == 7 {
      assert_eq(args[6], "--prefill-partitioned")
      ("prefill", history + (query + rows - 1) / rows)
    } else {
      assert_true(["--mixed-chain", "--mixed-decode-chain"].contains(args[6]))
      if args[6] == "--mixed-decode-chain" {
        assert_eq(
          args[1],
          args[2],
          msg="same prefill artifact; only decode companion changes",
        )
      }
      assert_eq(args[8], "--decode-history")
      guard rows >= 2 && query > rows && args[7].has_prefix("/") else {
        fail("mixed rows and immutable decode companion")
      }
      let decode_history = @string.parse_int(args[9])
      guard decode_history >= 0 else { fail("decode history") }
      // One decode row has its own history; do not divide the entire token
      // domain evenly and accidentally register a smaller context bucket.
      (
        "mixed",
        Int::max(
          history + (query - 1 + rows - 2) / (rows - 1),
          decode_history + 1,
        ),
      )
    }
    text += "record\t\{phase}\t\{rows}\t\{query}\t\{context}\t1\t\{(old * 1000.0).to_int64()}\t5\n"
    let candidate = if args[6] == "--mixed-decode-chain" { 7 } else { 5 }
    text += "record\t\{phase}\t\{rows}\t\{query}\t\{context}\t\{candidate}\t\{(fresh * 1000.0).to_int64()}\t5\n"
  }
  text
}

///|
fn append_routes(prior : String, fresh : String) -> String raise {
  guard prior.split("\n").to_array() is [header, scope, .., ""] &&
    fresh.split("\n").to_array() is [same_header, same_scope, .. records, ""] &&
    header == "luna-attention-buckets-v1" &&
    header == same_header &&
    scope == same_scope &&
    records.length() > 0 &&
    records.all(line => line.has_prefix("record\tmixed\t")) else {
    fail("same-scope additive mixed measurements")
  }
  // Replace a complete measured bucket, never mix its historical baseline
  // with a new companion comparison. Unaffected pure/mixed records survive.
  let keys = records.map(line => route_bucket(line.to_owned()))
  let kept : Array[String] = []
  for line in prior.split("\n") {
    if !line.has_prefix("record\t") ||
      !keys.contains(route_bucket(line.to_owned())) {
      kept.push(line.to_owned())
    }
  }
  kept.join("\n") + records.join("\n") + "\n"
}

///|
fn route_bucket(line : String) -> String raise {
  guard line.split("\t").to_array()
    is ["record", phase, rows, queries, context, _, _, _] else {
    fail("measured record")
  }
  let bounds = [rows, queries, context].map(text => {
    let value = @string.parse_int(text)
    guard value > 0 && value <= 1073741824 else {
      fail("bounded bucket dimension")
    }
    for bound = 1; bound < value; bound = bound * 2 {

    } nobreak {
      bound.to_string()
    }
  })
  phase.to_owned() + "\t" + bounds.join("\t")
}

///|
async fn sha(path : String) -> String {
  let out = @shell.Cmd("sha256sum", [path]).output()
  out.check()
  out.stdout().split(" ").to_array()[0].to_owned()
}

///|
async fn capture(
  root : String,
  label : String,
  program : String,
  args : Array[String],
  query : String,
) -> String {
  @fs.write_file(
    root + "/" + label + ".command.json",
    Json([program, ..args]).stringify(),
    create_mode=CreateNew,
  )
  let out = @shell.Cmd(program, args, cwd=query + "/source", env={
    "PATH": query + "/toolchain/bin:/usr/local/cuda-13.0/bin:/usr/bin:/bin",
  }).output(max_output_bytes=33554432)
  @fs.write_file(
    root + "/" + label + ".stdout",
    out.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    out.stderr(),
    create_mode=CreateNew,
  )
  out.check()
  println(label + " completed")
  out.stdout()
}

///|
async fn publish(path : String, value : Json) -> String {
  @shell.Cmd("mv", [path, path + ".8192-reference"]).run()
  @fs.write_file(
    path,
    value.stringify() + "\n",
    create_mode=CreateNew,
    permission=0o444,
  )
  sha(path)
}

///|
async fn main {
  guard @env.args() is [_, frozen, query, root, phase, .. extra] &&
    ["bind", "measure", "bind-mixed", "measure-mixed"].contains(phase) &&
    (if phase.has_suffix("-mixed") {
      extra.length() == 1
    } else {
      extra.is_empty()
    }) else {
    fail(
      "FROZEN_LONG IMMUTABLE_QUERY COMPLETED_PROBE_ROOT bind|measure|bind-mixed|measure-mixed [PRIOR_MEASURED_ROOT]",
    )
  }
  let moon = query + "/toolchain/bin/moon"
  let cli = query + "/source/_build/native/release/build/cmd/"
  if phase.has_prefix("bind") {
    assert_true(
      @fs.read_file(root + "/trial/RESULT.txt")
      .text()
      .has_prefix("outcome=completed\n"),
    )
    assert_eq(
      @fs.read_file(root + "/trial/device.stdout").text().trim(),
      "GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6",
    )
    let scope = field(
      @fs.read_file(query + "/serving-fused.stdout").text(),
      "attention_route_scope",
    )
    let measured = routes(
      @json.parse(@fs.read_file(root + "/trial/summary.json").text()),
      scope,
    )
    let measured = if phase == "bind-mixed" {
      append_routes(@fs.read_file(extra[0] + "/routes.v1").text(), measured)
    } else {
      measured
    }
    @fs.write_file(
      root + "/routes.v1",
      measured,
      create_mode=CreateNew,
      permission=0o444,
    )
    let bundle = root + "/measured-runtime.v11"
    let command = strings(
      @json.parse(@fs.read_file(query + "/serving-fused.command.json").text()),
    )
    let args = command[1:]
      .to_owned()
      .map(arg => {
        if arg == query + "/fused-routed/reusable-fused-runtime-bundle.v3" {
          bundle
        } else {
          arg
        }
      })
    args.append([
      "--attention-buckets",
      root + "/routes.v1",
      sha(root + "/routes.v1"),
    ])
    let report = capture(root, "rebind", command[0], args, query)
    assert_eq(field(report, "attention_route_scope"), scope)
    let command = strings(
      @json.parse(
        @fs.read_file(query + "/serving-materialize-target121.command.json").text(),
      ),
    )
    let args = command[1:]
      .to_owned()
      .map(arg => {
        if arg == query + "/deployment" {
          root + "/deployment"
        } else if arg.has_prefix(
            query + "/fused-routed/reusable-fused-runtime-bundle.v3#sha256=",
          ) {
          bundle + "#sha256=" + field(report, "runtime_sha256")
        } else {
          arg
        }
      })
    ignore(capture(root, "materialize", command[0], args, query))
    for name in ["source", "toolchain"] {
      @shell.Cmd("ln", ["-s", query + "/" + name, root + "/" + name]).run()
    }
    let prepare = once(
      @fs.read_file(root + "/prepare_long_context.mbtx").text(),
      "let cmd = base + \"/source/_build/native/release/build/cmd/\"",
      "let cmd = " + Json(cli).stringify(),
    )
    @fs.write_file(
      root + "/prepare-canonical.mbtx",
      prepare,
      create_mode=CreateNew,
    )
    for cap in [2048, 8192] {
      let arm = root + "/c\{cap}"
      @fs.mkdir(arm)
      for name in ["source", "toolchain"] {
        @shell.Cmd("ln", ["-s", query + "/" + name, arm + "/" + name]).run()
      }
      @shell.Cmd("ln", [
        "-s",
        query + "/serving-export.stdout",
        arm + "/export.stdout",
      ]).run()
      ignore(
        capture(
          root,
          "prepare-c\{cap}",
          moon,
          [
            "run",
            root + "/prepare-canonical.mbtx",
            root,
            arm,
            query + "/bind-target121-budget.stdout",
          ],
          query,
        ),
      )
      if cap == 2048 {
        let deployment = arm + "/deployment"
        let policy_path = deployment + "/policy-root/instance/policy.json"
        let policy = object(@json.parse(@fs.read_file(policy_path).text()))
        let scheduler = object(policy["scheduler"])
        scheduler["step_token_budget"] = Json(2048)
        scheduler["prefill_chunk_tokens"] = Json(2048)
        policy["scheduler"] = Json::object(scheduler)
        let policy_sha = publish(policy_path, Json::object(policy))
        let launch_path = deployment + "/lunaflux.launch.json"
        let launch = object(@json.parse(@fs.read_file(launch_path).text()))
        launch["instance_policy"] = {
          "locator": "instance/policy.json",
          "sha256": policy_sha,
        }
        let launch_sha = publish(launch_path, Json::object(launch))
        @shell.Cmd("mv", [
          arm + "/capacity.json",
          arm + "/capacity.8192-reference.json",
        ]).run()
        ignore(
          capture(
            root,
            "capacity-c2048",
            query +
            "/source/scripts/materialize-qwen3-authenticated-capacity.sh",
            [
              query +
              "/bind-target121-budget.stdout#sha256=" +
              sha(query + "/bind-target121-budget.stdout"),
              deployment + "#sha256=" + launch_sha,
              cli +
              "lunaflux/lunaflux.exe#sha256=" +
              sha(cli + "lunaflux/lunaflux.exe"),
              cli +
              "lunaflux_qwen3_token_id_bridge/lunaflux_qwen3_token_id_bridge.exe#sha256=" +
              sha(
                cli +
                "lunaflux_qwen3_token_id_bridge/lunaflux_qwen3_token_id_bridge.exe",
              ),
              arm + "/capacity.json",
            ],
            query,
          ),
        )
      }
    }
  } else {
    let tool = once(
      @fs.read_file(frozen + "/measure/launcher.mbtx").text(),
      "let cmd = \"/home/wlc004s/lunaflux-domain-serving-v4-20261004.QmE9WZ7s/source/_build/native/release/build/cmd/\"",
      "let cmd = " + Json(cli).stringify(),
    )
    let tool = once(
      tool, "let orders = [[\"vllm\",\"luna-full\",\"sglang\"]]", "let orders = [[\"luna-full\"]]",
    )
    let raw = @fs.read_file(frozen + "/long_context_client.mbtx").text()
    let begin = raw
      .split("  let cells = if options is [\"--smoke\"] {")
      .to_array()
    assert_eq(begin.length(), 2)
    let end = begin[1].split("  let matrix_json : Array[Json]").to_array()
    assert_eq(end.length(), 2)
    let cells = if phase == "measure-mixed" {
      "  let cells = [(\"i32512-o64-c1-varied\",[32512],64,\"varied\")," +
      "(\"i32512-o64-c2-varied\",[32512,32512],64,\"varied\")];\n"
    } else {
      "  let cells = [(\"i16384-o64-c1-varied\",[16384],64,\"varied\")," +
      "(\"i32512-o64-c1-varied\",[32512],64,\"varied\")," +
      "(\"i32512-o64-c2-varied\",[32512,32512],64,\"varied\")];\n"
    }
    let client = begin[0].to_owned() +
      cells +
      "  let matrix_json : Array[Json]" +
      end[1].to_owned()
    // ABBA fresh starts at the same 2K scheduler policy, then an 8K control.
    let starts = if phase == "measure-mixed" {
      [(false, 2048), (true, 2048), (true, 2048), (false, 2048)]
    } else {
      [(false, 2048), (true, 2048), (true, 2048), (false, 2048), (true, 8192)]
    }
    for index, (measured, cap) in starts {
      let output = root +
        "/e2e-\{index}-" +
        (if measured { "measured" } else { "baseline" })
      @fs.mkdir(output)
      let script = output + "/launcher.mbtx"
      @fs.write_file(script, tool, create_mode=CreateNew)
      @fs.write_file(script + ".client.mbtx", client, create_mode=CreateNew)
      let arm = if measured {
        root + "/c\{cap}"
      } else if phase == "measure-mixed" {
        extra[0] + "/c\{cap}"
      } else {
        query + "/c\{cap}-target121"
      }
      ignore(
        capture(
          root,
          "e2e-\{index}",
          moon,
          ["run", script, arm, output, script],
          query,
        ),
      )
    }
    @fs.write_file(
      root + "/RESULT.txt",
      "outcome=completed\nscope=per-device-measured-prefill-route; uninstrumented-serving-ABBA\n",
      create_mode=CreateNew,
    )
  }
}

///|
test "mixed context retains the independent decode history and prior routes" {
  let record : Json = {
    "args": [
      "/s", "/a", "/b", "1537", "2", "30976", "--mixed-chain", "/decode", "--decode-history",
      "32512",
    ],
    "metrics": {
      "baseline_median_us": 7.0,
      "candidate_median_us": 21.0,
      "samples": {
        "baseline_us": [7, 7, 7, 7, 7],
        "candidate_us": [21, 21, 21, 21, 21],
      },
    },
  }
  let fresh = routes(Json([record]), "scope")
  assert_true(fresh.contains("mixed\t2\t1537\t32513\t1\t7000\t5"))
  let prior = "luna-attention-buckets-v1\nscope\tscope\nrecord\tprefill\t1\t64\t64\t1\t50\t5\n"
  let combined = append_routes(prior, fresh)
  assert_true(combined.has_prefix(prior))
  assert_eq(combined.split("luna-attention-buckets-v1").to_array().length(), 2)
  let same_bucket = fresh.replace(old="1537", new="1792")
  assert_eq(append_routes(same_bucket, fresh), fresh)
  let companion = object(record)
  companion["args"] = Json([
    "/s", "/a", "/a", "1537", "2", "30976", "--mixed-decode-chain", "/decode", "--decode-history",
    "32512",
  ])
  let decode = routes(Json([Json::object(companion)]), "scope")
  assert_true(decode.contains("mixed\t2\t1537\t32513\t7\t21000\t5"))
  assert_false(append_routes(fresh, decode).contains("\t5\t21000\t5"))
  try
    append_routes(prior, fresh.replace(old="scope\tscope", new="scope\tother"))
  catch {
    _ => ()
  } noraise {
    _ => fail("cross-device/source scope accepted")
  }
}

///|
test "measurements describe complete split graph and actual row contexts" {
  let record : Json = {
    "args": ["/s", "/a", "/b", "2048", "2", "12288", "--prefill-partitioned"],
    "metrics": {
      "baseline_median_us": 3.0,
      "candidate_median_us": 9.0,
      "samples": {
        "baseline_us": [3, 3, 3, 3, 3],
        "candidate_us": [9, 9, 9, 9, 9],
      },
    },
  }
  let text = routes(Json([record]), "scope")
  assert_true(text.contains("prefill\t2\t2048\t13312\t1\t3000\t5"))
  assert_true(text.contains("prefill\t2\t2048\t13312\t5\t9000\t5"))
}
