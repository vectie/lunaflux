///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn csv(line : StringView) -> Array[String] {
  let fields = []
  let mut value = StringBuilder()
  for i = 0, quoted = false; i < line.length(); {
    let c = line[i]
    if c == '"' {
      if quoted && i + 1 < line.length() && line[i + 1] == '"' {
        value.write_char('"')
        continue i + 2, quoted
      }
      continue i + 1, !quoted
    }
    if c == ',' && !quoted {
      fields.push(value.to_string())
      value = StringBuilder()
    } else {
      value.write_view(line[i:i + 1])
    }
    continue i + 1, quoted
  }
  fields.push(value.to_string())
  fields
}

///|
fn number(value : String) -> Double raise {
  @string.parse_double(value.split(",").join(""))
}

///|
fn counters(source : String) -> Array[Json] raise {
  guard source.split("\n").filter(x => x.has_prefix("\"")).to_array()
    is [header, _, a, b] else {
    fail("two exact selected launches")
  }
  let keys = csv(header)
  [a, b].map(line => {
    let values = csv(line)
    assert_eq(keys.length(), values.length())
    let latency = number(
      values[keys
      .search("smsp__average_warp_latency_per_inst_issued.ratio")
      .unwrap()],
    )
    guard latency > 0.0 else { fail("latency denominator") }
    let raw : Map[String, Json] = Map([])
    let stalls : Map[String, Json] = Map([])
    for i, key in keys {
      raw[key] = Json(values[i])
      if key.has_prefix("smsp__average_warps_issue_stalled_") {
        stalls[key] = Json(100.0 * number(values[i]) / latency)
      }
    }
    { "raw": Json::object(raw), "warp_latency_percent": Json::object(stalls) }
  })
}

///|
fn opcodes(source : String) -> Array[Json] raise {
  let result = []
  let mut keys : Array[String] = []
  let mut totals : Map[String, Double] = Map([])
  for line in source.split("\n") {
    if !line.has_prefix("\"") {
      continue
    }
    let fields = csv(line)
    if fields[0] == "Kernel Name" {
      if !totals.is_empty() {
        result.push(Json::object(totals.map((_, x) => Json(x))))
      }
      totals = Map([])
      keys = []
    } else if fields[0] == "Address" {
      keys = fields
    } else if !keys.is_empty() {
      assert_eq(fields.length(), keys.length())
      let words = fields[keys.search("Source").unwrap()]
        .trim()
        .split(" ")
        .filter(x => !x.is_empty())
        .to_array()
      guard words is [first, .. rest] else { continue }
      let op = (if first.has_prefix("@") { rest[0] } else { first }).to_owned()
      let count = number(fields[keys.search("Instructions Executed").unwrap()])
      totals[op] = totals.get(op).unwrap_or(0.0) + count
    }
  }
  if !totals.is_empty() {
    result.push(Json::object(totals.map((_, x) => Json(x))))
  }
  assert_eq(result.length(), 2)
  result
}

///|
async fn main {
  guard @env.args() is [_, root] else { fail("LOCAL_RESULTS_ROOT") }
  let cells : Array[Json] = []
  for host in ["178", "179"] {
    guard @json.parse(@fs.read_file(root + "/summary" + host + ".json").text())
      is Array(records) &&
      records.length() == 3 else {
      fail("three cells/host")
    }
    for record in records {
      guard record is { "label": String(label), "metrics": metrics, .. } else {
        fail("record")
      }
      cells.push({ "host": host, "label": label, "metrics": metrics })
    }
  }
  let report : Json = {
    "scope": "explicit approximate numerical policy; synthetic attention, not serving",
    "cells": cells,
    "profile179_strict_then_approximate": counters(
      @fs.read_file(root + "/raw.stdout").text(),
    ),
    "opcodes179_strict_then_approximate": opcodes(
      @fs.read_file(root + "/sass.stdout").text(),
    ),
  }
  @fs.write_file(
    root + "/report.json",
    report.stringify(indent=2),
    create_mode=CreateNew,
  )
  println(Json(cells).stringify(indent=2))
}

///|
test "CSV functional state preserves grouped counters and quoting" {
  assert_eq(csv("\"a,b\",\"c\"\"d\",\"\""), ["a,b", "c\"d", ""])
  assert_eq(number("1,234,567"), 1234567.0)
}
