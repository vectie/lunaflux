import {
  "moonbitlang/async@0.20.3",
  "moonbitlang/async@0.20.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

fn number(fields : ArrayView[StringView], key : String) -> Int64 raise {
  guard fields.filter(f => f.has_prefix(key + "=")) is [value] else { fail("missing/duplicate " + key) }
  @string.parse_int64(value[key.length()+1:])
}

async fn main {
  let args=@env.args()
  guard args.length()==2 else { fail("usage: summarize_execution_trace.mbtx SERVER_STDERR") }
  let source=@fs.read_file(args[1]).text()
  let mut steps=0L
  let mut queries=0L
  let mut decoded=0L
  let mut outputs=0L
  let mut mixed=0L
  let mut prefill_steps=0L
  let mut decode_steps=0L
  let mut bucket_tokens=0L
  let mut route_ns=0L
  let mut captured=0L
  let mut eager=0L
  let mut current_tokens=0L
  let mut current_rows=0L
  let mut current_prefill=0L
  let mut current_decode=0L
  let mut observed_rows=0L
  let mut row_tokens=0L
  let mut context=0L
  let mut row_bucket_tokens=0L
  let mut selected_owner = -1L
  let mut epoch = -1L
  let mut state=0
  let mut submitted_ns=0L
  let mut last_completed_ns=0L
  let mut host_interstep_ns=0L
  let mut execute_interval_ns=0L
  let owners : Map[Int64,Int64] = Map([])
  println("step\trows\tqueries\tprefill_rows\tdecode_rows\tcontext\tbucket_rows\tbucket_queries\tbucket_context\towner\toutputs\troute_ns\tindependent_row_pow2_queries")
  for line in source.split("\n") {
    let parts=line.split("lf_exec ").to_array()
    if parts.length()==1 {continue}
    guard parts.length()==2 else {fail("overlapping trace records")}
    let fields=parts[1].split(" ").to_array()
    let kind=number(fields[:],"kind")
    let ns=number(fields[:],"ns")
    let sequence=number(fields[:],"seq")
    let a=number(fields[:],"a")
    let b=number(fields[:],"b")
    let c=number(fields[:],"c")
    let d=number(fields[:],"d")
    let e=number(fields[:],"e")
    let f=number(fields[:],"f")
    let elapsed=number(fields[:],"elapsed")
    match kind {
      0L => {
        assert_eq(state,0)
        current_rows=a;current_tokens=b;current_prefill=c;current_decode=d
        observed_rows=0;row_tokens=0;context=0;row_bucket_tokens=0
        assert_eq(a,c+d)
        state=1
      }
      1L | 2L => {
        assert_eq(state,1)
        guard b>0 && c>=0 else {fail("invalid row")}
        observed_rows+=1;row_tokens+=b;context=Int64::max(context,b+c)
        let mut rounded=1L
        while rounded<b {rounded*=2}
        row_bucket_tokens+=rounded
        if kind==1 {queries+=b} else {assert_eq(b,1L);decoded+=1}
      }
      3L => {
        assert_eq(state,1);assert_eq(observed_rows,current_rows);assert_eq(row_tokens,current_tokens)
        guard c>=current_rows && d>=current_tokens && e>=context else {fail("bucket undercovers work")}
        steps+=1;outputs+=f;bucket_tokens+=d;route_ns+=elapsed
        if current_prefill>0 && current_decode>0 {mixed+=1}
        else if current_prefill>0 {prefill_steps+=1} else {decode_steps+=1}
        owners[b]=owners.get(b).unwrap_or(0L)+1
        selected_owner=b;epoch=sequence;state=2
        println("\{steps}\t\{current_rows}\t\{current_tokens}\t\{current_prefill}\t\{current_decode}\t\{context}\t\{c}\t\{d}\t\{e}\t\{b}\t\{f}\t\{elapsed}\t\{row_bucket_tokens}")
      }
      4L => {
        assert_eq(state,2);assert_eq(sequence,epoch);assert_eq(a,selected_owner)
        if b==1 {captured+=1} else {assert_eq(b,0L);eager+=1}
        if last_completed_ns>0 {host_interstep_ns+=ns-last_completed_ns}
        submitted_ns=ns;state=3
      }
      5L => {
        assert_eq(state,3);assert_eq(sequence,epoch);assert_eq(a,selected_owner)
        execute_interval_ns+=ns-submitted_ns;last_completed_ns=ns;state=0
      }
      _ => fail("unknown trace event")
    }
  }
  assert_eq(state,0)
  guard steps>0 else {fail("no complete worker trace")}
  println("summary steps=\{steps} prefill_tokens=\{queries} decode_tokens=\{decoded} outputs=\{outputs} pure_prefill=\{prefill_steps} mixed=\{mixed} pure_decode=\{decode_steps} captured=\{captured} eager=\{eager} bucket_query_capacity=\{bucket_tokens} route_ns=\{route_ns} host_interstep_ns=\{host_interstep_ns} execute_interval_ns=\{execute_interval_ns}")
  let keys=owners.keys().to_array();keys.sort()
  for owner in keys {println("owner \{owner} steps=\{owners[owner]}")}
  println("host intervals include diagnostic overhead; bucket capacity and independent row rounding are not measured padded FLOPs")
}
