///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn csv_fields(line : StringView) -> Array[String] {
  let fields = []
  let mut quoted = false
  let mut value = StringBuilder()
  let mut i = 0
  while i < line.length() {
    let c = line[i]
    if c == '"' {
      if quoted && i + 1 < line.length() && line[i + 1] == '"' {
        value.write_char('"')
        i += 1
      } else {
        quoted = !quoted
      }
    } else if c == ',' && !quoted {
      fields.push(value.to_string())
      value = StringBuilder()
    } else {
      value.write_view(line[i:i + 1])
    }
    i += 1
  }
  fields.push(value.to_string())
  fields
}

///|
async fn main {
  let args = @env.args()
  guard args is [_, root, .. options] &&
    (options.is_empty() || options is ["seal"]) else {
    fail("SHORT_EXPERIMENT_ROOT [seal]")
  }
  if options is ["seal"] {
    for round in 0..<3 {
      let run = root + "/control/r\{round}-luna-full"
      assert_true(
        @fs.read_file(run + "/RESULT.txt")
        .text()
        .has_prefix("outcome=completed\n"),
      )
      assert_true(@fs.read_file(run + "/runtime.stderr").text().is_empty())
      for line in @fs.read_file(run + "/memory.csv").text().split("\n") {
        if !line.is_empty() {
          assert_true(
            @string.parse_int64(line.split(",").to_array()[1]) >= 33554432L,
          )
        }
      }
    }
    for tool in ["memcheck", "racecheck"] {
      let log = @fs.read_file(root + "/" + tool + ".stdout").text()
      assert_true(log.contains("correctness=passed"))
      assert_true(log.contains("0 errors") || log.contains("0 hazards"))
    }
    let idle = @shell.Cmd("nvidia-smi", [
      "--query-compute-apps=pid", "--format=csv,noheader",
    ]).output()
    idle.check()
    assert_true(idle.stdout().trim().is_empty())
    guard !@fs.exists(root + "/measurement.tar.gz") else {
      fail("non-overwriting archive")
    }
    let archive = @shell.Cmd("tar", [
      "-czf",
      root + "/measurement.tar.gz",
      "--exclude=_build",
      "--exclude=.mooncakes",
      "-C",
      root,
      "control",
      "trace",
      "decode",
      "decode-v2",
      "summary.json",
      "counters.csv",
      "counters.stderr",
      "counters-summary.json",
      "memcheck.stdout",
      "memcheck.stderr",
      "racecheck.stdout",
      "racecheck.stderr",
      "ako_short_serving.mbtx",
      "ako_short_decode.mbtx",
      "ako_short_decode_v2.mbtx",
      "ako_short_report.mbtx",
      "ako_short_counters.mbtx",
      "ako_trial.mbtx",
      "selected_policy_probe.cu",
      "selected_policy_geometry.h",
    ]).output(max_output_bytes=16777216)
    @fs.write_file(
      root + "/archive.stdout",
      archive.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/archive.stderr",
      archive.stderr(),
      create_mode=CreateNew,
    )
    archive.check()
    let hash = @shell.Cmd("sha256sum", [root + "/measurement.tar.gz"]).output()
    hash.check()
    @fs.write_file(
      root + "/measurement.tar.gz.sha256",
      hash.stdout(),
      create_mode=CreateNew,
    )
    @shell.Cmd("chmod", ["0444", root + "/measurement.tar.gz"]).run()
    @fs.write_file(
      root + "/RESULT.txt",
      "outcome=completed\nscope=short-input AKO diagnostic; no serving schedule promoted\n",
      create_mode=CreateNew,
    )
    println(hash.stdout())
    return
  }
  let lines = @fs.read_file(root + "/counters.csv")
    .text()
    .split("\n")
    .filter(s => s.has_prefix("\""))
    .to_array()
  assert_eq(lines.length(), 4)
  let names = csv_fields(lines[0])
  let units = csv_fields(lines[1])
  let wanted = [
    "Kernel Name", "gpu__time_duration.sum", "launch__registers_per_thread", "launch__waves_per_multiprocessor",
    "smsp__inst_executed.sum", "smsp__warps_eligible.avg.per_cycle_active", "smsp__issue_active.avg.pct_of_peak_sustained_active",
    "smsp__average_warps_issue_stalled_long_scoreboard_per_issue_active.ratio", "smsp__average_warps_issue_stalled_short_scoreboard_per_issue_active.ratio",
    "smsp__average_warps_issue_stalled_barrier_per_issue_active.ratio", "smsp__average_warps_issue_stalled_wait_per_issue_active.ratio",
    "derived__local_spilling_requests", "dram__bytes_read.sum", "l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_ld.sum",
    "l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_st.sum",
  ]
  let records : Array[Json] = []
  for i in 2..<4 {
    let values = csv_fields(lines[i])
    assert_eq(values.length(), names.length())
    let metrics : Array[Json] = []
    for index, name in names {
      if wanted.contains(name) {
        let record : Json = {
          "metric": name,
          "value": values[index],
          "unit": units[index],
        }
        metrics.push(record)
        println("\{i - 2} \{name}=\{values[index]} \{units[index]}")
      }
    }
    records.push({ "launch": i - 2, "metrics": metrics })
  }
  @fs.write_file(
    root + "/counters-summary.json",
    Json(records).stringify(indent=2),
    create_mode=CreateNew,
  )
  for tool in ["memcheck", "racecheck"] {
    let result = @shell.Cmd("/usr/local/cuda-13.0/bin/compute-sanitizer", [
      "--tool",
      tool,
      "--error-exitcode",
      "7",
      root + "/decode-v2/probe",
      root + "/decode-v2/decode.spec",
      root + "/decode-v2/baseline",
      root + "/decode-v2/c464",
      "16",
      "16",
      "128",
      "--check-only",
    ]).output(max_output_bytes=16777216)
    @fs.write_file(
      root + "/" + tool + ".stdout",
      result.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/" + tool + ".stderr",
      result.stderr(),
      create_mode=CreateNew,
    )
    result.check()
  }
}

///|
test "wide NCU CSV retains quoted commas and escaped quotes" {
  assert_eq(csv_fields("\"a,b\",\"c\"\"d\",\"e\""), ["a,b", "c\"d", "e"])
}
