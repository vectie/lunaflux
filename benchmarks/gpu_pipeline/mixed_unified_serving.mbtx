///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn once(text : String, old : String, fresh : String) -> String raise {
  guard text.split(old).to_array() is [a, b] else {
    fail("frozen seam: " + old)
  }
  a.to_owned() + fresh + b.to_owned()
}

///|
async fn capture(
  root : String,
  label : String,
  cmd : String,
  args : Array[String],
) -> Unit {
  @fs.write_file(
    root + "/" + label + ".command.json",
    Json([cmd, ..args]).stringify(),
    create_mode=CreateNew,
  )
  let r = @shell.Cmd(cmd, args).output(max_output_bytes=33554432)
  @fs.write_file(
    root + "/" + label + ".stdout",
    r.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    r.stderr(),
    create_mode=CreateNew,
  )
  r.check()
}

///|
async fn main {
  guard @env.args() is [_, root, mode, .. suffix] &&
    root.has_prefix("/home/wlc004s/lunaflux-mixed-serving-20261008.") else {
    fail("NEW_ROOT prepare|timing|profile")
  }
  let baseline = "/home/wlc004s/lunaflux-batch-cliff-fix-20261007.sx0E1lbt/serving/long-final"
  let frozen = "/home/wlc004s/lunaflux-mixed-capture-repair-20261006.sQMel69Z"
  let moon = frozen + "/toolchain/bin/moon"
  let serving = root + "/serving"
  if mode == "prepare" {
    assert_false(@fs.exists(root + "/source"))
    capture(root, "source-copy", "cp", [
      "-a",
      frozen + "/source",
      root + "/source",
    ])
    let directory = root + "/source/engine/device_step/"
    let metadata = once(
      @fs.read_file(directory + "attention_metadata.mbt").text(),
      "for row in 0..<summary.prefill_count {",
      "for row in 0..<(summary.prefill_count + summary.decode_count) {",
    )
    @fs.write_file(directory + "attention_metadata.mbt", metadata)
    @fs.write_file(
      root + "/attention_metadata.diagnostic.mbt",
      metadata,
      create_mode=CreateNew,
    )
    let original = @fs.read_file(directory + "attention_phase_executor.mbt").text()
    guard original
      .split(
        "  guard mixed_attention_steps(steps, resources, partitioned_decode~)",
      )
      .to_array()
      is [a, b] &&
      b.split("  let owner =").to_array() is [_, c] else {
      fail("mixed guard")
    }
    let changed = a.to_owned() +
      "  let mixed = steps\n  ignore(partitioned_decode)\n  ignore(decode_row_bound)\n  let owner =" +
      c.to_owned()
    guard changed
      .split("  let selected : Array[@device.OrderedKernelLaunch] = []")
      .to_array()
      is [a, b] &&
      b.split("  let operation_ids =").to_array() is [_, c] else {
      fail("mixed list")
    }
    let changed = a.to_owned() +
      "  let selected = launches.to_array()\n  let operation_ids =" +
      c.to_owned()
    @fs.write_file(directory + "attention_phase_executor.mbt", changed)
    @fs.write_file(
      root + "/attention_phase_executor.diagnostic.mbt",
      changed,
      create_mode=CreateNew,
    )
    capture(root, "build-worker", moon, [
      "-C",
      root + "/source",
      "build",
      "cmd/device_worker_child",
      "--target",
      "native",
      "--release",
      "-j",
      "2",
      "--warn-list",
      "-79-20-29-25-92-14",
    ])
    @fs.mkdir(serving)
    capture(root, "deployment-copy", "cp", [
      "-a",
      baseline + "/deployment",
      serving + "/deployment",
    ])
    for name in ["capacity.json", "export.stdout"] {
      @fs.write_file(
        serving + "/" + name,
        @fs.read_file(baseline + "/" + name),
        create_mode=CreateNew,
      )
    }
    for name in ["source", "toolchain"] {
      @shell.Cmd("ln", ["-s", frozen + "/" + name, serving + "/" + name]).run()
    }
    let worker = serving + "/deployment/bin/lunaflux-device-worker"
    @shell.Cmd("chmod", ["u+w", worker]).run()
    @shell.Cmd("cp", [
      root +
      "/source/_build/native/release/build/cmd/device_worker_child/device_worker_child.exe",
      worker,
    ]).run()
    let hash = @shell.Cmd("sha256sum", [worker]).output()
    hash.check()
    let sha = hash.stdout().split(" ").to_array()[0].to_owned()
    let launch = serving + "/deployment/lunaflux.launch.json"
    guard @json.parse(@fs.read_file(launch).text()) is Object(fields) else {
      fail("launch")
    }
    fields["worker_executable"] = { "path": worker, "sha256": sha }
    @shell.Cmd("chmod", ["u+w", launch]).run()
    @fs.write_file(launch, Json(fields).stringify())
    @fs.write_file(
      serving + "/PREPARED.json",
      Json({
        "scope": "diagnostic unified mixed-row substitution; not approved production release",
        "worker_sha256": sha,
        "decode_numeric_law": "selected prefill matrix law, not bitwise split-decode equivalent",
      }).stringify(indent=2),
      create_mode=CreateNew,
    )
    return
  }
  assert_true(mode == "timing" || mode == "profile")
  assert_true(@fs.exists(serving + "/PREPARED.json"))
  assert_true(suffix.is_empty() || suffix is ["v2"])
  let tag = if suffix.is_empty() { "" } else { "-v2" }
  let output = root + "/" + mode + tag
  @fs.mkdir(output)
  let previous = "/home/wlc004s/lunaflux-batch-cliff-abba-20261007.xvFHOL9t"
  let launcher = once(
    @fs.read_file(previous + "/launcher.mbtx").text(),
    "let unit = \"lunaflux-matched-\"",
    "let unit = \"lunaflux-unified-" +
    root.split(".").to_array().last().unwrap().to_owned() +
    "-\"",
  )
  let launcher = once(
    launcher, "\"--property=RuntimeMaxSec=7200\"", "\"--property=RuntimeMaxSec=600\"",
  )
  let launcher = if mode == "profile" {
    let build = "/home/wlc004s/lunaflux-mixed-work-20261007.NnA6SsKN/diagnostic-source/_build/native/release/build/"
    let tool = once(
      launcher,
      "cmd + \"lunaflux/lunaflux.exe\",",
      Json(build + "cmd/lunaflux/lunaflux.exe").stringify() + ",",
    )
    once(
      tool,
      "serving +\n        \"/source/_build/native/release/build/tests/qwen3_bf16_serving_supervisor/qwen3_bf16_serving_supervisor.exe\",\n        [",
      "\"/usr/local/bin/nsys\",\n        [\"profile\",\"--trace=cuda\",\"--sample=none\",\"--cpuctxsw=none\",\"--cuda-graph-trace=node\",\"--trace-fork-before-exec=true\",\"--wait=all\",\"-o\",root+\"/trace\"," +
      Json(
        build +
        "tests/qwen3_bf16_serving_supervisor/qwen3_bf16_serving_supervisor.exe",
      ).stringify() +
      ",",
    )
  } else {
    launcher
  }
  let client = @fs.read_file(previous + "/launcher.mbtx.client.mbtx").text()
  guard client
    .split("fn matrix() -> Array[(String, Array[Int], Int, String)] {")
    .to_array()
    is [a, b] &&
    b.split("///|\nfn token_ids").to_array() is [_, c] else {
    fail("matrix")
  }
  let client = a.to_owned() +
    "fn matrix() -> Array[(String, Array[Int], Int, String)] {\n [(\"i8192-o64-c8-varied\",inputs(8192,8),64,\"varied\")]\n}\n\n///|\nfn token_ids" +
    c.to_owned()
  let client = if mode == "profile" {
    once(
      client, "let trials = if options is [\"--smoke\"] { 1 } else { 4 }", "let trials = 2",
    )
  } else {
    client
  }
  let script = output + "/launcher.mbtx"
  @fs.write_file(script, launcher, create_mode=CreateNew)
  @fs.write_file(script + ".client.mbtx", client, create_mode=CreateNew)
  let arms = if mode == "profile" {
    ["unified"]
  } else {
    ["control", "unified", "unified", "control"]
  }
  for i, arm in arms {
    let out = output + "/s\{i}-" + arm
    @fs.mkdir(out)
    let selected = if arm == "control" { baseline } else { serving }
    capture(out, "launch", moon, ["run", script, selected, out, script])
    if mode == "profile" {
      let trace = out + "/r0-luna-full/trace"
      capture(out, "export", "/usr/local/bin/nsys", [
        "export",
        "--type=sqlite",
        "--output=" + trace + ".sqlite",
        trace + ".nsys-rep",
      ])
      capture(out, "kernels", "sqlite3", [
        "-header",
        "-csv",
        trace + ".sqlite",
        "SELECT s.value AS kernel,k.gridX,k.gridY,k.gridZ,count(*) AS calls,round(sum(k.end-k.start)/1e6,3) AS total_ms FROM CUPTI_ACTIVITY_KIND_KERNEL k JOIN StringIds s ON s.id=k.demangledName GROUP BY 1,2,3,4 ORDER BY total_ms DESC;",
      ])
    }
    println("completed=" + arm)
  }
  @fs.write_file(
    output + "/RESULT.txt",
    "outcome=completed\nscope=diagnostic unified-row attention; no production admission\n",
    create_mode=CreateNew,
  )
}

///|
test "frozen seam rejects accidental multiple edits" {
  assert_eq(once("abc", "b", "x"), "axc")
  try once("bb", "b", "x") catch {
    _ => ()
  } noraise {
    _ => fail("duplicate seam")
  }
}
