///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn best(
  records : String,
  eligible : (String) -> Bool,
  cost_column : Int,
) -> String raise {
  let rows = records
    .split("\n")
    .filter(x => x.has_prefix("record\t"))
    .map(x => x.split("\t").to_array())
    .filter(x => eligible(x[1].to_owned()))
    .to_array()
  let candidates : Array[(String, Int64)] = []
  for row in rows {
    candidates.push((row[1].to_owned(), @string.parse_int64(row[cost_column])))
  }
  guard !candidates.is_empty() else { fail("no measured eligible candidate") }
  candidates.sort_by((a, b) => a.1.compare(b.1))
  candidates[0].0
}

///|
async fn main {
  guard @env.args()
    is [_, calibration, root, prefill_cell, decode_cell, .. options] &&
    (options.is_empty() || options == ["--unrestricted"]) else {
    fail("CALIBRATION NEW_EMPTY_ROOT PREFILL_CELL DECODE_CELL [--unrestricted]")
  }
  let unrestricted = options == ["--unrestricted"]
  assert_eq(
    @fs.read_file(calibration + "/RESULT.txt").text(),
    "outcome=passed\n",
  )
  let ingress_records = @fs.read_file(
    calibration + "/" + prefill_cell + "/ingress.records",
  ).text()
  let attention_records = @fs.read_file(
    calibration + "/" + prefill_cell + "/attention.records",
  ).text()
  let decode_records = @fs.read_file(
    calibration + "/" + decode_cell + "/decode.records",
  ).text()
  let ingress = best(
    ingress_records,
    x => unrestricted || x.has_suffix("-h2") || x.has_suffix("-h4"),
    3,
  )
  let prefill = best(
    attention_records,
    x => unrestricted || ["322", "2000", "2001", "2003", "2004"].contains(x),
    2,
  )
  let decode = best(
    decode_records,
    x => unrestricted || ["450", "451", "452", "453"].contains(x),
    2,
  )
  @shell.Cmd("cp", ["-a", calibration + "/candidate", root + "/selected"]).run()
  for
    (entry, selected) in [
      ("reusable-qwen-full-ingress", "reusable-qwen-full-ingress-" + ingress),
      (
        "reusable-qwen-prefill-attention",
        "reusable-qwen-prefill-attention-c" + prefill,
      ),
      (
        "reusable-qwen-prefill-wide-query-attention",
        "reusable-qwen-prefill-attention-c" + prefill,
      ),
      (
        "reusable-qwen-decode-attention",
        "reusable-qwen-decode-attention-c" + decode,
      ),
    ] {
    @shell.Cmd("mv", [
      root + "/selected/" + entry,
      root + "/selected/default-" + entry,
    ]).run()
    @shell.Cmd("cp", [
      "-a",
      if entry == "reusable-qwen-prefill-attention" ||
        entry == "reusable-qwen-prefill-wide-query-attention" {
        calibration + "/" + prefill_cell + "/selected/" + entry
      } else if unrestricted && entry == "reusable-qwen-decode-attention" {
        calibration + "/" + decode_cell + "/selected/" + entry
      } else {
        root + "/selected/" + selected
      },
      root + "/selected/" + entry,
    ]).run()
    if entry == "reusable-qwen-prefill-attention" ||
      entry == "reusable-qwen-prefill-wide-query-attention" {
      // Use the typed export's canonical entry symbol and role recipe, not
      // the diagnostic frontier symbol. Both roles must retain our finalist.
      let path = root + "/selected/" + entry + "/kernel.recipe"
      guard @fs.read_file(path)
        .text()
        .contains("\nvariant_stable_id=" + prefill + "\n") else {
        fail("typed prefill export does not match the new-family finalist")
      }
    }
    if unrestricted && entry == "reusable-qwen-decode-attention" {
      guard @fs.read_file(root + "/selected/" + entry + "/kernel.recipe")
        .text()
        .contains("\nvariant_stable_id=" + decode + "\n") else {
        fail("typed decode export does not match the measured finalist")
      }
    }
  }
  for
    (name, records) in [
      ("ingress", ingress_records),
      ("attention", attention_records),
      ("decode", decode_records),
    ] {
    @fs.write_file(
      root + "/" + name + ".records",
      records,
      create_mode=CreateNew,
    )
  }
  for kind in ["ingress", "prefill", "decode"] {
    @fs.write_file(
      root + "/" + kind + ".spec",
      @fs.read_file(calibration + "/" + kind + ".spec"),
      create_mode=CreateNew,
    )
  }
  // Retain the original export verbatim as provenance, not a claim that its
  // unconstrained winner is selected. The explicit experiment plan below is
  // authoritative; the builder authenticates each aliased source/recipe.
  @fs.write_file(
    root + "/selected-export.stdout",
    @fs.read_file(calibration + "/export.stdout"),
    create_mode=CreateNew,
  )
  let plan = "schema=luna-all-new-benchmark-selection-v1\nmode=" +
    (if unrestricted {
      "unrestricted-measured-finalist"
    } else {
      "forced-new-family-measured-finalist"
    }) +
    "\n" +
    "ingress=" +
    ingress +
    "\nprefill=" +
    prefill +
    "\ndecode=" +
    decode +
    "\nprefill_objective=" +
    prefill_cell +
    "\ndecode_objective=" +
    decode_cell +
    "\nautomatic_per_cell_dispatch=false\n"
  @fs.write_file(root + "/selection-plan.txt", plan, create_mode=CreateNew)
  @fs.write_file(
    root + "/RESULT.txt",
    "outcome=passed\n",
    create_mode=CreateNew,
  )
  println(plan)
}
