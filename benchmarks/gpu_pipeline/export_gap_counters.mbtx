///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, root] else { fail("COUNTER_ROOT") }
  for page in ["raw", "source", "details"] {
    let args = [
        "--import",
        root + "/counter.ncu-rep",
        "--page",
        page,
        "--print-units",
        "base",
      ] +
      (if page == "details" { [] } else { ["--csv"] }) +
      (if page == "source" { ["--print-source", "sass"] } else { [] })
    let r = @shell.Cmd("/opt/nvidia/nsight-compute/2025.3.1/ncu", args).output(
      max_output_bytes=67108864,
    )
    @fs.write_file(
      root + "/counter-" + page + "-v2.stdout",
      r.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/counter-" + page + "-v2.stderr",
      r.stderr(),
      create_mode=CreateNew,
    )
    r.check()
  }
  @fs.write_file(
    root + "/EXPORT_RESULT.txt",
    "outcome=counter-export-complete\nnot-a-serving-pass\n",
    create_mode=CreateNew,
  )
}
