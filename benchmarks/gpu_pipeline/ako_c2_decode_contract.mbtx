///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
fn decode_spec(prefill : String) -> String raise {
  guard prefill.split("kind=prefill\n").to_array() is [before, after] else {
    fail("unique prefill specification")
  }
  let result = before.to_owned() + "kind=decode\n" + after.to_owned()
  guard result.split("query_metadata_version=1\n").to_array() is [before, after] else {
    fail("query metadata seam")
  }
  before.to_owned() + "query_metadata_version=0\n" + after.to_owned()
}

///|
async fn main {
  if @env.args() is [_, root, "finish"] {
    assert_true(root.has_prefix("/home/wlc003s/lunaflux-ako-c2-decode-"))
    assert_true(
      @fs.read_file(root + "/trial-cubin/RESULT.txt")
      .text()
      .has_prefix("outcome=completed\n"),
    )
    for
      (index, label) in [
        (0, "decode-r1-h32513"),
        (1, "decode-r2-h32513"),
        (2, "decode-r2-h32515"),
      ] {
      assert_true(
        @fs.read_file(root + "/trial-cubin/w\{index}-" + label + ".stderr")
        .text()
        .is_empty(),
      )
      let rows = @fs.read_file(
          root + "/trial-cubin/w\{index}-" + label + ".stdout",
        )
        .text()
        .split("\n")
        .filter(line => line.has_prefix("tokens="))
        .to_array()
      assert_eq(rows.length(), 5)
      assert_true(rows.all(line => line.contains("bitwise=true maxabs=0 ")))
    }
    let idle = @shell.Cmd("nvidia-smi", [
      "--query-compute-apps=pid", "--format=csv,noheader",
    ]).output()
    idle.check()
    assert_true(idle.stdout().trim().is_empty())
    @fs.write_file(
      root + "/idle-terminal.stdout",
      idle.stdout(),
      create_mode=CreateNew,
    )
    guard root.split(".").to_array().last() is Some(suffix) &&
      !suffix.is_empty() &&
      suffix.iter().all(c => c is ('a'..='z' | 'A'..='Z' | '0'..='9')) else {
      fail("unit suffix")
    }
    let suffix = suffix.to_owned()
    for
      (label, unit) in [
        ("build", "lunaflux-c2-decode-build-" + suffix),
        ("missing-cubin-preserved", "lunaflux-c2-decode-trial-" + suffix),
        ("corrected", "lunaflux-c2-decode-trial2-" + suffix),
      ] {
      let out = @shell.Cmd("journalctl", [
        "--user",
        "-u",
        unit + ".service",
        "--no-pager",
      ]).output()
      out.check()
      @fs.write_file(
        root + "/journal-" + label + ".stdout",
        out.stdout(),
        create_mode=CreateNew,
      )
    }
    @fs.write_file(
      root + "/RESULT.txt",
      "outcome=completed\nscope=isolated ordinary versus partitioned decode; no end-to-end or quality claim\ninitial_failure=missing transferred cubin before GPU launch; preserved\n",
      create_mode=CreateNew,
    )
    return
  }
  guard @env.args() is [_, spec, root, uuid, output] &&
    root.has_prefix("/home/") else {
    fail("PREFILL_SPEC NEW_REMOTE_ROOT GPU_UUID LOCAL_OUTPUT_DIRECTORY")
  }
  @fs.write_file(
    output + "/decode.spec",
    decode_spec(@fs.read_file(spec).text()),
    create_mode=CreateNew,
  )
  let workloads : Array[Json] = [(1, 32513), (2, 32513), (2, 32515)].map(shape => {
    let (rows, history) = shape
    {
      "label": "decode-r\{rows}-h\{history}",
      "args": [
        root + "/decode.spec",
        root + "/decode",
        root + "/decode",
        "\{rows}",
        "\{rows}",
        "\{history}",
        "--decode-chain-comparison",
      ],
    }
  })
  let contract : Json = {
    "schema": "lunaflux-ako-trial-v1",
    "gpu_uuid": uuid,
    "reserve_kib": 33554432,
    "minimum_gain": 0.03,
    "program": root + "/probe",
    "artifacts": [
      "/usr/local/cuda-13.0/bin/nvcc",
      root + "/selected_policy_probe.cu",
      root + "/selected_policy_geometry.h",
      root + "/decode.spec",
      root + "/decode/kernel.recipe",
      root + "/decode/kernel.cubin",
    ],
    "workloads": workloads,
  }
  @fs.write_file(
    output + "/contract.json",
    contract.stringify(indent=2),
    create_mode=CreateNew,
  )
}

///|
test "decode contract changes only phase and CSR metadata ABI" {
  assert_eq(
    decode_spec("kind=prefill\nhead_dimension=128\nquery_metadata_version=1\n"),
    "kind=decode\nhead_dimension=128\nquery_metadata_version=0\n",
  )
}
