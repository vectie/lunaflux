///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn field(j : Json, key : String) -> Json raise {
  guard j is Object(m) else { fail("object") }
  m[key]
}

///|
fn integer(j : Json) -> Int64 raise {
  match j {
    String(s) => @string.parse_int64(s)
    Number(n, repr~) => @string.parse_int64(repr.unwrap_or(n.to_string()))
    _ => fail("integer")
  }
}

///|
fn text(j : Json) -> String raise {
  guard j is String(s) else { fail("string") }
  s
}

///|
async fn sql(db : String, q : String) -> Array[Json] {
  let r = @shell.Cmd("sqlite3", ["-readonly", "-json", db, q]).output(
    max_output_bytes=67108864,
  )
  r.check()
  guard @json.parse(
      if r.stdout().trim().is_empty() {
        "[]"
      } else {
        r.stdout()
      },
    )
    is Array(xs) else {
    fail("SQL")
  }
  xs
}

///|
fn union_ns(xs : Array[(Int64, Int64)]) -> Int64 {
  let ys = xs.copy()
  ys.sort_by((a, b) => a.0.compare(b.0))
  for i = 0, end = 0L, total = 0L; i < ys.length(); {
    let (a, b) = ys[i]
    continue i + 1,
      Int64::max(end, b),
      total + Int64::max(0L, b - Int64::max(end, a))
  } nobreak {
    total
  }
}

///|
fn is_attention(s : String) -> Bool {
  s.contains("flash_fwd") ||
  s.contains("BatchDecode") ||
  s.contains("BatchPrefill") ||
  s.has_prefix("lunaflux_attention_") ||
  s.has_prefix("lunaflux_paged_attention") ||
  s.contains("VariableLengthMergeStates") ||
  s.contains("merge_states")
}

///|
fn matrix(s : String) -> Bool {
  s.contains("cutlass::Kernel2<") ||
  s.has_prefix("nvjet_") ||
  s.contains("internal::gemvx::kernel<")
}

///|
fn categories(names : Array[String], luna : Bool) -> Array[String] raise {
  let out = Array::make(names.length(), "other")
  let mut projection = 0
  let mut vendor = 0
  let mut attention = false
  let mut activation = false
  for i, s in names {
    if is_attention(s) {
      out[i] = "attention"
      attention = true
    } else if luna {
      if s.contains("fused_qwen_qkv") && !s.has_suffix("_rotary_prepare") {
        activation = false
        attention = false
      }
      if s.contains("gated_mlp") && !s.has_suffix("_down") {
        activation = true
      }
      out[i] = if s.contains("fused_qwen_qkv") {
        "qkv-chain"
      } else if s.contains("gated_mlp") && s.has_suffix("_down") {
        "down"
      } else if s.contains("gated_mlp") {
        "gate-up-chain"
      } else if s.contains("dense_projection") {
        "output"
      } else if s.contains("head") {
        "head"
      } else if s.contains("rms_norm") || s.contains("rmsnorm") {
        "norm"
      } else if s.contains("greedy") ||
        s.contains("argmax") ||
        s.contains("sampling") {
        "sampling"
      } else if matrix(s) {
        guard attention else { fail("vendor projection before attention") }
        let cat = if activation { "down" } else { "output" }
        vendor += 1
        cat
      } else {
        "other"
      }
    } else if matrix(s) {
      if projection < 112 {
        let stage = projection % 4
        if stage == 1 {
          guard attention else { fail("missing reference attention anchor") }
        }
        if stage == 3 {
          guard activation else { fail("missing reference activation anchor") }
        }
        out[i] = ["qkv-chain", "output", "gate-up-chain", "down"][stage]
        if stage == 0 {
          attention = false
        }
        if stage == 2 {
          activation = false
        }
      } else {
        guard projection == 112 else { fail("extra reference matrix") }
        out[i] = "head"
      }
      projection += 1
    } else if s.contains("silu") {
      out[i] = "gate-up-chain"
      activation = true
    } else if projection > 0 &&
      projection <= 112 &&
      (projection - 1) % 4 == 0 &&
      !attention &&
      (
        s.contains("triton_red_fused") ||
        s.contains("triton_poi_fused") ||
        s.contains("reshape_and_cache") ||
        s.contains("QKApplyRotary") ||
        s.contains("rmsnorm") ||
        s.contains("RMSNorm") ||
        s.contains("apply_rope") ||
        s.contains("store_kv")
      ) {
      out[i] = "qkv-chain"
    } else if s.contains("rms") ||
      s.contains("RMS") ||
      s.contains("mean_mul_pow_rsqrt") {
      out[i] = "norm"
    } else if s.contains("argmax") ||
      s.contains("ArgMax") ||
      s.contains("sampling") {
      out[i] = "sampling"
    }
  }
  if luna {
    guard vendor <= 56 else { fail("incomplete vendor output/down chain") }
  } else {
    guard projection == 112 || projection == 113 else {
      fail("incomplete reference projection chain: \{projection}")
    }
  }
  out
}

///|
async fn main {
  guard @env.args() is [_, root, output, .. engines] &&
    engines.all(x => ["luna-full", "vllm", "sglang"].contains(x)) else {
    fail("ROOT NEW_REPORT [ENGINE ...]")
  }
  let reports : Array[Json] = []
  for
    engine in (if engines.is_empty() {
      ["luna-full", "vllm", "sglang"]
    } else {
      engines.to_owned()
    }) {
    let base = root + "/capture/" + engine
    let db = base + "/trace.sqlite"
    let request = @json.parse(
      @fs.read_file(
        base + "/r0-" + engine + "/requests/i8192-o64-c8-varied-t1.json",
      ).text(),
    )
    let epoch = integer(
      field(
        sql(
          db, "SELECT cast(utcEpochNs as text) epoch FROM TARGET_INFO_SESSION_START_TIME;",
        )[0],
        "epoch",
      ),
    )
    let lo = integer(field(request, "epoch_start_ns")) - epoch
    let hi = integer(field(request, "epoch_end_ns")) - epoch
    let ks = sql(
      db,
      "SELECT max(k.start,\{lo}) start,min(k.end,\{hi}) end,k.correlationId,s.value name,k.gridX,k.gridY,k.gridZ,k.blockX,k.blockY,k.blockZ,k.registersPerThread,k.staticSharedMemory+k.dynamicSharedMemory shared,r.start cpu_start FROM CUPTI_ACTIVITY_KIND_KERNEL k JOIN StringIds s ON s.id=k.demangledName LEFT JOIN CUPTI_ACTIVITY_KIND_RUNTIME r ON r.correlationId=k.correlationId WHERE k.start<\{hi} AND k.end>\{lo} ORDER BY k.start;",
    )
    let intervals = ks.map(k => {
      (integer(field(k, "start")), integer(field(k, "end")))
    })
    let copies = sql(
      db,
      "SELECT max(start,\{lo}) start,min(end,\{hi}) end FROM CUPTI_ACTIVITY_KIND_MEMCPY WHERE start<\{hi} AND end>\{lo};",
    )
    if !sql(
        db, "SELECT name FROM sqlite_master WHERE name='CUPTI_ACTIVITY_KIND_MEMSET';",
      ).is_empty() {
      for
        c in sql(
          db,
          "SELECT max(start,\{lo}) start,min(end,\{hi}) end FROM CUPTI_ACTIVITY_KIND_MEMSET WHERE start<\{hi} AND end>\{lo};",
        ) {
        copies.push(c)
      }
    }
    let all = [
      ..intervals,
      ..copies.map(c => (integer(field(c, "start")), integer(field(c, "end")))),
    ]
    let steps = if engine == "luna-full" {
      sql(
        db,
        "SELECT r.start cpu_start_ns,r.correlationId FROM CUPTI_ACTIVITY_KIND_RUNTIME r JOIN StringIds s ON s.id=r.nameId WHERE s.value='cuGraphLaunch' AND r.start>=\{lo} AND r.start<\{hi} ORDER BY r.start;",
      )
    } else {
      guard field(
          @json.parse(@fs.read_file(base + "/work-shapes.json").text()),
          "steps",
        )
        is Array(xs) else {
        fail("steps")
      }
      xs
    }
    let buckets : Array[Array[Json]] = Array::makei(steps.length(), _ => [])
    let unmatched : Array[Json] = []
    for k in ks {
      let at = integer(field(k, "cpu_start"))
      let mut selected = -1
      for i, s in steps {
        if integer(field(s, "cpu_start_ns")) > at {
          break
        }
        selected = i
      }
      if selected < 0 {
        unmatched.push(k)
      } else {
        buckets[selected].push(k)
      }
    }
    let totals : Map[String, Int64] = Map([])
    let signatures : Map[String, (Int, Int64)] = Map([])
    let detail : Array[Json] = []
    let unresolved : Array[Json] = []
    let mut previous_gpu_end = lo
    let mut between_step_ns = 0L
    let mut submitted_before_previous_end = 0
    for i, rows in buckets {
      guard !rows.is_empty() else { fail("empty step") }
      let names = rows.map(k => text(field(k, "name")))
      let cats = categories(names, engine == "luna-full") catch {
        e => {
          unresolved.push({ "index": i, "reason": "\{e}", "names": names })
          Array::make(rows.length(), "UNRESOLVED")
        }
      }
      let phase = if engine == "luna-full" {
        if names.any(n => {
            n.contains("prefill") ||
            n.contains("attention_mixed_flashattention")
          }) {
          "multi-query"
        } else {
          "single-query"
        }
      } else {
        guard field(steps[i], "query") is Array(qs) else { fail("query") }
        if qs.all(q => integer(q) == 1L) {
          "single-query"
        } else {
          "multi-query"
        }
      }
      let per : Map[String, Int64] = Map([])
      for j, k in rows {
        let ns = integer(field(k, "end")) - integer(field(k, "start"))
        let cat = cats[j]
        let key = phase + "/" + cat
        totals[key] = totals.get(key).unwrap_or(0L) + ns
        per[cat] = per.get(cat).unwrap_or(0L) + ns
        let signature = (
          [
            phase,
            cat,
            field(k, "name"),
            field(k, "gridX"),
            field(k, "gridY"),
            field(k, "gridZ"),
            field(k, "blockX"),
            field(k, "blockY"),
            field(k, "blockZ"),
            field(k, "registersPerThread"),
            field(k, "shared"),
          ] : Json).stringify()
        let old = signatures.get(signature).unwrap_or((0, 0L))
        signatures[signature] = (old.0 + 1, old.1 + ns)
      }
      let gpu_start = integer(field(rows[0], "start"))
      let gpu_end = rows.fold(init=gpu_start, (s, k) => {
        Int64::max(s, integer(field(k, "end")))
      })
      if i > 0 {
        between_step_ns += Int64::max(0L, gpu_start - previous_gpu_end)
        if integer(field(steps[i], "cpu_start_ns")) < previous_gpu_end {
          submitted_before_previous_end += 1
        }
      }
      previous_gpu_end = gpu_end
      detail.push({
        "index": i,
        "phase": phase,
        "categories_ns": per,
        "work": steps[i],
        "gpu_start_ns": gpu_start,
        "gpu_end_ns": gpu_end,
      })
    }
    let ranked = signatures.to_array()
    ranked.sort_by((a, b) => b.1.1.compare(a.1.1))
    let first_gpu = all.fold(init=hi, (v, x) => Int64::min(v, x.0))
    let last_gpu = all.fold(init=lo, (v, x) => Int64::max(v, x.1))
    let report : Json = {
      "engine": engine,
      "wall_ns": hi - lo,
      "client_wall_ms": field(request, "wall_ms"),
      "gpu_union_ns": union_ns(all),
      "no_gpu_ns": hi - lo - union_ns(all),
      "inside_gpu_envelope_idle_ns": last_gpu - first_gpu - union_ns(all),
      "outside_gpu_envelope_ns": hi - lo - (last_gpu - first_gpu),
      "between_step_kernel_envelopes_ns": between_step_ns,
      "submitted_before_previous_gpu_end": submitted_before_previous_end,
      "kernel_sum_ns": intervals.fold(init=0L, (a, b) => a + b.1 - b.0),
      "kernel_union_ns": union_ns(intervals),
      "copy_set_union_ns": union_ns(
        copies.map(c => (integer(field(c, "start")), integer(field(c, "end")))),
      ),
      "totals_ns": totals,
      "steps": detail,
      "unmatched": unmatched,
      "unresolved": unresolved,
      "signatures": ranked.map(x => {
        ({ "signature": @json.parse(x.0), "calls": x.1.0, "ns": x.1.1 } : Json)
      }),
    }
    reports.push(report)
    println(
      (
        {
          "engine": engine,
          "wall_ms": (hi - lo).to_double() / 1.0e6,
          "gpu_ms": union_ns(all).to_double() / 1.0e6,
          "unmatched": unmatched.length(),
          "unresolved": unresolved.length(),
          "steps": steps.length(),
          "totals_ns": totals,
        } : Json).stringify(),
    )
  }
  @fs.write_file(
    output,
    Json(reports).stringify(indent=2),
    create_mode=CreateNew,
  )
}

///|
test "union avoids overlap double counting" {
  assert_eq(union_ns([(10L, 20L), (12L, 15L), (19L, 30L)]), 20L)
  assert_eq(union_ns([(30L, 35L), (10L, 20L)]), 15L)
  assert_eq(union_ns([]), 0L)
}

///|
test "vendor roles follow graph anchors not alternating vendor call count" {
  let names = [
    "lunaflux_fused_qwen_qkv_v3", "lunaflux_attention_decode_v4", "nvjet_output",
    "lunaflux_luna_gated_mlp_bf16_release_v1", "nvjet_down", "lunaflux_fused_qwen_qkv_v3",
    "lunaflux_attention_decode_v4", "lunaflux_dense_projection", "lunaflux_luna_gated_mlp_bf16_release_v1",
    "nvjet_down",
  ]
  assert_eq(categories(names, true), [
    "qkv-chain", "attention", "output", "gate-up-chain", "down", "qkv-chain", "attention",
    "output", "gate-up-chain", "down",
  ])
}

///|
test "reference projection role attribution includes GEMV and separate activation" {
  let names : Array[String] = []
  let expected : Array[String] = []
  for _ in 0..<28 {
    names.append([
      "internal::gemvx::kernel<T>", "flash_fwd_splitkv_kernel", "internal::gemvx::kernel<T>",
      "internal::gemvx::kernel<T>", "triton_poi_fused_mul_silu_slice", "internal::gemvx::kernel<T>",
    ])
    expected.append([
      "qkv-chain", "attention", "output", "gate-up-chain", "gate-up-chain", "down",
    ])
  }
  names.push("internal::gemvx::kernel<T>")
  expected.push("head")
  assert_eq(categories(names, false), expected)
  try categories(["internal::gemvx::kernel<T>"], false) catch {
    _ => ()
  } noraise {
    _ => fail("partial reference must remain unresolved")
  }
}
