///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn number(value : Json) -> Double raise {
  match value {
    Number(n, ..) => n
    String(s) => @string.parse_double(s)
    _ => fail("numeric metric")
  }
}

///|
fn quantile(values : Array[Double], fraction : Double) -> Double raise {
  assert_true(!values.is_empty() && fraction >= 0 && fraction <= 1)
  let sorted = values.copy()
  sorted.sort()
  let position = (sorted.length() - 1).to_double() * fraction
  let low = position.to_int()
  let high = if low + 1 < sorted.length() { low + 1 } else { low }
  sorted[low] + (sorted[high] - sorted[low]) * (position - low.to_double())
}

///|
async fn main {
  guard @env.args() is [_, root] else { fail("COMPLETED_COMPARISON_ROOT") }
  guard @json.parse(@fs.read_file(root + "/comparison.json").text())
    is Array(cells) else {
    fail("comparison cells")
  }
  let enriched : Array[Json] = []
  for cell in cells {
    guard cell
      is {
        "cell": String(name),
        "input_vector": Array(inputs),
        "output_tokens_per_request": output,
        "metrics": Array(metrics),
        ..
      } else {
      fail("cell schema")
    }
    let engines : Array[Json] = []
    for metric in metrics {
      guard metric
        is {
          "engine": String(engine),
          "wall_ms": Array(walls),
          "median_wall_ms": median_wall,
          "output_tok_s_including_prefill": rate,
          ..
        } else {
        fail("metric schema")
      }
      let ttft : Array[Double] = []
      let elapsed : Array[Double] = []
      let tpot : Array[Double] = []
      let intervals : Array[Double] = []
      let first_vectors : Map[Int, Json] = Map([])
      let mut varied_vectors = 0
      let mut request_count = 0
      for round in 0..<2 {
        for trial in 1..<4 {
          guard @json.parse(
              @fs.read_file(
                root +
                "/r\{round}-" +
                engine +
                "/requests/" +
                name +
                "-t\{trial}.json",
              ).text(),
            )
            is { "warmup": false, "requests": Array(requests), .. } else {
            fail("measured wave")
          }
          assert_eq(requests.length(), inputs.length())
          for row, request in requests {
            guard request
              is {
                "ttft_ms": first,
                "elapsed_ms": last,
                "mean_tpot_ms": mean,
                "token_ms": Array(times),
                "token_ids": Array(ids),
                ..
              } else {
              fail("request schema")
            }
            assert_eq(times.length(), number(output).to_int())
            assert_eq(ids.length(), times.length())
            ttft.push(number(first))
            elapsed.push(number(last))
            tpot.push(number(mean))
            for i in 1..<times.length() {
              let interval = number(times[i]) - number(times[i - 1])
              assert_true(interval >= 0)
              intervals.push(interval)
            }
            if first_vectors.get(row) is Some(expected) {
              if expected != Json(ids) {
                varied_vectors += 1
              }
            } else {
              first_vectors[row] = Json(ids)
            }
            request_count += 1
          }
        }
      }
      let summary : Json = {
        "engine": engine,
        "median_wall_ms": median_wall,
        "output_tok_s_including_prefill": rate,
        "wave_wall_min_ms": quantile(walls.map(number), 0),
        "wave_wall_max_ms": quantile(walls.map(number), 1),
        "request_count": request_count,
        "request_ttft_p50_ms": quantile(ttft, 0.5),
        "request_ttft_p95_ms": quantile(ttft, 0.95),
        "request_latency_p50_ms": quantile(elapsed, 0.5),
        "request_latency_p95_ms": quantile(elapsed, 0.95),
        "request_mean_tpot_p50_ms": quantile(tpot, 0.5),
        "pooled_stream_interval_p50_ms": quantile(intervals, 0.5),
        "pooled_stream_interval_p95_ms": quantile(intervals, 0.95),
        "within_engine_changed_vectors_vs_first_trial": varied_vectors,
        "vector_comparisons_vs_first_trial": request_count - inputs.length(),
        "quantile_method": "linear interpolation R7",
        "timing_scope": "millisecond client SSE arrival; token intervals may include batching and stream buffering",
      }
      engines.push(summary)
      println(
        "\{name} \{engine} wall_ms=\{number(median_wall)} output_tok_s=\{number(rate)} ttft_p50_ms=\{quantile(ttft,0.5)} mean_tpot_p50_ms=\{quantile(tpot,0.5)} variation=\{varied_vectors}/\{request_count-inputs.length()}",
      )
    }
    enriched.push({
      "cell": name,
      "input_vector": inputs,
      "output_tokens_per_request": output,
      "engines": engines,
    })
  }
  @fs.write_file(
    root + "/timing-vectors-summary.json",
    Json(enriched).stringify(indent=2),
    create_mode=CreateNew,
  )
}

///|
test "quantiles retain dispersion and include endpoints" {
  assert_eq(number(Json("559")), 559)
  assert_eq(number(Json(559)), 559)
  assert_eq(quantile([4.0, 1.0, 3.0, 2.0], 0.5), 2.5)
  assert_eq(quantile([4.0, 1.0, 3.0, 2.0], 0), 1)
  assert_eq(quantile([4.0, 1.0, 3.0, 2.0], 1), 4)
  assert_eq(quantile([7.0], 0.95), 7)
  try quantile([], 0.5) catch {
    _ => ()
  } noraise {
    _ => fail("empty metric accepted")
  }
}
