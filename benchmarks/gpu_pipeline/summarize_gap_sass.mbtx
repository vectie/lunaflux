///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn csv(line : StringView) -> Array[String] {
  let fields = []
  let text = StringBuilder()
  let mut quoted = false
  for c in line.to_owned() {
    if c == '"' {
      quoted = !quoted
    } else if c == ',' && !quoted {
      fields.push(text.to_string())
      text.reset()
    } else {
      text.write_char(c)
    }
  }
  fields.push(text.to_string())
  fields
}

///|
fn number(text : String) -> Int64 raise {
  if text.is_empty() || text == "-" {
    0L
  } else {
    @string.parse_int64(text)
  }
}

///|
fn not_issued_fixed_wait(values : Map[String, String]) -> Int64 raise {
  number(values.get("stall_wait (Not Issued)").unwrap_or("0"))
}

///|
test "fixed wait aggregation does not substitute all samples for not-issued samples" {
  assert_eq(
    not_issued_fixed_wait({
      "stall_wait": "100",
      "stall_wait (Not Issued)": "9",
    }),
    9L,
  )
  assert_eq(not_issued_fixed_wait({ "stall_wait": "100" }), 0L)
}

///|
// A stall sample names a waiting instruction, not necessarily its producer.
// Preserve nearby SASS for inspection without inventing a dependency edge:
// predicates, dynamic execution and scoreboard IDs require separate analysis.
fn instruction_window(instructions : Array[Json], pc : String) -> Array[Json] {
  for index, instruction in instructions {
    if instruction is { "pc": String(address), .. } && address == pc {
      let first = Int::max(0, index - 8)
      let last = Int::min(instructions.length(), index + 3)
      return instructions[first:last].to_owned()
    }
  }
  []
}

///|
test "sample windows retain producers without claiming causality" {
  let instructions : Array[Json] = Array::makei(16, i => {
    "pc": "p\{i}",
    "instruction": "instruction\{i}",
  })
  let middle = instruction_window(instructions, "p10")
  assert_eq(middle.length(), 11)
  assert_eq(middle[0], instructions[2])
  assert_eq(middle[10], instructions[12])
  assert_eq(instruction_window(instructions, "p0").length(), 3)
  assert_eq(instruction_window(instructions, "p15").length(), 9)
  assert_eq(instruction_window(instructions, "absent"), [])
}

///|
async fn main {
  let (path, output) = match @env.args() {
    [_, root] =>
      (
        if @fs.exists(root + "/counter-source-v2.stdout") {
          root + "/counter-source-v2.stdout"
        } else {
          root + "/counter-source.stdout"
        },
        root + "/sass-summary-v2.json",
      )
    [_, path, output] => (path, output)
    _ => fail("COUNTER_ROOT | SOURCE_CSV NEW_SUMMARY_JSON")
  }
  let records : Array[Json] = []
  let mut name = ""
  let mut header : Array[String] = []
  let mut ops : Map[String, Int64] = Map([])
  let mut stalls : Array[(Int64, Json)] = []
  let mut fixed_wait_sites : Array[(Int64, Json)] = []
  let mut fixed_wait_opcodes : Map[String, Int64] = Map([])
  let mut sectors = 0L
  let mut conflicts = 0L
  let mut instructions : Array[Json] = []
  fn finish() -> Unit {
    if name.is_empty() {
      return
    }
    let ordered = ops.to_array()
    ordered.sort_by((a, b) => b.1.compare(a.1))
    stalls.sort_by((a, b) => b.0.compare(a.0))
    fixed_wait_sites.sort_by((a, b) => b.0.compare(a.0))
    let fixed_totals = fixed_wait_opcodes.to_array()
    fixed_totals.sort_by((a, b) => b.1.compare(a.1))
    let opcodes : Array[Json] = ordered.map(p => {
      "opcode": p.0,
      "executed": if header.contains("Instructions Executed") {
        Json(p.1)
      } else {
        Json::null()
      },
    })
    records.push({
      "kernel": name,
      "ordinal": records.length(),
      "source_execution_metrics_collected": header.contains(
        "Instructions Executed",
      ),
      "fixed_wait_not_issued_collected": header.contains(
        "stall_wait (Not Issued)",
      ),
      "scope": "Source entries may include aliased functions; raw report IDs own launch counts",
      "opcodes": opcodes,
      "local_theoretical_sectors": if header.contains(
          "L2 Theoretical Sectors Local",
        ) {
        Json(sectors)
      } else {
        Json::null()
      },
      "shared_excessive_wavefronts": if header.contains(
          "L1 Wavefronts Shared Excessive",
        ) {
        Json(conflicts)
      } else {
        Json::null()
      },
      "top_stall_pcs": stalls[:Int::min(12, stalls.length())].map(p => p.1),
      "fixed_wait_not_issued_by_opcode": fixed_totals.map(p => {
        Json({ "opcode": Json(p.0), "samples": Json(p.1) })
      }),
      "top_fixed_wait_sites": fixed_wait_sites[:Int::min(
        12,
        fixed_wait_sites.length(),
      )].map(p => {
        match p.1 {
          { "pc": String(pc), .. } =>
            Json({
              "sample": p.1,
              "instructions": Json(instruction_window(instructions, pc)),
              "scope": "sampled consumer context, not a proven producer or elapsed-cycle share",
            })
          _ => Json::null()
        }
      }),
      "sample_instruction_windows": stalls[:Int::min(12, stalls.length())].map(p => {
        match p.1 {
          { "pc": String(pc), .. } =>
            Json({
              "sample": p.1,
              "instructions": Json(instruction_window(instructions, pc)),
              "scope": "static context only; sample identifies a waiting instruction, not its producer or root cause",
            })
          _ => Json::null()
        }
      }),
    })
  }
  for line in @fs.read_file(path).text().split("\n") {
    let row = csv(line)
    if row.length() > 1 && row[0] == "Kernel Name" {
      finish()
      name = row[1]
      header = []
      ops = Map([])
      stalls = []
      fixed_wait_sites = []
      fixed_wait_opcodes = Map([])
      sectors = 0L
      conflicts = 0L
      instructions = []
      continue
    }
    if row.length() > 1 && row[0] == "Address" {
      header = row
      continue
    }
    if header.is_empty() ||
      row.length() != header.length() ||
      !row[0].has_prefix("0x") {
      continue
    }
    let values : Map[String, String] = Map([])
    for i in 0..<header.length() {
      values[header[i]] = row[i]
    }
    let words = row[1].split(" ").filter(w => !w.is_empty()).to_array()
    if words.is_empty() {
      continue
    }
    let opcode = words[if words[0].has_prefix("@") { 1 } else { 0 }].to_owned()
    instructions.push({ "pc": row[0], "instruction": row[1] })
    ops[opcode] = ops.get(opcode).unwrap_or(0L) +
      number(values.get("Instructions Executed").unwrap_or("0"))
    sectors += number(values.get("L2 Theoretical Sectors Local").unwrap_or("0"))
    conflicts += number(
      values.get("L1 Wavefronts Shared Excessive").unwrap_or("0"),
    )
    let samples = number(values.get("# Samples").unwrap_or("0"))
    let fixed_wait = not_issued_fixed_wait(values)
    fixed_wait_opcodes[opcode] = fixed_wait_opcodes.get(opcode).unwrap_or(0L) +
      fixed_wait
    if fixed_wait > 0 {
      fixed_wait_sites.push(
        (
          fixed_wait,
          {
            "pc": row[0],
            "instruction": row[1],
            "not_issued_wait_samples": Json(fixed_wait),
          },
        ),
      )
    }
    if samples > 0 {
      stalls.push(
        (
          samples,
          {
            "pc": row[0],
            "instruction": row[1],
            "samples": samples,
            "load_dependency": number(
              values.get("stall_long_sb").unwrap_or("0"),
            ),
            "barrier": number(values.get("stall_barrier").unwrap_or("0")),
            "math": number(values.get("stall_math").unwrap_or("0")),
            "short_dependency": number(
              values.get("stall_short_sb").unwrap_or("0"),
            ),
            "fixed_dependency": number(values.get("stall_wait").unwrap_or("0")),
            "fixed_dependency_not_issued": number(
              values.get("stall_wait (Not Issued)").unwrap_or("0"),
            ),
            "sleep": number(values.get("stall_sleep").unwrap_or("0")),
          },
        ),
      )
    }
  }
  finish()
  guard !records.is_empty() else { fail("SASS absent") }
  @fs.write_file(
    output,
    Json(records).stringify(indent=2),
    create_mode=CreateNew,
  )
  println("\{records.length()} source-correlated kernel summaries")
}
