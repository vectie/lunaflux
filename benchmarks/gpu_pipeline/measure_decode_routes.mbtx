///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn field(text : String, key : String) -> String raise {
  guard text.split("\n").filter(x => x.has_prefix(key + "=")).to_array()
    is [line] else {
    fail("field " + key)
  }
  line[key.length() + 1:].to_owned()
}

///|
async fn checked(
  root : String,
  label : String,
  program : String,
  args : Array[String],
) -> String {
  let out = @shell.Cmd(program, args).output(max_output_bytes=16777216)
  @fs.write_file(
    root + "/" + label + ".stdout",
    out.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    out.stderr(),
    create_mode=CreateNew,
  )
  out.check()
  out.stdout()
}

///|
fn median(output : String, name : String) -> Int64 raise {
  let samples : Array[Double] = []
  for line in output.split("\n").filter(x => x.has_prefix("tokens=")) {
    guard line.split(" ").filter(x => x.has_prefix(name + "=")).to_array()
      is [value] else {
      fail("sample")
    }
    samples.push(@string.parse_double(value[name.length() + 1:]))
  }
  assert_eq(samples.length(), 5)
  samples.sort()
  (samples[2] * 1000.0).to_int64()
}

///|
fn mixed_chain_arguments(
  decode : String,
  context : Int,
  split : Bool,
) -> Array[String] {
  [
    if split {
      "--mixed-decode-chain"
    } else {
      "--mixed-ordinary-chain"
    },
    decode,
    "--decode-history",
    "\{context - 1}",
  ]
}

///|
test "mixed calibration times the companion and binds its independent history" {
  assert_eq(mixed_chain_arguments("module", 32768, false), [
    "--mixed-ordinary-chain", "module", "--decode-history", "32767",
  ])
  assert_eq(mixed_chain_arguments("module", 128, true), [
    "--mixed-decode-chain", "module", "--decode-history", "127",
  ])
}

///|
fn partitioned_decode_recipe(recipe : String) -> String raise {
  let law = field(recipe, "partition_numeric_law")
  guard [
    "blockwise-f32-probability-v1", "dual-score-blockwise-f32-probability-v2", "blockwise-fma-f32-probability-v3",
    "owned2-blockwise-fma-f32-probability-v4", "owned4-blockwise-f32-probability-v4",
    "owned4-blockwise-fma-f32-probability-v4", "owned8-blockwise-f32-probability-v4",
    "owned8-blockwise-fma-f32-probability-v4", "grouped-head-matrix-bf16-probability-v1",
  ].contains(law) else {
    fail("unsupported explicit partition numerical law")
  }
  let replacements = [
    ("function_symbol", "partition_function_symbol"),
    ("merge_function_symbol", "partition_merge_function_symbol"),
    ("grid", "partition_grid"),
    ("merge_grid", "partition_merge_grid"),
    ("block", "partition_block"),
    ("shared_memory_bytes", "partition_shared_memory_bytes"),
    ("workspace_bytes", "partition_workspace_bytes"),
    ("numeric_law", "partition_numeric_law"),
    ("key_value_tile_rows", "partition_key_value_tile_rows"),
    ("pipeline_stages", "partition_pipeline_stages"),
  ]
  let retained = recipe
    .split("\n")
    .filter(line => {
      !line.is_empty() &&
      !replacements.any(pair => line.has_prefix(pair.0 + "="))
    })
    .to_array()
    .join("\n")
  let out : Array[String] = [retained]
  for (target, source) in replacements {
    out.push(target + "=" + field(recipe, source))
  }
  out.join("\n") + "\n"
}

///|
test "partition route uses selected companion symbols and storage, not frozen defaults" {
  let recipe = "numeric_law=owned4-blockwise-fma-f32-probability-v4\nfunction_symbol=ordinary\ngrid=32,8,1\nblock=64,1,1\nshared_memory_bytes=33040\nkey_value_tile_rows=64\npipeline_stages=2\npartition_numeric_law=owned4-blockwise-fma-f32-probability-v4\npartition_function_symbol=selected_partial\npartition_merge_function_symbol=selected_merge\npartition_grid=32,8,8\npartition_merge_grid=32,16,1\npartition_block=64,1,1\npartition_shared_memory_bytes=66064\npartition_workspace_bytes=2129920\npartition_key_value_tile_rows=64\npartition_pipeline_stages=2\n"
  let selected = partitioned_decode_recipe(recipe)
  assert_eq(field(selected, "function_symbol"), "selected_partial")
  assert_eq(field(selected, "merge_function_symbol"), "selected_merge")
  assert_eq(field(selected, "grid"), "32,8,8")
  assert_eq(
    field(selected, "numeric_law"),
    "owned4-blockwise-fma-f32-probability-v4",
  )
  assert_eq(field(selected, "key_value_tile_rows"), "64")
  assert_eq(field(selected, "pipeline_stages"), "2")
}

///|
fn calibration_context_limit(rows : Int, extended : Bool) -> Int {
  if extended {
    Int::min(32768, 131072 / rows)
  } else {
    8192
  }
}

///|
fn decode_calibration_histories(rows : Int, extended : Bool) -> Array[Int] {
  let maximum = calibration_context_limit(rows, extended)
  let histories : Array[Int] = []
  let mut context = 128
  while context <= maximum {
    histories.push(context - 1)
    context *= 2
  }
  histories
}

///|
// Reusing immutable prefill records does not cover a mixed chain: its decode
// companion has independent history and must still be measured.
fn calibration_phases(reused_prefill : Bool) -> Array[String] {
  if reused_prefill {
    ["mixed"]
  } else {
    ["prefill", "mixed"]
  }
}

///|
// A bucket records rows/query/context, not the distribution of query tokens.
// Cover concentrated and distributed mixed work instead of assuming R-1
// prefill requests. Infeasible distributions are outside this context bucket.
fn mixed_prefill_domains(
  rows : Int,
  queries : Int,
  context : Int,
) -> Array[Int] {
  let domains : Array[Int] = []
  for prefill_rows in [1, rows - 1] {
    if prefill_rows > 0 &&
      prefill_rows < rows &&
      queries >= rows &&
      (queries - (rows - prefill_rows) + prefill_rows - 1) / prefill_rows <=
      context &&
      !domains.contains(prefill_rows) {
      domains.push(prefill_rows)
    }
  }
  domains
}

///|
test "mixed envelope covers concentrated and distributed work without duplicates" {
  assert_eq(mixed_prefill_domains(8, 2048, 8192), [1, 7])
  assert_eq(mixed_prefill_domains(8, 2048, 512), [7])
  assert_eq(mixed_prefill_domains(2, 128, 128), [1])
  assert_eq(mixed_prefill_domains(1, 128, 128), [])
}

///|
test "prefill reuse never removes mixed chain coverage" {
  assert_eq(calibration_phases(true), ["mixed"])
  assert_eq(calibration_phases(false), ["prefill", "mixed"])
}

///|
test "decode calibration covers every context bucket through the bounded limit" {
  assert_eq(decode_calibration_histories(2, true), [
    127, 255, 511, 1023, 2047, 4095, 8191, 16383, 32767,
  ])
  assert_eq(decode_calibration_histories(16, true).last(), Some(8191))
  assert_eq(decode_calibration_histories(8, true).last(), Some(16383))
  assert_eq(decode_calibration_histories(1, false).last(), Some(8191))
}

///|
test "context coverage does not enlarge query capacity or exceed KV arena" {
  assert_eq(calibration_context_limit(1, false), 8192)
  assert_eq(calibration_context_limit(1, true), 32768)
  assert_eq(calibration_context_limit(4, true), 32768)
  assert_eq(calibration_context_limit(8, true), 16384)
  assert_eq(calibration_context_limit(16, true), 8192)
}

///|
async fn main {
  guard @env.args() is [_, serving, calibration, .. options] else {
    fail(
      "SERVING PREPARED_CALIBRATION [--context-limit 32768 [--reuse-prefill-routes EXACT_SCOPE_ROUTES]]",
    )
  }
  let (extended, reused) = match options {
    [] => (false, None)
    ["--context-limit", "32768"] => (true, None)
    ["--context-limit", "32768", "--reuse-prefill-routes", path] =>
      (true, Some(path))
    _ => fail("bounded calibration options")
  }
  let gpu = @shell.Cmd("nvidia-smi", [
    "--query-compute-apps=pid", "--format=csv,noheader",
  ]).output()
  gpu.check()
  guard gpu.stdout().trim().is_empty() else { fail("GPU busy") }
  guard @fs.read_file("/proc/meminfo")
    .text()
    .split("\n")
    .filter(x => x.has_prefix("MemAvailable:"))
    .to_array()
    is [available] else {
    fail("memory")
  }
  guard @string.parse_int64(
      available.split(" ").filter(x => !x.is_empty()).to_array()[1],
    ) >=
    33554432L else {
    fail("32 GiB reserve")
  }
  let recipe = @fs.read_file(serving + "/decode-selected/kernel.recipe").text()
  let blockwise = recipe.contains("partition_numeric_law=")
  let root = serving + "/decode-route-measurements"
  @fs.mkdir(root)
  let partial = root + "/partitioned"
  if blockwise {
    @fs.mkdir(partial)
    let text = partitioned_decode_recipe(recipe)
    @fs.write_file(partial + "/kernel.recipe", text, create_mode=CreateNew)
    @fs.write_file(
      partial + "/kernel.cubin",
      @fs.read_file(serving + "/fused/attention.cubin"),
      create_mode=CreateNew,
    )
  }
  let report = @fs.read_file(serving + "/fused/export.stdout").text()
  let mut routes = "luna-attention-buckets-v1\nscope\t" +
    field(report, "attention_route_scope") +
    "\n"
  if reused is Some(path) {
    let previous = @fs.read_file(path).text()
    guard previous.has_prefix(routes) else {
      fail("reused prefill scope differs")
    }
    for line in previous.split("\n") {
      // Older mixed records timed only prefill, not the executed companion.
      // Reuse exact prefill records, but never relabel those partial timings
      // as measured mixed-graph choices.
      if line.has_prefix("record\tprefill\t") {
        routes += line.to_owned() + "\n"
      }
    }
  }
  let wide = root + "/wide-prefill"
  @fs.mkdir(wide)
  @fs.write_file(
    wide + "/kernel.recipe",
    @fs.read_file(
      if @fs.exists(serving + "/wide-prefill-selected/kernel.recipe") {
        serving + "/wide-prefill-selected/kernel.recipe"
      } else {
        serving +
        "/candidate/reusable-qwen-prefill-wide-query-attention/kernel.recipe"
      },
    ),
    create_mode=CreateNew,
  )
  @fs.write_file(
    wide + "/kernel.cubin",
    @fs.read_file(serving + "/fused/prefill_wide.cubin"),
    create_mode=CreateNew,
  )
  for rows in [1, 2, 4, 8, 16] {
    // Context coverage may grow independently of the query/AOT envelope.
    // Keep aggregate KV within the existing 131072-token diagnostic arena.
    let maximum_context = calibration_context_limit(rows, extended)
    for phase in calibration_phases(reused is Some(_)) {
      if phase == "mixed" && rows == 1 {
        continue
      }
      for queries in [128, 512, 2048] {
        let current = if phase == "mixed" {
          (queries - 1 + rows - 2) / (rows - 1)
        } else {
          (queries + rows - 1) / rows
        }
        let mut context = 1
        while context < current {
          context *= 2
        }
        while context <= maximum_context {
          // One representative per context bucket. Sparse history vectors
          // leave intervening runtime slots unmeasured even at the same query.
          let domains = if phase == "mixed" {
            mixed_prefill_domains(rows, queries, context)
          } else {
            [rows]
          }
          let mut old_ns = 0L
          let mut wide_ns = 0L
          let mut split_ns = 0L
          for prefill_rows in domains {
            let current = (queries - (rows - prefill_rows) + prefill_rows - 1) /
              prefill_rows
            let history = context - current
            let domain_args = if phase == "mixed" {
              ["--prefill-rows", prefill_rows.to_string()]
            } else {
              []
            }
            let output = checked(
              root,
              "\{phase}-q\{queries}-r\{rows}-p\{prefill_rows}-h\{history}",
              serving + "/check-probe",
              [
                calibration + "/prefill.spec",
                serving + "/prefill-selected",
                wide,
                "\{queries}",
                "\{rows}",
                "\{history}",
              ] +
              (if phase == "mixed" {
                mixed_chain_arguments(
                  serving + "/decode-selected",
                  context,
                  false,
                )
              } else {
                []
              }) +
              domain_args,
            )
            old_ns = Int64::max(old_ns, median(output, "old_us"))
            wide_ns = Int64::max(wide_ns, median(output, "new_us"))
            if phase == "mixed" && blockwise {
              let split = checked(
                root,
                "mixed-split-q\{queries}-r\{rows}-p\{prefill_rows}-h\{history}",
                serving + "/check-probe",
                [
                  calibration + "/prefill.spec",
                  wide,
                  wide,
                  "\{queries}",
                  "\{rows}",
                  "\{history}",
                ] +
                mixed_chain_arguments(
                  serving + "/decode-selected",
                  context,
                  true,
                ) +
                domain_args,
              )
              split_ns = Int64::max(split_ns, median(split, "new_us"))
            }
          }
          // Conservative maximum of five-sample medians across the valid
          // distributions. Do not label one partial chain as the full bucket.
          assert_true(!domains.is_empty())
          routes += "record\t\{phase}\t\{rows}\t\{queries}\t\{context}\t1\t\{old_ns}\t5\nrecord\t\{phase}\t\{rows}\t\{queries}\t\{context}\t2\t\{wide_ns}\t5\n"
          if phase == "mixed" && blockwise {
            routes += "record\t\{phase}\t\{rows}\t\{queries}\t\{context}\t7\t\{split_ns}\t5\n"
          }
          context *= 2
        }
      }
    }
  }
  for rows in [1, 2, 4, 8, 16] {
    if !blockwise {
      continue
    }
    for history in decode_calibration_histories(rows, extended) {
      let args = [
        calibration + "/decode.spec",
        serving + "/decode-selected",
        partial,
        "\{rows}",
        "\{rows}",
        "\{history}",
      ]
      // Isolated GPU probes are serialized, small and independently checked.
      if (rows == 1 || rows == 2 || rows == 16) &&
        history + 1 == calibration_context_limit(rows, extended) {
        for tool in ["memcheck", "racecheck", "synccheck"] {
          ignore(
            checked(
              root,
              "\{tool}-r\{rows}",
              "/usr/local/cuda/bin/compute-sanitizer",
              [
                "--tool",
                tool,
                "--error-exitcode",
                "99",
                ..if tool == "racecheck" {
                  ["--racecheck-num-workers", "1"]
                } else {
                  []
                },
                serving + "/check-probe",
              ] +
              args +
              ["--check-only"],
            ),
          )
        }
      }
      let output = checked(
        root,
        "r\{rows}-h\{history}",
        serving + "/check-probe",
        args,
      )
      routes += "record\tdecode\t\{rows}\t\{rows}\t\{history + 1}\t1\t\{median(output, "old_us")}\t5\nrecord\tdecode\t\{rows}\t\{rows}\t\{history + 1}\t4\t\{median(output, "new_us")}\t5\n"
    }
  }
  let route_path = root + "/routes.v1"
  @fs.write_file(route_path, routes, create_mode=CreateNew, permission=0o444)
  let hash = checked(root, "route-sha", "sha256sum", [route_path])
  .split(" ")
  .to_array()[0].to_owned()
  @fs.mkdir(serving + "/fused-routed")
  let old_path = serving + "/fused/reusable-fused-runtime-bundle.v3"
  let new_path = serving + "/fused-routed/reusable-fused-runtime-bundle.v3"
  let args = @fs.read_file(serving + "/fused/export.arguments")
    .text()
    .split("\n")
    .filter(x => !x.is_empty())
    .map(x => if x == old_path { new_path } else { x.to_owned() })
    .to_array()
  guard args.contains(new_path) else { fail("output seam") }
  args.append(["--attention-buckets", route_path, hash])
  ignore(
    checked(
      root,
      "rebind",
      serving +
      "/source/_build/native/release/build/cmd/lunaflux_qwen3_fused_runtime_bundle_export/lunaflux_qwen3_fused_runtime_bundle_export.exe",
      args,
    ),
  )
  @fs.write_file(
    root + "/RESULT.txt",
    "outcome=passed\nobjective=matched-attention-span-not-full-graph-timing\n",
    create_mode=CreateNew,
  )
  println(routes)
}
