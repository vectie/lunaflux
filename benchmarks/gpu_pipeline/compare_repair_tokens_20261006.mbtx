///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  guard @env.args() is [_, previous, current] else {
    fail("PREVIOUS CURRENT_COMPLETED_CAMPAIGN")
  }
  let cells = [
    ("i128-o256-c1-varied", 1, 256),
    ("i4096-o64-c1-varied", 1, 64),
    ("i4096-o64-c16-varied", 16, 64),
    ("i32512-o64-c1-varied", 1, 64),
    ("i32512-o64-c2-varied", 2, 64),
  ]
  let results : Array[Json] = []
  for (cell, rows, count) in cells {
    let differences : Array[Json] = []
    let mut comparisons = 0
    for round in 0..<2 {
      for trial in 1..<=3 {
        for row in 0..<rows {
          let suffix = "/r" +
            round.to_string() +
            "-luna-full/requests/" +
            cell +
            "-t" +
            trial.to_string() +
            "-r" +
            row.to_string() +
            ".json"
          guard @json.parse(@fs.read_file(previous + suffix).text())
            is { "token_ids": Array(old), .. } &&
            @json.parse(@fs.read_file(current + suffix).text())
            is { "token_ids": Array(fresh), .. } else {
            fail("complete output vector")
          }
          assert_eq(old.length(), count)
          assert_eq(fresh.length(), count)
          comparisons += 1
          for token in 0..<count {
            if old[token] != fresh[token] {
              differences.push({
                "round": round,
                "trial": trial,
                "row": row,
                "first_token_difference": token,
                "previous": old[token],
                "current": fresh[token],
              })
              break
            }
          }
        }
      }
    }
    results.push({
      "cell": cell,
      "compared_complete_vectors": comparisons,
      "different_vectors": differences,
      "scope": "same-engine synthetic token regression, not independent language-quality qualification",
    })
  }
  @fs.write_file(
    current + "/OWN_OUTPUT_REGRESSION.json",
    Json(results).stringify(indent=2),
    create_mode=CreateNew,
  )
  println(Json(results).stringify(indent=2))
}
