///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
async fn capture(
  root : String,
  name : String,
  exe : String,
  args : Array[String],
) -> String {
  @fs.write_file(
    root + "/" + name + ".command.json",
    Json([exe, ..args]).stringify(),
    create_mode=CreateNew,
  )
  let result = @shell.Cmd(exe, args).output(max_output_bytes=67108864)
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  result.stdout()
}

///|
async fn available() -> Int64 {
  guard @fs.read_file("/proc/meminfo")
    .text()
    .split("\n")
    .filter(x => x.has_prefix("MemAvailable:"))
    .to_array()
    is [line] else {
    fail("memory field")
  }
  @string.parse_int64(line.split(" ").filter(x => !x.is_empty()).to_array()[1])
}

///|
struct CapturePlan {
  rows : String
  envelope : String
  history : String
  paired : Bool
  partitioned : Bool
}

///|
fn counter_container(root : String) -> String raise {
  let parts = root.split("/").filter(p => !p.is_empty()).to_array()
  assert_true(root.has_prefix("/") && parts.length() >= 2)
  let scope = parts[parts.length() - 2:].join("-")
  assert_true(
    scope.length() <= 128 &&
    scope
    .iter()
    .all(c => c is ('a'..='z' | 'A'..='Z' | '0'..='9' | '_' | '.' | '-')),
  )
  "lunaflux-decode-consumer-" + scope
}

///|
fn probe_pin(options : ArrayView[String]) -> String raise {
  match options {
    [] => "821fa177be7e30219dbaf92a58c7337af45529075dca84c9fe162017c7ee1b66"
    ["--probe-sha256", hash] => {
      assert_true(
        hash.length() == 64 &&
        hash.iter().all(c => c is ('a'..='f' | '0'..='9')),
      )
      hash
    }
    _ => fail("explicit probe pin or no override")
  }
}

///|
fn capture_plan(mode : String) -> CapturePlan raise {
  guard ["counter", "prepare", "window", "paired", "split", "split-paired"].contains(
    mode,
  ) else {
    fail("unknown capture profile")
  }
  {
    rows: if mode == "window" {
      "2"
    } else {
      "16"
    },
    envelope: if mode == "window" {
      "8"
    } else {
      "16"
    },
    history: if mode == "window" {
      "32767"
    } else {
      "4095"
    },
    paired: ["window", "paired", "split-paired"].contains(mode),
    partitioned: ["split", "split-paired"].contains(mode),
  }
}

///|
fn CapturePlan::kernel_filter(self : CapturePlan) -> String {
  if self.partitioned {
    "regex:^lunaflux_paged_attention_bf16_decode_split_(partial_v3_ep_3903|merge_v3_ep_3904)$"
  } else {
    "lunaflux_attention_decode_tile_compiler_v1_owned8_blockwise_f32_v4"
  }
}

///|
fn CapturePlan::launch_count(self : CapturePlan) -> String {
  ((if self.paired { 2 } else { 1 }) * (if self.partitioned { 2 } else { 1 })).to_string()
}

///|
fn CapturePlan::probe_args(
  self : CapturePlan,
  spec : String,
  baseline : String,
  artifact : String,
) -> Array[String] {
  let args = [
    spec,
    baseline,
    artifact,
    self.rows,
    self.rows,
    self.history,
    "--decode-envelope",
  ]
  if self.partitioned {
    args.push("--decode-partitioned")
  }
  args
}

///|
fn CapturePlan::verify_launches(self : CapturePlan, raw : String) -> Unit raise {
  let names = raw
    .split("\n")
    .filter_map(line => {
      let columns = line.split("\",\"").to_array()
      if columns.length() > 5 &&
        columns[0].has_prefix("\"") &&
        columns[4].has_prefix("lunaflux_") {
        Some(columns[4].to_owned())
      } else {
        None
      }
    })
    .to_array()
  let chain = if self.partitioned {
    [
      "lunaflux_paged_attention_bf16_decode_split_partial_v3_ep_3903", "lunaflux_paged_attention_bf16_decode_split_merge_v3_ep_3904",
    ]
  } else {
    ["lunaflux_attention_decode_tile_compiler_v1_owned8_blockwise_f32_v4"]
  }
  assert_eq(names, if self.paired { [..chain, ..chain] } else { chain })
}

///|
async fn main {
  guard @env.args() is [_, base, probe_root, root, mode, ..] &&
    ["counter", "prepare", "window", "paired", "split", "split-paired"].contains(
      mode,
    ) else {
    fail(
      "IMMUTABLE_SERVING PROBE_ROOT NEW_ROOT counter|prepare|window|paired|split|split-paired [MODULE]",
    )
  }
  let plan = capture_plan(mode)
  let (artifact, expected_probe) = if plan.paired {
    guard @env.args() is [_, _, _, _, _, artifact, .. options] else {
      fail("window module")
    }
    (artifact, probe_pin(options))
  } else {
    (base + "/decode-selected", probe_pin([]))
  }
  let { rows, envelope, history, .. } = plan
  let probe = probe_root + "/check-probe"
  let idle = capture(root, mode + "-idle", "nvidia-smi", [
    "--query-compute-apps=pid", "--format=csv,noheader",
  ])
  guard idle.trim().is_empty() && available() >= 33554432L else {
    fail("GPU busy or memory reserve")
  }
  assert_eq(
    capture(root, mode + "-device", "nvidia-smi", [
      "--query-gpu=uuid", "--format=csv,noheader",
    ]).trim(),
    "GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6",
  )
  assert_true(
    capture(root, mode + "-probe", "sha256sum", [probe]).has_prefix(
      expected_probe + " ",
    ),
  )
  assert_true(
    capture(root, mode + "-nvcc", "sha256sum", ["/usr/local/cuda-13.0/bin/nvcc"]).has_prefix(
      "fbb111f057786ddd10ba723d993cc7dd43abf978b6baa32fedd3c9d806dc79e1 ",
    ),
  )
  let spec = @fs.read_file(base + "/calibration-spec/decode.spec").text()
  guard spec.split("maximum_rows=32\n").to_array() is [before, after] else {
    fail("frozen workspace envelope")
  }
  @fs.write_file(
    root + "/traced.spec",
    before.to_owned() + "maximum_rows=\{envelope}\n" + after.to_owned(),
    create_mode=CreateNew,
  )
  let arguments = plan.probe_args(
    root + "/traced.spec",
    base + "/decode-selected",
    artifact,
  )
  if mode == "prepare" {
    ignore(capture(root, "baseline-timing", probe, arguments))
    return
  }
  let container = counter_container(root)
  let cidfile = root + "/container.id"
  errdefer (if @fs.exists(cidfile) {
    let owned = @fs.read_file(cidfile).text().trim().to_owned()
    // A failed name allocation does not authorize stopping a preexisting
    // container. Docker creates this receipt only for this invocation.
    if owned.length() == 64 &&
      owned.iter().all(c => c is ('0'..='9' | 'a'..='f')) {
      ignore(@shell.Cmd("docker", ["stop", "--time", "15", owned]).output())
    }
  })
  let samples = StringBuilder()
  let mut done = false
  @async.with_task_group(group => {
    group.spawn_bg(() => {
      while !done {
        let free = available()
        samples.write_string("\{@async.now()},\{free}\n")
        guard free >= 33554432L else { fail("32 GiB reserve breached") }
        @async.sleep(500)
      }
    })
    ignore(
      capture(
        root,
        "counter-run",
        "docker",
        [
          "run",
          "--name",
          container,
          "--cidfile",
          cidfile,
          "--gpus",
          "all",
          "--memory",
          "8g",
          "--memory-swap",
          "8g",
          "--cap-add",
          "SYS_ADMIN",
          "--security-opt",
          "seccomp=unconfined",
          "--mount",
          "type=bind,source=/opt/nvidia,target=/opt/host-nvidia,readonly",
          "--mount",
          "type=bind,source=" + base + ",target=" + base + ",readonly",
          "--mount",
          "type=bind,source=" +
          probe_root +
          ",target=" +
          probe_root +
          ",readonly",
          "--mount",
          "type=bind,source=" + root + ",target=" + root,
          "--mount",
          "type=bind,source=" + artifact + ",target=" + artifact + ",readonly",
          "nvcr.io/nvidia/vllm:26.01-py3",
          "timeout",
          "900",
          "/opt/host-nvidia/nsight-compute/2025.3.1/ncu",
          "--config-file",
          "off",
          "--clock-control",
          "none",
          "--cache-control",
          "none",
          "--filter-mode",
          "global",
          "--kernel-name-base",
          "function",
          "--kernel-name",
          plan.kernel_filter(),
          "--launch-count",
          plan.launch_count(),
          "--launch-skip",
          "0",
          "--section",
          "LaunchStats",
          "--section",
          "Occupancy",
          "--section",
          "SpeedOfLight",
          "--section",
          "SchedulerStats",
          "--section",
          "WarpStateStats",
          "--section",
          "MemoryWorkloadAnalysis",
          "--section",
          "InstructionStats",
          "--section",
          "SourceCounters",
          "--metrics",
          "lts__t_sectors_op_read.sum,lts__t_sectors_op_write.sum",
          "--export",
          root + "/counter",
          probe,
          ..arguments,
        ],
      ),
    )
    done = true
  })
  @fs.write_file(
    root + "/memory.csv",
    samples.to_string(),
    create_mode=CreateNew,
  )
  let raw = capture(
    root,
    "counter-raw",
    "/opt/nvidia/nsight-compute/2025.3.1/ncu",
    [
      "--import",
      root + "/counter.ncu-rep",
      "--page",
      "raw",
      "--csv",
      "--print-units",
      "base",
    ],
  )
  plan.verify_launches(raw)
  ignore(
    capture(root, "counter-source", "/opt/nvidia/nsight-compute/2025.3.1/ncu", [
      "--import",
      root + "/counter.ncu-rep",
      "--page",
      "source",
      "--csv",
      "--print-source",
      "sass",
    ]),
  )
  @fs.write_file(
    root + "/COUNTER_RESULT.txt",
    "outcome=completed\npartitioned=\{plan.partitioned}\nlaunch_count=\{plan.launch_count()}\nscope=synthetic immutable KV, rows=\{rows}, envelope=\{envelope}, history=\{history}, module=\{artifact}; not serving counters or throughput\n",
    create_mode=CreateNew,
  )
}

///|
test "partitioned capture retains both launches and the actual C16 envelope" {
  let plan = capture_plan("split-paired")
  assert_eq(plan.launch_count(), "4")
  assert_eq(plan.probe_args("s", "b", "c"), [
    "s", "b", "c", "16", "16", "4095", "--decode-envelope", "--decode-partitioned",
  ])
  assert_true(plan.kernel_filter().contains("partial_v3_ep_3903"))
  assert_true(plan.kernel_filter().contains("merge_v3_ep_3904"))
  assert_eq(capture_plan("split").launch_count(), "2")
  let partial = "\"0\",\"p\",\"p\",\"host\",\"lunaflux_paged_attention_bf16_decode_split_partial_v3_ep_3903\",\"c\""
  let merge = "\"1\",\"p\",\"p\",\"host\",\"lunaflux_paged_attention_bf16_decode_split_merge_v3_ep_3904\",\"c\""
  plan.verify_launches([partial, merge, partial, merge].join("\n"))
  for incomplete in [partial, [partial, partial, merge, merge].join("\n"), ""] {
    try plan.verify_launches(incomplete) catch {
      _ => ()
    } noraise {
      _ => fail("missing or reordered merge accepted")
    }
  }
}

///|
test "ordinary profiles preserve their original workloads" {
  assert_eq(capture_plan("counter").launch_count(), "1")
  assert_eq(capture_plan("paired").launch_count(), "2")
  let long = capture_plan("window")
  assert_eq(long.envelope, "8")
  assert_eq(long.history, "32767")
  assert_false(long.probe_args("s", "b", "c").contains("--decode-partitioned"))
  let rejected = try {
    ignore(capture_plan("no-such-profile"))
    false
  } catch {
    _ => true
  }
  assert_true(rejected)
}

///|
test "counter scopes do not collide and explicit probe pins stay strict" {
  assert_true(
    counter_container("/home/experiment-a/counter-c16") !=
    counter_container("/home/experiment-b/counter-c16"),
  )
  assert_eq(probe_pin(["--probe-sha256", "a".repeat(64)]), "a".repeat(64))
  for
    options in [
      ["--probe-sha256", "bad"],
      ["--skip-probe-check"],
      ["--probe-sha256", "g".repeat(64)],
    ] {
    try probe_pin(options) catch {
      _ => ()
    } noraise {
      _ => fail("unchecked probe accepted")
    }
  }
}
