///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
}

///|
fn replace_once(
  source : String,
  before : String,
  after : String,
) -> String raise {
  let pieces = source.split(before).to_array()
  guard pieces.length() == 2 else { fail("pinned reference seam changed") }
  pieces.join(after)
}

// Only mount the generated files into disposable profiler containers. The
// marker reads CPU metadata: no CUDA tensor .item(), copy or synchronization.
// Do not use these instrumented runs for ordinary throughput claims.

///|
async fn main {
  guard @env.args() is [_, root] else {
    fail("NEW_ROOT_WITH_PINNED_REFERENCE_ORIGINALS")
  }
  let vllm = @fs.read_file(root + "/vllm-original.py").text()
  let seam =
    #|        self.seq_lens.np[:num_reqs] = (
    #|            self.input_batch.num_computed_tokens_cpu[:num_reqs] + num_scheduled_tokens
    #|        )
  let marker =
    #|        # OFFLINE DIAGNOSTIC ONLY: logical work, never request contents.
    #|        import json as _lf_json
    #|        torch.cuda.nvtx.mark("lf_work " + _lf_json.dumps({
    #|            "engine": "vllm", "rows": int(num_reqs),
    #|            "query": [int(x) for x in num_scheduled_tokens],
    #|            "past": [int(x) for x in self.input_batch.num_computed_tokens_cpu[:num_reqs]],
    #|        }, separators=(",", ":")))
  @fs.write_file(
    root + "/vllm-work.py",
    replace_once(vllm, seam, seam + "\n" + marker),
    create_mode=CreateNew,
  )
  let sglang = @fs.read_file(root + "/sglang-original.py").text()
  let seam =
    #|        mode_check = (
    #|            forward_batch.forward_mode.is_cpu_graph
  let marker =
    #|        # OFFLINE DIAGNOSTIC ONLY: CPU metadata, no device round trip.
    #|        import json as _lf_json
    #|        _lf_rows = int(forward_batch.batch_size)
    #|        if forward_batch.forward_mode.is_decode():
    #|            _lf_query = [1] * _lf_rows
    #|            _lf_past = [int(x) - 1 for x in forward_batch.seq_lens_cpu[:_lf_rows]]
    #|        elif forward_batch.extend_seq_lens_cpu is not None:
    #|            _lf_query = [int(x) for x in forward_batch.extend_seq_lens_cpu]
    #|            _lf_past = [int(x) for x in forward_batch.extend_prefix_lens_cpu]
    #|        else:
    #|            raise RuntimeError("diagnostic work metadata absent")
    #|        assert len(_lf_query) == _lf_rows and len(_lf_past) == _lf_rows
    #|        torch.cuda.nvtx.mark("lf_work " + _lf_json.dumps({
    #|            "engine": "sglang", "rows": _lf_rows,
    #|            "query": _lf_query, "past": _lf_past,
    #|        }, separators=(",", ":")))
  @fs.write_file(
    root + "/sglang-work.py",
    replace_once(sglang, seam, marker + "\n" + seam),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/REFERENCE_WORK_SCOPE.txt",
    "Pinned reference source overrides for NVTX logical-work diagnostics only; unchanged model, scheduler configuration and GPU kernels.\n",
    create_mode=CreateNew,
  )
  println("reference CPU metadata markers prepared")
}
