///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
// Immutable effect allocation: barrier zero belongs to initialization/join.
// Each slot owns distinct K/V ready and K/V retired rendezvous. Hardware IDs
// are a terminal lowering resource, not a model or scheduling constant.
struct NamedSlots {
  slots : Int
  participants : Int
} derive(Eq, Debug)

///|
fn NamedSlots::new(slots : Int, participants : Int) -> NamedSlots raise {
  assert_true(slots >= 1 && slots <= 3)
  assert_true(
    participants >= 64 && participants <= 1024 && participants % 32 == 0,
  )
  { slots, participants, }
}

///|
fn NamedSlots::barrier(
  self : NamedSlots,
  slot : Int,
  operand : Int,
  released : Bool,
) -> Int raise {
  assert_true(slot >= 0 && slot < self.slots && (operand == 0 || operand == 1))
  1 + slot * 4 + operand + (if released { 2 } else { 0 })
}

///|
fn exact(
  source : String,
  old : String,
  fresh : String,
  count : Int,
) -> String raise {
  assert_eq(source.split(old).length(), count + 1, msg=old)
  source.split(old).join(fresh)
}

///|
fn transform(source : String) -> String raise {
  let plan = NamedSlots::new(2, 128)
  assert_eq(plan.barrier(1, 1, true), 8)
  let source = exact(
    source, "\n  unsigned long long *phase_barriers = reinterpret_cast<unsigned long long *>(stage_valid + 4);\n  const unsigned int barrier_base = (unsigned int)__cvta_generic_to_shared(phase_barriers);",
    "", 2,
  )
  let source = exact(
    source, "    asm volatile(\"cp.async.commit_group;\" ::: \"memory\");\n    const unsigned int ready = barrier_base + (slot * 4 + 0) * 8;\n    asm volatile(\"cp.async.mbarrier.arrive.noinc.shared::cta.b64 [%0];\" :: \"r\"(ready) : \"memory\");\n    asm volatile(\"mbarrier.arrive.release.cta.shared::cta.b64 _, [%0];\" :: \"r\"(ready) : \"memory\");",
    "    asm volatile(\"cp.async.commit_group;\" ::: \"memory\");\n    asm volatile(\"cp.async.wait_group 0;\" ::: \"memory\");\n    const int ready = 1 + slot * 4;\n    asm volatile(\"bar.arrive %0, 128;\" :: \"r\"(ready) : \"memory\");",
    2,
  )
  let source = exact(
    source, "    asm volatile(\"cp.async.commit_group;\" ::: \"memory\");\n    const unsigned int ready = barrier_base + (slot * 4 + 1) * 8;\n    asm volatile(\"cp.async.mbarrier.arrive.noinc.shared::cta.b64 [%0];\" :: \"r\"(ready) : \"memory\");\n    asm volatile(\"mbarrier.arrive.release.cta.shared::cta.b64 _, [%0];\" :: \"r\"(ready) : \"memory\");",
    "    asm volatile(\"cp.async.commit_group;\" ::: \"memory\");\n    asm volatile(\"cp.async.wait_group 0;\" ::: \"memory\");\n    const int ready = 2 + slot * 4;\n    asm volatile(\"bar.arrive %0, 128;\" :: \"r\"(ready) : \"memory\");",
    2,
  )
  let old_protocol =
    #|  auto phase_wait = [&](unsigned int address, int parity) {
    #|    asm volatile("{ .reg .pred done; "
    #|                 "again: mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 done, [%0], %1; "
    #|                 "@!done bra again; }" :: "r"(address), "r"(parity) : "memory");
    #|  };
    #|  auto phase_release = [&](unsigned int address) {
    #|    asm volatile("mbarrier.arrive.release.cta.shared::cta.b64 _, [%0];" :: "r"(address) : "memory");
    #|  };
    #|  if (thread == 0) {
    #|    for (int slot = 0; slot < 2; ++slot) {
    #|      stage_valid[slot] = stage_valid[2 + slot] = 1;
    #|      for (int operand = 0; operand < 4; ++operand) {
    #|        const unsigned int address = barrier_base + (slot * 4 + operand) * 8;
    #|        const int arrivals = operand < 2 ? 128 : 64;
    #|        asm volatile("mbarrier.init.shared::cta.b64 [%0], %1;" :: "r"(address), "r"(arrivals) : "memory");
    #|      }
    #|    }
    #|  }
  let new_protocol =
    #|  auto phase_wait = [&](int barrier) {
    #|    asm volatile("bar.sync %0, 128;" :: "r"(barrier) : "memory");
    #|  };
    #|  auto phase_release = [&](int barrier) {
    #|    asm volatile("bar.arrive %0, 128;" :: "r"(barrier) : "memory");
    #|  };
    #|  if (thread == 0) stage_valid[0] = stage_valid[1] = stage_valid[2] = stage_valid[3] = 1;
  let source = exact(source, old_protocol, new_protocol, 2)
  let source = exact(
    source, "  if (thread == 0) {\n    for (int barrier = 0; barrier < 8; ++barrier) {\n      const unsigned int address = barrier_base + barrier * 8;\n      asm volatile(\"mbarrier.inval.shared::cta.b64 [%0];\" :: \"r\"(address) : \"memory\");\n    }\n  }\n",
    "", 2,
  )
  let source = exact(
    source, "      const int parity = (epoch >> 1) & 1;\n", "", 2,
  )
  let source = exact(
    source, "      phase_release(barrier_base + (slot * 4 + 3) * 8);", "      __syncwarp();\n      phase_release(1 + slot * 4 + 3);",
    2,
  )
  let mut source = source
  for operand in 0..<3 {
    source = exact(
      source,
      "barrier_base + (slot * 4 + \{operand}) * 8",
      "1 + slot * 4 + \{operand}",
      if operand == 2 {
        4
      } else {
        2
      },
    )
  }
  source = exact(
    source, "barrier_base + (slot * 4 + 3) * 8", "1 + slot * 4 + 3", 2,
  )
  source = exact(source, ", ((epoch >> 1) - 1) & 1)", ")", 4)
  source = exact(source, ", parity);", ");", 4)
  assert_false(source.contains("mbarrier"))
  assert_false(source.contains("again:"))
  assert_eq(source.split("  __syncthreads();").length(), 6)
  source
}

///|
async fn captured(
  root : String,
  name : String,
  exe : String,
  args : Array[String],
) -> String {
  let result = @shell.Cmd(exe, args).output(max_output_bytes=33554432)
  @fs.write_file(
    root + "/" + name + ".command.json",
    Json([exe, ..args]).stringify(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  result.stdout()
}

///|
async fn main {
  guard @env.args() is [_, input, root, mode] else {
    fail("PINNED_SLOT_SOURCE NEW_ROOT render|build")
  }
  if mode == "render" {
    @fs.write_file(
      root,
      transform(@fs.read_file(input).text()),
      create_mode=CreateNew,
    )
    return
  }
  assert_eq(mode, "build")
  assert_true(
    captured(root, "source-pin", "sha256sum", [input]).has_prefix(
      "25297b800ad6dbe6727f173eafb145e4d1ca9ae115509ef130709cd805b06e05 ",
    ),
  )
  let nvcc = "/usr/local/cuda-13.0/bin/nvcc"
  assert_true(
    captured(root, "nvcc-pin", "sha256sum", [nvcc]).has_prefix(
      "fbb111f057786ddd10ba723d993cc7dd43abf978b6baa32fedd3c9d806dc79e1 ",
    ),
  )
  assert_true(
    captured(root, "idle-before", "nvidia-smi", [
      "--query-compute-apps=pid", "--format=csv,noheader",
    ])
    .trim()
    .is_empty(),
  )
  @fs.mkdir(root + "/roles")
  @fs.write_file(
    root + "/roles/kernel.cu",
    transform(@fs.read_file(input).text()),
    create_mode=CreateNew,
  )
  let recipe = exact(
    @fs.read_file(input.replace(old="kernel.cu", new="kernel.recipe")).text(),
    "shared_memory_bytes=33104\n",
    "shared_memory_bytes=33040\n",
    2,
  )
  let recipe = exact(
    recipe, "diagnostic_slot_completion=separate-ready-release\n", "diagnostic_slot_completion=copy-wait-named-ready-release\n",
    1,
  )
  @fs.write_file(root + "/roles/kernel.recipe", recipe, create_mode=CreateNew)
  ignore(
    captured(root, "compile", nvcc, [
      "-O3",
      "-arch=sm_121",
      "--std=c++14",
      "--fmad=false",
      "--ftz=false",
      "--prec-div=true",
      "--prec-sqrt=true",
      "--Werror",
      "all-warnings",
      "--maxrregcount=255",
      "-Xptxas=-v",
      "-cubin",
      root + "/roles/kernel.cu",
      "-o",
      root + "/roles/kernel.cubin",
    ]),
  )
  ignore(
    captured(root, "identities", "sha256sum", [
      root + "/roles/kernel.cu",
      root + "/roles/kernel.cubin",
      root + "/roles/kernel.recipe",
    ]),
  )
}

///|
test "named readiness and retirement resources are disjoint and exclude barrier zero" {
  for slots in 1..<=3 {
    let plan = NamedSlots::new(slots, 128)
    let ids = [
      for index in 0..<(slots * 4) => {
        plan.barrier(index / 4, index % 2, index % 4 >= 2)
      }
    ]
    assert_eq(ids.length(), slots * 4)
    for i, id in ids {
      assert_true(id > 0 && id < 16)
      assert_false(ids[:i].contains(id))
    }
  }
  for (slots, count) in [(0, 128), (4, 128), (2, 63), (2, 129), (2, 1056)] {
    try NamedSlots::new(slots, count) catch {
      _ => ()
    } noraise {
      _ => fail("invalid physical barrier allocation")
    }
  }
}

///|
test "partial source must not become an executable protocol" {
  try transform("partial source") catch {
    _ => ()
  } noraise {
    _ => fail("partial source accepted")
  }
}
