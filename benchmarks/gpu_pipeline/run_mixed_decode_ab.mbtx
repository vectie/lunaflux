///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn replace_once(
  source : String,
  before : String,
  after : String,
) -> String raise {
  guard source.split(before).to_array().length() == 2 else {
    fail("harness seam " + before)
  }
  source.replace(old=before, new=after)
}

///|
// Reuse the existing bounded lifecycle harness unchanged for each fresh start.
// ABBA order separates a dispatch change from an old/new machine-session shift.
async fn main {
  guard @env.args() is [_, baseline, partitioned, harness, root, .. options] &&
    options.length() <= 2 &&
    options.filter(x => x == "--compiler-module-ab").length() <= 1 &&
    options.filter(x => x == "--include-c8").length() <= 1 &&
    options.all(x => x == "--compiler-module-ab" || x == "--include-c8") else {
    fail(
      "BASELINE_SERVING PARTITIONED_DIAGNOSTIC_SERVING MATCHED_HARNESS NEW_ROOT [--compiler-module-ab] [--include-c8]",
    )
  }
  guard !@fs.exists(root) else { fail("non-overwriting root") }
  guard @fs.exists(harness) else { fail("matched harness missing") }
  for serving in [baseline, partitioned] {
    guard @fs.read_file(serving + "/RESULT.txt")
      .text()
      .has_prefix("outcome=completed\n") else {
      fail("prepared runtime required")
    }
  }
  @fs.mkdir(root)
  let runner = root + "/trial.mbtx"
  let source = replace_once(
    @fs.read_file(harness).text(),
    "  guard options.is_empty() &&",
    "  if options is [\"--trial\"] {\n    trial(serving, root, script, \"luna-full\")\n    return\n  }\n  guard options.is_empty() &&",
  )
  // Basenames such as abba/r0-baseline recur across campaigns. Include the
  // full diagnostic path so a retained transient unit cannot alias this run.
  let source = replace_once(
    source, "components[components.length() - 2].to_owned() +\n    \"-\" +\n    components.last().unwrap().to_owned()",
    "components.join(\"-\")",
  )
  let source = replace_once(
    source, "    for _ in 0..<240 {\n      let health", "    for _ in 0..<240 {\n      for service in units {\n        let state = @shell.Cmd(\"systemctl\", [\"--user\", \"is-failed\", service]).output()\n        guard state.stdout().trim() != \"failed\" else { fail(\"benchmark unit failed: \" + service) }\n      }\n      let health",
  )
  @fs.write_file(runner, source, create_mode=CreateNew)
  let client = replace_once(
    @fs.read_file(baseline + "/benchmark.mbtx").text(),
    "[(128,32),(4096,64),(4096,256)]",
    "[(4096,64),(4096,256)]",
  )
  let include_c8 = options.contains("--include-c8")
  let client = replace_once(
    client,
    "[1,8,16]",
    if include_c8 {
      "[8,16]"
    } else {
      "[16]"
    },
  )
  let client = replace_once(client, "0..<4", "0..<2")
  @fs.write_file(runner + ".client.mbtx", client, create_mode=CreateNew)
  let orders = ["baseline", "partitioned", "partitioned", "baseline"]
  let moon = baseline + "/toolchain/bin/moon"
  for round, kind in orders {
    let serving = if kind == "baseline" { baseline } else { partitioned }
    let trial = root + "/r\{round}-" + kind
    let result = @shell.Cmd(moon, [
      "run", runner, serving, trial, runner, "--trial",
    ]).output(max_output_bytes=33554432)
    @fs.write_file(
      root + "/r\{round}.stdout",
      result.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/r\{round}.stderr",
      result.stderr(),
      create_mode=CreateNew,
    )
    result.check()
    println("round \{round} " + kind + " completed")
  }
  let campaign : Json = {
    "schema": "lunaflux.mixed-decode-ab.v1",
    "baseline": baseline,
    "partitioned": partitioned,
    "order": orders,
    "inputs": [4096],
    "outputs": [64, 256],
    "concurrency": if include_c8 {
      Json([8, 16])
    } else {
      Json([16])
    },
    "scope": if !options.contains("--compiler-module-ab") {
      "ordinary timing, diagnostic forced mixed dispatch, identical AOT modules; no production tuning records"
    } else {
      "ordinary timing, identical runtime; scoped changed compiler modules with fresh route measurements; diagnostic forced mixed dispatch in both arms. See prepared runtime MODULE_DIFF or module verification for exact scope."
    },
  }
  @fs.write_file(
    root + "/CAMPAIGN.json",
    campaign.stringify(indent=2),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/RESULT.txt",
    "outcome=completed\nscope=ordinary-mixed-decode-ABBA\n",
    create_mode=CreateNew,
  )
}
