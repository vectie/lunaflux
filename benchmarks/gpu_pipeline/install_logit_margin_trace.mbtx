///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn tracked_token_ids(text : String) -> Array[Int] raise {
  let ids = text.split(",").to_array().map(id => @string.parse_int(id))
  guard ids.length() > 0 && ids.length() <= 32 else {
    fail("1..32 tracked token IDs")
  }
  for i, id in ids {
    guard id >= 0 && ids[:i].all(previous => previous != id) else {
      fail("nonnegative unique tracked IDs")
    }
  }
  ids
}

// Run after install_execution_trace, and only in a disposable source tree.
// This intentionally adds synchronous readback and cannot measure performance.

///|
fn replace_exact(
  source : String,
  before : String,
  after : String,
) -> String raise {
  guard source.split(before).to_array().length() == 2 else {
    fail("logit diagnostic seam changed: " + before)
  }
  source.replace(old=before, new=after)
}

///|
fn margin_request_markers(source : String) -> String raise {
  let seam = "fn trace_plan(plan : @worker_protocol.SubmittedSchedulePlan)"
  guard source.split(seam).to_array() is [wire, plan] else {
    fail("wire/submitted diagnostic boundary changed")
  }
  let before = "      trace_event(1, seq, i, row.token_length(), row.sequence_token_start(), 0, 0, 0, 0UL)"
  let wire = replace_exact(
    wire.to_owned(),
    before,
    "      trace_event(7, row.request_id_value(), i, row.sample_index(), 1, 0, 0, 0, row.request_generation_value())\n" +
    before,
  )
  let before = "      trace_event(1, seq, i, row.tokens().length(), row.sequence_token_start(), 0, 0, 0, 0UL)"
  let plan = replace_exact(
    plan.to_owned(),
    before,
    "      trace_event(7, row.request_id().value(), i, row.sample_index(), 1, 0, 0, 0, row.request_generation().value())\n" +
    before,
  )
  let before = "    for i in 0..<d { trace_event(2, seq, i, 1, frame.decode_row(i).sequence_token_position(), 0, 0, 0, 0UL) }"
  let wire = replace_exact(
    wire, before, "    for i in 0..<d { let row=frame.decode_row(i); trace_event(7, row.request_id_value(), p+i, row.sample_index(), 2, 0, 0, 0, row.request_generation_value()); trace_event(2, seq, i, 1, row.sequence_token_position(), 0, 0, 0, 0UL) }",
  )
  let before = "    for i in 0..<d { trace_event(2, seq, i, 1, plan.decode_row(i).sequence_token_position(), 0, 0, 0, 0UL) }"
  let plan = replace_exact(
    plan, before, "    for i in 0..<d { let row=plan.decode_row(i); trace_event(7, row.request_id().value(), p+i, row.sample_index(), 2, 0, 0, 0, row.request_generation().value()); trace_event(2, seq, i, 1, row.sequence_token_position(), 0, 0, 0, 0UL) }",
  )
  wire + seam + plan
}

///|
async fn main {
  let (root, tracked) = match @env.args() {
    [_, root] => (root, [624, 382])
    [_, root, "--tracked-tokens", ids] => (root, tracked_token_ids(ids))
    _ => fail("DISPOSABLE_TRACE_SOURCE [--tracked-tokens ID,ID,...]")
  }
  let directory = root + "/engine/device_step/"
  let events = directory + "diagnostic_execution.mbt"
  assert_true(@fs.exists(events))
  assert_false(@fs.exists(directory + "diagnostic_logit_margin.mbt"))
  assert_false(
    @fs.read_file(root + "/internal/process/process_approved_spawn.c")
    .text()
    .contains("if (close(2) != 0 && errno != EBADF) _exit(126);"),
    msg="install the current diagnostic stderr-preserving trace first",
  )
  let bindings = margin_request_markers(@fs.read_file(events).text())
  let path = directory + "paged_executor_greedy_sampling.mbt"
  let source = @fs.read_file(path).text()
  let parts = source.split("  token\n}").to_array()
  assert_eq(parts.length(), 2)
  let function =
    #|///|
    #|fn trace_paged_margin(executor : PagedGraphExecutor, descriptor : DeviceStepOwner, row : Int, selected : Int) -> Unit raise DeviceStepError {
    #|  let end = read_paged_i32(descriptor.host.query_row_offsets, row + 1)
    #|  if end <= 0 || end > descriptor.staged_summary.token_count { raise InvalidExecutor(SamplingOutput) }
    #|  let scratch = executor.completion
    #|  let activation = open_activation_workspace(executor.resources)
    #|  descriptor.context.copy_to_fixed_host(activation, scratch.encoded_logits,
    #|    scratch.final_output_offset + (end - 1).to_int64() * scratch.row_bytes, 0L, scratch.row_bytes) catch {
    #|    error => raise ExecutorDevice(ActivationReadback, error)
    #|  }
    #|  decode_paged_bf16_logits(scratch)
    #|  let mut best = -1
    #|  let mut second = -1
    #|  for token in 0..<scratch.vocabulary_size {
    #|    let value = scratch.logits[token]
    #|    if best < 0 || value > scratch.logits[best] { second = best; best = token }
    #|    else if second < 0 || value > scratch.logits[second] { second = token }
    #|  }
    #|  if best < 0 || second < 0 { raise InvalidExecutor(SamplingOutput) }
    #|  let first_bits = scratch.encoded_logits[best * 2].to_int() | (scratch.encoded_logits[best * 2 + 1].to_int() << 8)
    #|  let second_bits = scratch.encoded_logits[second * 2].to_int() | (scratch.encoded_logits[second * 2 + 1].to_int() << 8)
    #|  trace_event(6, descriptor.stage_epoch, row, read_paged_i32(descriptor.host.token_positions, end - 1), selected, best, second, first_bits, second_bits.to_uint64())
    #|  for token in [624, 382] {
    #|    if token < scratch.vocabulary_size {
    #|      let bits = scratch.encoded_logits[token * 2].to_int() | (scratch.encoded_logits[token * 2 + 1].to_int() << 8)
    #|      trace_event(14, descriptor.stage_epoch, row, token, bits, end - 1, projected_result_row(descriptor, row), 0, 0UL)
    #|    }
    #|  }
    #|}
  let function = replace_exact(
    function,
    "[624, 382]",
    tracked.to_json().stringify(),
  )
  @fs.write_file(
    directory + "diagnostic_logit_margin.mbt",
    function,
    create_mode=CreateNew,
  )
  @fs.write_file(events, bindings)
  @fs.write_file(
    path,
    parts.join(
      "  trace_paged_margin(executor, descriptor, row, token)\n  token\n}",
    ),
  )
  println(
    "diagnostic-only epoch-correlated top-two and explicit token logits installed",
  )
}

///|
test "tracked IDs are explicit and bounded without changing the default trace" {
  assert_eq(tracked_token_ids("315,389,279,198,13,271"), [
    315, 389, 279, 198, 13, 271,
  ])
  for invalid in ["", "315,315", "-1", "x"] {
    try tracked_token_ids(invalid) catch {
      _ => ()
    } noraise {
      _ => fail("invalid tracked IDs")
    }
  }
}

///|
test "request markers preserve wire and submitted row APIs" {
  let source =
    #|fn trace_frame(frame : @worker_wire.ValidatedPlanFrame) {
    #|      trace_event(1, seq, i, row.token_length(), row.sequence_token_start(), 0, 0, 0, 0UL)
    #|    for i in 0..<d { trace_event(2, seq, i, 1, frame.decode_row(i).sequence_token_position(), 0, 0, 0, 0UL) }
    #|}
    #|fn trace_plan(plan : @worker_protocol.SubmittedSchedulePlan) {
    #|      trace_event(1, seq, i, row.tokens().length(), row.sequence_token_start(), 0, 0, 0, 0UL)
    #|    for i in 0..<d { trace_event(2, seq, i, 1, plan.decode_row(i).sequence_token_position(), 0, 0, 0, 0UL) }
    #|}
  let modified = margin_request_markers(source)
  assert_eq(modified.split("trace_event(7,").count(), 5)
  assert_eq(modified.split("row.request_id_value()").count(), 3)
  assert_eq(modified.split("row.request_id().value()").count(), 3)
  assert_eq(modified.split("row.request_generation().value()").count(), 3)
}
