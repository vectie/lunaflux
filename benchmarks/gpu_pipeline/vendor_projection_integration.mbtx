///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn once(text : String, old : String, fresh : String) -> String raise {
  guard text.split(old).to_array() is [a, b] else {
    fail("ambiguous seam: " + old)
  }
  a.to_owned() + fresh + b.to_owned()
}

///|
async fn record(
  root : String,
  label : String,
  exe : String,
  args : Array[String],
  cwd? : String,
  env? : Map[String, String],
) -> String {
  @fs.write_file(
    root + "/" + label + ".command.json",
    Json([exe, ..args]).stringify(),
    create_mode=CreateNew,
  )
  let result = @shell.Cmd(exe, args, cwd?, env?).output(
    max_output_bytes=33554432,
  )
  @fs.write_file(
    root + "/" + label + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  println("completed=" + label)
  result.stdout()
}

///|
async fn admit(root : String, label : String) -> Unit {
  let identity = record(root, label + "-device", "nvidia-smi", [
    "--query-gpu=uuid,pci.bus_id", "--format=csv,noheader",
  ])
  assert_true(identity.contains("GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6"))
  assert_true(identity.contains("0000000F:01:00.0"))
  assert_true(
    record(root, label + "-idle", "nvidia-smi", [
      "--query-compute-apps=pid", "--format=csv,noheader",
    ])
    .trim()
    .is_empty(),
  )
  let memory = @fs.read_file("/proc/meminfo").text()
  @fs.write_file(
    root + "/" + label + "-memory.txt",
    memory,
    create_mode=CreateNew,
  )
  guard memory.split("\n").filter(x => x.has_prefix("MemAvailable:")).to_array()
    is [line] else {
    fail("memory")
  }
  assert_true(
    @string.parse_int64(
      line.split(" ").filter(x => !x.is_empty()).to_array()[1],
    ) >=
    33554432L,
  )
  assert_true(
    record(root, label + "-nvcc", "sha256sum", ["/usr/local/cuda-13.0/bin/nvcc"]).has_prefix(
      "fbb111f057786ddd10ba723d993cc7dd43abf978b6baa32fedd3c9d806dc79e1 ",
    ),
  )
}

///|
async fn args_from(path : String) -> Array[String] {
  guard @json.parse(@fs.read_file(path).text()) is Array(values) else {
    fail("command")
  }
  values.map(value => {
    guard value is String(s) else { fail("argument") }
    s
  })
}

///|
async fn main {
  guard @env.args() is [_, root, mode] &&
    root.has_prefix("/home/wlc004s/lunaflux-vendor-integration-20261008.") else {
    fail("NEW_ROOT MODE")
  }
  let frozen = "/home/wlc004s/lunaflux-mixed-capture-repair-20261006.sQMel69Z"
  let baseline = "/home/wlc004s/lunaflux-batch-cliff-fix-20261007.sx0E1lbt"
  let reference = "/home/wlc004s/lunaflux-reference-integration-20261008.G89e6nwn"
  let benchmark = "/home/wlc004s/lunaflux-batch-cliff-abba-20261007.xvFHOL9t"
  let moon = frozen + "/toolchain/bin/moon"
  let source = root + "/source"
  let worker = source +
    "/_build/native/release/build/cmd/device_worker_child/device_worker_child.exe"
  let exporter = source +
    "/_build/native/release/build/cmd/lunaflux_qwen3_fused_runtime_bundle_export/lunaflux_qwen3_fused_runtime_bundle_export.exe"
  let flags = "-79-20-29-25-92-14"
  if mode == "prepare" {
    assert_false(@fs.exists(source))
    @fs.mkdir(source)
    @shell.Cmd("tar", ["-xf", root + "/source.tar", "-C", source]).run()
    @shell.Cmd("tar", ["-xf", root + "/overlay.tar", "-C", source]).run()
    @shell.Cmd("cp", [
      "-a",
      frozen + "/source/.mooncakes",
      source + "/.mooncakes",
    ]).run()
    ignore(
      record(root, "source-identity", "sha256sum", [
        root + "/source.tar",
        root + "/overlay.tar",
      ]),
    )
  } else if mode == "budget-build" {
    ignore(
      record(root, "budget-repair-identity", "sha256sum", [
        root + "/budget-repair.tar",
      ]),
    )
    @shell.Cmd("tar", ["-xf", root + "/budget-repair.tar", "-C", source]).run()
    let tools = reference + "/validation-toolchain/bin/moon"
    for
      (label, args) in [
        ("info", ["info"]),
        ("fmt", ["fmt", "--check"]),
        (
          "check",
          ["check", "--target", "native", "--deny-warn", "--warn-list", flags],
        ),
        (
          "test",
          ["test", "--target", "native", "--deny-warn", "--warn-list", flags],
        ),
        (
          "build",
          [
            "build", "--target", "native", "--release", "--deny-warn", "--warn-list",
            flags, "cmd/device_worker_child",
          ],
        ),
      ] {
      ignore(record(root, "budget-" + label, tools, args, cwd=source))
    }
    ignore(
      record(root, "budget-binary-identity", "sha256sum", [worker, exporter]),
    )
  } else if mode == "repair-build" {
    ignore(
      record(root, "bootstrap-repair-identity", "sha256sum", [
        root + "/bootstrap-repair.tar",
      ]),
    )
    @shell.Cmd("tar", ["-xf", root + "/bootstrap-repair.tar", "-C", source]).run()
    let tools = reference + "/validation-toolchain/bin/moon"
    ignore(
      record(
        root,
        "repair-bootstrap-tests",
        tools,
        [
          "test", "--target", "native", "--deny-warn", "--warn-list", flags, "-p",
          "engine/device_worker_bootstrap",
        ],
        cwd=source,
      ),
    )
    ignore(
      record(
        root,
        "repair-worker-build",
        tools,
        [
          "build", "--target", "native", "--release", "--deny-warn", "--warn-list",
          flags, "cmd/device_worker_child",
        ],
        cwd=source,
      ),
    )
    ignore(
      record(
        root,
        "repair-full-tests",
        tools,
        ["test", "--target", "native", "--deny-warn", "--warn-list", flags],
        cwd=source,
      ),
    )
    ignore(
      record(root, "repair-binary-identity", "sha256sum", [worker, exporter]),
    )
  } else if mode == "build" {
    for
      package_path in [
        "engine/device_step", "device", "kernels/luna_fused_artifact_admission",
        "cmd/lunaflux_qwen3_fused_runtime_bundle_export", "engine/device_worker",
      ] {
      ignore(
        record(
          root,
          "test-" + package_path.replace(old="/", new="-"),
          moon,
          [
            "test", "--target", "native", "--deny-warn", "--warn-list", flags, "-p",
            package_path,
          ],
          cwd=source,
        ),
      )
    }
    for
      package_path in [
        "cmd/device_worker_child", "cmd/lunaflux_qwen3_fused_runtime_bundle_export",
      ] {
      ignore(
        record(
          root,
          "build-" + package_path.replace(old="/", new="-"),
          moon,
          [
            "build", "--target", "native", "--release", "--deny-warn", "--warn-list",
            flags, package_path,
          ],
          cwd=source,
        ),
      )
    }
    ignore(record(root, "binary-identity", "sha256sum", [worker, exporter]))
  } else if mode == "physical" {
    let root = root + "/physical-v4"
    @fs.mkdir(root)
    admit(root, "physical")
    ignore(
      record(root, "library-identity", "sha256sum", [
        "/usr/local/cuda/targets/sbsa-linux/lib/libcublas.so.13", "/usr/local/cuda/targets/sbsa-linux/lib/libcublasLt.so.13",
      ]),
    )
    let fixture = root + "/effect.cubin"
    ignore(
      record(root, "fixture", "/usr/local/cuda-13.0/bin/nvcc", [
        "-arch=sm_121",
        "-cubin",
        source + "/tests/fixtures/output_demand.cu",
        "-o",
        fixture,
      ]),
    )
    // Instrument the frozen executable, never Moon or its compiler children.
    // The generated native driver uses filename:start-end (exclusive end).
    let test_binary = source +
      "/_build/native/debug/test/engine/device_step/device_step.whitebox_test.exe"
    ignore(record(root, "test-binary-identity", "sha256sum", [test_binary]))
    let args = ["vendor_projection_physical_wbtest.mbt:0-1"]
    let environment = { "LUNAFLUX_VENDOR_PROJECTION_FIXTURE": fixture }
    assert_true(
      record(
        root,
        "physical-oracle",
        test_binary,
        args,
        cwd=source,
        env=environment,
      ).contains("vendor_projection_physical=passed"),
    )
    for tool in ["memcheck", "initcheck", "racecheck", "synccheck"] {
      admit(root, tool)
      let sanitizer_args = [
        "--tool", tool, "--target-processes", "all", "--error-exitcode", "99",
      ]
      if tool == "memcheck" {
        sanitizer_args.append(["--leak-check", "full"])
      }
      if tool == "synccheck" {
        // CUDA 13.0 automatic detection undercounts vendor TMA barriers.
        // Explicitly provision tracking; this does not suppress any check.
        sanitizer_args.append(["--num-cuda-barriers", "256"])
      }
      sanitizer_args.append([test_binary, ..args])
      assert_true(
        record(
          root,
          tool,
          "/usr/local/cuda-13.0/bin/compute-sanitizer",
          sanitizer_args,
          cwd=source,
          env=environment,
        ).contains("vendor_projection_physical=passed"),
      )
    }
  } else if mode == "boundary" {
    let tools = reference + "/validation-toolchain/bin/moon"
    for
      (label, args) in [
        ("info", ["info"]),
        ("fmt", ["fmt", "--check"]),
        (
          "check",
          ["check", "--target", "native", "--deny-warn", "--warn-list", flags],
        ),
        (
          "test",
          ["test", "--target", "native", "--deny-warn", "--warn-list", flags],
        ),
      ] {
      ignore(record(root, "boundary-" + label, tools, args, cwd=source))
    }
    ignore(
      record(
        root,
        "native-sanitizer",
        "sh",
        ["scripts/validate-cuda-ordered-executor-sanitizer.sh"],
        cwd=source,
        env={
          "PATH": reference +
          "/validation-toolchain/bin:/usr/local/bin:/usr/bin:/bin",
        },
      ),
    )
  } else if mode == "native-sanitizer" {
    // This host has GCC but no /usr/bin/clang. Run the same isolated native
    // fixture with ASan/UBSan; do not alter the host or the repository gate.
    let inputs = [
      "ordered_executor_sanitizer_main.c", "ordered_executor.c", "ordered_executor_probe.c",
      "ordered_graph.c", "ordered_graph_probe.c", "resources.c", "regions.c", "modules.c",
    ].map(name => source + "/internal/cuda/" + name)
    let probe = root + "/ordered-asan-probe"
    ignore(
      record(
        root,
        "native-sanitizer-gcc-build",
        "/usr/bin/cc",
        [
          "-std=c11",
          "-Wall",
          "-Wextra",
          "-Werror",
          "-g",
          "-pthread",
          "-fsanitize=address,undefined",
          "-fno-omit-frame-pointer",
          "-I" + frozen + "/toolchain/include",
          ..inputs,
          "-ldl",
          "-o",
          probe,
        ],
      ),
    )
    ignore(
      record(root, "native-sanitizer-gcc-run", probe, [], env={
        "ASAN_OPTIONS": "detect_leaks=1:fast_unwind_on_malloc=0",
      }),
    )
  } else if mode == "materialize-final" || mode == "materialize-retry" {
    assert_true(
      @fs.read_file(root + "/physical-v4/physical-oracle.stdout")
      .text()
      .contains("vendor_projection_physical=passed"),
    )
    for tool in ["memcheck", "initcheck", "racecheck", "synccheck"] {
      assert_true(
        @fs.read_file(root + "/physical-v4/" + tool + ".stdout")
        .text()
        .contains("vendor_projection_physical=passed"),
      )
    }
    let suffix = if mode == "materialize-retry" { "retry" } else { "final" }
    @fs.mkdir(root + "/serving-" + suffix)
    // Adapt only the helper location; keep the frozen host toolchain/runtime.
    @fs.write_file(
      root + "/materializer-" + suffix + ".mbtx",
      once(
        @fs.read_file(
          source + "/scripts/materialize-qwen3-bf16-v12-launch.mbtx",
        ).text(),
        "repo + \"/scripts/assemble-luna-kernel-root.mbtx\"",
        Json(source + "/scripts/assemble-luna-kernel-root.mbtx").stringify(),
      ),
      create_mode=CreateNew,
    )
    for arm in ["control", "attention", "gemm", "both"] {
      let label = arm + "-" + suffix
      let serving = root + "/serving-" + suffix + "/" + arm
      @fs.mkdir(serving)
      @fs.mkdir(serving + "/fused-routed")
      let bundle = serving + "/fused-routed/reusable-fused-runtime-bundle.v3"
      if mode == "materialize-retry" {
        @shell.Cmd("cp", [
          "-a",
          root +
          "/serving-final/" +
          arm +
          "/fused-routed/reusable-fused-runtime-bundle.v3",
          bundle,
        ]).run()
      } else if arm == "control" || arm == "attention" {
        let origin = if arm == "control" { baseline } else { reference }
        @shell.Cmd("cp", [
          "-a",
          origin + "/serving/fused-routed/reusable-fused-runtime-bundle.v3",
          bundle,
        ]).run()
      } else {
        let command = args_from(
          if arm == "gemm" {
            baseline + "/rebind.command.json"
          } else {
            reference + "/export-bundle.command.json"
          },
        )
        let args = command[1:].to_owned()
        args[70] = bundle
        args.append(["--prefill-vendor-projection-rows", "2048"])
        ignore(record(root, label + "-export", exporter, args))
      }
      for name in ["source", "toolchain"] {
        @shell.Cmd("ln", ["-s", frozen + "/" + name, serving + "/" + name]).run()
      }
      for
        name in [
          "bind.stdout", "convert.stdout", "export.stdout", "toolchain.v1",
        ] {
        @fs.write_file(
          serving + "/" + name,
          @fs.read_file(baseline + "/serving/" + name),
          create_mode=CreateNew,
        )
      }
      let prepare = once(
        @fs.read_file(baseline + "/serving/prepare.mbtx").text(),
        "let worker=cli+\"device_worker_child/device_worker_child.exe\"",
        "let worker=" + Json(worker).stringify(),
      )
      let prepare = once(
        prepare,
        "source+\"/scripts/materialize-qwen3-bf16-v12-launch.mbtx\"",
        Json(root + "/materializer-" + suffix + ".mbtx").stringify(),
      )
      @fs.write_file(serving + "/prepare.mbtx", prepare, create_mode=CreateNew)
      ignore(
        record(root, label + "-materialize", moon, [
          "run",
          serving + "/prepare.mbtx",
          serving,
          "materialize",
        ]),
      )
      let long = serving + "/long-final"
      @fs.mkdir(long)
      for name in ["source", "toolchain"] {
        @shell.Cmd("ln", ["-s", frozen + "/" + name, long + "/" + name]).run()
      }
      @fs.write_file(
        long + "/export.stdout",
        @fs.read_file(serving + "/export.stdout"),
        create_mode=CreateNew,
      )
      ignore(
        record(root, label + "-long", moon, [
          "run",
          frozen + "/prepare-long.mbtx",
          serving,
          long,
        ]),
      )
    }
  } else if mode == "timing" ||
    mode == "profile" ||
    mode == "timing-retry" ||
    mode == "profile-retry" ||
    mode == "profile-gemm" {
    let profile_mode = mode.has_prefix("profile")
    let output = root + "/" + mode
    @fs.mkdir(output)
    let launcher = once(
      @fs.read_file(benchmark + "/launcher.mbtx").text(),
      "let unit = \"lunaflux-matched-\"",
      "let unit = \"lunaflux-vendor-" +
      root.split(".").to_array().last().unwrap().to_owned() +
      "-\"",
    )
    let launcher = once(
      launcher, "\"--property=RuntimeMaxSec=7200\"", "\"--property=RuntimeMaxSec=1200\"",
    )
    let launcher = if profile_mode {
      let diagnostic = "/home/wlc004s/lunaflux-mixed-work-20261007.NnA6SsKN/diagnostic-source/_build/native/release/build/"
      let traced = once(
        launcher,
        "cmd + \"lunaflux/lunaflux.exe\",",
        Json(diagnostic + "cmd/lunaflux/lunaflux.exe").stringify() + ",",
      )
      once(
        traced,
        "serving +\n        \"/source/_build/native/release/build/tests/qwen3_bf16_serving_supervisor/qwen3_bf16_serving_supervisor.exe\",\n        [",
        "\"/usr/local/bin/nsys\",\n        [\"profile\",\"--trace=cuda\",\"--sample=none\",\"--cpuctxsw=none\",\"--cuda-graph-trace=node\",\"--trace-fork-before-exec=true\",\"--wait=all\",\"-o\",root+\"/trace\"," +
        Json(
          diagnostic +
          "tests/qwen3_bf16_serving_supervisor/qwen3_bf16_serving_supervisor.exe",
        ).stringify() +
        ",",
      )
    } else {
      launcher
    }
    let script = output + "/launcher.mbtx"
    @fs.write_file(script, launcher, create_mode=CreateNew)
    let client = @fs.read_file(benchmark + "/launcher.mbtx.client.mbtx").text()
    let client = if profile_mode {
      guard client
        .split("fn matrix() -> Array[(String, Array[Int], Int, String)] {")
        .to_array()
        is [a, b] &&
        b.split("///|\nfn token_ids").to_array() is [_, c] else {
        fail("matrix")
      }
      let single = a.to_owned() +
        "fn matrix() -> Array[(String, Array[Int], Int, String)] { [(\"i8192-o64-c8-varied\",inputs(8192,8),64,\"varied\")] }\n\n///|\nfn token_ids" +
        c.to_owned()
      once(
        single, "let trials = if options is [\"--smoke\"] { 1 } else { 4 }", "let trials = 2",
      )
    } else {
      client
    }
    @fs.write_file(script + ".client.mbtx", client, create_mode=CreateNew)
    let arms = if !profile_mode {
      [
        "control", "attention", "gemm", "both", "both", "gemm", "attention", "control",
      ]
    } else if mode == "profile-gemm" {
      ["gemm"]
    } else {
      ["control", "both"]
    }
    for index, arm in arms {
      admit(output, "s\{index}-" + arm)
      let result = output + "/s\{index}-" + arm
      @fs.mkdir(result)
      ignore(
        record(output, "s\{index}-" + arm, moon, [
          "run",
          script,
          root +
          (if mode.has_suffix("-retry") || mode == "profile-gemm" {
            "/serving-retry/"
          } else {
            "/serving-final/"
          }) +
          arm +
          "/long-final",
          result,
          script,
          "--luna-only",
        ]),
      )
    }
  } else {
    fail("unknown mode")
  }
}
