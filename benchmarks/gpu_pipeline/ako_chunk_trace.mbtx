///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn once(source : String, old : String, fresh : String) -> String raise {
  let parts = source.split(old).to_array()
  assert_eq(parts.length(), 2, msg=old)
  parts.join(fresh)
}

///|
async fn sha(path : String) -> String {
  let result = @shell.Cmd("sha256sum", [path]).output()
  result.check()
  result.stdout().split(" ").to_array()[0].to_owned()
}

///|
async fn capture(
  root : String,
  label : String,
  exe : String,
  args : Array[String],
) -> Unit {
  @fs.write_file(
    root + "/" + label + ".command.json",
    Json([exe, ..args]).stringify(),
    create_mode=CreateNew,
  )
  let result = @shell.Cmd(exe, args, env={
    "PATH": root + "/toolchain/bin:/usr/local/cuda-13.0/bin:/usr/bin:/bin",
  }).output(max_output_bytes=33554432)
  @fs.write_file(
    root + "/" + label + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  println(label + " completed")
}

///|
fn client(original : String, bodies_path : String) -> String raise {
  guard original.split("///|\nasync fn main {").to_array() is [helpers, _] else {
    fail("client main boundary")
  }
  let main =
    #|///|
    #|async fn main {
    #|  guard @env.args() is [_, engine, root] && engine == "luna-full" else { fail("luna-full NEW_ROOT") }
    #|  @fs.mkdir(root)
    #|  guard @json.parse(@fs.read_file(BODIES_PATH).text()) is Array(bodies) && bodies.length() == 2 else { fail("saved bodies") }
    #|  let samples : Array[Json] = []
    #|  for trial in 0..<2 {
    #|    for row in [0,1] {
    #|      let label = "solo-r\{row}-t\{trial}"
    #|      @fs.write_file(root + "/" + label + ".body.json", bodies[row].stringify(), create_mode=CreateNew)
    #|      let result = request(root, engine, label, 64)
    #|      samples.push({"row":row,"trial":trial,"result":result})
    #|    }
    #|  }
    #|  @fs.write_file(root + "/replay.json", Json(samples).stringify(), create_mode=CreateNew)
    #|}
  helpers.to_owned() + once(main, "BODIES_PATH", Json(bodies_path).stringify())
}

///|
async fn main {
  guard @env.args() is [_, frozen, query, root, phase] &&
    ["prepare", "run"].contains(phase) &&
    root.has_prefix("/home/wlc004s/lunaflux-ako-chunk-trace-") else {
    fail(
      "FROZEN_LONG_CONTEXT IMMUTABLE_QUERY_ROOT NEW_DEDICATED_ROOT prepare|run",
    )
  }
  let moon = query + "/toolchain/bin/moon"
  let cli = root + "/source/_build/native/release/build/cmd/"
  if phase == "prepare" {
    assert_false(@fs.exists(root + "/source"))
    @shell.Cmd("ln", ["-s", query + "/toolchain", root + "/toolchain"]).run()
    @fs.mkdir(root + "/source")
    @shell.Cmd("cp", ["-a", query + "/source/.", root + "/source/"]).run()
    @shell.Cmd("chmod", ["-R", "u+w", root + "/source"]).run()
    capture(root, "install-execution", moon, [
      "run",
      root + "/install_execution_trace.mbtx",
      root + "/source",
    ])
    capture(root, "install-margins", moon, [
      "run",
      root + "/install_logit_margin_trace.mbtx",
      root + "/source",
      "--tracked-tokens",
      "315,389,279,198,13,271",
    ])
    if @fs.exists(root + "/install_prefill_route_diagnostic.mbtx") {
      capture(root, "install-routes", moon, [
        "run",
        root + "/install_prefill_route_diagnostic.mbtx",
        root + "/source",
        "--unsplit-prefill",
      ])
    }
    capture(root, "build", moon, [
      "-C",
      root + "/source",
      "build",
      "--target",
      "native",
      "--release",
      "--deny-warn",
      "--warn-list",
      "-79-29-25-20-92-14",
      "-j",
      "2",
      "cmd/device_worker_child",
      "cmd/lunaflux",
    ])
    for cap in [2048, 8192] {
      let arm = root + "/c\{cap}"
      @fs.mkdir(arm)
      for name in ["source", "toolchain"] {
        @shell.Cmd("ln", ["-s", root + "/" + name, arm + "/" + name]).run()
      }
      @shell.Cmd("ln", [
        "-s",
        query + "/serving-export.stdout",
        arm + "/export.stdout",
      ]).run()
      @shell.Cmd("cp", [
        "-a",
        query + "/c\{cap}-target121/deployment",
        arm + "/deployment",
      ]).run()
      let launch_path = arm + "/deployment/lunaflux.launch.json"
      guard @json.parse(@fs.read_file(launch_path).text()) is Object(launch) else {
        fail("launch")
      }
      let worker = arm + "/deployment/bin/lunaflux-device-worker"
      @shell.Cmd("chmod", ["u+w", worker, launch_path]).run()
      @shell.Cmd("cp", [
        cli + "device_worker_child/device_worker_child.exe",
        worker,
      ]).run()
      launch["worker_executable"] = { "path": worker, "sha256": sha(worker) }
      // Frozen model/kernel/policy roots retain their original canonical paths.
      // Only the diagnostic executable changes; no module bytes are rebuilt.
      @fs.write_file(launch_path, Json(launch).stringify() + "\n")
      capture(root, "preflight-c\{cap}", cli + "lunaflux/lunaflux.exe", [
        "validate-release",
        arm + "/deployment#sha256=" + sha(launch_path),
      ])
      let bridge = cli +
        "lunaflux_qwen3_token_id_bridge/lunaflux_qwen3_token_id_bridge.exe"
      capture(
        root,
        "capacity-c\{cap}",
        root + "/source/scripts/materialize-qwen3-authenticated-capacity.sh",
        [
          query +
          "/bind-target121-budget.stdout#sha256=" +
          sha(query + "/bind-target121-budget.stdout"),
          arm + "/deployment#sha256=" + sha(launch_path),
          cli +
          "lunaflux/lunaflux.exe#sha256=" +
          sha(cli + "lunaflux/lunaflux.exe"),
          bridge + "#sha256=" + sha(bridge),
          arm + "/capacity.json",
        ],
      )
      let prepared : Json = {
        "scope": "disposable logit/route diagnostics; not deployable or timing",
      }
      @fs.write_file(
        arm + "/PREPARED.json",
        prepared.stringify(),
        create_mode=CreateNew,
      )
    }
    @fs.write_file(
      root + "/SCOPE.txt",
      "diagnostic-only explicit synchronous readback; frozen AOT modules; no performance admission\n",
      create_mode=CreateNew,
    )
  } else {
    assert_true(@fs.exists(root + "/SCOPE.txt"))
    let bodies_path = root + "/replay-bodies.json"
    let bodies : Array[Json] = []
    for row in [0, 1] {
      bodies.push(
        @json.parse(
          @fs.read_file(
            query +
            "/e2e-0-c2048/r0-luna-full/requests/i32512-o64-c2-varied-t1-r\{row}.body.json",
          ).text(),
        ),
      )
    }
    @fs.write_file(bodies_path, Json(bodies).stringify(), create_mode=CreateNew)
    let original = @fs.read_file(frozen + "/measure/launcher.mbtx").text()
    let launcher = once(
      original,
      "let cmd = \"/home/wlc004s/lunaflux-domain-serving-v4-20261004.QmE9WZ7s/source/_build/native/release/build/cmd/\"",
      "let cmd = " + Json(cli).stringify(),
    )
    let launcher = once(
      launcher, "let orders = [[\"vllm\",\"luna-full\",\"sglang\"]]", "let orders = [[\"luna-full\"]]",
    )
    let launcher = once(
      launcher, "guard @fs.read_file(root + \"/runtime.stderr\").text().is_empty() else",
      "guard @fs.read_file(root + \"/runtime.stderr\").text().split(\"\\n\").all(line => line.is_empty() || line.has_prefix(\"lf_exec \")) else",
    )
    let launcher = once(
      launcher, "unprofiled timing, fresh starts, unchanged qualified worker/cubins; not current dirty-tree deployment",
      "diagnostic readback overhead; changed worker; unchanged AOT kernels; not timing or deployment",
    )
    let client = client(
      @fs.read_file(frozen + "/long_context_client.mbtx").text(),
      bodies_path,
    )
    for cap in [2048, 8192] {
      let output = root + "/replay-c\{cap}"
      @fs.mkdir(output)
      let script = output + "/launcher.mbtx"
      @fs.write_file(script, launcher, create_mode=CreateNew)
      @fs.write_file(script + ".client.mbtx", client, create_mode=CreateNew)
      capture(root, "replay-c\{cap}", moon, [
        "run",
        script,
        root + "/c\{cap}",
        output,
        script,
      ])
      capture(root, "margins-c\{cap}", moon, [
        "run",
        root + "/summarize_logit_margins.mbtx",
        output + "/r0-luna-full/runtime.stderr",
        output + "/margins.json",
      ])
    }
    @fs.write_file(
      root + "/RESULT.txt",
      "outcome=completed\nscope=diagnostic-chunk-numerics-not-performance\n",
      create_mode=CreateNew,
    )
  }
}

///|
test "client reads frozen bodies without embedding large literal ASTs" {
  let source = client(
    "helpers\n///|\nasync fn main { old }", "/saved/bodies.json",
  )
  assert_true(source.contains("@fs.read_file(\"/saved/bodies.json\")"))
  assert_false(source.contains("old"))
  assert_true(source.contains("request(root, engine, label, 64)"))
}
