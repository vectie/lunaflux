///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
fn field(text : String, key : String) -> String raise {
  guard text.split("\n").filter(x => x.has_prefix(key + "=")).to_array()
    is [line] else {
    fail("unique field " + key)
  }
  line[key.length() + 1:].to_owned()
}

///|
fn alternatives(kind : String) -> Array[(String, Int, Int)] raise {
  match kind {
    "schedule-v1" => [("kv128", 32004, 128), ("retain128", 70645, 64)]
    // Half/full invariant retention and joint RHS consumption are already
    // pure frontier alternatives; this driver measures, not invents, them.
    "query-lifetime-v1" =>
      [("retain64", 70644, 64), ("joint64", 80644, 64), ("joint128", 80645, 64)]
    "epoch-local-v1" => [("epochjoint", 130322, 64)]
    "value-readiness-v1" => [("valueoverlap", 30322, 64)]
    "unit-rescale-v1" => [("unitrescale", 30322, 64)]
    "page-batch-v1" => [("pagebatch", 30322, 64)]
    "page-lookahead-v1" => [("lookahead", 30322, 64)]
    "page-origin-v1" => [("pageorigin", 30322, 64)]
    _ => fail("unknown bounded experiment kind")
  }
}

///|
async fn selected_alternatives(root : String) -> Array[(String, Int, Int)] {
  alternatives(
    @fs.read_file(root + "/experiment-kind.txt").text().trim().to_owned(),
  )
}

///|
fn exporter_args(
  command : Array[String],
  query : String,
  root : String,
  label : String,
  candidate : Int,
) -> Array[String] raise {
  guard command.filter(x => x == "--prefill-candidate").length() == 1 &&
    !command.contains("--prefill-approximate-exp2") &&
    command.filter(x => x == query + "/candidate").length() == 1 else {
    fail("frozen strict exporter")
  }
  let args = command.copy()
  let i = args.search("--prefill-candidate").unwrap()
  guard i + 1 < args.length() && args[i + 1] == "322" else {
    fail("strict candidate identity")
  }
  args[i + 1] = candidate.to_string()
  args[args.search(query + "/candidate").unwrap()] = root + "/export-" + label
  args.push("--prefill-approximate-exp2")
  args
}

///|
async fn capture(
  root : String,
  label : String,
  program : String,
  args : Array[String],
) -> String {
  @fs.write_file(
    root + "/" + label + ".command.json",
    Json([program, ..args]).stringify(),
    create_mode=CreateNew,
  )
  let result = @shell.Cmd(program, args).output(max_output_bytes=33554432)
  @fs.write_file(
    root + "/" + label + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  result.stdout()
}

///|
async fn identity(root : String, label : String, path : String) -> String {
  capture(root, label, "sha256sum", [path]).split(" ").to_array()[0].to_owned()
}

///|
async fn write_contract(root : String, uuid : String) -> Unit {
  let choices = selected_alternatives(root)
  let workloads : Array[Json] = []
  let artifacts : Array[String] = [root + "/prefill.spec"]
  for name in ["baseline", ..choices.map(x => x.0)] {
    for file in ["kernel.cu", "kernel.recipe", "kernel.cubin"] {
      artifacts.push(root + "/" + name + "/" + file)
    }
  }
  for (name, _, _) in choices {
    for (rows, history) in [(1, 28672), (2, 28672), (2, 8192)] {
      workloads.push({
        "label": "\{name}-q2048-r\{rows}-h\{history}",
        "args": [
          root + "/prefill.spec",
          root + "/baseline",
          root + "/" + name,
          "2048",
          rows.to_string(),
          history.to_string(),
        ],
      })
    }
  }
  @fs.write_file(
    root + "/contract.json",
    (
      {
        "schema": "lunaflux-ako-trial-v1",
        "gpu_uuid": uuid,
        "reserve_kib": 33554432,
        "minimum_gain": 0.03,
        "program": root + "/probe",
        "artifacts": artifacts,
        "workloads": workloads,
      } : Json).stringify(indent=2),
    create_mode=CreateNew,
  )
}

///|
async fn main {
  if @env.args() is [_, "query", frozen_query, new_query, exporter] {
    guard exporter.has_prefix("/") && @fs.exists(exporter) else {
      fail("built exporter path")
    }
    guard @json.parse(
        @fs.read_file(frozen_query + "/export.command.json").text(),
      )
      is Array(values) else {
      fail("frozen command")
    }
    let raw = values.map(x => {
      guard x is String(v) else { fail("argument") }
      v
    })
    assert_eq(raw.filter(x => x == frozen_query + "/candidate").length(), 1)
    let command = raw.map(x => {
      if x == frozen_query + "/candidate" {
        new_query + "/candidate"
      } else {
        x
      }
    })
    command[0] = exporter
    @fs.mkdir(new_query)
    @fs.write_file(
      new_query + "/export.command.json",
      Json(command).stringify(),
      create_mode=CreateNew,
    )
    ignore(identity(new_query, "exporter", exporter))
    return
  }
  if @env.args() is [_, "contract", root, uuid] {
    write_contract(root, uuid)
    return
  }
  if @env.args() is [_, phase, root] &&
    (phase == "validate" || phase == "validate-long") {
    let long = phase == "validate-long"
    let out = root + (if long { "/validation-long" } else { "/validation" })
    @fs.mkdir(out)
    for (name, _, _) in selected_alternatives(root) {
      for
        tool in (if long {
          ["memcheck"]
        } else {
          ["memcheck", "racecheck", "synccheck"]
        }) {
        let result = capture(
          out,
          name + "-" + tool,
          "/usr/local/cuda-13.0/bin/compute-sanitizer",
          [
            "--tool",
            tool,
            "--error-exitcode",
            "99",
            root + "/probe",
            root + "/prefill.spec",
            root + "/baseline",
            root + "/" + name,
            if long {
              "2048"
            } else {
              "129"
            },
            "2",
            if long {
              "28672"
            } else {
              "128"
            },
            "--check-only",
          ],
        )
        assert_true(result.contains("correctness=passed"))
        assert_true(result.contains("0 errors") || result.contains("0 hazards"))
      }
    }
    @fs.write_file(
      out + "/RESULT.txt",
      "outcome=completed\nscope=" +
      (if long {
        "Q2048 R2 H28672 memory check"
      } else {
        "Q129 R2 H128 irregular-tail sanitizer"
      }) +
      "; not whole-model quality\n",
      create_mode=CreateNew,
    )
    return
  }
  if @env.args() is [_, "profile", root, name] {
    assert_true(selected_alternatives(root).any(x => x.0 == name))
    @fs.mkdir(root + "/profile-" + name)
    let out = root + "/profile-" + name
    let ncu = "/opt/nvidia/nsight-compute/2025.3.1/ncu"
    ignore(
      capture(out, "capture", ncu, [
        "--section",
        "InstructionStats",
        "--section",
        "SchedulerStats",
        "--section",
        "WarpStateStats",
        "--section",
        "LaunchStats",
        "--section",
        "SourceCounters",
        "--kernel-name",
        "regex:lunaflux_attention_prefill_tile_compiler_exp2_v1$",
        "--launch-count",
        "2",
        "--export",
        out + "/selected",
        root + "/probe",
        root + "/prefill.spec",
        root + "/baseline",
        root + "/" + name,
        "2048",
        "2",
        "28672",
        "--check-only",
      ]),
    )
    for page in ["raw", "source"] {
      ignore(
        capture(
          out,
          page,
          ncu,
          [
            "--import",
            out + "/selected.ncu-rep",
            "--csv",
            "--page",
            page,
            ..if page == "source" {
              ["--print-source", "sass"]
            } else {
              []
            },
          ],
        ),
      )
    }
    @fs.write_file(
      out + "/RESULT.txt",
      "outcome=completed\nscope=two matched instrumented launches; not serving timing\n",
      create_mode=CreateNew,
    )
    return
  }
  if @env.args() is [_, "finish", root] {
    assert_true(
      @fs.read_file(root + "/trial/RESULT.txt")
      .text()
      .has_prefix("outcome=completed\n"),
    )
    guard @json.parse(@fs.read_file(root + "/trial/summary.json").text())
      is Array(rows) &&
      rows.length() == selected_alternatives(root).length() * 3 else {
      fail("all bounded workload cells")
    }
    assert_true(
      capture(root, "terminal-idle", "nvidia-smi", [
        "--query-compute-apps=pid", "--format=csv,noheader",
      ])
      .trim()
      .is_empty(),
    )
    @fs.write_file(
      root + "/RESULT.txt",
      "outcome=completed\nscope=bounded existing attention schedules, three workloads, five pairs; no serving/quality admission\n",
      create_mode=CreateNew,
    )
    return
  }
  guard @env.args() is [_, "prepare", query, frozen, root, .. kind_args] else {
    fail(
      "prepare QUERY_ROOT FROZEN_EXP2_ROOT NEW_ROOT [query-lifetime-v1|epoch-local-v1|value-readiness-v1] | contract ROOT UUID | validate ROOT | profile ROOT NAME | finish ROOT",
    )
  }
  let kind = match kind_args {
    [] => "schedule-v1"
    [kind] if kind == "query-lifetime-v1" ||
      kind == "epoch-local-v1" ||
      kind == "value-readiness-v1" ||
      kind == "unit-rescale-v1" ||
      kind == "page-batch-v1" || kind == "page-lookahead-v1" || kind == "page-origin-v1" => kind
    _ => fail("bounded experiment arguments")
  }
  let choices = alternatives(kind)
  @fs.mkdir(root)
  @fs.write_file(
    root + "/experiment-kind.txt",
    kind + "\n",
    create_mode=CreateNew,
  )
  assert_true(
    capture(root, "idle", "nvidia-smi", [
      "--query-compute-apps=pid", "--format=csv,noheader",
    ])
    .trim()
    .is_empty(),
  )
  let (baseline, expected) = if kind == "page-lookahead-v1" || kind == "page-origin-v1" {
    (frozen + "/pagebatch", "7b42b3531466f5fe22c59e5aac2883db68984907c49a5637ac5f1358ad2eab57")
  } else {
    (frozen + "/approximate", "66881bc0055ce4c4340e6001e7746d0abd64a8b7f9a02b741e6b87463f0e2922")
  }
  assert_eq(identity(root, "baseline-cubin", baseline + "/kernel.cubin"), expected)
  assert_eq(
    identity(root, "nvcc", "/usr/local/cuda-13.0/bin/nvcc"),
    "fbb111f057786ddd10ba723d993cc7dd43abf978b6baa32fedd3c9d806dc79e1",
  )
  @fs.mkdir(root + "/baseline")
  for name in ["kernel.cu", "kernel.recipe", "kernel.cubin"] {
    @fs.write_file(
      root + "/baseline/" + name,
      @fs.read_file(baseline + "/" + name),
      create_mode=CreateNew,
    )
  }
  for name in ["probe", "prefill.spec"] {
    @shell.Cmd("cp", ["--update=none", frozen + "/" + name, root + "/" + name]).run()
  }
  guard @json.parse(@fs.read_file(query + "/export.command.json").text())
    is Array(values) else {
    fail("export command")
  }
  let command = values.map(x => {
    guard x is String(v) else { fail("argument") }
    v
  })
  ignore(identity(root, "exporter", command[0]))
  for (name, id, keys) in choices {
    ignore(
      capture(
        root,
        "export-" + name,
        command[0],
        exporter_args(command[1:].to_owned(), query, root, name, id),
      ),
    )
    @fs.mkdir(root + "/" + name)
    let output = root + "/" + name
    for file in ["kernel.cu", "kernel.recipe"] {
      @fs.write_file(
        output + "/" + file,
        @fs.read_file(
          root + "/export-" + name + "/reusable-qwen-prefill-attention/" + file,
        ),
        create_mode=CreateNew,
      )
    }
    let recipe = @fs.read_file(output + "/kernel.recipe").text()
    assert_eq(field(recipe, "candidate_stable_id"), id.to_string())
    assert_eq(field(recipe, "numeric_law"), "approx-base2-f32-v1")
    assert_eq(field(recipe, "query_tile_rows"), "64")
    assert_eq(field(recipe, "key_value_tile_rows"), keys.to_string())
    assert_eq(field(recipe, "pipeline_stages"), "1")
    assert_eq(
      identity(root, name + "-source", output + "/kernel.cu"),
      field(recipe, "source_sha256"),
    )
    for
      (tag, path) in [
        ("first", output + "/kernel.cubin"),
        ("second", output + "/second.cubin"),
      ] {
      ignore(
        capture(root, name + "-" + tag, "/usr/local/cuda-13.0/bin/nvcc", [
          "--cubin",
          "--std=c++14",
          "-arch=sm_121",
          "-O3",
          "--fmad=false",
          "--ftz=false",
          "--prec-div=true",
          "--prec-sqrt=true",
          "--maxrregcount=" + field(recipe, "max_registers"),
          "--Werror",
          "all-warnings",
          "-lineinfo",
          "-Xptxas=-v",
          output + "/kernel.cu",
          "-o",
          path,
        ]),
      )
    }
    assert_eq(
      identity(root, name + "-first-hash", output + "/kernel.cubin"),
      identity(root, name + "-second-hash", output + "/second.cubin"),
    )
  }
  write_contract(root, "GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6")
  println("prepared=" + root)
}

///|
test "schedule alternatives retain explicit approximation and independent identities" {
  assert_eq(alternatives("schedule-v1"), [
    ("kv128", 32004, 128),
    ("retain128", 70645, 64),
  ])
  assert_eq(alternatives("query-lifetime-v1"), [
    ("retain64", 70644, 64),
    ("joint64", 80644, 64),
    ("joint128", 80645, 64),
  ])
  assert_eq(alternatives("epoch-local-v1"), [("epochjoint", 130322, 64)])
  assert_eq(alternatives("value-readiness-v1"), [("valueoverlap", 30322, 64)])
  assert_eq(alternatives("page-lookahead-v1"), [("lookahead", 30322, 64)])
  assert_eq(alternatives("page-origin-v1"), [("pageorigin", 30322, 64)])
  let command = ["/home/q/candidate", "--prefill-candidate", "322"]
  for
    kind in [
      "schedule-v1", "query-lifetime-v1", "epoch-local-v1", "value-readiness-v1",
    ] {
    for (name, id, _) in alternatives(kind) {
      assert_eq(exporter_args(command, "/home/q", "/home/new", name, id), [
        "/home/new/export-" + name,
        "--prefill-candidate",
        id.to_string(),
        "--prefill-approximate-exp2",
      ])
    }
  }
  for
    bad in [
      ["--prefill-candidate", "30322"],
      [..command, "--prefill-approximate-exp2"],
      [..command, "--prefill-candidate", "322"],
    ] {
    try exporter_args(bad, "/home/q", "/home/new", "kv128", 32004) catch {
      _ => ()
    } noraise {
      _ => fail("ambiguous exporter")
    }
  }
}
