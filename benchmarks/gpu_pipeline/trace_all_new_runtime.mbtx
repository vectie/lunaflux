///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn capture(
  root : String,
  label : String,
  command : String,
  args : Array[String],
) -> Unit {
  let result = @shell.Cmd(command, args).output(max_output_bytes=16777216)
  @fs.write_file(
    root + "/" + label + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
}

///|
async fn main {
  if @env.args() is [_, root, "--verify-existing"] {
    verify_trace(root)
    return
  }
  guard @env.args() is [_, serving, root, .. options] &&
    (options.is_empty() || options is ["--selected"]) else {
    fail("COMPLETED_SERVING NEW_EMPTY_ROOT [--selected]")
  }
  let selected = options is ["--selected"]
  guard @fs.read_file(serving + "/RESULT.txt")
    .text()
    .has_prefix("outcome=completed\n") else {
    fail("finish unprofiled benchmark first")
  }
  let gpu = @shell.Cmd("nvidia-smi", [
    "--query-compute-apps=pid", "--format=csv,noheader",
  ]).output()
  gpu.check()
  guard gpu.stdout().trim().is_empty() else { fail("GPU occupied") }
  @shell.Cmd("ln", ["-s", serving + "/toolchain", root + "/toolchain"]).run()
  // The bridge validates canonical executable paths, including parent paths.
  @fs.mkdir(root + "/source")
  @shell.Cmd("cp", ["-a", serving + "/source/.", root + "/source/"]).run()
  for
    entry in [
      "deployment", "convert.stdout", "export.stdout", "toolchain.v1", "bind.stdout",
    ] {
    @shell.Cmd("cp", ["-a", serving + "/" + entry, root + "/" + entry]).run()
  }
  @fs.write_file(
    root + "/prepare-full.mbtx",
    @fs.read_file(serving + "/prepare-full.mbtx"),
    create_mode=CreateNew,
  )
  // Diagnostic-only parent: production intentionally strips injected profiler
  // environment at exec. Keep the deployed worker and every AOT cubin frozen;
  // rebuild only the launcher in this separate trace directory.
  let spawn_path = root + "/source/internal/process/process_approved_spawn.c"
  let original = @fs.read_file(spawn_path).text()
  let target = "fexecve(5, argv, sanitized_environment);"
  assert_eq(original.split(target).to_array().length(), 2)
  @fs.write_file(
    root + "/process_approved_spawn.original.c",
    original,
    create_mode=CreateNew,
  )
  @fs.write_file(
    spawn_path,
    original.replace(
      old=target,
      new="/* OFFLINE PROFILE ONLY: never deploy this launcher. */\n    extern char **environ;\n    (void)sanitized_environment;\n    fexecve(5, argv, environ);",
    ),
  )
  let moon = root + "/toolchain/bin/moon"
  let build = @shell.Cmd(
    moon,
    [
      "build", "cmd/lunaflux", "--target", "native", "--release", "--warn-list",
      "-79-20-29-25", "--diagnostic-limit", "5",
    ],
    cwd=root + "/source",
  ).output(max_output_bytes=16777216)
  @fs.write_file(
    root + "/diagnostic-build.stdout",
    build.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/diagnostic-build.stderr",
    build.stderr(),
    create_mode=CreateNew,
  )
  build.check()
  capture(root, "prepare-capacity", moon, [
    "run",
    root + "/prepare-full.mbtx",
    root,
    "capacity",
  ])
  capture(root, "worker-identities", "sha256sum", [
    serving + "/deployment/bin/lunaflux-device-worker",
    root + "/deployment/bin/lunaflux-device-worker",
  ])
  let hashes = @fs.read_file(root + "/worker-identities.stdout")
    .text()
    .split("\n")
    .filter(x => !x.is_empty())
    .map(x => x.split(" ").to_array()[0])
    .to_array()
  assert_eq(hashes.length(), 2)
  assert_eq(hashes[0], hashes[1])
  @fs.write_file(
    root + "/SCOPE.txt",
    "Isolated profiler-environment launcher; unchanged measured worker and AOT kernels. Not a timing benchmark or deployable runtime.\n",
    create_mode=CreateNew,
  )
  if selected {
    @fs.write_file(
      root + "/SELECTED_MODE.txt",
      "retained measured families\n",
      create_mode=CreateNew,
    )
  }
  let client = @fs.read_file(serving + "/benchmark.mbtx")
    .text()
    .replace(old="[(128,32),(4096,64),(4096,256)]", new="[(4096,4)]")
    .replace(old="[1,8,16]", new="[1,16]")
    .replace(old="0..<4", new="0..<1")
  @fs.write_file(root + "/client.mbtx", client, create_mode=CreateNew)
  let unit = "lunaflux-allnew-trace-" +
    root.split("/").to_array().last().unwrap().to_owned()
  let units = [unit + "-bridge.service", unit + "-serve.service"]
  errdefer ignore(@shell.Cmd("systemctl", ["--user", "stop"] + units).output())
  @shell.Cmd("systemd-run", [
    "--user",
    "--unit=" + unit + "-serve",
    "--property=MemoryMax=64G",
    "--property=MemorySwapMax=0",
    "--property=RuntimeMaxSec=600",
    "/usr/local/bin/nsys",
    "profile",
    "--trace=cuda",
    "--sample=none",
    "--cpuctxsw=none",
    "--cuda-graph-trace=node",
    "--trace-fork-before-exec=true",
    "--wait=all",
    "-o",
    root + "/trace",
    moon,
    "run",
    root + "/prepare-full.mbtx",
    root,
    "serve",
  ]).run()
  @shell.Cmd("systemd-run", [
    "--user",
    "--unit=" + unit + "-bridge",
    "--property=MemoryMax=64G",
    "--property=MemorySwapMax=0",
    "--property=RuntimeMaxSec=600",
    moon,
    "run",
    root + "/prepare-full.mbtx",
    root,
    "bridge",
  ]).run()
  let mut ready = false
  for _ in 0..<180 {
    for service in units {
      let state = @shell.Cmd("systemctl", ["--user", "is-failed", service]).output()
      guard state.stdout().trim() != "failed" else {
        fail(
          "trace unit failed before readiness; inspect its user journal: " +
          service,
        )
      }
    }
    let result = @shell.Cmd("ss", ["-ltnH", "sport", "=", ":5061"]).output()
    let bridge = @shell.Cmd("ss", ["-ltnH", "sport", "=", ":5062"]).output()
    if result.exit_code() == 0 &&
      !result.stdout().trim().is_empty() &&
      bridge.exit_code() == 0 &&
      !bridge.stdout().trim().is_empty() {
      ready = true
      break
    }
    @async.sleep(1000)
  }
  guard ready else { fail("trace runtime readiness") }
  capture(root, "client", moon, [
    "run",
    root + "/client.mbtx",
    "luna-full",
    root + "/requests",
  ])
  capture(root, "drain", moon, [
    "run",
    root + "/prepare-full.mbtx",
    root,
    "drain",
  ])
  @shell.Cmd("systemctl", ["--user", "stop", unit + "-bridge.service"]).run()
  let mut finished = false
  for _ in 0..<120 {
    let state = @shell.Cmd("systemctl", [
      "--user",
      "is-active",
      unit + "-serve.service",
    ]).output()
    if state.stdout().trim() != "active" && @fs.exists(root + "/trace.nsys-rep") {
      finished = true
      break
    }
    @async.sleep(1000)
  }
  guard finished else { fail("trace did not finish") }
  verify_trace(root)
}

///|
async fn verify_trace(root : String) -> Unit {
  let supervisor = @fs.read_file(root + "/supervisor.stdout").text()
  for field in ["drain_acknowledged=1", "child_exit_code=0", "child_closed=1"] {
    guard supervisor.contains(field) else { fail("trace missing " + field) }
  }
  guard @fs.read_file(root + "/runtime.stderr").text().is_empty() else {
    fail("trace runtime stderr")
  }
  if !@fs.exists(root + "/trace.sqlite") {
    capture(root, "nsight-export", "/usr/local/bin/nsys", [
      "export",
      "--type=sqlite",
      "--output=" + root + "/trace.sqlite",
      root + "/trace.nsys-rep",
    ])
  }
  capture(root, "selected-kernels", "sqlite3", [
    "-header",
    "-csv",
    root + "/trace.sqlite",
    "SELECT s.value AS kernel,k.gridX,k.gridY,k.blockX,count(*) AS calls,round(sum(k.end-k.start)/1e6,3) AS total_ms FROM CUPTI_ACTIVITY_KIND_KERNEL k JOIN StringIds s ON s.id=k.demangledName GROUP BY kernel,k.gridX,k.gridY,k.blockX ORDER BY total_ms DESC;",
  ])
  let kernels = @fs.read_file(root + "/selected-kernels.stdout").text()
  let selected = @fs.exists(root + "/SELECTED_MODE.txt")
  guard kernels.contains(
      if selected {
        "lunaflux_attention_decode_tile_compiler_v1"
      } else {
        "lunaflux_attention_decode_tile_compiler_v1_blockwise_f32_v1"
      },
    ) &&
    kernels.contains(
      "lunaflux_fused_qwen_qkv_qknorm_rope_kvwrite_bf16_head128_production_v2",
    ) else {
    fail("new kernel absent from actual serving launches")
  }
  guard kernels.contains("lunaflux_attention_prefill_tile_compiler_v1") else {
    fail("selected prefill kernel absent from serving launches")
  }
  for line in kernels.split("\n") {
    if selected {
      continue
    }
    if line.contains(
        "lunaflux_fused_qwen_qkv_qknorm_rope_kvwrite_bf16_head128_production_v2",
      ) {
      guard line.split(",").to_array() is [_, _, "16", _, _, _] else {
        fail("serving ingress did not retain two-head grid ownership")
      }
    }
    if line.contains("lunaflux_attention_decode_tile_compiler_v1") &&
      !line.contains(
        "lunaflux_attention_decode_tile_compiler_v1_blockwise_f32_v1",
      ) {
      fail("old decode path was launched in the all-new capture")
    }
  }
  @fs.write_file(
    root + "/RESULT.txt",
    "outcome=completed\nscope=profiled-selection-not-latency-benchmark\n",
    create_mode=CreateNew,
  )
  println(kernels)
}
