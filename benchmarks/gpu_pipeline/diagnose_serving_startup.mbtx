///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  guard @env.args() is [_, serving, root] else { fail("ISOLATED_SERVING NEW_EMPTY_ROOT") }
  let launch = serving + "/deployment/lunaflux.launch.json"
  let hash = @shell.Cmd("sha256sum", [launch]).output()
  hash.check()
  let cli = serving + "/source/_build/native/release/build/"
  let args = ["--batch", "-ex", "set pagination off", "-ex", "set detach-on-fork off", "-ex", "set schedule-multiple on", "-ex", "run", "-ex", "info inferiors", "-ex", "thread apply all bt", "--args", cli + "tests/qwen3_bf16_serving_supervisor/qwen3_bf16_serving_supervisor.exe", cli + "cmd/lunaflux/lunaflux.exe", serving + "/deployment#sha256=" + hash.stdout().split(" ").to_array()[0].to_owned(), root + "/runtime.stdout", root + "/runtime.stderr", root + "/drain-trigger"]
  @fs.write_file(root + "/command.json", Json(["gdb", ..args]).stringify(), create_mode=CreateNew)
  let out = @shell.Cmd("gdb", args).output(max_output_bytes=16777216)
  @fs.write_file(root + "/gdb.stdout", out.stdout(), create_mode=CreateNew)
  @fs.write_file(root + "/gdb.stderr", out.stderr(), create_mode=CreateNew)
  @fs.write_file(root + "/gdb.exit", out.exit_code().to_string(), create_mode=CreateNew)
  out.check()
}
