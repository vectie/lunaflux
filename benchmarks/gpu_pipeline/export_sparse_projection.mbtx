import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

async fn main {
  guard @env.args() is [_, destination] else { fail("NEW_HEADER") }
  let result = @shell.Cmd("env", ["LUNA_EXPORT_SPARSE_PROJECTION=1", "moon",
    "test", "--target", "native", "kernels/indexed_sparse_projection_cuda_source",
    "--diagnostic-limit", "2"]).output(max_output_bytes=1048576)
  result.check()
  let pieces = result.stdout().split("LUNA_SOURCE_BEGIN projection\n").to_array()
  guard pieces.length() == 2 else { fail("missing projection source") }
  let bodies = pieces[1].split("LUNA_SOURCE_END").to_array()
  guard bodies.length() == 2 else { fail("invalid projection source") }
  @fs.write_file(destination, bodies[0], create_mode=CreateNew)
  println("exported hidden-to-sparse projection and retained attention chain")
}
