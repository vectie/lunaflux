@@ -5,18 +5,33 @@
 pub struct MatrixFragmentPipeline {
   priv matrix : MatrixTilePlan
   priv row_tile : Int
+  priv transfer : FragmentOperandTransfer
 }

+///|
+/// Transfer ownership is distinct from the ascending arithmetic fold. A
+/// rectangular producer publishes one operand epoch to all matrix consumers.
+pub(all) enum FragmentOperandTransfer {
+  LaneVectors
+  Rectangular(leader_wait~ : Bool)
+} derive(Eq, Debug)
+
 ///|
 pub fn MatrixFragmentPipeline::new(
   matrix : MatrixTilePlan,
   row_tile~ : Int,
+  transfer? : FragmentOperandTransfer = LaneVectors,
 ) -> Self raise @precision.PrecisionPlanError {
   let (_, _, inner) = matrix.geometry()
   guard row_tile is (32 | 64) && inner % 64 == 0 else {
     raise @precision.PrecisionPlanError::NoImplementation
   }
-  { matrix, row_tile, }
+  { matrix, row_tile, transfer }
+}
+
+///|
+pub fn MatrixFragmentPipeline::transfer(self : Self) -> FragmentOperandTransfer {
+  self.transfer
 }

