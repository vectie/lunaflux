+++ b/compiler/grouped_matrix_ir/fragment_pipeline_test.mbt
@@ -1,3 +1,17 @@
+///|
+test "rectangular epoch keeps arithmetic ownership independent of waiter" {
+  let matrix = @grouped_matrix_ir.MatrixTilePlan::new(rows=64, columns=4096, inner=8192, law=ShapeAwareFloat32)
+  for leader_wait in [true,false] {
+    let plan = @grouped_matrix_ir.MatrixFragmentPipeline::new(matrix, row_tile=32, transfer=Rectangular(leader_wait~))
+    assert_eq(plan.matrix().geometry(), matrix.geometry())
+    assert_eq(plan.matrix().law(), matrix.law())
+    assert_eq(plan.tile(), (32,64,64))
+    assert_eq(plan.operand_slots(), 2)
+    assert_eq(plan.shared_bytes(),24576)
+    assert_eq(plan.transfer(), Rectangular(leader_wait~))
+  }
+}
