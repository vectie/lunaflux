diff --git a/compiler/grouped_matrix_ir/fragment_pipeline_test.mbt b/compiler/grouped_matrix_ir/fragment_pipeline_test.mbt
index a3baaa7f..df7fadfe 100644
--- a/compiler/grouped_matrix_ir/fragment_pipeline_test.mbt
+++ b/compiler/grouped_matrix_ir/fragment_pipeline_test.mbt
@@ -73,3 +73,37 @@ test "fragment envelope preserves unrelated shapes and arithmetic" {
     }
   }
 }
+
+///|
+test "wide fragment columns share operands without splitting reductions" {
+  let matrix = @grouped_matrix_ir.MatrixTilePlan::new(
+    rows=64,
+    columns=4096,
+    inner=8192,
+    law=ShapeAwareFloat32,
+  )
+  for row_tile in [32, 64] {
+    let p = @grouped_matrix_ir.MatrixFragmentPipeline::new(
+      matrix,
+      row_tile~,
+      column_tile=128,
+    )
+    assert_eq(p.matrix().law(), ShapeAwareFloat32)
+    assert_eq(p.matrix().geometry(), matrix.geometry())
+    assert_eq(p.tile(), (row_tile, 128, 64))
+    assert_eq(p.tile_count(), 1024)
+    assert_eq(p.shared_bytes(), 2 * (row_tile + 128) * 128)
+    assert_eq(p.fragment_slots(), 2)
+  }
+  try
+    @grouped_matrix_ir.MatrixFragmentPipeline::new(
+      matrix,
+      row_tile=32,
+      column_tile=96,
+    )
+  catch {
+    _ => ()
+  } noraise {
+    _ => fail("unsupported fragment columns accepted")
+  }
+}
