+++ b/compiler/grouped_matrix_ir/fragment_pipeline_test.mbt
@@ -1,3 +1,25 @@
+///|
+test "wider ownership budgets transport independently of ascending reduction" {
+  let matrix = @grouped_matrix_ir.MatrixTilePlan::new(rows=64, columns=4096, inner=8192, law=ShapeAwareFloat32)
+  for (m,n,k,shared) in [(32,64,64,24576), (32,128,32,20480), (64,128,32,24576)] {
+    let plan = @grouped_matrix_ir.MatrixFragmentPipeline::new(matrix, row_tile=m, column_tile=n, inner_tile=k)
+    assert_eq(plan.tile(), (m,n,k))
+    assert_eq(plan.shared_bytes(), shared)
+    assert_eq(plan.tile_count(),1024)
+    assert_eq(plan.matrix().law(),ShapeAwareFloat32)
+    for extent in [m,n] {
+      let seen = Array::make(extent*k*2,false)
+      for byte in 0..<(extent*k*2) {
+        let physical = plan.operand_byte_offset(byte)
+        assert_true(physical < extent*k*2)
+        assert_false(seen[physical])
+        seen[physical] = true
+      }
+      assert_true(seen.all(x => x))
+    }
+  }
+}
