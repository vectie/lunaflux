--- /dev/null
+++ b/tests/packed_moe_execution/partitioned_projection_probe.cu
@@ -0,0 +1,72 @@
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include "prefill.cuh"
+static void ck(cudaError_t s){if(s!=cudaSuccess){fprintf(stderr,"%s\n",cudaGetErrorString(s));exit(2);}}
+template<class T>T*allocate(size_t n){T*p;ck(cudaMalloc(&p,n*sizeof(T)));return p;}
+int main(int argc,char**argv){
+ if(argc!=5)return 2;
+ const int shape=atoi(argv[1]),rows=atoi(argv[2]),candidate=atoi(argv[3]);
+ const bool profile=!strcmp(argv[4],"profile"),sanitize=!strcmp(argv[4],"sanitize");
+ if(shape<0||shape>=int(sizeof(widths)/sizeof(widths[0]))||rows<0||rows>65||candidate<0||candidate>1)return 2;
+ const int n=widths[shape],k=inners[shape],base_grid=std::max((n+3)/4,4*((n+63)/64));
+ auto counts=allocate<int>(4);auto x=allocate<__nv_bfloat16>(64*k),w=allocate<__nv_bfloat16>(size_t(n)*k);
+ auto y=allocate<float>(64*n),partials=allocate<float>(size_t(8)*64*n);
+ auto map_a=allocate<CUtensorMap>(1),map_b=allocate<CUtensorMap>(1);
+ std::vector<__nv_bfloat16> hx(64*k),hw(size_t(n)*k);unsigned seed=713;
+ for(auto*v:{&hx,&hw})for(auto&e:*v){seed=1664525u*seed+1013904223u;e=__float2bfloat16_rn(float(int(seed>>16)-32768)*.000001f);}
+ int c[]={0,1,1,rows};ck(cudaMemcpy(counts,c,sizeof(c),cudaMemcpyHostToDevice));
+ ck(cudaMemcpy(x,hx.data(),hx.size()*2,cudaMemcpyHostToDevice));ck(cudaMemcpy(w,hw.data(),hw.size()*2,cudaMemcpyHostToDevice));
+ auto map=[&](void*data,int outer,int tile_rows,CUtensorMap*target){
+  alignas(64)CUtensorMap descriptor;cuuint64_t dims[]={cuuint64_t(k),cuuint64_t(outer)},strides[]={cuuint64_t(k)*2};
+  cuuint32_t box[]={64,cuuint32_t(tile_rows)},element[]={1,1};
+  auto status=cuTensorMapEncodeTiled(&descriptor,CU_TENSOR_MAP_DATA_TYPE_BFLOAT16,2,data,dims,strides,box,element,CU_TENSOR_MAP_INTERLEAVE_NONE,CU_TENSOR_MAP_SWIZZLE_NONE,CU_TENSOR_MAP_L2_PROMOTION_NONE,CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+  if(status!=CUDA_SUCCESS){fprintf(stderr,"tensor map %d\n",int(status));exit(6);}
+  ck(cudaMemcpy(target,&descriptor,sizeof(descriptor),cudaMemcpyHostToDevice));
+ };
+ map(x,64,64,map_a);map(w,n,128,map_b);
+ ck(cudaFuncSetAttribute(functions[shape][1],cudaFuncAttributeMaxDynamicSharedMemorySize,98304));
+ void*base_args[]={&counts,&x,&w,&y};
+ void*part_args[]={&counts,&x,&w,&partials,&map_a,&map_b};
+ void*reduce_args[]={&counts,&partials,&y};
+ auto launch=[&](int v,cudaStream_t stream=0){
+  if(v==0)ck(cudaLaunchKernel(functions[shape][0],base_grid,128,base_args,0,stream));
+  else{
+   ck(cudaLaunchKernel(functions[shape][1],8*((n+127)/128),128,part_args,98304,stream));
+   ck(cudaLaunchKernel(functions[shape][2],(64*n+255)/256,256,reduce_args,0,stream));
+  }
+ };
+ if(profile){launch(candidate);ck(cudaDeviceSynchronize());}
+ else{
+  std::vector<float>a(64*n),b(64*n);ck(cudaMemset(y,0x55,a.size()*4));launch(0);ck(cudaMemcpy(a.data(),y,a.size()*4,cudaMemcpyDeviceToHost));
+  ck(cudaMemset(y,0x55,b.size()*4));launch(1);ck(cudaMemcpy(b.data(),y,b.size()*4,cudaMemcpyDeviceToHost));
+  double delta=0,oracle=0;size_t bf16_diff=0;
+  for(size_t i=0;i<a.size();++i){
+   bool active=rows>0&&rows<=64&&i<size_t(rows)*n;
+   if(!active){if(memcmp(&a[i],&b[i],4)){fprintf(stderr,"inactive mismatch index=%zu baseline=%.12g candidate=%.12g\n",i,a[i],b[i]);return 4;}continue;}
+   double d=std::abs(double(a[i])-b[i]);if(!std::isfinite(d)){fprintf(stderr,"nonfinite index=%zu baseline=%.12g candidate=%.12g\n",i,a[i],b[i]);return 4;}delta=std::max(delta,d);
+   auto av=__float2bfloat16_rn(a[i]),bv=__float2bfloat16_rn(b[i]);bf16_diff+=memcmp(&av,&bv,2)!=0;
+  }
+  if(delta>0.000001){fprintf(stderr,"arithmetic mismatch maxabs=%.12g bf16_differences=%zu\n",delta,bf16_diff);return 4;} // Predeclared F32 arithmetic check, not a model-quality waiver.
+  if(rows>0&&rows<=64)for(int r:{0,rows-1})for(int col:{0,n/2,n-1}){
+   double sum=0;for(int j=0;j<k;++j)sum+=double(__bfloat162float(hx[r*k+j]))*__bfloat162float(hw[size_t(col)*k+j]);
+   oracle=std::max(oracle,std::abs(double(b[r*n+col])-sum));
+  }
+  if(!(oracle<=0.003))return 5;
+  printf("correctness=passed shape=%d rows=%d candidate=%d maxabs=%.12g bf16_differences=%zu oracle_maxabs=%.12g numerical_law=contiguous8_f32_sum\n",shape,rows,candidate,delta,bf16_diff,oracle);
+  if(!sanitize&&rows>0&&rows<=64){
+   cudaStream_t stream;ck(cudaStreamCreate(&stream));cudaGraph_t graphs[2];cudaGraphExec_t executions[2];
+   for(int v=0;v<2;++v){ck(cudaStreamBeginCapture(stream,cudaStreamCaptureModeGlobal));for(int i=0;i<20;++i)launch(v,stream);ck(cudaStreamEndCapture(stream,&graphs[v]));ck(cudaGraphInstantiate(&executions[v],graphs[v],nullptr,nullptr,0));ck(cudaGraphLaunch(executions[v],stream));}
+   ck(cudaStreamSynchronize(stream));cudaEvent_t start,end;ck(cudaEventCreate(&start));ck(cudaEventCreate(&end));
+   for(int trial=0;trial<5;++trial){float times[2];for(int order=0;order<2;++order){int v=trial%2?1-order:order;ck(cudaEventRecord(start,stream));ck(cudaGraphLaunch(executions[v],stream));ck(cudaEventRecord(end,stream));ck(cudaEventSynchronize(end));float ms;ck(cudaEventElapsedTime(&ms,start,end));times[v]=ms*50.f;}printf("tokens=%d rows=%d trial=%d old_us=%.9g new_us=%.9g bitwise=%s maxabs=%.12g oracle_maxabs=%.12g\n",rows,rows,trial,times[0],times[1],delta==0?"true":"false",delta,oracle);}
+   ck(cudaEventDestroy(start));ck(cudaEventDestroy(end));for(int i=0;i<2;++i){ck(cudaGraphExecDestroy(executions[i]));ck(cudaGraphDestroy(graphs[i]));}ck(cudaStreamDestroy(stream));
+  }
+ }
+ for(void*p:{(void*)counts,(void*)x,(void*)w,(void*)y,(void*)partials,(void*)map_a,(void*)map_b})ck(cudaFree(p));
+ ck(cudaDeviceReset());puts("released=true");
+}
