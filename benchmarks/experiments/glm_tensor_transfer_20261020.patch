+++ b/kernels/tiled_matrix_cuda_source/partitioned_rectangular_test.mbt
@@ -0,0 +1,43 @@
+///|
+test "partitioned rectangular plan has explicit numerical and scratch ownership" {
+  let tile = @matrix.MatrixTilePlan::new(
+    rows=64, columns=4096, inner=8192, law=MatrixFloat32,
+    tile_rows=64, tile_columns=128, staging=RectangularBuffered(inner_tile=64),
+  )
+  let plan = @matrix.PartitionedMatrixPlan::new(
+    tile, law=ContiguousFloat32(partitions=8), stages=4,
+  )
+  assert_eq(plan.tile_count(), 256)
+  assert_eq(plan.partial_bytes(), 8388608L)
+  let text = @utf8.decode(@tiled_matrix_cuda_source.partitioned_rectangular_source(plan,symbol="partitioned"))
+  assert_true(text.contains("accumulators[8]"))
+  assert_true(text.contains("epoch%4"))
+  assert_true(text.contains("sum=__fadd_rn"))
+  assert_true(text.contains("All pending publications and readers have retired"))
+  try @matrix.PartitionedMatrixPlan::new(tile,law=ContiguousFloat32(partitions=3),stages=4) catch {
+    _ => ()
+  } noraise { _ => fail("unaligned partition accepted") }
+}
+
+///|
+test "export partitioned rectangular candidate" {
+  if @env.get_env_var("LUNA_EXPORT_PARTITIONED_RECTANGULAR") != Some("1") { return }
+  let shapes=[(4096,4096),(4096,8192),(8192,1536),(4096,1536),(65,512)]
+  println("LUNA_SOURCE_BEGIN prefill")
+  for i,(columns,inner) in shapes {
+    let baseline=@matrix.MatrixTilePlan::new(
+      rows=64,columns~,inner~,law=ShapeAwareFloat32,tile_rows=32,tile_columns=32,
+      staging=SynchronousTiles(inner_tile=if inner>=8192 {64} else {32}),
+    )
+    let matrix=@matrix.MatrixTilePlan::new(
+      rows=64,columns~,inner~,law=MatrixFloat32,tile_rows=64,tile_columns=128,
+      staging=RectangularBuffered(inner_tile=64),
+    )
+    let plan=@matrix.PartitionedMatrixPlan::new(matrix,law=ContiguousFloat32(partitions=8),stages=4)
+    println(@utf8.decode(@tiled_matrix_cuda_source.dense_source(baseline,symbol="p\{i}_base",partial_float32=true)))
+    println(@utf8.decode(@tiled_matrix_cuda_source.partitioned_rectangular_source(plan,symbol="p\{i}_parts",partial_float32=true)))
+  }
+  println("static void *functions[][3]={\{[for i in 0..<shapes.length() => "{(void*)p\{i}_base,(void*)p\{i}_parts,(void*)p\{i}_parts_reduce}"].join(",")}};")
+  println("static const int widths[]={\{shapes.map(s=>s.0.to_string()).join(",")}},inners[]={\{shapes.map(s=>s.1.to_string()).join(",")}};")
+  println("LUNA_SOURCE_END")
+}
