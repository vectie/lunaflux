diff --git a/compiler/grouped_matrix_ir/partitioned.mbt b/compiler/grouped_matrix_ir/partitioned.mbt
new file mode 100644
--- /dev/null
+++ b/compiler/grouped_matrix_ir/partitioned.mbt
@@ -0,0 +1,51 @@
+///|
+/// Immutable matrix/partial-publication plan. Backends own descriptor layout,
+/// synchronization instructions and actual launch topology.
+pub struct PartitionedMatrixPlan {
+  priv matrix : MatrixTilePlan
+  priv law : @precision.MatrixPartitionLaw
+  priv stages : Int
+}
+
+///|
+pub fn PartitionedMatrixPlan::new(
+  matrix : MatrixTilePlan,
+  law~ : @precision.MatrixPartitionLaw,
+  stages~ : Int,
+) -> Self raise @precision.PrecisionPlanError {
+  let (rows, columns, inner) = matrix.geometry()
+  let (_, _, tile_inner) = matrix.tile()
+  let ContiguousFloat32(partitions~) = law
+  guard partitions > 1 && partitions <= 32 && stages is (2 | 3 | 4) &&
+    matrix.staging() is RectangularBuffered(_) &&
+    inner % (partitions * tile_inner) == 0 &&
+    rows.to_int64() * columns.to_int64() * partitions.to_int64() <= 536870911L else {
+    raise @precision.PrecisionPlanError::NoImplementation
+  }
+  { matrix, law, stages }
+}
+
+///|
+pub fn PartitionedMatrixPlan::matrix(self : Self) -> MatrixTilePlan { self.matrix }
+
+///|
+pub fn PartitionedMatrixPlan::partitions(self : Self) -> Int {
+  let ContiguousFloat32(partitions~) = self.law
+  partitions
+}
+
+///|
+pub fn PartitionedMatrixPlan::stages(self : Self) -> Int { self.stages }
+
+///|
+pub fn PartitionedMatrixPlan::partial_bytes(self : Self) -> Int64 {
+  let (rows, columns, _) = self.matrix.geometry()
+  rows.to_int64() * columns.to_int64() * self.partitions().to_int64() * 4L
+}
+
+///|
+pub fn PartitionedMatrixPlan::tile_count(self : Self) -> Int {
+  let (rows, columns, _) = self.matrix.geometry()
+  let (m, n, _) = self.matrix.tile()
+  (rows + m - 1) / m * ((columns + n - 1) / n) * self.partitions()
+}
diff --git a/compiler/precision_ir/matrix_partition.mbt b/compiler/precision_ir/matrix_partition.mbt
new file mode 100644
--- /dev/null
+++ b/compiler/precision_ir/matrix_partition.mbt
@@ -0,0 +1,13 @@
+///|
+/// Explicit alternate numerical program: independent contiguous matrix
+/// partials, followed by ascending-partition F32 additions and one final
+/// publication round. This is not an equality rewrite of an unsplit fold.
+pub(all) enum MatrixPartitionLaw {
+  ContiguousFloat32(partitions~ : Int)
+} derive(Debug, Eq)
+
+///|
+pub extend MatrixPartitionLaw with Eq::{equal, not_equal}
+
+///|
+pub extend MatrixPartitionLaw with @debug.Debug::{to_repr}
diff --git a/kernels/tiled_matrix_cuda_source/rectangular.mbt b/kernels/tiled_matrix_cuda_source/rectangular.mbt
new file mode 100644
--- /dev/null
+++ b/kernels/tiled_matrix_cuda_source/rectangular.mbt
@@ -0,0 +1,89 @@
+///|
+/// Private NVIDIA realization of rectangular publication epochs. Descriptor
+/// storage is prepared once from the immutable extents and fixed device
+/// bindings. The ordinary four-pointer ABI cannot call this entry.
+pub fn rectangular_dense_source(
+  plan : @matrix.MatrixTilePlan,
+  symbol~ : String,
+  partial_float32? : Bool = false,
+) -> Bytes raise @precision.PrecisionPlanError {
+  let (rows, columns, inner) = plan.geometry()
+  let (m, n, k) = plan.tile()
+  guard plan.staging() is RectangularBuffered(_) &&
+    ((m, n) is ((16, 64) | (32, 32))) else {
+    raise @precision.PrecisionPlanError::NoImplementation
+  }
+  let blocks_n = (columns + n - 1) / n
+  let a_offset = "(warp/\{n/16})*16*\{k}+kk"
+  let b_offset = "(warp%\{n/16})*16*\{k}+kk"
+  let c_offset = "(warp/\{n/16})*16*\{n}+(warp%\{n/16})*16"
+  let output_type = if partial_float32 { "float" } else { "__nv_bfloat16" }
+  let publication = if partial_float32 { "result[i]" } else { "__float2bfloat16_rn(result[i])" }
+  let decode = if plan.law() == ShapeAwareFloat32 {
+    let body = shape_decode_body(
+      inner~, columns~, maximum_rows=rows,
+      tile_id="blockIdx.x", tile_count="gridDim.x",
+      left="__bfloat162float(input[inner])",
+      right="__bfloat162float(weight[(unsigned long long)column*\{inner}+inner])",
+      publish="output[column]=\{if partial_float32 { "value" } else { "__float2bfloat16_rn(value)" }};",
+    )
+    "if(live_rows==1) { \{body}\n return; }"
+  } else { "" }
+  @utf8.encode((
+    $|#include <cuda.h>
+    $|#include <cuda_bf16.h>
+    $|#include <mma.h>
+    $|extern "C" __global__ void \{symbol}(const int *counts,const __nv_bfloat16 *input,const __nv_bfloat16 *weight,\{output_type} *output,const CUtensorMap *map_a,const CUtensorMap *map_b) {
+    $|  const int live_rows=counts[3]; if(live_rows<=0||live_rows>\{rows}) return;
+    $|  \{decode}
+    $|  const int row_base=(blockIdx.x/\{blocks_n})*\{m},column_base=(blockIdx.x%\{blocks_n})*\{n};
+    $|  if(row_base>=live_rows) return;
+    $|  __shared__ __align__(128) __nv_bfloat16 tile_a[\{2*m*k}],tile_b[\{2*n*k}];
+    $|  __shared__ __align__(32) float result[\{m*n}];
+    $|  __shared__ __align__(8) unsigned long long ready[2];
+    $|  const unsigned int bar0=__cvta_generic_to_shared(ready),bar1=__cvta_generic_to_shared(ready+1);
+    $|  if(threadIdx.x==0) {
+    $|    asm volatile("mbarrier.init.shared.b64 [%0], 1;" :: "r"(bar0) : "memory");
+    $|    asm volatile("mbarrier.init.shared.b64 [%0], 1;" :: "r"(bar1) : "memory");
+    $|    asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+    $|  }
+    $|  __syncthreads();
+    $|  if(threadIdx.x==0) {
+    $|    const unsigned int a=__cvta_generic_to_shared(tile_a),b=__cvta_generic_to_shared(tile_b);
+    $|    asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;" :: "r"(bar0),"r"(\{2*(m+n)*k}) : "memory");
+    $|    asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2,%3}], [%4];" :: "r"(a),"l"(map_a),"r"(0),"r"(row_base),"r"(bar0) : "memory");
+    $|    asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2,%3}], [%4];" :: "r"(b),"l"(map_b),"r"(0),"r"(column_base),"r"(bar0) : "memory");
+    $|  }
+    $|  const int warp=threadIdx.x/32;
+    $|  nvcuda::wmma::fragment<nvcuda::wmma::accumulator,16,16,16,float> accumulator;
+    $|  nvcuda::wmma::fill_fragment(accumulator,0.0f);
+    $|  for(int base_k=0,epoch=0;base_k<\{inner};base_k+=\{k},++epoch) {
+    $|    const int slot=epoch&1; const unsigned int bar=slot?bar1:bar0,parity=(epoch/2)&1;
+    $|    asm volatile("{ .reg .pred done; WAIT: mbarrier.try_wait.parity.shared::cta.b64 done, [%0], %1; @!done bra WAIT; }" :: "r"(bar),"r"(parity) : "memory");
+    $|    if(threadIdx.x==0 && base_k+\{k}<\{inner}) {
+    $|      const int next=slot^1,coordinate=base_k+\{k}; const unsigned int nb=next?bar1:bar0;
+    $|      const unsigned int a=__cvta_generic_to_shared(tile_a+next*\{m*k}),b=__cvta_generic_to_shared(tile_b+next*\{n*k});
+    $|      asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;" :: "r"(nb),"r"(\{2*(m+n)*k}) : "memory");
+    $|      asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2,%3}], [%4];" :: "r"(a),"l"(map_a),"r"(coordinate),"r"(row_base),"r"(nb) : "memory");
+    $|      asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2,%3}], [%4];" :: "r"(b),"l"(map_b),"r"(coordinate),"r"(column_base),"r"(nb) : "memory");
+    $|    }
+    $|    #pragma unroll
+    $|    for(int kk=0;kk<\{k};kk+=16) {
+    $|      nvcuda::wmma::fragment<nvcuda::wmma::matrix_a,16,16,16,__nv_bfloat16,nvcuda::wmma::row_major> a;
+    $|      nvcuda::wmma::fragment<nvcuda::wmma::matrix_b,16,16,16,__nv_bfloat16,nvcuda::wmma::col_major> b;
+    $|      nvcuda::wmma::load_matrix_sync(a,tile_a+slot*\{m*k}+\{a_offset},\{k});
+    $|      nvcuda::wmma::load_matrix_sync(b,tile_b+slot*\{n*k}+\{b_offset},\{k});
+    $|      nvcuda::wmma::mma_sync(accumulator,a,b,accumulator);
+    $|    }
+    $|    // Retire all readers before the next epoch may reuse this slot.
+    $|    __syncthreads();
+    $|  }
+    $|  nvcuda::wmma::store_matrix_sync(result+\{c_offset},accumulator,\{n},nvcuda::wmma::mem_row_major);
+    $|  __syncthreads();
+    $|  for(int i=threadIdx.x;i<\{m*n};i+=128) {
+    $|    int row=row_base+i/\{n},column=column_base+i%\{n};
+    $|    if(row<live_rows&&column<\{columns}) output[(unsigned long long)row*\{columns}+column]=\{publication};
+    $|  }
+    $|}
+  ))
+}
diff --git a/kernels/tiled_matrix_cuda_source/rectangular_test.mbt b/kernels/tiled_matrix_cuda_source/rectangular_test.mbt
new file mode 100644
--- /dev/null
+++ b/kernels/tiled_matrix_cuda_source/rectangular_test.mbt
@@ -0,0 +1,58 @@
+///|
+test "rectangular transport requires explicit descriptor ABI" {
+  let plan = @matrix.MatrixTilePlan::new(
+    rows=64, columns=4096, inner=8192, law=ShapeAwareFloat32,
+    tile_rows=32, tile_columns=32, staging=RectangularBuffered(inner_tile=64),
+  )
+  assert_eq(plan.tile(), (32, 32, 64))
+  assert_eq(plan.operand_slots(), 2)
+  try @tiled_matrix_cuda_source.dense_source(plan, symbol="wrong_abi") catch {
+    _ => ()
+  } noraise { _ => fail("descriptor-less lowering accepted") }
+  let text = @utf8.decode(
+    @tiled_matrix_cuda_source.rectangular_dense_source(plan, symbol="rectangular"),
+  )
+  assert_true(text.contains("const CUtensorMap *map_a"))
+  assert_true(text.contains("cp.async.bulk.tensor.2d"))
+  assert_true(text.contains("mbarrier.try_wait.parity"))
+  assert_true(text.contains("Retire all readers"))
+  assert_true(text.contains("if(live_rows==1)"))
+  assert_true(text.contains("kk+=16"))
+  try @matrix.MatrixTilePlan::new(
+    rows=64, columns=65, inner=33, law=MatrixFloat32,
+    staging=RectangularBuffered(inner_tile=64),
+  ) catch { _ => () } noraise { _ => fail("unaligned tensor stride accepted") }
+}
+
+///|
+test "export rectangular publication through actual lowering" {
+  if @env.get_env_var("LUNA_EXPORT_RECTANGULAR") != Some("1") { return }
+  let shapes = [(4096,4096),(4096,8192),(8192,1536),(4096,1536),(65,40),(65,136)]
+  println("LUNA_SOURCE_BEGIN prefill")
+  println("#define PROJECTION_TENSOR_MAPS 1")
+  for i, (columns,inner) in shapes {
+    for j in 0..<4 {
+      let plan = @matrix.MatrixTilePlan::new(
+        rows=64, columns~, inner~, law=ShapeAwareFloat32,
+        tile_rows=32, tile_columns=32,
+        staging=if j == 1 {
+          RectangularBuffered(inner_tile=64)
+        } else {
+          SynchronousTiles(inner_tile=if inner>=8192 {64} else {32})
+        },
+      )
+      println(@utf8.decode(if j == 1 {
+        @tiled_matrix_cuda_source.rectangular_dense_source(
+          plan,symbol="p\{i}_s\{j}",partial_float32=true,
+        )
+      } else {
+        @tiled_matrix_cuda_source.dense_source(
+          plan,symbol="p\{i}_s\{j}",partial_float32=true,
+        )
+      }))
+    }
+  }
+  println("static void *functions[][4]={\{[for i in 0..<shapes.length() => "{"+[for j in 0..<4 => "(void*)p\{i}_s\{j}"].join(",")+"}"].join(",")}};")
+  println("static const int widths[]={\{shapes.map(s=>s.0.to_string()).join(",")}},inners[]={\{shapes.map(s=>s.1.to_string()).join(",")}};")
+  println("LUNA_SOURCE_END")
+}
diff --git a/kernels/tiled_matrix_cuda_source/partitioned_rectangular.mbt b/kernels/tiled_matrix_cuda_source/partitioned_rectangular.mbt
new file mode 100644
--- /dev/null
+++ b/kernels/tiled_matrix_cuda_source/partitioned_rectangular.mbt
@@ -0,0 +1,99 @@
+///|
+/// Two-stage device realization of an explicit partitioned numerical program.
+/// Shared operand storage is reused for publication only after every operand
+/// reader and transfer has retired. Partial results never escape this chain.
+pub fn partitioned_rectangular_source(
+  plan : @matrix.PartitionedMatrixPlan,
+  symbol~ : String,
+  partial_float32? : Bool = false,
+) -> Bytes raise @precision.PrecisionPlanError {
+  let matrix = plan.matrix()
+  let (rows, columns, inner) = matrix.geometry()
+  let (m, n, k) = matrix.tile()
+  guard (m, n, k) == (64, 128, 64) else {
+    raise @precision.PrecisionPlanError::NoImplementation
+  }
+  let stages = plan.stages()
+  let partitions = plan.partitions()
+  let extent = inner / partitions
+  let tiles_n = (columns + n - 1) / n
+  let tiles = (rows + m - 1) / m * tiles_n
+  let output_type = if partial_float32 { "float" } else { "__nv_bfloat16" }
+  let publication = if partial_float32 { "sum" } else { "__float2bfloat16_rn(sum)" }
+  @utf8.encode((
+    $|#include <cuda.h>
+    $|#include <cuda_bf16.h>
+    $|#include <mma.h>
+    $|__device__ __forceinline__ void \{symbol}_load(int slot,int coordinate,int row_base,int column_base,const CUtensorMap *map_a,const CUtensorMap *map_b,__nv_bfloat16 *tile_a,__nv_bfloat16 *tile_b,unsigned long long *ready) {
+    $|  const unsigned int bar=__cvta_generic_to_shared(ready+slot);
+    $|  const unsigned int a=__cvta_generic_to_shared(tile_a+slot*\{m*k}),b=__cvta_generic_to_shared(tile_b+slot*\{n*k});
+    $|  asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+    $|  asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;" :: "r"(bar),"r"(\{2*(m+n)*k}) : "memory");
+    $|  asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2,%3}], [%4];" :: "r"(a),"l"(map_a),"r"(coordinate),"r"(row_base),"r"(bar) : "memory");
+    $|  asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%2,%3}], [%4];" :: "r"(b),"l"(map_b),"r"(coordinate),"r"(column_base),"r"(bar) : "memory");
+    $|}
+    $|extern "C" __global__ void \{symbol}(const int *counts,const __nv_bfloat16 *input,const __nv_bfloat16 *weight,float *partials,const CUtensorMap *map_a,const CUtensorMap *map_b) {
+    $|  const int live_rows=counts[3]; if(live_rows<=0||live_rows>\{rows}) return;
+    $|  const int partition=blockIdx.x/\{tiles},tile=blockIdx.x%\{tiles};
+    $|  if(partition>=\{partitions}) return;
+    $|  const int row_base=(tile/\{tiles_n})*\{m},column_base=(tile%\{tiles_n})*\{n};
+    $|  if(row_base>=live_rows) return;
+    $|  extern __shared__ __align__(128) unsigned char scratch[];
+    $|  __nv_bfloat16 *tile_a=reinterpret_cast<__nv_bfloat16 *>(scratch),*tile_b=tile_a+\{stages*m*k};
+    $|  __shared__ __align__(8) unsigned long long ready[\{stages}];
+    $|  if(threadIdx.x==0) {
+    $|    #pragma unroll
+    $|    for(int s=0;s<\{stages};++s) {
+    $|      const unsigned int address=__cvta_generic_to_shared(ready+s);
+    $|      asm volatile("mbarrier.init.shared.b64 [%0], 1;" :: "r"(address) : "memory");
+    $|    }
+    $|    asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+    $|  }
+    $|  __syncthreads();
+    $|  const int begin=partition*\{extent};
+    $|  if(threadIdx.x==0) {
+    $|    #pragma unroll
+    $|    for(int s=0;s<\{stages};++s) if(s*\{k}<\{extent}) \{symbol}_load(s,begin+s*\{k},row_base,column_base,map_a,map_b,tile_a,tile_b,ready);
+    $|  }
+    $|  const int warp=threadIdx.x/32;
+    $|  nvcuda::wmma::fragment<nvcuda::wmma::accumulator,16,16,16,float> accumulators[8];
+    $|  #pragma unroll
+    $|  for(int c=0;c<8;++c) nvcuda::wmma::fill_fragment(accumulators[c],0.0f);
+    $|  for(int offset=0,epoch=0;offset<\{extent};offset+=\{k},++epoch) {
+    $|    const int slot=epoch%\{stages}; const unsigned int bar=__cvta_generic_to_shared(ready+slot),parity=(epoch/\{stages})&1;
+    $|    asm volatile("{ .reg .pred done; WAIT: mbarrier.try_wait.parity.shared::cta.b64 done, [%0], %1; @!done bra WAIT; }" :: "r"(bar),"r"(parity) : "memory");
+    $|    #pragma unroll
+    $|    for(int kk=0;kk<\{k};kk+=16) {
+    $|      nvcuda::wmma::fragment<nvcuda::wmma::matrix_a,16,16,16,__nv_bfloat16,nvcuda::wmma::row_major> a;
+    $|      nvcuda::wmma::load_matrix_sync(a,tile_a+slot*\{m*k}+warp*16*\{k}+kk,\{k});
+    $|      #pragma unroll
+    $|      for(int c=0;c<8;++c) {
+    $|        nvcuda::wmma::fragment<nvcuda::wmma::matrix_b,16,16,16,__nv_bfloat16,nvcuda::wmma::col_major> b;
+    $|        nvcuda::wmma::load_matrix_sync(b,tile_b+slot*\{n*k}+c*16*\{k}+kk,\{k});
+    $|        nvcuda::wmma::mma_sync(accumulators[c],a,b,accumulators[c]);
+    $|      }
+    $|    }
+    $|    __syncthreads();
+    $|    if(threadIdx.x==0 && offset+\{stages*k}<\{extent}) \{symbol}_load(slot,begin+offset+\{stages*k},row_base,column_base,map_a,map_b,tile_a,tile_b,ready);
+    $|  }
+    $|  // All pending publications and readers have retired; reuse storage.
+    $|  float *result=reinterpret_cast<float *>(scratch);
+    $|  #pragma unroll
+    $|  for(int c=0;c<8;++c) nvcuda::wmma::store_matrix_sync(result+warp*16*\{n}+c*16,accumulators[c],\{n},nvcuda::wmma::mem_row_major);
+    $|  __syncthreads();
+    $|  for(int i=threadIdx.x;i<\{m*n};i+=128) {
+    $|    int row=row_base+i/\{n},column=column_base+i%\{n};
+    $|    if(row<live_rows&&column<\{columns}) partials[((unsigned long long)partition*\{rows}+row)*\{columns}+column]=result[i];
+    $|  }
+    $|}
+    $|extern "C" __global__ void \{symbol}_reduce(const int *counts,const float *partials,\{output_type} *output) {
+    $|  const int live_rows=counts[3]; if(live_rows<=0||live_rows>\{rows}) return;
+    $|  for(unsigned long long i=(unsigned long long)blockIdx.x*blockDim.x+threadIdx.x;i<(unsigned long long)live_rows*\{columns};i+=(unsigned long long)gridDim.x*blockDim.x) {
+    $|    float sum=0.0f;
+    $|    #pragma unroll
+    $|    for(int p=0;p<\{partitions};++p) sum=__fadd_rn(sum,partials[(unsigned long long)p*\{rows*columns}+i]);
+    $|    output[i]=\{publication};
+    $|  }
+    $|}
+  ))
+}
