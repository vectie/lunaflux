+///|
+test "full fragment residency retires shared readers before refill and ascending MMA" {
+  let matrix = @matrix.MatrixTilePlan::new(rows=64, columns=4096, inner=8192, law=ShapeAwareFloat32)
+  let plan = @matrix.MatrixFragmentPipeline::new(matrix, row_tile=32, resident_fragments=4)
+  let text = @utf8.decode(@tiled_matrix_cuda_source.fragment_pipeline_source(plan, symbol="resident"))
+  assert_true(text.contains("unsigned a[4][4],b[4][4][2]"))
+  guard text.split("// Retain the full operand epoch").to_array() is [_, body] else {fail("missing schedule")}
+  guard body.split("// retire readers before producer overwrites").to_array() is [readers, producer] else {fail("missing retirement")}
+  assert_true(readers.contains("ldmatrix.sync"))
+  assert_false(readers.contains("mma.sync"))
+  guard producer.split("cp.async.commit_group").to_array() is [refill, consumers] else {fail("missing commit")}
+  assert_true(refill.contains("copy_k=(epoch+2)*64"))
+  assert_true(consumers.contains("for(int q=0;q<4;++q)"))
+  assert_true(consumers.contains("mma.sync"))
+}
