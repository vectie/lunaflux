+  let resident = @grouped_matrix_ir.MatrixFragmentPipeline::new(matrix, row_tile=32, resident_fragments=4)
+  assert_eq(normal.fragment_slots(), 2)
+  assert_eq(resident.fragment_slots(), 4)
+  assert_eq(normal.shared_bytes(), resident.shared_bytes())
+  assert_eq(normal.tile_count(), resident.tile_count())
+  assert_eq(normal.matrix().law(), resident.matrix().law())
+  try @grouped_matrix_ir.MatrixFragmentPipeline::new(matrix, row_tile=32, resident_fragments=3)
+  catch { _ => () } noraise { _ => fail("unsupported partial residency") }
+}
