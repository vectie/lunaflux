import {
  "moonbitlang/async@0.20.3",
  "moonbitlang/async@0.20.3/fs",
  "moonbitlang/async@0.20.3/process",
  "moonbitlang/core/env",
}

async fn main {
  guard @env.args() is [_, root, tree, label] else { fail("OUTPUT_ROOT SOURCE_TREE baseline|current") }
  let output = root + "/" + label + "-variants"
  @fs.mkdir(output)
  for family in ["qkv", "mlp"] {
    for (stages, width) in [(3, 2), (4, 2)] {
      let name = family + "-s" + stages.to_string()
      let arguments = if family == "qkv" { [family] } else { ["intermediate"] }
      let (code, stdout, stderr) = @process.collect_output("moon", ["run", "--target", "native", "tests/projection_pipeline_cuda_source_probe", "--"] + arguments + [stages.to_string(), width.to_string(), "2"], cwd=tree)
      @fs.write_file(output + "/" + name + ".stderr", stderr, create_mode=CreateNew)
      @fs.write_file(output + "/" + name + ".stdout", stdout, create_mode=CreateNew)
      assert_eq(code, 0, msg=stderr.text())
      @fs.write_file(output + "/" + name + ".cu", stdout, create_mode=CreateNew)
    }
  }
  println(output)
}
