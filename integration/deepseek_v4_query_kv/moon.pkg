  "vectie/lunaflux/compiler/precision_ir" @precision,
  "vectie/lunaflux/engine/precision_materialize" @materialize,
  "vectie/lunaflux/integration/precision_checkpoint_upload" @upload,
  "vectie/lunaflux/integration/quantized_query_kv_frame" @frame,
  "vectie/lunaflux/kernels/quantized_query_kv_cuda_source" @source,
  "vectie/lunaflux/kernels/rotary_kv_cuda_source" @rotary_source,
  "vectie/lunaflux/integration/rotary_kv_frame" @rotary_frame,
  "vectie/lunaflux/kernels/window_shared_kv_cuda_source" @window_source,
  "vectie/lunaflux/integration/window_shared_kv_frame" @window_frame,
  "vectie/lunaflux/kernels/window_compressed_kv_cuda_source" @compressed_window_source,
  "vectie/lunaflux/integration/window_compressed_kv_frame" @compressed_window_frame,
  "vectie/lunaflux/kernels/grouped_attention_output_cuda_source" @output_source,
  "vectie/lunaflux/integration/grouped_attention_output_frame" @output_frame,
  "vectie/lunaflux/kernels/learned_gated_pool_cuda_source" @pool_source,
  "vectie/lunaflux/integration/learned_gated_pool_frame" @pool_frame,
  "vectie/lunaflux/kernels/retained_rows_cuda_source" @retained_source,
  "vectie/lunaflux/integration/retained_rows_frame" @retained_frame,
  "vectie/lunaflux/kernels/rotary_hadamard_fp4_cuda_source" @indexer_source,
  "vectie/lunaflux/integration/rotary_hadamard_fp4_frame" @indexer_frame,
  "vectie/lunaflux/kernels/learned_index_queries_cuda_source" @index_queries_source,
  "vectie/lunaflux/integration/learned_index_queries_frame" @index_queries_frame,
  "vectie/lunaflux/kernels/compressed_index_selection_cuda_source" @selection_source,
