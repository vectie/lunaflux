import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/x/crypto",
} for "test"

supported_targets = "native"

options(
  link: { "native": { "cc-link-flags": "-pthread -ldl" } },
)
