///|
test "Luna scheduler telemetry commits only submitted plan scalars" {
  let owner = wb_owner_with_capacity(1, 1)
  let empty = owner.luna_telemetry()
  let empty_plan = owner.luna_plan_telemetry()
  assert_eq(empty.queue_depth(), 0)
  assert_eq(empty.active_requests(), 0)
  assert_eq(empty.kv_pages_used(), 0)
  assert_eq(empty.kv_pages_free(), 8)
  assert_eq(empty_plan.last_plan_sequence(), 0UL)
  ignore(owner.admit(wb_request(9901UL), 0UL))
  let waiting = owner.luna_telemetry()
  assert_eq(waiting.queue_depth(), 1)
  assert_eq(waiting.active_requests(), 0)
  let outcome = try! owner.build_next()
  let plan = try! owner.submitted_plan(outcome)
  let current = owner.luna_telemetry()
  let current_plan = owner.luna_plan_telemetry()
  assert_eq(current.queue_depth(), 0)
  assert_eq(current.active_requests(), 1)
  assert_eq(current_plan.last_plan_sequence(), try! plan.sequence_wire())
  assert_eq(current_plan.last_plan_rows(), try! plan.row_count())
  assert_eq(current_plan.last_plan_tokens(), try! plan.token_budget())
}
