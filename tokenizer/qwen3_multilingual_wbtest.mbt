///|
/// Fixture manifest SHA-256:
/// 4cdbf98e273e2bc488f380a906762044baed6864c8b56d715473e951747152d4.
test "Qwen3-0.6B pinned multilingual corpus matches exact IDs and NFC decode" {
  let spec = qwen3_reference_spec()
  let cases : Array[(String, Array[Int], String)] = [
    (
      "月光引擎可以稳定地处理中文推理。",
      [9754, 99225, 102977, 73670, 100407, 29490, 54542, 104811, 113272, 1773],
      "月光引擎可以稳定地处理中文推理。",
    ),
    (
      "月光引擎可以穩定地處理中文推理。",
      [9754, 99225, 102977, 73670, 117820, 29490, 102923, 104811, 113272, 1773],
      "月光引擎可以穩定地處理中文推理。",
    ),
    (
      "月光エンジンは日本語の推論を安定して処理します。",
      [
        9754, 99225, 131592, 75328, 15698, 15322, 101059, 102819, 15767, 83751, 100946,
        29412, 113707, 38826, 12585, 99, 21887, 77334, 1773,
      ],
      "月光エンジンは日本語の推論を安定して処理します。",
    ),
    (
      "루나플럭스는 한국어 추론을 안정적으로 처리합니다.",
      [
        126746, 60315, 131587, 144329, 24897, 16560, 130092, 31079, 57835, 126605,
        17877, 95170, 29281, 128552, 81058, 60838, 13,
      ],
      "루나플럭스는 한국어 추론을 안정적으로 처리합니다.",
    ),
    (
      "Η μηχανή LunaFlux εκτελεί ντετερμινιστική συμπερασματολογία.",
      [
        145260, 32883, 41424, 89102, 18945, 33269, 72930, 49805, 3882, 2200, 59147,
        67337, 35824, 30143, 33486, 30143, 54141, 98686, 35824, 30143, 35824, 30143,
        38079, 43123, 29762, 33269, 29762, 43928, 35824, 29762, 67337, 72930, 47723,
        53456, 43123, 48245, 30143, 38079, 18945, 43928, 43123, 18945, 35824, 27554,
        33486, 27554, 59374, 54141, 18945, 13,
      ],
      "Η μηχανή LunaFlux εκτελεί ντετερμινιστική συμπερασματολογία.",
    ),
    (
      "ينفذ محرك لونافلوكس الاستدلال بشكل حتمي.",
      [
        123860, 128041, 126502, 124335, 56794, 123890, 95975, 8532, 125067, 20064,
        126455, 13325, 125450, 128953, 68238, 123978, 14558, 13,
      ],
      "ينفذ محرك لونافلوكس الاستدلال بشكل حتمي.",
    ),
    (
      "लूनाफ़्लक्स इंजन निर्धारक अनुमान चलाता है।",
      [
        91811, 12619, 224, 60096, 31411, 104, 5502, 120, 29607, 91811, 64704, 30484,
        116, 14925, 229, 72314, 146114, 60096, 14925, 101, 42311, 108, 30484, 100,
        31411, 108, 64704, 14925, 227, 60096, 72653, 87244, 31411, 101, 14925, 248,
        91811, 31411, 97, 23868, 84310, 12619, 230, 146031,
      ],
      "लूनाफ़्लक्स इंजन निर्धारक अनुमान चलाता है।",
    ),
    (
      "Qwen推理：稳定✅，快速⚡；结果可复现！",
      [
        48, 16948, 113272, 5122, 100407, 144247, 3837, 101098, 144995, 24968, 59151,
        30440, 58364, 46451, 6313,
      ],
      "Qwen推理：稳定✅，快速⚡；结果可复现！",
    ),
    (
      "A\u{0315}\u{0300} cafe\u{0301} Ångstro\u{0308}m",
      [71953, 136, 243, 51950, 79252, 968, 495, 85584],
      "À\u{0315} café Ångström",
    ),
    (
      "루나플럭스와 한글",
      [126746, 60315, 131587, 144329, 24897, 80573, 61298, 83291],
      "루나플럭스와 한글",
    ),
  ]
  for entry in cases {
    let (text, expected_ids, expected_decode) = entry
    let actual_ids = qwen3_reference_encode(spec, text)
    assert_eq(actual_ids, expected_ids)
    assert_eq(
      spec.decode_text(actual_ids, special_policy=Preserve),
      expected_decode,
    )
  }
}
