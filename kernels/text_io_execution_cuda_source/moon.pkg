import {
  "vectie/lunaflux/compiler/precision_ir" @precision,
  "vectie/lunaflux/compiler/parallel_ir" @parallel,
  "vectie/lunaflux/kernels/luna_cuda_precision" @arithmetic,
  "vectie/lunaflux/kernels/luna_cuda_pointwise_aot" @literal,
  "vectie/lunaflux/kernels/decoder_hyper_connection_cuda_source" @head,
  "moonbitlang/core/encoding/utf8",
  "vectie/lunaflux/kernels/tiled_matrix_cuda_source" @tiled,
  "vectie/lunaflux/kernels/luna_sampling_strategy" @sampling,
}

import {
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/fs",
} for "test"

supported_targets = "native"

options(
  link: { "native": { "cc-link-flags": "-pthread -ldl" } },
)
