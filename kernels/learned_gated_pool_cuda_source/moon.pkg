import {
  "vectie/lunaflux/compiler/precision_ir" @precision,
  "vectie/lunaflux/kernels/luna_cuda_pointwise_aot" @literal,
  "vectie/lunaflux/kernels/luna_cuda_precision" @arithmetic,
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "vectie/lunaflux/kernels/rotary_kv_cuda_source" @rotary_source,
} for "test"

supported_targets = "native"

options(
  link: { "native": { "cc-link-flags": "-pthread -ldl" } },
)
