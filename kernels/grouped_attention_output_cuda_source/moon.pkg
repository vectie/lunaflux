import {
  "vectie/lunaflux/compiler/precision_ir" @precision,
  "vectie/lunaflux/kernels/rotary_kv_cuda_source" @rotary,
  "vectie/lunaflux/kernels/block_fp8_ue8m0_projection_cuda_source" @projection,
