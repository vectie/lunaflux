import {
  "vectie/lunaflux/engine/rank_group_wire",
  "vectie/lunaflux/model/spec",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "allocation_probe.c", "execution_probe.c" ],
  "stub-cc-flags": "-std=c11 -Wall -Wextra -Werror",
  link: {
    "native": {
      "cc-flags": "-O2 -include tests/rank_group_wire_alloc/allocation_redirect.h",
    },
  },
)
