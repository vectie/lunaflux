import {
  "vectie/lunaflux/device",
  "vectie/lunaflux/integration/packed_expert_mlp" @moe,
  "vectie/lunaflux/compiler/precision_ir" @precision,
  "vectie/lunaflux/model/precision_format" @format,
  "vectie/lunaflux/kernels/selected_expert_mlp_cuda_source" @source,
  "vectie/lunaflux/kernels/luna_cuda_precision" @combine,
  "vectie/lunaflux/kernels/moe_routing_cuda_source" @router,
  "vectie/lunaflux/integration/recurrent_delta_program" @recurrent,
  "vectie/lunaflux/kernels/recurrent_delta_execution_cuda_source" @delta,
  "vectie/lunaflux/kernels/causal_convolution_execution_cuda_source" @convolution,
  "vectie/lunaflux/kernels/recurrent_block_execution_cuda_source" @block,
  "moonbitlang/core/encoding/utf8",
  "vectie/lunaflux/integration/precision_checkpoint_upload" @upload,
  "vectie/lunaflux/engine/precision_materialize" @materialize,
  "vectie/lunaflux/model/streaming_safetensors" @streaming,
  "vectie/lunaflux/runtime/approved_fs",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/x/crypto",
  "vectie/lunaflux/integration/glm53_packed_expert_upload",
  "vectie/lunaflux/model/glm53_spec",
  "vectie/lunaflux/integration/indexed_sparse_attention_frame" @sparse,
  "vectie/lunaflux/kernels/indexed_sparse_attention_execution_cuda_source" @sparse_source,
  "vectie/lunaflux/kernels/indexed_sparse_projection_cuda_source" @projection_source,
  "vectie/lunaflux/integration/indexed_sparse_projection_frame" @projection_frame,
  "vectie/lunaflux/integration/hyper_connection_frame" @hyper_frame,
  "vectie/lunaflux/kernels/hyper_connection_execution_cuda_source" @hyper_source,
  "vectie/lunaflux/kernels/text_io_execution_cuda_source" @text_source,
  "vectie/lunaflux/integration/text_io_frame" @text_frame,
}

import {
  "vectie/lunaflux/integration/serial_decoder_worker" @serial_worker,
  "vectie/lunaflux/engine/serial_decoder_frame" @serial_frame,
  "vectie/lunaflux/engine/worker_wire" @wire,
  "vectie/lunaflux/engine/worker_protocol" @protocol,
  "vectie/lunaflux/contracts/inference",
  "vectie/lunaflux/kv/page_allocator",
  "vectie/lunaflux/model/plan",
} for "test"

supported_targets = "native"

options(
  "native-stub": [
    "allocation_probe.c",
    "fake_device.c",
    "fake_executor.c",
    "fake_collective.c",
    "fake_overlap.c",
  ],
  "stub-cc-flags": "-std=c11 -Wall -Wextra -Werror",
  link: {
    "native": {
      "cc-flags": "-O2 -include tests/tensor_parallel_device_worker_alloc/runtime_redirect.h -include tests/packed_moe_execution/transfer_redirect.h",
    },
  },
)
