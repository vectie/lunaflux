import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
  "vectie/lunaflux/contracts/inference",
  "vectie/lunaflux/device",
  "vectie/lunaflux/engine/device_memory",
  "vectie/lunaflux/engine/device_step",
  "vectie/lunaflux/engine/device_worker",
  "vectie/lunaflux/engine/execution_manifest_file",
  "vectie/lunaflux/engine/worker_protocol",
  "vectie/lunaflux/engine/worker_wire",
  "vectie/lunaflux/kernels/artifact",
  "vectie/lunaflux/kernels/artifact_file",
  "vectie/lunaflux/kernels/catalog",
  "vectie/lunaflux/kernels/launch_contract",
  "vectie/lunaflux/kv/device_layout",
  "vectie/lunaflux/kv/page_allocator",
  "vectie/lunaflux/model/device_materialize",
  "vectie/lunaflux/model/llama",
  "vectie/lunaflux/model/plan",
  "vectie/lunaflux/model/safetensors",
  "vectie/lunaflux/model/spec",
  "vectie/lunaflux/runtime/approved_fs",
  "vectie/lunaflux/sampling",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "allocation_probe.c", "fake_device.c" ],
  "stub-cc-flags": "-std=c11 -Wall -Wextra -Werror",
  link: {
    "native": {
      "cc-flags": "-O2 -include tests/device_worker_alloc/allocation_redirect.h",
    },
  },
)
