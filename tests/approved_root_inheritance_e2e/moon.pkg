import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "vectie/lunaflux/internal/process",
  "vectie/lunaflux/runtime/approved_fs",
  "vectie/lunaflux/tests/worker_executable_fixture",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "probe.c" ],
  "stub-cc-flags": "-std=c11 -Wall -Wextra -Werror",
)
