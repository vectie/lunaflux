import {
  "vectie/lunaflux/config/cache",
  "vectie/lunaflux/config/runtime_resolved",
  "vectie/lunaflux/config/scheduler" @scheduler_config,
  "vectie/lunaflux/contracts/inference",
  "vectie/lunaflux/engine/worker_protocol",
  "vectie/lunaflux/engine/worker_wire",
  "vectie/lunaflux/model/plan",
  "vectie/lunaflux/model/spec",
  "vectie/lunaflux/scheduler/core" @scheduler,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "allocation_probe.c" ],
  "stub-cc-flags": "-std=c11 -Wall -Wextra -Werror",
  link: {
    "native": {
      "cc-flags": "-O2 -include tests/hot_path_alloc/allocation_redirect.h",
    },
  },
)
