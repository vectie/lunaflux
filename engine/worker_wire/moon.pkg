import {
  "vectie/lunaflux/engine/streaming_ir",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
  "vectie/lunaflux/contracts/inference",
  "vectie/lunaflux/engine/worker_protocol",
  "vectie/lunaflux/kernels/luna_capability_manifest",
  "vectie/lunaflux/kernels/luna_artifact_admission",
  "vectie/lunaflux/kernels/fp8_release_authority",
  "vectie/lunaflux/model/spec",
}

import {
  "vectie/lunaflux/kv/page_allocator",
  "vectie/lunaflux/model/plan",
  "vectie/lunaflux/model/spec",
} for "test"

import {
  "vectie/lunaflux/kv/page_allocator",
  "vectie/lunaflux/model/plan",
} for "wbtest"

supported_targets = "native"

// Native test executables also link the runtime allocator on pre-glibc-2.34 Linux.

options(
  link: { "native": { "cc-link-flags": "-pthread -ldl" } },
)
