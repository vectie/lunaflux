import {
  "moonbitlang/async@0.20.3",
  "moonbitlang/async@0.20.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

async fn main {
  let args = @env.args()
  assert_eq(args.length(), 2)
  let content = @fs.read_file(args[1]).text()
  let samples : Map[String, Array[Double]] = Map([])
  for line in content.split("\n") {
    let fields = line.split(" ").to_array()
    if fields.length() != 4 || !line.contains("microseconds=") {
      continue
    }
    let key = fields[0].to_owned() + ":" + fields[2].to_owned()
    let value = @string.parse_double(fields[3].split("=").to_array()[1].to_owned())
    match samples.get(key) {
      Some(values) => values.push(value)
      None => samples.set(key, [value])
    }
  }
  println("| Tokens | Old median μs | New median μs | Old/new |")
  println("| ---: | ---: | ---: | ---: |")
  for tokens in [1, 2, 15, 16, 17, 32, 64, 128, 256] {
    guard samples.get("tokens=\{tokens}:kernel=old") is Some(old) &&
      samples.get("tokens=\{tokens}:kernel=new") is Some(new) else {
      fail("missing token vector")
    }
    assert_eq(old.length(), 7)
    assert_eq(new.length(), 7)
    old.sort()
    new.sort()
    println("| \{tokens} | \{old[3]} | \{new[3]} | \{old[3] / new[3]} |")
  }
}
