///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
priv struct Host {
  node : String
  socket : String
  root : String
  checkpoint : String
  uuid : String
}

///|
fn execution_label(mode : String, role : String) -> String {
  mode + "-" + role
}

///|
fn prepared_prompt(document : String) -> (String, Int) raise {
  let mut directory = "prompt-bos"
  let mut count = 1
  for line in document.split("\n") {
    if line.has_prefix("prompt_directory=") {
      directory = line[17:].to_owned()
    } else if line.has_prefix("prefill_count=") {
      count = @string.parse_int(line[14:])
    }
  }
  guard !directory.is_empty() &&
    directory.iter().all(c => c is ('a'..='z' | '0'..='9' | '-')) &&
    count > 0 &&
    count <= 255 else {
    fail("invalid prepared prompt")
  }
  (directory, count)
}

///|
fn prepared_generation(document : String) -> (Int, Int) raise {
  let mut maximum = 16
  let mut stop = -1
  for line in document.split("\n") {
    if line.has_prefix("maximum_new_tokens=") {
      maximum = @string.parse_int(line[19:])
    } else if line.has_prefix("stop_token=") {
      stop = @string.parse_int(line[11:])
    }
  }
  guard maximum > 0 && maximum <= 255 && stop >= -1 else {
    fail("invalid prepared generation envelope")
  }
  (maximum, stop)
}

///|
fn completed_tokens(
  source : String,
  maximum : Int,
  stop : Int,
) -> Array[Int] raise {
  let tokens : Array[Int] = []
  for line in source.split("\n") {
    if !line.is_empty() {
      tokens.push(@string.parse_int(line))
    }
  }
  guard !tokens.is_empty() && tokens.length() <= maximum else {
    fail("generation output exceeds requested envelope")
  }
  for index, token in tokens {
    guard token >= 0 &&
      (stop == -1 || token != stop || index == tokens.length() - 1) else {
      fail("generation continued after the first stop token")
    }
  }
  guard tokens.length() == maximum ||
    (stop >= 0 && tokens[tokens.length() - 1] == stop) else {
    fail("generation terminated before limit without a stop token")
  }
  tokens
}

///|
fn check_prepared_generation() -> Unit raise {
  assert_eq(prepared_generation("old\n"), (16, -1))
  assert_eq(
    prepared_generation("maximum_new_tokens=64\nstop_token=1\n"),
    (64, 1),
  )
  assert_eq(completed_tokens("7\n1\n", 64, 1), [7, 1])
  assert_eq(completed_tokens("7\n8\n", 2, -1), [7, 8])
  for
    document in [
      "maximum_new_tokens=0\n", "maximum_new_tokens=256\n", "stop_token=-2\n",
    ] {
    try prepared_generation(document) catch {
      _ => ()
    } noraise {
      _ => fail("invalid generation policy accepted")
    }
  }
  for
    (source, maximum, stop) in [
      ("7\n1\n8\n", 64, 1),
      ("7\n", 64, 1),
      ("", 64, 1),
      ("7\n8\n", 1, -1),
    ] {
    try completed_tokens(source, maximum, stop) catch {
      _ => ()
    } noraise {
      _ => fail("invalid generation completion accepted")
    }
  }
}

///|
test "prepared generation retains fixed-length diagnostics and ends exactly at EOS" {
  check_prepared_generation()
}

///|
fn check_prepared_prompt() -> Unit raise {
  assert_eq(prepared_prompt("build=old\n"), ("prompt-bos", 1))
  assert_eq(
    prepared_prompt("prompt_directory=prompt-text\nprefill_count=3\n"),
    ("prompt-text", 3),
  )
  try prepared_prompt("prompt_directory=../old\nprefill_count=0\n") catch {
    _ => ()
  } noraise {
    _ => fail("invalid prompt accepted")
  }
}

///|
test "prepared literal prompts use all frames while old BOS campaigns remain unchanged" {
  check_prepared_prompt()
}

///|
fn check_execution_labels() -> Unit raise {
  let roles = ["egress", "ingress", "178-gpu-terminal", "179-gpu-terminal"]
  let names : Array[String] = []
  for mode in ["run", "reference"] {
    for role in roles {
      let name = execution_label(mode, role)
      assert_false(names.contains(name))
      names.push(name)
    }
  }
  assert_eq(names.length(), 8)
  assert_eq(execution_label("reference", "egress"), "reference-egress")
}

///|
test "speculative and reference receipts never collide in one campaign root" {
  check_execution_labels()
}

///|
async fn remote(host : Host, command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=10",
    "-S",
    host.socket,
    host.node,
    command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn record(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn download(host : Host, source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + host.socket,
    host.node + ":" + source,
    destination,
  ])
  .output()
  .check()
}

///|
async fn upload(host : Host, source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + host.socket,
    source,
    host.node + ":" + destination,
  ])
  .output()
  .check()
}

///|
async fn wait_unit(host : Host, unit : String) -> Unit {
  for ;; {
    let output = remote(
      host,
      "systemctl --user show " +
      unit +
      " -p LoadState -p ActiveState -p SubState -p Result -p ExecMainStatus",
    )
    output.check()
    let status = output.stdout()
    guard status.contains("LoadState=loaded\n") &&
      !status.contains("ActiveState=failed\n") &&
      status.contains("ExecMainStatus=0\n") else {
      println(
        remote(host, "journalctl --user -u " + unit + " -n 30 --no-pager").stdout(),
      )
      fail("unit missing or failed: " + unit + "\n" + status)
    }
    if (
        status.contains("SubState=exited\n") ||
        status.contains("SubState=dead\n")
      ) &&
      status.contains("Result=success\n") {
      return
    }
    @async.sleep(10000)
  }
}

///|
async fn start(
  host : Host,
  root : String,
  unit : String,
  memory : String,
  seconds : Int,
  command : String,
) -> Unit {
  record(
    root,
    unit + "-start",
    remote(
      host,
      "systemd-run --user --unit=" +
      unit +
      " --property=RemainAfterExit=yes --property=MemoryMax=" +
      memory +
      " --property=MemorySwapMax=0 --property=RuntimeMaxSec=" +
      seconds.to_string() +
      " " +
      command,
    ),
  )
}

///|
async fn collect(host : Host, root : String, unit : String) -> Unit {
  record(
    root,
    unit + "-terminal",
    remote(
      host,
      "systemctl --user show " +
      unit +
      " -p ActiveState -p SubState -p Result -p ExecMainStatus -p MemoryPeak -p MemorySwapPeak",
    ),
  )
  record(
    root,
    unit + "-journal",
    remote(host, "journalctl --user -u " + unit + " --no-pager"),
  )
}

///|
async fn admit(host : Host, root : String, label : String) -> Unit {
  let identity = remote(
    host, "nvidia-smi --query-gpu=uuid,pci.bus_id --format=csv,noheader",
  )
  record(root, label + "-identity", identity)
  guard identity.stdout().trim() == host.uuid + ", 0000000F:01:00.0" else {
    fail("wrong GPU")
  }
  let occupied = remote(
    host, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  record(root, label + "-occupied", occupied)
  guard occupied.stdout().trim().is_empty() else {
    fail("GPU occupied; do not start another model")
  }
}

///|
async fn main {
  if @env.args() is [_, "self-test"] {
    check_prepared_prompt()
    check_execution_labels()
    check_prepared_generation()
    println(
      "DSpark runner prompt, stop-aware generation and disjoint-output regressions passed",
    )
    return
  }
  guard @env.args() is [_, root, suffix, mode, build, commit] &&
    root.has_prefix("/tmp/lunaflux-dspark-run-") &&
    [root, suffix].all(s => {
      !s.is_empty() &&
      !s.contains("..") &&
      s.iter().all(c => c is ('a'..='z' | '0'..='9' | '-' | '/'))
    }) &&
    !suffix.contains("/") &&
    mode is ("prepare" | "run" | "reference") else {
    fail(
      "NEW_LOCAL_DIRECTORY UNIQUE_SUFFIX prepare|run|reference BUILD_ROOT COMMIT",
    )
  }
  let remote_root = "/tmp/lunaflux-dspark-real-" + suffix
  let first = Host::{
    node: "wlc003s@192.168.2.178",
    socket: "/tmp/lunaflux-checkpoint-live-20261010.sock",
    root: remote_root,
    checkpoint: "/tmp/lunaflux-deepseek-real-20261010.dLryo68E",
    uuid: "GPU-9c3d3cf0-439a-5da2-67e9-20414255879f",
  }
  let last = Host::{
    node: "wlc004s@192.168.2.179",
    socket: "/tmp/lunaflux-checkpoint-live179-20261010.sock",
    root: remote_root,
    checkpoint: "/tmp/lunaflux-deepseek-real-20261010.ZYa0kMPT",
    uuid: "GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6",
  }
  guard build.has_prefix("/tmp/lunaflux-checkpoint-build-dspark-") &&
    !build.contains("..") &&
    build.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) &&
    commit.length() == 40 &&
    commit.iter().all(c => c is ('a'..='f' | '0'..='9')) else {
    fail("invalid committed-build location")
  }
  let build_unit = build[5:].to_owned() + ".service"
  let binary = build +
    "/source/_build/native/release/build/cmd/deepseek_checkpoint/deepseek_checkpoint.exe"
  let reserve = 4294967296L
  let budgets = " 6 256 103079215104 103079215104 " + reserve.to_string() + " "
  let model = "/DeepSeek-V4-Flash-DSpark "
  let args0 = first.checkpoint +
    model +
    first.checkpoint +
    "/SHARDS.sha256" +
    budgets
  let args1 = last.checkpoint +
    model +
    last.checkpoint +
    "/SHARDS.sha256" +
    budgets
  let name = "lunaflux-dspark-" +
    suffix +
    "-" +
    (if mode == "reference" { "reference-" } else { "" })
  if mode == "prepare" {
    @fs.mkdir(root)
    // Preparation is CPU-only. No old benchmark process is a dependency.
    // The non-retained transient build unit can be collected after success.
    // Its successful journal, not LoadState, records build completion.
    let build_journal = remote(
      first,
      "journalctl --user -u " + build_unit + " --no-pager",
    )
    record(root, "build-journal", build_journal)
    guard build_journal.stdout().contains("Finished. moon:") &&
      build_journal.stdout().contains("now up to date") else {
      fail("exact source build has not completed")
    }
    download(first, binary, root + "/deepseek_checkpoint.exe")
    for host in [first, last] {
      record(
        root,
        (if host.node == first.node { "178" } else { "179" }) + "-mkdir",
        remote(host, "mkdir " + host.root),
      )
      upload(
        host,
        root + "/deepseek_checkpoint.exe",
        host.root + "/deepseek_checkpoint.exe",
      )
    }
    let export_unit = name + "export"
    start(
      first,
      root,
      export_unit,
      "4G",
      7200,
      first.root +
      "/deepseek_checkpoint.exe export-dspark " +
      args0 +
      first.root +
      "/aot",
    )
    {
      errdefer collect(first, root, export_unit)
      wait_unit(first, export_unit)
    }
    collect(first, root, export_unit)
    for file in ["stage-0.cu", "stage-1.cu", "placement.txt"] {
      download(first, first.root + "/aot/" + file, root + "/" + file)
    }
    println(@fs.read_file(root + "/placement.txt").text())
    record(root, "179-aot-mkdir", remote(last, "mkdir " + last.root + "/aot"))
    upload(last, root + "/stage-1.cu", last.root + "/aot/stage-1.cu")
    for (host, ordinal) in [(first, 0), (last, 1)] {
      let stage = "stage-" + ordinal.to_string()
      let unit = name + "aot" + ordinal.to_string()
      start(
        host,
        root,
        unit,
        "2G",
        1800,
        "/usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 --cubin -arch=sm_121 " +
        host.root +
        "/aot/" +
        stage +
        ".cu -o " +
        host.root +
        "/aot/" +
        stage +
        ".cubin",
      )
    }
    for (host, ordinal) in [(first, 0), (last, 1)] {
      let unit = name + "aot" + ordinal.to_string()
      {
        errdefer collect(host, root, unit)
        wait_unit(host, unit)
      }
      collect(host, root, unit)
      let file = "stage-" + ordinal.to_string() + ".cubin"
      download(host, host.root + "/aot/" + file, root + "/" + file)
    }
    record(
      root,
      "token-frames",
      remote(
        first,
        first.root +
        "/deepseek_checkpoint.exe token-frames " +
        first.checkpoint +
        "/DeepSeek-V4-Flash-DSpark 6 256 0 " +
        first.root +
        "/prompt-bos",
      ),
    )
    @fs.write_file(
      root + "/prepared.txt",
      "commit=" + commit + "\n" + "build=" + build + "\n",
      create_mode=CreateNew,
    )
    println(
      "DSpark exact checkpoint AOT prepared; no new GPU model execution yet",
    )
    return
  }
  guard @fs.read_file(root + "/prepared.txt")
    .text()
    .contains("build=" + build + "\n") &&
    @fs.read_file(root + "/prepared.txt")
    .text()
    .contains("commit=" + commit + "\n") else {
    fail("preparation missing for this build")
  }
  let (prompt_directory, prefill_count) = prepared_prompt(
    @fs.read_file(root + "/prepared.txt").text(),
  )
  let (maximum_new_tokens, stop_token) = prepared_generation(
    @fs.read_file(root + "/prepared.txt").text(),
  )
  // Resolve the entire requested context before either GPU owns checkpoint
  // weights. This is CPU-only prompt planning, not a payload checksum scan.
  record(
    root,
    execution_label(mode, "prompt-preflight"),
    remote(
      first,
      first.root +
      "/deepseek_checkpoint.exe preflight-generation " +
      first.checkpoint +
      "/DeepSeek-V4-Flash-DSpark 6 256 " +
      maximum_new_tokens.to_string() +
      " " +
      stop_token.to_string() +
      " " +
      first.root +
      "/" +
      prompt_directory +
      " " +
      prefill_count.to_string() +
      " " +
      (reserve / 4L).to_string(),
    ),
  )
  @fs.write_file(
    root + "/" + mode + "-started.txt",
    "starting prepared checkpoint execution\n",
    create_mode=CreateNew,
  )
  let egress = name + "egress"
  let ingress = name + "ingress"
  let peers = "192.168.2.179:28578 192.168.2.179:28579 "
  // Check both hosts before starting either model owner. Otherwise a busy
  // ingress GPU can leave a new egress waiting with its checkpoint resident.
  admit(first, root, execution_label(mode, "ingress"))
  admit(last, root, execution_label(mode, "egress"))
  start(
    last,
    root,
    egress,
    "96G",
    14400,
    last.root +
    "/deepseek_checkpoint.exe egress-dspark " +
    args1 +
    last.root +
    "/aot stage-1.cubin " +
    peers,
  )
  for ;; {
    let output = remote(
      last,
      "systemctl --user show " +
      egress +
      " -p MainPID -p ActiveState -p SubState",
    )
    output.check()
    let status = output.stdout()
    guard status.contains("ActiveState=active\n") &&
      status.contains("SubState=running\n") else {
      collect(last, root, egress)
      fail("egress terminated before listening")
    }
    let pid = remote(
      last,
      "systemctl --user show " + egress + " -p MainPID --value",
    )
    pid.check()
    let owner = pid.stdout().trim().to_owned()
    guard owner != "0" &&
      !owner.is_empty() &&
      owner.iter().all(c => c is ('0'..='9')) else {
      fail("missing egress PID")
    }
    let listeners = remote(last, "ss -ltnp")
    listeners.check()
    if ["28578", "28579"].all(port => {
        listeners
        .stdout()
        .split("\n")
        .any(line => {
          line.contains("192.168.2.179:" + port) &&
          line.contains("pid=" + owner + ",")
        })
      }) {
      break
    }
    @async.sleep(10000)
  }
  start(
    first,
    root,
    ingress,
    "96G",
    14400,
    first.root +
    "/deepseek_checkpoint.exe " +
    (if mode == "reference" {
      "generate-reference-dspark "
    } else {
      "generate-dspark "
    }) +
    args0 +
    first.root +
    "/aot stage-0.cubin " +
    peers +
    first.root +
    "/" +
    prompt_directory +
    " " +
    prefill_count.to_string() +
    " " +
    maximum_new_tokens.to_string() +
    " " +
    stop_token.to_string() +
    " " +
    first.root +
    "/output-" +
    mode,
  )
  {
    errdefer {
      collect(first, root, ingress)
      collect(last, root, egress)
    }
    wait_unit(first, ingress)
    wait_unit(last, egress)
  }
  collect(first, root, ingress)
  collect(last, root, egress)
  let tokens = root + "/tokens-" + mode + ".txt"
  download(first, first.root + "/output-" + mode + "/tokens.txt", tokens)
  let generated = completed_tokens(
    @fs.read_file(tokens).text(),
    maximum_new_tokens,
    stop_token,
  )
  let journal = @fs.read_file(root + "/" + ingress + "-journal.stdout").text()
  let finish = if stop_token >= 0 &&
    generated[generated.length() - 1] == stop_token {
    "StopToken"
  } else {
    "Length"
  }
  guard journal.contains("generated=\{generated.length()} finish=\{finish}") else {
    fail("terminal generation reason does not match output")
  }
  if mode == "run" && generated.length() > 1 {
    guard journal
      .split("\n")
      .any(line => {
        line.contains("dspark_verified_blocks=") &&
        !line.contains("dspark_verified_blocks=0 ") &&
        line.contains("committed_input_rows=\{generated.length() - 1} ") &&
        line.contains("accepted_prefix_replays=")
      }) else {
      fail("no complete speculative verification/commit generation")
    }
  }
  for (host, label) in [(first, "178"), (last, "179")] {
    let occupied = remote(
      host, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    record(root, execution_label(mode, label + "-gpu-terminal"), occupied)
    guard occupied.stdout().trim().is_empty() else {
      fail("GPU ownership remains after terminal generation")
    }
  }
  if mode == "reference" {
    guard @fs.read_file(tokens).text() ==
      @fs.read_file(root + "/tokens-run.txt").text() else {
      fail("speculative tokens differ from matched ordinary target generation")
    }
    println(
      "real DSpark greedy verification matches ordinary target generation for \{generated.length()} tokens from the prepared prompt; finish=\{finish}; independent upstream numerical parity remains unverified",
    )
  } else {
    println(
      "real DSpark greedy verification/commit generation completed; run matched reference next",
    )
  }
}
