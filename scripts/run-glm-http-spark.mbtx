///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn host(rank : Int32) -> String {
  if rank == 0 {
    "wlc003s@192.168.2.178"
  } else {
    "wlc004s@192.168.2.179"
  }
}

///|
fn socket(rank : Int32) -> String {
  if @env.get_env_var(
      if rank == 0 {
        "LUNAFLUX_SPARK_178_SOCKET"
      } else {
        "LUNAFLUX_SPARK_179_SOCKET"
      },
    )
    is Some(path) {
    return path
  }
  if rank == 0 {
    "/tmp/lunaflux-glm178-prefill-20261018.sock"
  } else {
    "/tmp/lunaflux-glm179-prefill-20261018.sock"
  }
}

///|
async fn remote(rank : Int32, command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=10",
    "-S",
    socket(rank),
    host(rank),
    command,
  ]).output(max_output_bytes=8388608)
}

///|
fn available(text : String) -> Int64 raise {
  for line in text.split("\n") {
    if line.has_prefix("MemAvailable:") {
      for word in line.split(" ") {
        if !word.is_empty() && word[0] is ('0'..<='9') {
          return @string.parse_int64(word)
        }
      }
    }
  }
  fail("missing MemAvailable")
}

///|
fn gpu_mib(text : String) -> Int64 raise {
  let mut total = 0L
  for line in text.split("\n") {
    let s = line.trim()
    if !s.is_empty() {
      total += @string.parse_int64(s)
    }
  }
  total
}

///|
fn stop_order() -> Array[Int32] {
  // The coordinator owns admission and its worker. Keep the peer alive while
  // that owner retires requests and closes the stage channel after release.
  [0, 1]
}

///|
fn unexpected_rank_loss(
  active : Int32,
  paired : Bool,
  requested_stop : Bool,
) -> Bool {
  paired && active == 1 && !requested_stop
}

///|
test "requested drain is distinct from unexpected rank loss" {
  assert_true(unexpected_rank_loss(1, true, false))
  assert_false(unexpected_rank_loss(1, true, true))
  assert_false(unexpected_rank_loss(1, false, false))
  assert_false(unexpected_rank_loss(2, true, false))
}

///|
fn stop_properties() -> String {
  // SIGTERM goes to the owning main process only. A timeout still kills the
  // entire cgroup, so an abandoned child cannot survive a failed drain.
  " --property=KillMode=mixed --property=TimeoutStopSec=90" +
  " --property='ExecStopPost=/usr/bin/echo GLM_UNIT_EXIT result=${SERVICE_RESULT} code=${EXIT_CODE} status=${EXIT_STATUS}'"
}

///|
fn profile_options(
  granularity : String?,
  ranks : String?,
  rank : Int32,
  trace_method~ : String = "cuda",
  events~ : Bool = false,
) -> String raise {
  guard trace_method is ("cuda" | "cuda-hw") else {
    fail("trace method must be cuda or cuda-hw")
  }
  guard ranks is (None | Some("egress") | Some("both")) else {
    fail("profile ranks must be egress or both")
  }
  let trace = match granularity {
    None | Some("node") => "node"
    Some("graph") => "graph:host-only"
    _ => fail("profile granularity must be node or graph")
  }
  if rank == 1 || ranks == Some("both") {
    " --trace=" +
    trace_method +
    " --cuda-graph-trace=" +
    trace +
    " --cuda-flush-interval=0 --cuda-event-trace=" +
    (if events { "true" } else { "false" }) +
    " "
  } else {
    ""
  }
}

///|
test "both-rank graph-only option is explicit, not proof of child injection" {
  assert_true(
    profile_options(Some("graph"), Some("both"), 0).contains("graph:host-only"),
  )
  assert_eq(profile_options(None, None, 0), "")
  assert_true(profile_options(None, None, 1).contains("node"))
}

///|
test "hardware trace and event observation remain explicit diagnostic options" {
  let flags = profile_options(
    Some("node"),
    Some("both"),
    0,
    trace_method="cuda-hw",
    events=true,
  )
  assert_true(flags.contains("--trace=cuda-hw"))
  assert_true(flags.contains("--cuda-graph-trace=node"))
  assert_true(flags.contains("--cuda-event-trace=true"))
  try profile_options(None, None, 1, trace_method="unknown") catch {
    _ => ()
  } noraise {
    _ => fail("unknown tracing method accepted")
  }
}

///|
async fn main {
  guard @env.args() is [_, root, mode] &&
    root.has_prefix("/tmp/lunaflux-glm-http-") &&
    !root.contains("..") &&
    root
    .iter()
    .all(c => c is ('a'..<='z' | 'A'..<='Z' | '0'..<='9' | '/' | '-' | '_')) &&
    mode
    is ("start"
    | "start-traced"
    | "start-profile"
    | "watch"
    | "stop"
    | "status") else {
    fail("ROOT start|start-traced|start-profile|watch|stop|status")
  }
  let tag = root.split("/").last().unwrap().to_string()
  async fn stop() -> Unit {
    let failures = []
    for rank in stop_order() {
      let unit = tag + "-rank\{rank}.service"
      let result = remote(rank, "systemctl --user stop " + unit)
      if result.exit_code() != 0 {
        // A peer can finish from the acknowledged release and clean EOF before
        // this stop reaches systemd. Verify that precise unit, not other owners.
        let state = remote(
          rank,
          "systemctl --user show " + unit + " -p LoadState -p ActiveState",
        )
        if state.exit_code() != 0 ||
          !state.stdout().contains("LoadState=not-found") ||
          !state.stdout().contains("ActiveState=inactive") {
          failures.push(result.stderr() + state.stdout() + state.stderr())
        }
      }
    }
    guard failures.is_empty() else { fail(failures.join("\n")) }
  }
  if mode == "stop" {
    // External lifecycle evidence, published before requesting either stop.
    // Memory and failed-rank checks remain active during intentional draining.
    if !@fs.exists(root + "/stop-requested.txt") {
      @fs.write_file(
        root + "/stop-requested.txt",
        "paired owner drain requested\n",
        create_mode=CreateNew,
      )
    }
    stop()
    return
  }
  if mode == "status" {
    for rank in 0..<2 {
      let result = remote(
        rank,
        "systemctl --user show " +
        tag +
        "-rank\{rank}.service -p ActiveState -p SubState -p Result -p ExecMainStatus -p MemoryPeak -p MemorySwapPeak; journalctl --user -u " +
        tag +
        "-rank\{rank}.service -n 18 --no-pager",
      )
      println(result.stdout())
      result.check()
    }
    return
  }
  if mode == "start" || mode == "start-traced" || mode == "start-profile" {
    guard !@fs.exists(root + "/stop-requested.txt") else {
      fail("retired qualification root; use a fresh run root for a new owner")
    }
    // Trace evidence has its own directory, but the executable and manifest
    // must retain their original, matching artifact root.
    let artifact_root = if @fs.exists(root + "/artifact-root.txt") {
      @fs.read_file(root + "/artifact-root.txt").text().trim().to_owned()
    } else {
      root
    }
    guard artifact_root.has_prefix("/tmp/lunaflux-glm-http-") &&
      !artifact_root.contains("..") &&
      artifact_root.all(c => {
        c is ('a'..<='z' | 'A'..<='Z' | '0'..<='9' | '/' | '-' | '_')
      }) else {
      fail("invalid artifact root")
    }
    for rank in 0..<2 {
      let owners = remote(
        rank, "nvidia-smi --query-compute-apps=pid --format=csv,noheader,nounits",
      )
      owners.check()
      guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
      let mem = remote(rank, "cat /proc/meminfo")
      mem.check()
      guard available(mem.stdout()) >= 16777216L else { fail("host reserve") }
    }
    for rank in [1, 0] {
      let profile = if mode == "start-profile" {
        profile_options(
          @env.get_env_var("LUNAFLUX_NATIVE_GRAPH_TRACE"),
          @env.get_env_var("LUNAFLUX_NATIVE_TRACE_RANKS"),
          rank,
          trace_method=@env.get_env_var("LUNAFLUX_NATIVE_TRACE_METHOD").unwrap_or(
            "cuda",
          ),
          events=@env.get_env_var("LUNAFLUX_NATIVE_TRACE_EVENTS") == Some("1"),
        )
      } else {
        ""
      }
      let interface = if rank == 0 { "enp1s0f1np1" } else { "enp1s0f0np0" }
      let hca = if rank == 0 { "rocep1s0f1" } else { "rocep1s0f0" }
      if !profile.is_empty() {
        remote(rank, "mkdir " + root + "/nsys-tmp").check()
      }
      let command = "systemd-run --user --unit=" +
        tag +
        "-rank\{rank} --setenv=LD_LIBRARY_PATH=/tmp/lunaflux-glm-expert-tp-complete-answers-20261018-v1/nccl --setenv=NCCL_DEBUG=WARN --setenv=NCCL_SOCKET_IFNAME=" +
        interface +
        " --setenv=NCCL_IB_HCA=" +
        hca +
        (if profile.is_empty() {
          ""
        } else {
          " --setenv=TMPDIR=" + root + "/nsys-tmp"
        }) +
        " --property=MemoryMax=100G --property=MemorySwapMax=0 --property=RuntimeMaxSec=10800" +
        stop_properties() +
        " " +
        (if mode == "start-traced" && rank == 0 {
          "/usr/bin/strace -ff -tt -xx -s 8192 -e trace=read,write,recvfrom,sendto,close,shutdown,exit_group -e trace-fds=0,1,2 -z -o " +
          root +
          "/worker-wire "
        } else if !profile.is_empty() {
          // Collection starts explicitly after readiness. Only the egress rank
          // is instrumented by default; both ranks are an explicit option.
          // No profiler code enters the engine or its IR.
          "/opt/nvidia/nsight-systems/2025.3.2/bin/nsys launch --session-new=" +
          tag +
          profile
        } else {
          ""
        }) +
        artifact_root +
        "/glm_service.exe " +
        (if rank == 0 { "serve" } else { "rank1" }) +
        " " +
        artifact_root +
        " service.json"
      let result = remote(rank, command)
      @fs.write_file(
        root + "/start-\{rank}.txt",
        result.stdout() + result.stderr(),
        create_mode=CreateNew,
      )
      if result.exit_code() != 0 {
        stop()
        result.check()
      }
      @async.sleep(1000)
    }
    println("private acceptance service started; public GLM remains offline")
    return
  }
  let out = @fs.open(
    root + "/memory-watch.txt",
    mode=WriteOnly,
    create_mode=CreateNew,
  )
  defer out.close()
  let mut pair_observed = false
  while true {
    let mut active = 0
    for rank in 0..<2 {
      let memory = remote(rank, "cat /proc/meminfo")
      let gpu = remote(
        rank, "nvidia-smi --query-compute-apps=used_gpu_memory --format=csv,noheader,nounits",
      )
      let state = remote(
        rank,
        "systemctl --user show " +
        tag +
        "-rank\{rank}.service -p ActiveState -p Result -p ExecMainStatus -p MemoryCurrent -p MemoryPeak -p MemorySwapCurrent -p MemorySwapPeak",
      )
      memory.check()
      gpu.check()
      state.check()
      let reserve = available(memory.stdout())
      let used = gpu_mib(gpu.stdout())
      out.write(
        "rank=\{rank} host_available_kib=\{reserve} gpu_mib=\{used}\n" +
        state.stdout(),
      )
      if reserve < 16777216L || used > 102400L {
        stop()
        fail("stopped service: memory envelope")
      }
      if state.stdout().contains("ActiveState=active") {
        active += 1
      }
      if state.stdout().contains("ActiveState=failed") {
        stop()
        fail("rank failed; both owned units stopped")
      }
    }
    if active == 0 {
      return
    }
    if active == 2 {
      pair_observed = true
    } else if unexpected_rank_loss(
        active,
        pair_observed,
        @fs.exists(root + "/stop-requested.txt"),
      ) {
      stop()
      fail("one resident rank exited; paired owner stopped")
    }
    @async.sleep(2000)
  }
}

///|
test "coordinator owns graceful shutdown before its worker and peer" {
  assert_eq(stop_order(), [0, 1])
  assert_true(stop_properties().contains("--property=KillMode=mixed"))
  assert_true(stop_properties().contains("--property=TimeoutStopSec=90"))
  assert_false(stop_properties().contains("KillMode=process"))
  assert_true(
    stop_properties().contains(
      "GLM_UNIT_EXIT result=${SERVICE_RESULT} code=${EXIT_CODE} status=${EXIT_STATUS}",
    ),
  )
}
