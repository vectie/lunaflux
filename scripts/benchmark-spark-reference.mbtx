///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

// External reference engine/client. No compiler/runtime import or payload hash.

///|
fn reference_image(glm : Bool, sglang : Bool) -> String {
  if sglang {
    "docker.1ms.run/lmsysorg/sglang:" +
    (if glm { "glm-5.3-flash-arm64" } else { "dev-v4f-2dgx-v2" })
  } else {
    "ghcr.nju.edu.cn/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-e3-20260907"
  }
}

///|
fn sglang_options(glm : Bool) -> String {
  " --chunked-prefill-size 256 --max-prefill-tokens 256" +
  (if glm {
    " --language-only --attention-backend dsa --dsa-prefill-backend tilelang --dsa-decode-backend tilelang --moe-runner-backend flashinfer_cutlass --kv-cache-dtype bfloat16 --disable-shared-experts-fusion --disable-flashinfer-autotune --cuda-graph-max-bs-decode 1 --cuda-graph-max-bs-prefill 256"
  } else {
    " --attention-backend dsv4 --moe-runner-backend b12x --cuda-graph-max-bs-decode 1 --cuda-graph-max-bs-prefill 256 --disable-flashinfer-autotune"
  })
}

///|
fn host(last : Bool) -> String {
  if last {
    "wlc004s@192.168.2.179"
  } else {
    "wlc003s@192.168.2.178"
  }
}

///|
fn socket(last : Bool) -> String {
  if @env.get_env_var(
      if last {
        "LUNAFLUX_SPARK_179_SOCKET"
      } else {
        "LUNAFLUX_SPARK_178_SOCKET"
      },
    )
    is Some(path) {
    return path
  }
  if last {
    "/tmp/lunaflux-checkpoint-live179-20261010.sock"
  } else {
    "/tmp/lunaflux-checkpoint-live-20261010.sock"
  }
}

///|
async fn remote(last : Bool, command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=10",
    "-S",
    socket(last),
    host(last),
    command,
  ]).output(max_output_bytes=16777216)
}

///|
async fn record(root : String, name : String, result : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
}

///|
async fn copy(last : Bool, source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket(last),
    source,
    destination,
  ])
  .output()
  .check()
}

///|
fn checkpoint(glm : Bool, last : Bool) -> String {
  if glm {
    (if last {
      "/tmp/lunaflux-glm-real-20261010.ekEYBzqU"
    } else {
      "/tmp/lunaflux-glm-real-20261010.6yIBQN35"
    }) +
    "/GLM-5.3-Flash-NVFP4"
  } else {
    (if last {
      "/tmp/lunaflux-deepseek-real-20261010.ZYa0kMPT"
    } else {
      "/tmp/lunaflux-deepseek-real-20261010.dLryo68E"
    }) +
    "/DeepSeek-V4-Flash-DSpark"
  }
}

///|
fn payload(
  tokens : Array[Int32],
  glm : Bool,
  sglang : Bool,
  output~ : Int32 = 8,
) -> Json {
  let stops : Array[Json] = [Json(if glm { 154827 } else { 1 })]
  if sglang {
    {
      "input_ids": Json(tokens.map(t => Json(t))),
      "sampling_params": {
        "temperature": 0,
        "max_new_tokens": Json(output),
        "stop_token_ids": Json(stops),
      },
      "stream": false,
    }
  } else {
    {
      "model": "matched-model",
      "prompt": Json(tokens.map(t => Json(t))),
      "temperature": 0,
      "max_tokens": Json(output),
      "stop_token_ids": Json(stops),
      "stream": false,
    }
  }
}

///|
test "profile payload uses the literal two-token diagnostic, ordinary requests stay eight" {
  assert_true(
    payload([1, 2], true, false, output=2)
    .stringify()
    .contains("\"max_tokens\":2"),
  )
  assert_true(
    payload([1, 2], true, false).stringify().contains("\"max_tokens\":8"),
  )
}

///|
fn available_kib(text : String) -> Int64 raise {
  for line in text.split("\n") {
    if line.has_prefix("MemAvailable:") {
      let parts = line.split(" ").filter(s => !s.is_empty()).to_array()
      guard parts is [_, value, "kB"] else { fail("memory units") }
      return @string.parse_int64(value)
    }
  }
  fail("missing host memory observation")
}

///|
async fn stop_ranks(action : async (Bool) -> Unit) -> Unit {
  @async.with_task_group(group => {
    for last in [false, true] {
      group.spawn_bg(() => action(last), allow_failure=true)
    }
  })
}

///|
async fn stop_pair(tag : String) -> Unit {
  stop_ranks(last => {
    let rank = if last { "1" } else { "0" }
    let result = @async.with_timeout(15000, () => {
      remote(last, "docker stop --time 5 " + tag + "-" + rank)
    }) catch {
      error => {
        println("stop rank=\{rank} unconfirmed: \{error}")
        return
      }
    }
    if result.exit_code() != 0 {
      println("stop rank=\{rank} exit=\{result.exit_code()} \{result.stderr()}")
    }
  })
}

///|
async test "slow rank stop does not delay requesting the other stop" {
  let finished : Array[Bool] = []
  stop_ranks(last => {
    if !last {
      @async.sleep(20)
    }
    finished.push(last)
  })
  assert_eq(finished, [true, false])
}

///|
async test "one unreachable rank does not cancel the other stop" {
  let finished : Array[Bool] = []
  stop_ranks(last => {
    if !last {
      fail("simulated unreachable rank")
    }
    @async.sleep(10)
    finished.push(last)
  })
  assert_eq(finished, [true])
}

///|
test "reference uses literal IDs and does not reinterpret the chat template" {
  let p = payload([0, 12, 1], false, false)
  guard p
    is { "prompt": Array([Number(a, ..), Number(b, ..), Number(c, ..)]), .. } else {
    fail("literal ID prompt missing")
  }
  assert_eq((a, b, c), (0.0, 12.0, 1.0))
  assert_eq(available_kib("MemAvailable: 16777216 kB\n"), 16777216L)
}

///|
test "Spark recipes retain distinct GLM and DeepSeek builds" {
  assert_true(reference_image(true, true).has_suffix(":glm-5.3-flash-arm64"))
  assert_true(reference_image(false, true).has_suffix(":dev-v4f-2dgx-v2"))
  assert_eq(reference_image(true, false), reference_image(false, false))
}

///|
test "GLM recipe limits scratch and captures without enabling speculation" {
  let options = sglang_options(true)
  assert_true(options.contains("--dsa-prefill-backend tilelang"))
  assert_true(options.contains("--disable-flashinfer-autotune"))
  assert_true(options.contains("--kv-cache-dtype bfloat16"))
  assert_true(options.contains("--cuda-graph-max-bs-decode 1"))
  assert_true(options.contains("--language-only"))
  assert_false(options.contains("--speculative"))
  assert_false(sglang_options(false).contains("--dsa-prefill-backend"))
  assert_true(sglang_options(false).contains("--moe-runner-backend b12x"))
}

///|
fn vllm_trace_capacity(compact : Bool) -> (Int32, Int32) {
  // The hybrid recurrent model needs 0.14 GiB even at context 64; retain
  // 256 MiB, not merely a token-proportional 128 MiB KV estimate.
  if compact {
    (64, 268435456)
  } else {
    (256, 536870912)
  }
}

///|
fn reference_positive(
  name : String,
  fallback : Int32,
  maximum : Int32,
) -> Int32 raise {
  reference_value(@env.get_env_var(name), fallback, maximum)
}

///|
fn reference_value(
  value : String?,
  fallback : Int32,
  maximum : Int32,
) -> Int32 raise {
  match value {
    None => fallback
    Some(s) => {
      let n = @string.parse_int(s)
      guard n > 0 && n <= maximum else { fail("invalid reference capacity") }
      n
    }
  }
}

///|
test "explicit long trace capacities override short diagnostic defaults" {
  let (context, kv_bytes) = vllm_trace_capacity(true)
  assert_eq(reference_value(Some("8192"), context, 1048576), 8192)
  assert_eq(reference_value(Some("256"), kv_bytes / 1048576, 8192), 256)
  assert_eq(reference_value(Some("64"), 8192, 32768), 64)
  assert_eq(reference_value(None, context, 1048576), 64)
}

///|
fn reference_trace_granularity(value : String?) -> String raise {
  match value {
    None | Some("node") => "node"
    Some("graph") => "graph:host-only"
    _ => fail("LUNAFLUX_REFERENCE_GRAPH_TRACE must be node or graph")
  }
}

///|
fn reference_trace_rank(value : String?, last : Bool) -> Bool raise {
  match value {
    None | Some("both") => true
    Some("egress") => last
    _ => fail("LUNAFLUX_REFERENCE_TRACE_RANKS must be both or egress")
  }
}

///|
test "reference graph trace explicitly omits captured nodes, not eager kernels" {
  assert_eq(reference_trace_granularity(None), "node")
  assert_eq(reference_trace_granularity(Some("graph")), "graph:host-only")
  assert_true(reference_trace_rank(None, false))
  assert_false(reference_trace_rank(Some("egress"), false))
  assert_true(reference_trace_rank(Some("egress"), true))
}

///|
test "compact trace keeps hybrid state capacity and leaves ordinary baseline unchanged" {
  assert_eq(vllm_trace_capacity(true), (64, 268435456))
  assert_eq(vllm_trace_capacity(false), (256, 536870912))
}

///|
async fn main {
  guard @env.args() is [_, root, family, engine, mode, .. rest] &&
    root.has_prefix("/tmp/lunaflux-reference-bench-") &&
    !root.contains("..") &&
    root.iter().all(c => c is ('a'..<='z' | '0'..<='9' | '/' | '-')) &&
    family is ("glm" | "deepseek") &&
    engine is ("vllm" | "sglang") &&
    mode
    is ("prepare"
    | "prepare-profile"
    | "start-profile"
    | "query-profile"
    | "start"
    | "status"
    | "query"
    | "stop"
    | "watch"
    | "collect"
    | "collect-ingress") else {
    fail(
      "NEW_ROOT glm|deepseek vllm|sglang prepare NATIVE_CORPUS | start|status|query|stop|watch|collect|collect-ingress",
    )
  }
  let glm = family == "glm"
  let sg = engine == "sglang"
  let image = reference_image(glm, sg)
  let tag = root[5:].to_owned()
  let profile = mode is ("prepare-profile" | "start-profile" | "query-profile")
  let granularity = reference_trace_granularity(
    @env.get_env_var("LUNAFLUX_REFERENCE_GRAPH_TRACE"),
  )
  let trace_ranks = @env.get_env_var("LUNAFLUX_REFERENCE_TRACE_RANKS")
  let trace_ingress = reference_trace_rank(trace_ranks, false)
  // This is a separately labelled selected-kernel trace, not the ordinary
  // graph-enabled timing baseline. Avoid graph-capture memory at the host floor.
  let eager_profile = profile &&
    @env.get_env_var("LUNAFLUX_REFERENCE_PROFILE_EAGER") == Some("1")
  // The selected request needs fewer than 64 positions. A smaller, explicitly
  // labelled trace envelope avoids allocating unused startup/warmup capacity.
  // It is never applied to ordinary graph-enabled benchmark cohorts.
  let compact_profile = profile &&
    @env.get_env_var("LUNAFLUX_REFERENCE_PROFILE_COMPACT") == Some("1")
  let (trace_context, trace_kv_bytes) = vllm_trace_capacity(compact_profile)
  // Explicit capacities apply equally to timing and tracing. The historical
  // short diagnostic defaults remain, but must not silently replace a matched
  // long-context workload when profiling is requested.
  let context = reference_positive(
    "LUNAFLUX_REFERENCE_CONTEXT", trace_context, 1048576,
  )
  let kv_bytes = reference_positive(
      "LUNAFLUX_REFERENCE_KV_MIB",
      trace_kv_bytes / 1048576,
      8192,
    ).to_int64() *
    1048576L
  let sequences = reference_positive("LUNAFLUX_REFERENCE_SEQUENCES", 1, 64)
  let batch_tokens = reference_positive(
    "LUNAFLUX_REFERENCE_BATCH_TOKENS", context, 32768,
  )
  let capture_option = match
    @env.get_env_var("LUNAFLUX_REFERENCE_CAPTURE_MAX") {
    None => ""
    Some(_) =>
      " --max-cudagraph-capture-size \{reference_positive("LUNAFLUX_REFERENCE_CAPTURE_MAX", 16, 512)}"
  }
  guard !profile || (glm && !sg) else {
    fail("bounded profile is GLM/vLLM only")
  }
  if mode == "watch" {
    let observations = StringBuilder()
    for tick in 0..<1500 {
      let mut terminal = 0
      let mut failed = false
      for last in [false, true] {
        let rank = if last { "1" } else { "0" }
        let status = @async.with_timeout(10000, () => {
          remote(
            last,
            "systemctl --user show " +
            tag +
            "-" +
            rank +
            ".service -p SubState -p Result -p ExecMainStatus; grep MemAvailable /proc/meminfo",
          )
        }) catch {
          error => {
            observations <+
              "tick=\{tick} rank=\{rank} observation_error=\{error}\n"
            failed = true
            break
          }
        }
        observations <+ "tick=\{tick} rank=\{rank}\n\{status.stdout()}"
        let gpu = remote(
          last, "nvidia-smi --query-compute-apps=used_memory --format=csv,noheader,nounits",
        )
        let used = gpu
          .stdout()
          .split("\n")
          .filter(s => !s.trim().is_empty())
          .fold(init=0L, (sum, s) => sum + @string.parse_int64(s.trim()))
        observations <+ "gpu_mib=\{used}\n"
        if status.exit_code() != 0 ||
          gpu.exit_code() != 0 ||
          used > 102400L ||
          available_kib(status.stdout()) < 16777216L ||
          status.stdout().contains("SubState=failed") {
          failed = true
          break
        }
        if status.stdout().contains("SubState=exited") {
          terminal += 1
        }
      }
      if failed || terminal == 2 {
        @fs.write_file(
          root + "/memory-watch.txt",
          observations.to_string(),
          create_mode=CreateNew,
        )
        if failed {
          stop_pair(tag)
        }
        guard !failed else {
          fail(
            "external rank/observation failed or 16 GiB host floor reached; paired stop requested, verify release",
          )
        }
        println("both reference ranks retired")
        return
      }
      @async.sleep(5000)
    }
    stop_pair(tag)
    @fs.write_file(
      root + "/memory-watch.txt",
      observations.to_string(),
      create_mode=CreateNew,
    )
    fail(
      "bounded reference watch expired; paired stop requested, verify release",
    )
  }
  if mode is ("collect" | "collect-ingress") {
    for
      last in (if mode == "collect-ingress" { [false] } else { [false, true] }) {
      let rank = if last { "1" } else { "0" }
      record(
        root,
        "terminal-" + rank,
        remote(
          last,
          "systemctl --user show " +
          tag +
          "-" +
          rank +
          ".service -p ActiveState -p SubState -p Result -p ExecMainStatus; journalctl --user -u " +
          tag +
          "-" +
          rank +
          " --no-pager",
        ),
      )
    }
    return
  }
  if mode is ("prepare" | "prepare-profile") {
    guard rest is [corpus] && corpus.has_prefix("/tmp/lunaflux-model-bench-") else {
      fail("prepared literal corpus required")
    }
    @fs.mkdir(root)
    for last in [false, true] {
      record(
        root,
        if last {
          "179-mkdir"
        } else {
          "178-mkdir"
        },
        remote(last, "mkdir " + root),
      )
    }
    for i in 0..<(if profile { 1 } else { 6 }) {
      let text = @fs.read_file(corpus + "/input-\{i}-tokens.txt").text().trim()
      let tokens : Array[Int32] = []
      for item in text.split(",") {
        tokens.push(@string.parse_int(item))
      }
      guard !tokens.is_empty() && tokens.all(t => t >= 0) else {
        fail("invalid IDs")
      }
      guard tokens.length() + (if profile { 2 } else { 8 }) <= context else {
        fail("literal request exceeds the selected context capacity")
      }
      let path = root + "/request-\{i}.json"
      @fs.write_file(
        path,
        payload(tokens, glm, sg, output=if profile { 2 } else { 8 }).stringify(),
        create_mode=CreateNew,
      )
      copy(false, path, host(false) + ":" + path)
    }
    @fs.write_file(
      root + "/configuration.txt",
      "image=" +
      image +
      "\ncheckpoint=" +
      family +
      "\nengine=" +
      engine +
      "\ntp=2\npp=1\ncontext=\{context}" +
      (if sg { "" } else { "\nkv_bytes=\{kv_bytes}" }) +
      "\nmaximum_sequences=\{sequences}\nbatch_tokens=\{batch_tokens}\nconcurrency=1\nmax_output=" +
      (if profile { "2" } else { "8" }) +
      "\nspeculation=false\nprefix_cache=false\ncorpus=" +
      corpus +
      (if profile {
        "\nprofile=cuda-profiler-api\nprofile_output=2\nprofile_requests=1\n" +
        "profile_eager=\{eager_profile}\nprofile_compact=\{compact_profile}\nprofile_graph_trace=\{granularity}\nprofile_ingress=\{trace_ingress}\nprofile_egress=true\n"
      } else {
        ""
      }) +
      (if sg { "\nsglang_options=" + sglang_options(glm) } else { "" }) +
      (if capture_option.is_empty() {
        ""
      } else {
        "\ncapture_option=" + capture_option
      }) +
      "\n",
      create_mode=CreateNew,
    )
    return
  }
  guard rest.is_empty() else { fail("unexpected arguments") }
  if mode == "stop" {
    for last in [false, true] {
      let rank = if last { "1" } else { "0" }
      record(
        root,
        "stop-" + rank,
        remote(last, "docker stop --time 30 " + tag + "-" + rank),
      )
    }
    return
  }
  if mode == "status" {
    for last in [false, true] {
      let rank = if last { "1" } else { "0" }
      let result = remote(
        last,
        "systemctl --user show " +
        tag +
        "-" +
        rank +
        ".service -p ActiveState -p SubState -p Result -p ExecMainStatus; journalctl --user -u " +
        tag +
        "-" +
        rank +
        " -n 60 --no-pager; grep MemAvailable /proc/meminfo",
      )
      println("rank=" + rank + "\n" + result.stdout())
    }
    return
  }
  if mode is ("query" | "query-profile") {
    let readiness = StringBuilder()
    let mut ready = false
    for attempt in 0..<180 {
      let health = remote(
        false, "curl --fail --silent --show-error --max-time 3 http://127.0.0.1:28880/health",
      )
      readiness <+
        "attempt=\{attempt} status=\{health.exit_code()}\n\{health.stderr()}"
      if health.exit_code() == 0 {
        ready = true
        break
      }
      let state = remote(
        false,
        "systemctl --user show " + tag + "-0.service -p SubState",
      )
      state.check()
      if state.stdout().contains("SubState=failed") ||
        state.stdout().contains("SubState=exited") {
        break
      }
      @async.sleep(5000)
    }
    @fs.write_file(
      root + "/readiness.txt",
      readiness.to_string(),
      create_mode=CreateNew,
    )
    guard ready else {
      if profile {
        stop_pair(tag)
      }
      fail("reference did not become ready; no benchmark result")
    }
    record(
      root,
      "health",
      remote(
        false, "curl --fail --silent --show-error --max-time 10 http://127.0.0.1:28880/health",
      ),
    )
    let endpoint = if sg { "/generate" } else { "/v1/completions" }
    record(
      root,
      "warmup-timing",
      remote(
        false,
        "curl --fail --silent --show-error --max-time 900 -H 'Content-Type: application/json' --data-binary @" +
        root +
        "/request-0.json -o " +
        root +
        "/warmup-response.json -w 'http=%{http_code} total_seconds=%{time_total}\n' http://127.0.0.1:28880" +
        endpoint,
      ),
    )
    copy(
      false,
      host(false) + ":" + root + "/warmup-response.json",
      root + "/warmup-response.json",
    )
    if profile {
      let start = remote(
        false, "curl --fail --silent --show-error --max-time 30 -X POST http://127.0.0.1:28880/start_profile",
      )
      if start.exit_code() != 0 {
        stop_pair(tag)
      }
      record(root, "start-profile", start)
    }
    for i in 0..<(if profile { 1 } else { 6 }) {
      record(
        root,
        "request-\{i}-timing",
        remote(
          false,
          "curl --fail --silent --show-error --max-time 900 -H 'Content-Type: application/json' --data-binary @" +
          root +
          "/request-\{i}.json -o " +
          root +
          "/response-\{i}.json -w 'http=%{http_code} total_seconds=%{time_total}\n' http://127.0.0.1:28880" +
          endpoint,
        ),
      )
      copy(
        false,
        host(false) + ":" + root + "/response-\{i}.json",
        root + "/response-\{i}.json",
      )
    }
    if profile {
      let stop = remote(
        false, "curl --fail --silent --show-error --max-time 60 -X POST http://127.0.0.1:28880/stop_profile",
      )
      if stop.exit_code() != 0 {
        stop_pair(tag)
      }
      record(root, "stop-profile", stop)
      // Reports are finalized before model shutdown; retain a failed capture.
      for last in [false, true] {
        if !reference_trace_rank(trace_ranks, last) {
          continue
        }
        let mut ready = false
        for _ in 0..<60 {
          let state = remote(last, "test -s " + root + "/timeline.nsys-rep")
          if state.exit_code() == 0 {
            ready = true
            break
          }
          @async.sleep(1000)
        }
        if !ready {
          stop_pair(tag)
          fail("profile report not finalized; stopped pair")
        }
        copy(
          last,
          host(last) + ":" + root + "/timeline.nsys-rep",
          root + (if last { "/egress.nsys-rep" } else { "/ingress.nsys-rep" }),
        )
      }
    }
    if !profile &&
      glm &&
      !sg &&
      @env.get_env_var("LUNAFLUX_REFERENCE_STREAM_DIAGNOSTIC") == Some("1") {
      let diagnostic = @shell.Cmd("moon", [
        "run", "scripts/measure-glm-reference-stream.mbtx", root,
      ]).output(max_output_bytes=8388608)
      @fs.write_file(
        root + "/stream-diagnostic.stdout",
        diagnostic.stdout(),
        create_mode=CreateNew,
      )
      @fs.write_file(
        root + "/stream-diagnostic.stderr",
        diagnostic.stderr(),
        create_mode=CreateNew,
      )
      if diagnostic.exit_code() != 0 {
        stop_pair(tag)
      }
      diagnostic.check()
    }
    stop_pair(tag)
    println(
      (if profile {
        "one profiled literal request"
      } else {
        "six literal requests"
      }) +
      " collected; paired stop requested, verify release",
    )
    return
  }
  for last in [false, true] {
    let profilers = remote(last, "ps -eo comm=")
    profilers.check()
    guard !profilers
      .stdout()
      .split("\n")
      .any(name => name.trim() is ("nsys" | "QdstrmImporter")) else {
      fail(
        "profile capture/conversion still owns host memory; wait before model loading",
      )
    }
    let memory = remote(last, "grep MemAvailable /proc/meminfo")
    memory.check()
    guard available_kib(memory.stdout()) >= 16777216L else {
      fail("host reserve unavailable before launch")
    }
    let owners = remote(
      last, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    owners.check()
    guard owners.stdout().trim().is_empty() else {
      fail("GPU already occupied")
    }
    record(
      root,
      if last {
        "179-image"
      } else {
        "178-image"
      },
      remote(
        last,
        "docker image inspect --format '{{.Architecture}} {{.Created}}' " +
        image,
      ),
    )
  }
  for last in [true, false] {
    let capture_rank = profile && reference_trace_rank(trace_ranks, last)
    let rank = if last { "1" } else { "0" }
    let ip = if last { "10.0.0.2" } else { "10.0.0.1" }
    let interface = if last { "enp1s0f0np0" } else { "enp1s0f1np1" }
    let hca = if last { "rocep1s0f0" } else { "rocep1s0f1" }
    let command = if sg {
      "python3 -m sglang.launch_server --model-path /model --served-model-name matched-model --tp-size 2 --nnodes 2 --node-rank " +
      rank +
      " --dist-init-addr 10.0.0.1:29570 --host 127.0.0.1 --port 28880 --context-length 256 --max-total-tokens 1024 --max-running-requests 1 --mem-fraction-static 0.80 --disable-radix-cache --trust-remote-code" +
      sglang_options(glm)
    } else {
      "vllm serve /model --served-model-name matched-model --tensor-parallel-size 2 --nnodes 2 --node-rank " +
      rank +
      " --master-addr 10.0.0.1 --master-port 29570 --distributed-executor-backend mp --host 127.0.0.1 --port 28880 --max-model-len \{context} --max-num-seqs \{sequences} --max-num-batched-tokens \{batch_tokens} --gpu-memory-utilization 0.80 --kv-cache-memory-bytes \{kv_bytes} --no-enable-prefix-caching --trust-remote-code" +
      (if glm { " --language-model-only" } else { "" }) +
      capture_option +
      (if eager_profile { " --enforce-eager" } else { "" }) +
      (if last { " --headless" } else { "" })
    }
    let nsys = "/opt/nvidia/nsight-systems/2025.3.2/bin/nsys"
    let profile_args = " profile --trace=cuda,nvtx --sample=none --cpuctxsw=none --cuda-graph-trace=\{granularity} --capture-range=cudaProfilerApi --capture-range-end=stop --output=/run-result/timeline vllm "
    record(
      root,
      "start-" + rank,
      remote(
        last,
        "systemd-run --user --unit=" +
        tag +
        "-" +
        rank +
        " --property=RemainAfterExit=yes --property=RuntimeMaxSec=7200 docker run --rm --name " +
        tag +
        "-" +
        rank +
        " --network host --gpus all --ipc=private --shm-size=2g --memory=96g --memory-swap=96g --ulimit memlock=-1 --cap-add IPC_LOCK --device=/dev/infiniband -v " +
        checkpoint(glm, last) +
        ":/model:ro -v " +
        root +
        ":/run-result" +
        (if profile {
          " -v /opt/nvidia/nsight-systems/2025.3.2:/opt/nvidia/nsight-systems/2025.3.2:ro"
        } else {
          ""
        }) +
        " -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1 -e VLLM_HOST_IP=" +
        ip +
        " -e NCCL_SOCKET_IFNAME=" +
        interface +
        (if sg {
          " -e TP_SOCKET_IFNAME=" +
          interface +
          " -e NCCL_CUMEM_ENABLE=0 -e NCCL_NVLS_ENABLE=0 -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
        } else {
          ""
        }) +
        (if sg && !glm {
          " -e SGLANG_SM120_FLASHMLA_BACKEND=b12x -e SGLANG_B12X_MAX_TOKENS=256"
        } else {
          ""
        }) +
        " -e GLOO_SOCKET_IFNAME=" +
        interface +
        " -e NCCL_IB_HCA=" +
        hca +
        " -e NCCL_IB_DISABLE=0 -e HF_HOME=/run-result/hf --entrypoint " +
        (if capture_rank { nsys } else if sg { "python3" } else { "vllm" }) +
        " " +
        image +
        " " +
        (if capture_rank { profile_args } else { "" }) +
        command[if sg { 8 } else { 5 }:].to_owned() +
        (if profile {
          " --profiler-config '{\"profiler\":\"cuda\"}'"
        } else {
          ""
        }),
      ),
    )
  }
  println("started external pair; both GPUs reserved until stopped or failed")
}
