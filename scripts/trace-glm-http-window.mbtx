///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/async@0.22.4/http",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
}

// One diagnostic request or a fixed cold/warm pair, not a latency sweep. Startup, warmup and report
// conversion are outside the capture. The launcher selects observed ranks;
// separate rank traces do not imply synchronized clocks or full coverage.
// No compiler/runtime instrumentation.

///|
fn require_replay_scope(config : Json, sites : Int32) -> Unit raise {
  guard config is Object(fields) &&
    fields.get("collective_replay") == Some(Json("exact-capacity")) &&
    fields.get("collective_window_sites") == Some(Json(sites)) else {
    fail("trace control omitted the requested exact collective window policy")
  }
}

///|
test "latest-path trace cannot silently revert to decode-only collectives" {
  require_replay_scope(
    { "collective_replay": "exact-capacity", "collective_window_sites": 16 },
    16,
  )
  let wrongs : Array[Json] = [
    {},
    { "collective_replay": "exact-capacity" },
    { "collective_replay": "exact-capacity", "collective_window_sites": 8 },
  ]
  for wrong in wrongs {
    try require_replay_scope(wrong, 16) catch {
      _ => ()
    } noraise {
      _ => fail("accepted a different trace execution policy")
    }
  }
}

///|
async fn wait_capture_drained(drained : Ref[Bool]) -> Unit {
  while !drained.val {
    @async.sleep(10)
  }
}

///|
async test "a second stop caller waits for drain before starting another phase" {
  let drained = Ref(false)
  let issued = Ref(false)
  @async.with_task_group(group => {
    group.spawn_bg(() => {
      issued.val = true
      @async.sleep(20)
      drained.val = true
    })
    wait_capture_drained(drained)
    assert_true(issued.val && drained.val)
  })
}

///|
async fn main {
  guard @env.args() is [_, root, request_file, .. options] &&
    options is ([] | ["--cold-warm"]) &&
    root.has_prefix("/tmp/lunaflux-glm-http-") &&
    root.all(c => c is ('a'..<='z' | '0'..<='9' | '-' | '/')) else {
    fail("PREPARED_NATIVE_TRACE_ROOT LITERAL_REQUEST_JSON [--cold-warm]")
  }
  if @env.get_env_var("LUNAFLUX_TRACE_EXPECT_REPLAY_SITES") is Some(value) {
    let sites = @string.parse_int(value)
    guard sites > 0 else { fail("positive expected replay sites") }
    let artifact = @fs.read_file(root + "/artifact-root.txt")
      .text()
      .trim()
      .to_owned()
    for path in [root, artifact] {
      for rank in 0..<2 {
        require_replay_scope(
          @json.parse(@fs.read_file(path + "/service-\{rank}.json").text()),
          sites,
        )
      }
    }
  }
  async fn saved(
    label : String,
    program : String,
    args : Array[String],
    environment : Map[String, String],
  ) -> Unit {
    let out = @shell.Cmd(program, args, env=environment).output(
      max_output_bytes=8388608,
    )
    @fs.write_file(
      root + "/" + label + ".stdout",
      out.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/" + label + ".stderr",
      out.stderr(),
      create_mode=CreateNew,
    )
    out.check()
  }
  let owner = ["run", "scripts/run-glm-http-spark.mbtx", root]
  let activity = @env.get_env_var("LUNAFLUX_ACTIVITY_LIBRARY_ROOT") != None
  let trace = if activity {
    ["run", "scripts/trace-glm-activity.mbtx", root]
  } else {
    ["run", "scripts/trace-glm-long-http.mbtx", root, "native"]
  }
  let credential = @fs.read_file(root + "/acceptance.credential")
    .text()
    .trim()
    .to_owned()
  let watch = @fs.open(
    root + "/bounded-memory.txt",
    mode=WriteOnly,
    create_mode=CreateNew,
  )
  defer watch.close()
  let active = Ref(false)
  let completed = Ref(false)
  let stopped = Ref(false)
  let capture_drained = Ref(false)
  let phase_label = Ref("")
  async fn memory_snapshot(label : String) -> Unit {
    for rank in 0..<2 {
      saved(
        "memory-" + label + "-rank\{rank}",
        "ssh",
        [
          "-S",
          if rank == 0 {
            "/tmp/lunaflux-glm178-context-20261019.sock"
          } else {
            "/tmp/lunaflux-glm179-context-20261019.sock"
          },
          "-o",
          "BatchMode=yes",
          if rank == 0 {
            "wlc003s@192.168.2.178"
          } else {
            "wlc004s@192.168.2.179"
          },
          "cat /proc/meminfo; ps -eo pid,ppid,rss,comm --sort=-rss | head -20",
        ],
        {},
      )
    }
  }
  let progress_plugin = @env.get_env_var("LUNAFLUX_NCCL_PROGRESS_PLUGIN")
  async fn progress(mode : String, label : String) -> Unit {
    if progress_plugin is Some(path) {
      guard path.rev_find("/") is Some(i) else { fail("progress plugin path") }
      for rank in 0..<2 {
        saved(
          "progress-" + label + "-rank\{rank}",
          "ssh",
          [
            "-S",
            if rank == 0 {
              "/tmp/lunaflux-glm178-context-20261019.sock"
            } else {
              "/tmp/lunaflux-glm179-context-20261019.sock"
            },
            "-o",
            "BatchMode=yes",
            if rank == 0 {
              "wlc003s@192.168.2.178"
            } else {
              "wlc004s@192.168.2.179"
            },
            path[:i].to_owned() + "/progress-control " + root + " " + mode,
          ],
          {},
        )
      }
    }
  }
  async fn network(label : String) -> Unit {
    if options.is_empty() {
      return
    }
    for rank in 0..<2 {
      let hca = if rank == 0 { "rocep1s0f1" } else { "rocep1s0f0" }
      saved(
        "network-" + label + "-rank\{rank}",
        "ssh",
        [
          "-S",
          if rank == 0 {
            "/tmp/lunaflux-glm178-context-20261019.sock"
          } else {
            "/tmp/lunaflux-glm179-context-20261019.sock"
          },
          "-o",
          "BatchMode=yes",
          if rank == 0 {
            "wlc003s@192.168.2.178"
          } else {
            "wlc004s@192.168.2.179"
          },
          "grep -H . /sys/class/infiniband/" +
          hca +
          "/ports/1/counters/* /sys/class/infiniband/" +
          hca +
          "/ports/1/hw_counters/*",
        ],
        {},
      )
    }
  }
  async fn stop_capture() -> Unit {
    if active.val && !stopped.val {
      stopped.val = true
      defer {
        capture_drained.val = true
      }
      // Stop callback retention before report flushing: flushing is not part
      // of the fixed GPU window and must not exhaust the finite event pool.
      progress("0", "stop" + phase_label.val)
      saved(
        "bounded-stop" + phase_label.val,
        "moon",
        [..trace, "stop"],
        if phase_label.val == "" {
          {}
        } else {
          { "LUNAFLUX_TRACE_LABEL": phase_label.val[1:].to_owned() }
        },
      )
      memory_snapshot("stopped" + phase_label.val)
    } else if active.val {
      // A timer may already own the stop RPC. Retiring the model or starting
      // the next capture must wait for that RPC to drain, not just be issued.
      wait_capture_drained(capture_drained)
    }
  }
  async fn request(name : String, text : String) -> Unit {
    @fs.write_file(
      root + "/" + name + ".request.json",
      text,
      create_mode=CreateNew,
    )
    let client = @http.Client("http://127.0.0.1:18889")
    defer client.close()
    let reply = client.post("/v1/chat/completions", text, extra_headers={
      "Content-Type": "application/json",
      "Authorization": "Bearer " + credential,
      "Content-Length": @utf8.encode(text).length().to_string(),
    })
    let body = client.read_all().text()
    @fs.write_file(root + "/" + name + ".response", body, create_mode=CreateNew)
    guard reply.code == 200 else { fail("HTTP \{reply.code}: " + body) }
    guard body.contains("finish_reason") else {
      fail("incomplete HTTP response")
    }
  }
  let result = try {
    progress("init", "init")
    saved(
      "bounded-start",
      "moon",
      [..owner, if activity { "start-activity" } else { "start-profile" }],
      {},
    )
    defer saved("bounded-retire", "moon", [..owner, "stop"], {})
    @async.with_task_group(group => {
      group.spawn_bg(() => {
        while !completed.val {
          for rank in 0..<2 {
            let out = @shell.Cmd("ssh", [
              "-S",
              if rank == 0 {
                "/tmp/lunaflux-glm178-context-20261019.sock"
              } else {
                "/tmp/lunaflux-glm179-context-20261019.sock"
              },
              "-o",
              "BatchMode=yes",
              "-o",
              "ConnectTimeout=5",
              if rank == 0 {
                "wlc003s@192.168.2.178"
              } else {
                "wlc004s@192.168.2.179"
              },
              "awk '/MemAvailable:/ {print $2}' /proc/meminfo",
            ]).output()
            out.check()
            let reserve = @string.parse_int64(out.stdout().trim())
            watch.write(
              "at=\{@async.now()} rank=\{rank} host_available_kib=\{reserve}\n",
            )
            if reserve < 17825792L {
              stop_capture()
              fail(
                "17 GiB diagnostic headroom stop before the 16 GiB service floor",
              )
            }
          }
          @async.sleep(250)
        }
      })
      group.spawn_bg(() => {
        saved("service-watch", "moon", [..owner, "watch"], {})
      })
      let ready = Ref(false)
      for _ in 0..<180 {
        let client = @http.Client("http://127.0.0.1:18889")
        let health = try
          client.get("/health", extra_headers={
            "Authorization": "Bearer " + credential,
          }).code ==
          200
        catch {
          _ => false
        }
        client.close()
        if health {
          ready.val = true
          break
        }
        @async.sleep(2000)
      }
      guard ready.val else { fail("readiness timeout") }
      let warmup : Json = {
        "model": "glm-5.3",
        "messages": [
          { "role": "user", "content": "Reply with the integer 323." },
        ],
        "max_tokens": 1,
        "temperature": 0,
        "stream": false,
      }
      request("warmup", warmup.stringify())
      memory_snapshot("ready")
      for
        (label, phase) in (if options.is_empty() {
          [("", "1")]
        } else {
          [("cold", "1"), ("warm", "2")]
        }) {
        phase_label.val = if label == "" { "" } else { "-" + label }
        stopped.val = false
        capture_drained.val = false
        network(label + "-before")
        progress(phase, "start" + phase_label.val)
        saved(
          "bounded-capture-start" + phase_label.val,
          "moon",
          [..trace, "start"],
          if label == "" {
            {}
          } else {
            { "LUNAFLUX_TRACE_LABEL": label }
          },
        )
        active.val = true
        defer stop_capture()
        memory_snapshot("started" + phase_label.val)
        @async.with_task_group(capture => {
          if @env.get_env_var("LUNAFLUX_TRACE_CAPTURE_MILLIS") is Some(value) {
            let milliseconds = @string.parse_int(value)
            guard milliseconds >= 50 && milliseconds <= 1000 else {
              fail("bounded capture must be 50..1000 ms")
            }
            capture.spawn_bg(() => {
              @async.sleep(milliseconds)
              stop_capture()
            })
          }
          @async.with_timeout(60000, () => {
            request(
              "profile" + phase_label.val,
              @fs.read_file(request_file).text(),
            )
          })
          stop_capture()
        })
        active.val = false
        network(label + "-after")
        if !options.is_empty() {
          let body = @fs.read_file(
            root + "/profile" + phase_label.val + ".response",
          ).text()
          guard body.contains("\"prompt_tokens\":7973") &&
            body.contains("\"cached_tokens\":0") &&
            body.contains("[DONE]") else {
            fail(
              "cold/warm workload differs or prompt reused; no matched claim",
            )
          }
        }
      }
      if @env.get_env_var("LUNAFLUX_TRACE_CORRECTNESS") == Some("1") {
        // Outside the measured window: exercise partial chunks and retirement
        // after the long request has already exercised exact and tail rows.
        let correctness : Json = {
          "model": "glm-5.3",
          "messages": [
            {
              "role": "user",
              "content": "What is 17 * 19? Reply with only the integer.",
            },
          ],
          "max_tokens": 128,
          "temperature": 0,
          "stream": false,
        }
        @async.with_timeout(60000, () => {
          request("correctness", correctness.stringify())
        })
        guard @fs.read_file(root + "/correctness.response")
          .text()
          .contains("323") else {
          fail("arithmetic correctness request did not produce 323")
        }
      }
      if activity {
        saved("bounded-seal", "moon", [..trace, "seal"], {})
      }
      completed.val = true
      saved("bounded-drain", "moon", [..owner, "stop"], {})
    })
    "COMPLETE: fixed diagnostic request scope; inspect cold/warm and proxy coverage before attribution"
  } catch {
    error => "FAILED: " + error.to_string()
  }
  @fs.write_file(root + "/CAPTURE_RESULT.txt", result, create_mode=CreateNew)
  println(result)
  guard result.has_prefix("COMPLETE") else { fail(result) }
}
