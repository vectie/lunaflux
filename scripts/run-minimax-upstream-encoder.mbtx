///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
let node : String = "wlc004s@192.168.2.179"

///|
let socket : String = "/tmp/lunaflux-checkpoint-live179-20261010.sock"

///|
let image : String = "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/h3-runtime-serving:20260923-arm64-r2"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=2097152,
  )
}

///|
async fn upload(source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket,
    source,
    node + ":" + destination,
  ])
  .output()
  .check()
}

///|
async fn record(root : String, name : String, result : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
}

///|
fn literal_rows(bytes : Bytes) -> Int raise {
  guard bytes.length() > 0 && bytes.length() % 4 == 0 && bytes.length() <= 4096 else {
    fail("bounded complete I32 input required")
  }
  bytes.length() / 4
}

///|
test "original module replay retains complete literal inputs" {
  assert_eq(literal_rows(Bytes::make(140 * 4, 0)), 140)
  assert_eq(literal_rows(Bytes::make(1024 * 4, 0)), 1024)
  for bytes in [b"", b"\x00", Bytes::make(4097, 0)] {
    try literal_rows(bytes) catch {
      _ => ()
    } noraise {
      _ => fail("incomplete or unbounded literal input accepted")
    }
  }
}

///|
fn replay_layer(
  options : ArrayView[String],
  layers : Int,
) -> (Int, String?) raise {
  match options {
    [] => (-1, None)
    ["--replay-layer", frontier, input] => {
      let layer = @string.parse_int(frontier)
      guard layers == 1 && layer >= 1 && layer <= 50 else {
        fail("matched replay needs one layer and hidden-state index 1..50")
      }
      (layer - 1, Some(input))
    }
    _ => fail("[--replay-layer NEXT_HIDDEN_INDEX INPUT_BF16] required")
  }
}

///|
test "original matched replay is one literal layer, not a new propagated prefix" {
  assert_eq(replay_layer([], 50), (-1, None))
  assert_eq(
    replay_layer(["--replay-layer", "7", "hidden-6.bf16"], 1),
    (6, Some("hidden-6.bf16")),
  )
  assert_eq(replay_layer(["--replay-layer", "50", "hidden-49.bf16"], 1).0, 49)
  for
    (options, layers) in [
      (["--replay-layer", "0", "input"], 1),
      (["--replay-layer", "51", "input"], 1),
      (["--replay-layer", "7", "input"], 50),
      (["--replay-layer", "7"], 1),
    ] {
    try replay_layer(options, layers) catch {
      _ => ()
    } noraise {
      _ => fail("ambiguous matched replay accepted")
    }
  }
}

///|
fn observed_layers(first : Int, count : Int) -> Array[Int] {
  [
    for i in 0..<=count => first.max(0) + i
  ]
}

///|
async fn selected_first_layer(root : String) -> Int {
  // Old complete-prefix captures predate this optional replay descriptor.
  let descriptor = @fs.read_file(root + "/FIRST_LAYER.txt") catch {
    _ => return -1
  }
  @string.parse_int(descriptor.text())
}

///|
test "matched replay collects only its input and next hidden state" {
  assert_eq(observed_layers(6, 1), [6, 7])
  assert_eq(observed_layers(-1, 2), [0, 1, 2])
}

///|
async fn main {
  guard @env.args() is [_, mode, root, .. extra] &&
    mode is ("prepare" | "run" | "inspect") &&
    (if mode == "prepare" {
      extra.length() == 2 || extra.length() == 5
    } else {
      extra.is_empty()
    }) &&
    root.has_prefix("/tmp/lunaflux-minimax-upstream-encoder-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
    fail(
      "prepare NEW_ROOT LITERAL_IDS_I32 LAYERS [--replay-layer NEXT_HIDDEN_INDEX INPUT_BF16] | run|inspect ROOT",
    )
  }
  let tag = root.split("/").last().unwrap().to_owned()
  if mode == "prepare" {
    let bytes = @fs.read_file(extra[0]).binary()
    let rows = literal_rows(bytes)
    let layers = @string.parse_int(extra[1])
    guard layers >= 1 && layers <= 50 else {
      fail("1..50 original layers required")
    }
    let (first, input) = replay_layer(extra[2:], layers)
    let input_bytes = match input {
      None => b""
      Some(path) => {
        let bytes = @fs.read_file(path).binary()
        guard bytes.length() == rows * 10240 else {
          fail("matched input must preserve every literal BF16 hidden row")
        }
        bytes
      }
    }
    @fs.mkdir(root)
    @fs.mkdir(root + "/layers")
    @fs.write_file(root + "/ids.i32", bytes, create_mode=CreateNew)
    @fs.write_file(
      root + "/LAYERS.txt",
      layers.to_string(),
      create_mode=CreateNew,
    )
    @fs.write_file(root + "/ROWS.txt", rows.to_string(), create_mode=CreateNew)
    @fs.write_file(
      root + "/FIRST_LAYER.txt",
      first.to_string(),
      create_mode=CreateNew,
    )
    record(root, "mkdir", remote("mkdir " + root + " " + root + "/layers"))
    upload(root + "/ids.i32", root + "/ids.i32")
    if input is Some(_) {
      @fs.write_file(
        root + "/input-hidden.bf16",
        input_bytes,
        create_mode=CreateNew,
      )
      upload(root + "/input-hidden.bf16", root + "/input-hidden.bf16")
    }
    upload(
      "benchmarks/checkpoint_aten_reference/aten/encoder_upstream.cpp",
      root + "/encoder_upstream.cpp",
    )
    record(
      root,
      "compile",
      remote(
        "docker run --rm --user 0 --network none --memory 2g --memory-swap 2g -v " +
        root +
        ":/work --entrypoint g++ " +
        image +
        " -O2 -std=c++20 -Wall -Wextra -Werror -I/usr/include/python3.12 /work/encoder_upstream.cpp -o /work/encoder-upstream -lpython3.12",
      ),
    )
  } else if mode == "run" {
    let owners = remote(
      "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    owners.check()
    guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
    let layers = @string.parse_int(@fs.read_file(root + "/LAYERS.txt").text())
    let first = selected_first_layer(root)
    record(
      root,
      "start",
      remote(
        "systemd-run --user --unit=" +
        tag +
        " --property=MemoryMax=8G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1800 --property=RemainAfterExit=yes docker run --name " +
        tag +
        " --user 0 --pull=never --network none --gpus all --memory 8g --memory-swap 8g -e OMP_NUM_THREADS=2 -v " +
        root +
        ":/work -v /tmp/lunaflux-minimax-text-upload-20261010-v2-179/FL2VA/text_encoder:/model:ro --entrypoint /work/encoder-upstream " +
        image +
        " /model /work/ids.i32 /work/layers " +
        layers.to_string() +
        (if first >= 0 {
          " --replay-layer \{first} /work/input-hidden.bf16"
        } else {
          ""
        }),
      ),
    )
  } else {
    let terminal = remote(
      "docker inspect --format '{{.State.Running}} {{.State.ExitCode}} {{.State.OOMKilled}}' " +
      tag,
    )
    terminal.check()
    guard terminal.stdout().trim() == "false 0 false" else {
      fail(
        "original module replay is not successfully terminal: " +
        terminal.stdout(),
      )
    }
    record(
      root,
      "terminal",
      remote(
        "docker logs " +
        tag +
        "; docker inspect --format '{{json .State}}' " +
        tag,
      ),
    )
    let layers = @string.parse_int(@fs.read_file(root + "/LAYERS.txt").text())
    let rows = @string.parse_int(@fs.read_file(root + "/ROWS.txt").text())
    let first = selected_first_layer(root)
    for layer in observed_layers(first, layers) {
      let name = "hidden-" + layer.to_string() + ".bf16"
      @shell.Cmd("scp", [
        "-o",
        "BatchMode=yes",
        "-o",
        "ControlPath=" + socket,
        node + ":" + root + "/layers/" + name,
        root + "/layers/" + name,
      ])
      .output()
      .check()
      guard @fs.read_file(root + "/layers/" + name).binary().length() ==
        rows * 5120 * 2 else {
        fail("incomplete original hidden tensor")
      }
    }
    println(
      "original module replay collected layers=\{layers} rows=\{rows} first_layer=\{first.max(0)} matched_input=\{first >= 0}; not media-quality acceptance",
    )
  }
}
