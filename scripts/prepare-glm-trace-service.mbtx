///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

// Reuse exact qualified artifacts. The new directory owns only trace outputs
// and launch metadata; no recompilation, checkpoint scan, or payload hashing.

///|
fn trace_files(rank : Int32, isolated : Bool) -> Array[String] {
  if !isolated {
    return ["glm_service.exe", "SHARDS.sha256", "acceptance.credential"]
  }
  let files = [
    "glm_service.exe",
    "SHARDS.sha256",
    "rank\{rank}.cubin",
    "sampling.cubin",
  ]
  if rank == 0 {
    files.push("acceptance.credential")
  }
  files
}

///|
test "isolated manifests retain each rank's modules without requiring peer-only files" {
  assert_eq(trace_files(0, true), [
    "glm_service.exe", "SHARDS.sha256", "rank0.cubin", "sampling.cubin", "acceptance.credential",
  ])
  assert_eq(trace_files(1, true), [
    "glm_service.exe", "SHARDS.sha256", "rank1.cubin", "sampling.cubin",
  ])
  assert_eq(trace_files(1, false), [
    "glm_service.exe", "SHARDS.sha256", "acceptance.credential",
  ])
}

///|
async fn main {
  guard @env.args() is [_, source, root, .. options] &&
    options
    is ([]
    | ["--eight-admission-lanes"]
    | ["--exact-replay", _]
    | ["--windowed-replay", _, _]
    | ["--windowed-replay", _, _, "--admission-lanes", _]) &&
    [source, root].all(p => {
      p.has_prefix("/tmp/lunaflux-glm-http-") &&
      !p.contains("..") &&
      p.all(c => c is ('a'..<='z' | '0'..<='9' | '-' | '/'))
    }) else {
    fail(
      "EXISTING_SERVICE_ROOT NEW_TRACE_SERVICE_ROOT [--eight-admission-lanes | --exact-replay CANDIDATE_EXE | --windowed-replay CANDIDATE_EXE MAXIMUM_SITES [--admission-lanes LANES]]",
    )
  }
  @fs.mkdir(root)
  let isolated_manifest = !options.is_empty()
  let candidate = match options {
    ["--exact-replay", executable] | ["--windowed-replay", executable, ..] => {
      guard executable.has_prefix("/tmp/lunaflux-glm-service-arm-") &&
        executable.has_suffix("/glm_service.exe") &&
        @fs.exists(executable) else {
        fail("missing candidate service")
      }
      Some(executable)
    }
    _ => None
  }
  let horizon = match options {
    ["--windowed-replay", _, value, ..] => {
      let n = @string.parse_int(value)
      guard n > 0 else { fail("positive collective horizon") }
      Some(n)
    }
    _ => None
  }
  let lanes = match options {
    [_, _, _, "--admission-lanes", value] => {
      let n = @string.parse_int(value)
      guard n > 0 && n <= 64 else { fail("admission lanes must be 1..64") }
      n
    }
    _ => 8
  }
  @fs.write_file(
    root + "/artifact-root.txt",
    if isolated_manifest {
      root
    } else {
      source
    },
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/acceptance.credential",
    @fs.read_file(source + "/acceptance.credential"),
    create_mode=CreateNew,
  )
  for rank in 0..<2 {
    let socket = if rank == 0 {
      "/tmp/lunaflux-glm178-context-20261019.sock"
    } else {
      "/tmp/lunaflux-glm179-context-20261019.sock"
    }
    let host = if rank == 0 {
      "wlc003s@192.168.2.178"
    } else {
      "wlc004s@192.168.2.179"
    }
    let original = @fs.read_file(source + "/service-\{rank}.json").text()
    let config = if isolated_manifest {
      guard @json.parse(original) is Object(fields) &&
        fields["slots"] == Json(8) else {
        fail("eight resident slots required")
      }
      fields["admission_lanes"] = Json(lanes)
      fields["kernel_root"] = Json(root)
      if candidate is Some(_) {
        fields["collective_replay"] = Json("exact-capacity")
        fields["executable"] = Json(root + "/glm_service.exe")
        if horizon is Some(sites) {
          fields["collective_window_sites"] = Json(sites)
        }
      }
      Json(fields).stringify()
    } else {
      original
    }
    @fs.write_file(
      root + "/service-\{rank}.json",
      config,
      create_mode=CreateNew,
    )
    @shell.Cmd("ssh", [
      "-S",
      socket,
      "-o",
      "BatchMode=yes",
      host,
      "mkdir " + root,
    ])
    .output()
    .check()
    for file in trace_files(rank, isolated_manifest) {
      if file == "glm_service.exe" && candidate is Some(executable) {
        @shell.Cmd("scp", [
          "-o",
          "ControlPath=" + socket,
          executable,
          host + ":" + root + "/glm_service.exe",
        ])
        .output()
        .check()
        continue
      }
      let command = (if isolated_manifest { "ln " } else { "ln -s " }) +
        source +
        "/" +
        file +
        " " +
        root +
        "/" +
        file
      @shell.Cmd("ssh", ["-S", socket, "-o", "BatchMode=yes", host, command])
      .output()
      .check()
    }
    @shell.Cmd("scp", [
      "-o",
      "ControlPath=" + socket,
      root + "/service-\{rank}.json",
      host + ":" + root + "/service.json",
    ])
    .output()
    .check()
  }
  @shell.Cmd("chmod", ["600", root + "/acceptance.credential"]).output().check()
  @fs.write_file(
    root + "/scope.txt",
    "Artifacts/config reused from " +
    source +
    (if candidate is Some(executable) {
      "\nCandidate executable=" +
      executable +
      "; exact-capacity collective replay, window horizon=\{Repr(horizon)}. Qualified CUBINs and GPU geometry unchanged.\n"
    } else {
      "\nTrace uses unchanged executable/CUBINs and GPU geometry; run a paired host/GPU memory watcher.\n"
    }) +
    (if isolated_manifest {
      "Offline prepared owner admission_lanes=\{lanes}. Resident slots=8, context=8192, rows=64 unchanged. Not a production configuration change.\n"
    } else {
      "Admission configuration unchanged.\n"
    }),
    create_mode=CreateNew,
  )
}
