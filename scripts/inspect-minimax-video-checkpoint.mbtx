///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, root, staged, build, unit] &&
    root.has_prefix("/tmp/lunaflux-minimax-video-inspect-") &&
    staged.has_prefix("/tmp/lunaflux-minimax-video-upload-") &&
    build.has_prefix("/tmp/lunaflux-checkpoint-build-minimax-") &&
    unit.has_prefix("lunaflux-minimax-video-inspect-") &&
    [root, staged, build, unit].all(s => {
      !s.contains("..") &&
      s.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-'))
    }) else {
    fail("NEW_RESULT_DIRECTORY STAGED_CHECKPOINT COMMITTED_BUILD NEW_USER_UNIT")
  }
  @fs.mkdir(root)
  let result = @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-S",
    "/tmp/lunaflux-checkpoint-live-20261010.sock",
    "wlc003s@192.168.2.178",
    "systemd-run --user --wait --pipe --unit=" + unit +
    " --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1800 " +
    build +
    "/source/_build/native/release/build/cmd/minimax_checkpoint/minimax_checkpoint.exe inspect-component " +
    staged +
    "/FL2VA video_vae VIDEO.sha256 12884901888 12884901888",
  ]).output(max_output_bytes=4194304)
  @fs.write_file(
    root + "/inspect.stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/inspect.stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  println(result.stdout())
}
