///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
// ATen MeanOps publishes sum * F32(1/width), not a rounded sum/width.
// This is an isolated offline arithmetic experiment, not production selection.
fn mean_publication(source : String) -> String raise {
  let division = "__fdiv_rn(sum,5120.0f)"
  guard source.split(division).count() == 2 &&
    source.contains("correction=0.0f;") else {
    fail("one source-selected compensated row norm required")
  }
  source.replace(old=division, new="__fmul_rn(sum,__fdiv_rn(1.0f,5120.0f))")
}

///|
test "mean publication changes only the non-power-of-two row mean" {
  let source = "float correction=0.0f; __fdiv_rn(sum,5120.0f); __fdiv_rn(sum,128.0f);"
  let result = mean_publication(source)
  assert_true(result.contains("__fmul_rn(sum,__fdiv_rn(1.0f,5120.0f))"))
  assert_true(result.contains("__fdiv_rn(sum,128.0f)"))
  let inverse = 1.0F / 5120.0F
  let differences = for n in 1..<1000; count = 0 {
    continue count +
      (if Float::from_int(n) / 5120.0F != Float::from_int(n) * inverse {
        1
      } else {
        0
      })
  } nobreak {
    count
  }
  assert_true(differences > 0)
  try mean_publication(source + source) catch {
    _ => ()
  } noraise {
    _ => fail("multiple interventions accepted")
  }
}

///|
async fn main {
  guard @env.args() is [_, input, manifest, output] &&
    output.has_prefix("/tmp/lunaflux-minimax-request-aot-") &&
    output.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
    fail("COMPENSATED_TEXT_CUDA SOURCES_MANIFEST NEW_EXPERIMENT_AOT_DIRECTORY")
  }
  let source = mean_publication(@fs.read_file(input).text())
  @fs.mkdir(output)
  @fs.write_file(output + "/text.cu", source, create_mode=CreateNew)
  @fs.write_file(
    output + "/SOURCES.v1",
    @fs.read_file(manifest).binary(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    output + "/EXPERIMENT.txt",
    "scope=offline_row_mean_publication_only\nmean=sum_times_f32_reciprocal\nweights_geometry_head_norm_bf16_boundaries_unchanged=true\nproduction_selection_changed=false\n",
    create_mode=CreateNew,
  )
  let socket = "/tmp/lunaflux-checkpoint-live179-20261010.sock"
  let node = "wlc004s@192.168.2.179"
  @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-S",
    socket,
    node,
    "mkdir " + output,
  ])
  .output()
  .check()
  for name in ["text.cu", "SOURCES.v1", "EXPERIMENT.txt"] {
    @shell.Cmd("scp", [
      "-o",
      "BatchMode=yes",
      "-o",
      "ControlPath=" + socket,
      output + "/" + name,
      node + ":" + output + "/" + name,
    ])
    .output()
    .check()
  }
  let result = @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-S",
    socket,
    node,
    "systemd-run --user --wait --pipe --unit=" +
    output.split("/").last().unwrap().to_owned() +
    " --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=600 /usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 --cubin -arch=sm_121 " +
    output +
    "/text.cu -o " +
    output +
    "/text.cubin",
  ]).output()
  @fs.write_file(
    output + "/compile.stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    output + "/compile.stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  println(
    "row-mean ablation compiled; not a correctness or production-selection claim",
  )
}
