///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn record(root : String, name : String, result : @shell.Output) -> Unit {
  @fs.write_file(root + "/" + name + ".stdout", result.stdout(), create_mode=CreateNew)
  @fs.write_file(root + "/" + name + ".stderr", result.stderr(), create_mode=CreateNew)
  result.check()
}

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o", "BatchMode=yes", "-S", "/tmp/lunaflux-checkpoint-live-20261010.sock",
    "wlc003s@192.168.2.178", command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn copy(source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o", "BatchMode=yes", "-o", "ControlPath=/tmp/lunaflux-checkpoint-live-20261010.sock",
    source, destination,
  ]).output().check()
}

///|
async fn main {
  guard @env.args() is [_, root, suffix, build, binary_hash, staged, aot] &&
    root.has_prefix("/tmp/lunaflux-minimax-text-encoder-") &&
    build.has_prefix("/tmp/lunaflux-checkpoint-build-minimax-") &&
    staged.has_prefix("/tmp/lunaflux-minimax-text-upload-") &&
    aot.has_prefix("/tmp/lunaflux-minimax-request-aot-") &&
    [root, suffix, build, staged, aot].all(s => {
      !s.is_empty() && !s.contains("..") &&
      s.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-'))
    }) && !suffix.contains("/") && binary_hash.length() == 64 &&
    binary_hash.iter().all(c => c is ('a'..='f' | '0'..='9')) else {
    fail("NEW_ROOT SUFFIX COMMITTED_BUILD BINARY_SHA STAGED_WEIGHTS REQUEST_AOT")
  }
  @fs.mkdir(root)
  let binary = build + "/source/_build/native/release/build/cmd/minimax_checkpoint/minimax_checkpoint.exe"
  let identity = remote("sha256sum " + binary)
  record(root, "binary", identity)
  guard identity.stdout().has_prefix(binary_hash + "  ") else {
    fail("different committed ARM binary")
  }
  // Text smoke uses explicit valid lexical IDs, not a claimed natural-language
  // prompt or output from a fabricated conditioning encoder.
  @fs.write_file(root + "/ids.i32", b"\x01\x00\x00\x00\x02\x00\x00\x00\x03\x00\x00\x00", create_mode=CreateNew)
  record(root, "mkdir", remote("mkdir " + root))
  record(root, "copy-binary", remote("cp " + binary + " " + root + "/minimax_checkpoint.exe"))
  copy(root + "/ids.i32", "wlc003s@192.168.2.178:" + staged + "/FL2VA/ids-" + suffix + ".i32")
  let cubin_remote = remote("sha256sum " + aot + "/text.cubin")
  record(root, "cubin-remote", cubin_remote)
  let cubin_local = @shell.Cmd("shasum", ["-a", "256", aot + "/text.cubin"]).output()
  record(root, "cubin-local", cubin_local)
  guard cubin_remote.stdout().split(" ").next() == cubin_local.stdout().split(" ").next() else {
    fail("different compiled text module")
  }
  let gpu = remote("nvidia-smi --query-gpu=uuid,pci.bus_id --format=csv,noheader")
  record(root, "gpu", gpu)
  guard gpu.stdout().trim() == "GPU-9c3d3cf0-439a-5da2-67e9-20414255879f, 0000000F:01:00.0" else {
    fail("different GPU")
  }
  let tools = remote("sha256sum /usr/local/cuda-13.0/bin/nvcc /usr/local/cuda-13.0/compute-sanitizer/compute-sanitizer")
  record(root, "tools", tools)
  guard tools.stdout().contains("fbb111f057786ddd10ba723d993cc7dd43abf978b6baa32fedd3c9d806dc79e1  ") &&
    tools.stdout().contains("7a7fcdefb67042731daf021478176f4919e1843d0b10cb697af28a7d8a3d108b  ") else {
    fail("different CUDA tools")
  }
  let occupied = remote("nvidia-smi --query-compute-apps=pid --format=csv,noheader")
  record(root, "occupied", occupied)
  guard occupied.stdout().trim().is_empty() else { fail("GPU occupied; no overlapping inference") }
  let unit = "lunaflux-minimax-text-encoder-" + suffix
  record(root, "encode", remote(
    "systemd-run --user --wait --pipe --unit=" + unit +
    " --property=MemoryMax=80G --property=MemorySwapMax=0 --property=RuntimeMaxSec=5400 " +
    root + "/minimax_checkpoint.exe encode-text " + staged +
    "/FL2VA TEXT.inventory 3 ids-" + suffix + ".i32 " + aot +
    " " + root + "/hidden.bf16 75161927680 64424509440",
  ))
  let run = @fs.read_file(root + "/encode.stdout").text()
  guard run.contains("text_encoder_complete hidden_state=50 rows=3 width=5120 bytes=30720 nonfinite=0") else {
    fail("missing complete finite hidden state")
  }
  copy("wlc003s@192.168.2.178:" + root + "/hidden.bf16", root + "/hidden.bf16")
  let remote_hash = remote("sha256sum " + root + "/hidden.bf16")
  record(root, "hidden-remote", remote_hash)
  let local_hash = @shell.Cmd("shasum", ["-a", "256", root + "/hidden.bf16"]).output()
  record(root, "hidden-local", local_hash)
  guard @fs.read_file(root + "/hidden.bf16").binary().length() == 30720 &&
    remote_hash.stdout().split(" ").next() == local_hash.stdout().split(" ").next() else {
    fail("incomplete or mismatched downloaded hidden state")
  }
  let released = remote("nvidia-smi --query-compute-apps=pid --format=csv,noheader")
  record(root, "released", released)
  guard released.stdout().trim().is_empty() else { fail("encoder GPU owner remains") }
  record(root, "journal", remote("journalctl --user -u " + unit + " --no-pager"))
  println("checkpoint-backed hidden_states[50] complete and released; no full-media or reference-equivalence claim")
}
