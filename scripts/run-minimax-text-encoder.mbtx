///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn record(root : String, name : String, result : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
}

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o", "BatchMode=yes", "-S", "/tmp/lunaflux-checkpoint-live-20261010.sock", "wlc003s@192.168.2.178",
    command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn copy(source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o", "BatchMode=yes", "-o", "ControlPath=/tmp/lunaflux-checkpoint-live-20261010.sock",
    source, destination,
  ])
  .output()
  .check()
}

///|
async fn main {
  guard @env.args() is [_, root, suffix, build, staged, aot] &&
    root.has_prefix("/tmp/lunaflux-minimax-text-encoder-") &&
    build.has_prefix("/tmp/lunaflux-checkpoint-build-minimax-") &&
    staged.has_prefix("/tmp/lunaflux-minimax-text-upload-") &&
    aot.has_prefix("/tmp/lunaflux-minimax-request-aot-") &&
    [root, suffix, build, staged, aot].all(s => {
      !s.is_empty() &&
      !s.contains("..") &&
      s.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-'))
    }) &&
    !suffix.contains("/") else {
    fail("NEW_ROOT SUFFIX COMMITTED_BUILD STAGED_WEIGHTS REQUEST_AOT")
  }
  @fs.mkdir(root)
  let binary = build +
    "/source/_build/native/release/build/cmd/minimax_checkpoint/minimax_checkpoint.exe"
  // Text smoke uses explicit valid lexical IDs, not a claimed natural-language
  // prompt or output from a fabricated conditioning encoder.
  @fs.write_file(
    root + "/ids.i32",
    b"\x01\x00\x00\x00\x02\x00\x00\x00\x03\x00\x00\x00",
    create_mode=CreateNew,
  )
  record(root, "mkdir", remote("mkdir " + root))
  record(
    root,
    "copy-binary",
    remote("cp " + binary + " " + root + "/minimax_checkpoint.exe"),
  )
  copy(
    root + "/ids.i32",
    "wlc003s@192.168.2.178:" + staged + "/FL2VA/ids-" + suffix + ".i32",
  )
  let gpu = remote(
    "nvidia-smi --query-gpu=uuid,pci.bus_id --format=csv,noheader",
  )
  record(root, "gpu", gpu)
  guard gpu.stdout().trim() ==
    "GPU-9c3d3cf0-439a-5da2-67e9-20414255879f, 0000000F:01:00.0" else {
    fail("different GPU")
  }
  let occupied = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  record(root, "occupied", occupied)
  guard occupied.stdout().trim().is_empty() else {
    fail("GPU occupied; no overlapping inference")
  }
  let unit = "lunaflux-minimax-text-encoder-" + suffix
  record(
    root,
    "encode",
    remote(
      "systemd-run --user --wait --pipe --unit=" +
      unit +
      " --property=MemoryMax=80G --property=MemorySwapMax=0 --property=RuntimeMaxSec=5400 " +
      root +
      "/minimax_checkpoint.exe encode-text " +
      staged +
      "/FL2VA TEXT.inventory 3 ids-" +
      suffix +
      ".i32 " +
      aot +
      " " +
      root +
      "/hidden.bf16 75161927680 64424509440",
    ),
  )
  let run = @fs.read_file(root + "/encode.stdout").text()
  guard run.contains(
    "text_encoder_complete hidden_state=50 rows=3 width=5120 bytes=30720 nonfinite=0",
  ) else {
    fail("missing complete finite hidden state")
  }
  copy("wlc003s@192.168.2.178:" + root + "/hidden.bf16", root + "/hidden.bf16")
  guard @fs.read_file(root + "/hidden.bf16").binary().length() == 30720 else {
    fail("incomplete downloaded hidden state")
  }
  let released = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  record(root, "released", released)
  guard released.stdout().trim().is_empty() else {
    fail("encoder GPU owner remains")
  }
  record(
    root,
    "journal",
    remote("journalctl --user -u " + unit + " --no-pager"),
  )
  println(
    "checkpoint-backed hidden_states[50] complete and released; no full-media or reference-equivalence claim",
  )
}
