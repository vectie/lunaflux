///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn record(root : String, name : String, result : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
}

///|
async fn remote(
  node : String,
  socket : String,
  command : String,
) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=4194304,
  )
}

///|
async fn copy(socket : String, source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket,
    source,
    destination,
  ])
  .output()
  .check()
}

///|
async fn main {
  guard @env.args() is [_, root, suffix, executable, staged, aot, .. target] &&
    (
      target is [] ||
      target is ["178"] ||
      target is ["179"] ||
      target is ["178", _] ||
      target is ["179", _] ||
      target is ["178", _, "layers"] ||
      target is ["179", _, "layers"]
    ) &&
    root.has_prefix("/tmp/lunaflux-minimax-text-encoder-") &&
    executable.has_prefix("/tmp/lunaflux-") &&
    executable.has_suffix(".exe") &&
    staged.has_prefix("/tmp/lunaflux-minimax-text-upload-") &&
    aot.has_prefix("/tmp/lunaflux-minimax-request-aot-") &&
    [root, suffix, executable, staged, aot].all(s => {
      !s.is_empty() &&
      !s.contains("..") &&
      s.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-' | '_' | '.'))
    }) &&
    !suffix.contains("/") else {
    fail(
      "NEW_ROOT SUFFIX COMMITTED_ARM_EXECUTABLE STAGED_WEIGHTS REQUEST_AOT [178|179 [INPUT_IDS_I32 [layers]]]",
    )
  }
  let last = target is ["179", ..]
  let node = if last {
    "wlc004s@192.168.2.179"
  } else {
    "wlc003s@192.168.2.178"
  }
  let socket = if last {
    "/tmp/lunaflux-checkpoint-live179-20261010.sock"
  } else {
    "/tmp/lunaflux-checkpoint-live-20261010.sock"
  }
  let expected_uuid = if last {
    "GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6"
  } else {
    "GPU-9c3d3cf0-439a-5da2-67e9-20414255879f"
  }
  let capture_layers = target is [_, _, "layers"]
  // The existing request AOT has exactly three text rows. Caller-supplied IDs
  // come from text-ids; the legacy default remains an explicitly synthetic probe.
  let ids = match target {
    [_, input, ..] => @fs.read_file(input).binary()
    _ => b"\x01\x00\x00\x00\x02\x00\x00\x00\x03\x00\x00\x00"
  }
  guard ids.length() == 12 else {
    fail("this request AOT requires exactly three little-endian I32 token IDs")
  }
  @fs.mkdir(root)
  let binary = executable
  @fs.write_file(root + "/ids.i32", ids, create_mode=CreateNew)
  record(root, "mkdir", remote(node, socket, "mkdir " + root))
  record(
    root,
    "copy-binary",
    remote(
      node,
      socket,
      "cp " + binary + " " + root + "/minimax_checkpoint.exe",
    ),
  )
  copy(
    socket,
    root + "/ids.i32",
    node + ":" + staged + "/FL2VA/ids-" + suffix + ".i32",
  )
  let gpu = remote(
    node, socket, "nvidia-smi --query-gpu=uuid,pci.bus_id --format=csv,noheader",
  )
  record(root, "gpu", gpu)
  guard gpu.stdout().trim() == expected_uuid + ", 0000000F:01:00.0" else {
    fail("different GPU")
  }
  let occupied = remote(
    node, socket, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  record(root, "occupied", occupied)
  guard occupied.stdout().trim().is_empty() else {
    fail("GPU occupied; no overlapping inference")
  }
  let unit = "lunaflux-minimax-text-encoder-" + suffix
  record(
    root,
    "encode",
    remote(
      node,
      socket,
      "systemd-run --user --wait --pipe --unit=" +
      unit +
      " --property=MemoryMax=80G --property=MemorySwapMax=0 --property=RuntimeMaxSec=5400 " +
      root +
      "/minimax_checkpoint.exe " +
      (if capture_layers { "encode-text-layers " } else { "encode-text " }) +
      staged +
      "/FL2VA TEXT.inventory 3 ids-" +
      suffix +
      ".i32 " +
      aot +
      " " +
      root +
      (if capture_layers { "/layers" } else { "/hidden.bf16" }) +
      " 75161927680 64424509440" +
      (if capture_layers { " 1566720" } else { "" }),
    ),
  )
  let run = @fs.read_file(root + "/encode.stdout").text()
  guard run.contains(
    "text_encoder_complete hidden_state=50 rows=3 width=5120 bytes=30720 nonfinite=0",
  ) else {
    fail("missing complete finite hidden state")
  }
  if capture_layers {
    @fs.mkdir(root + "/layers")
    for layer in 0..<=50 {
      let path = root + "/layers/hidden-\{layer}.bf16"
      copy(socket, node + ":" + path, path)
      guard @fs.read_file(path).binary().length() == 30720 else {
        fail("incomplete downloaded layer hidden state")
      }
    }
  } else {
    copy(socket, node + ":" + root + "/hidden.bf16", root + "/hidden.bf16")
    guard @fs.read_file(root + "/hidden.bf16").binary().length() == 30720 else {
      fail("incomplete downloaded hidden state")
    }
  }
  let released = remote(
    node, socket, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  record(root, "released", released)
  guard released.stdout().trim().is_empty() else {
    fail("encoder GPU owner remains")
  }
  record(
    root,
    "journal",
    remote(node, socket, "journalctl --user -u " + unit + " --no-pager"),
  )
  println(
    "checkpoint-backed hidden_states[50] complete and released; no full-media or reference-equivalence claim",
  )
}
