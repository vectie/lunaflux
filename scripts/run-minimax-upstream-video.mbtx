///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn latent_shape(options : ArrayView[String]) -> (String?, Int, Int, Int) raise {
  let (source, axes) : (String?, ArrayView[String]) = match options {
    [] => (None, [])
    [source] => (Some(source), [])
    ["--latent-shape", .. axes] => (None, axes)
    [source, "--latent-shape", .. axes] => (Some(source), axes)
    _ => fail("[CANONICAL_LATENT_F32] [--latent-shape TIME HEIGHT WIDTH]")
  }
  let dimensions = match axes {
    [] => [37, 2, 2]
    [time, height, width] =>
      [time, height, width].map(value => @string.parse_int(value))
    _ => fail("three literal latent dimensions required")
  }
  guard dimensions[0] > 0 &&
    dimensions[0] <= 128 &&
    dimensions[1] > 0 &&
    dimensions[1] <= 16 &&
    dimensions[2] > 0 &&
    dimensions[2] <= 16 else {
    fail("latent shape exceeds the diagnostic decoder memory budget")
  }
  (source, dimensions[0], dimensions[1], dimensions[2])
}

///|
test "original decoder replay uses explicit canonical quality geometry" {
  assert_eq(latent_shape([]), (None, 37, 2, 2))
  assert_eq(latent_shape(["captured.f32"]), (Some("captured.f32"), 37, 2, 2))
  assert_eq(
    latent_shape(["captured.f32", "--latent-shape", "37", "8", "8"]),
    (Some("captured.f32"), 37, 8, 8),
  )
  assert_eq(latent_shape(["--latent-shape", "37", "8", "4"]), (None, 37, 8, 4))
  for
    args in [
      ["--latent-shape", "37", "8"],
      ["--latent-shape", "37", "0", "8"],
      ["--latent-shape", "37", "32", "8"],
    ] {
    try latent_shape(args) catch {
      _ => ()
    } noraise {
      _ => fail("invalid diagnostic geometry accepted")
    }
  }
}

///|
let node : String = "wlc004s@192.168.2.179"

///|
let socket : String = "/tmp/lunaflux-checkpoint-live179-20261010.sock"

///|
let image : String = "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/h3-runtime-serving:20260923-arm64-r2"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=2097152,
  )
}

///|
async fn record(root : String, label : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + label + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn main {
  guard @env.args() is [_, mode, root, .. extra] &&
    mode is ("prepare" | "run" | "inspect") &&
    (extra.is_empty() || mode == "prepare") &&
    root.has_prefix("/tmp/lunaflux-minimax-upstream-video-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
    fail(
      "prepare NEW_ROOT [CANONICAL_STANDARDIZED_LATENT_F32] [--latent-shape TIME HEIGHT WIDTH] | run|inspect PREPARED_ROOT",
    )
  }
  let tag = root.split("/").last().unwrap().to_owned()
  if mode == "prepare" {
    @fs.mkdir(root)
    @fs.mkdir(root + "/video_vae")
    @fs.mkdir(root + "/video_vae/source")
    let (source, time, height, width) = latent_shape(extra)
    let shape = "\{time} \{height} \{width}"
    if source is Some(path) {
      let input = @fs.read_file(path).binary()
      guard input.length() == 24 * time * height * width * 4 else {
        fail(
          "canonical standardized F32 latent extent differs from the declared geometry",
        )
      }
      @fs.write_file(root + "/latent.f32", input, create_mode=CreateNew)
    }
    @fs.write_file(
      root + "/LATENT_INPUT.txt",
      if source is Some(_) {
        "captured"
      } else {
        "zero"
      },
      create_mode=CreateNew,
    )
    @fs.write_file(root + "/LATENT_SHAPE.txt", shape, create_mode=CreateNew)
    for
      file in [
        "config.json", "source/config.json", "attention.py", "base_module.py", "conv.py",
        "flash.py", "func.py", "klvae.py", "minimax_h3_video_vae.py", "norm.py",
        "normalize.py", "parallel.py", "utils.py", "vae_cnn.py", "vae_module.py",
        "vae_processor.py", "vae_vit.py",
      ] {
      @shell.Cmd("scp", [
        "-o",
        "BatchMode=yes",
        "lunanexa-management:/data/models/MiniMax/MiniMax-H3/FL2VA/video_vae/" +
        file,
        root + "/video_vae/" + file,
      ])
      .output()
      .check()
    }
    @shell.Cmd("scp", [
      "-r",
      "-o",
      "BatchMode=yes",
      "-o",
      "ControlPath=" + socket,
      root,
      node + ":/tmp/",
    ])
    .output()
    .check()
    for file in ["video_upstream.cpp", "canonical_latent_input.h"] {
      @shell.Cmd("scp", [
        "-o",
        "BatchMode=yes",
        "-o",
        "ControlPath=" + socket,
        "benchmarks/checkpoint_aten_reference/aten/" + file,
        node + ":" + root + "/" + file,
      ])
      .output()
      .check()
    }
    record(
      root,
      "weights-view",
      remote(
        "ln -s /checkpoint/model.safetensors " +
        root +
        "/video_vae/source/model.safetensors",
      ),
    )
    record(
      root,
      "compile",
      remote(
        "docker run --rm --user 0 --network none --memory 2g --memory-swap 2g -v " +
        root +
        ":/work --entrypoint g++ " +
        image +
        " -O2 -std=c++20 -I/usr/include/python3.12 /work/video_upstream.cpp -o /work/video-upstream -lpython3.12",
      ),
    )
    if source is Some(_) {
      record(
        root,
        "input-probe",
        remote(
          "docker run --rm --network none --memory 2g --memory-swap 2g -v " +
          root +
          ":/work --entrypoint /work/video-upstream " +
          image +
          " --input-probe /work/latent.f32 " +
          shape,
        ),
      )
    }
  } else if mode == "run" {
    let owners = remote(
      "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    owners.check()
    guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
    record(
      root,
      "start",
      remote(
        "systemd-run --user --unit=" +
        tag +
        " --property=MemoryMax=32G --property=MemorySwapMax=0 --property=RuntimeMaxSec=3600 --property=RemainAfterExit=yes docker run --name " +
        tag +
        " --user 0 --pull=never --network none --gpus all --memory 32g --memory-swap 32g -v " +
        root +
        ":/work -v /tmp/lunaflux-minimax-video-reference-weights-20261011-v3:/checkpoint:ro --entrypoint /work/video-upstream " +
        image +
        " /work /work/pixels.f32" +
        (if @fs.read_file(root + "/LATENT_INPUT.txt").text() == "captured" {
          " /work/latent.f32"
        } else {
          ""
        }) +
        " " +
        @fs.read_file(root + "/LATENT_SHAPE.txt").text(),
      ),
    )
  } else {
    record(
      root,
      "terminal",
      remote(
        "docker logs " +
        tag +
        "; docker inspect --format '{{json .State}}' " +
        tag +
        "; nvidia-smi --query-compute-apps=pid --format=csv,noheader",
      ),
    )
    @shell.Cmd("scp", [
      "-o",
      "BatchMode=yes",
      "-o",
      "ControlPath=" + socket,
      node + ":" + root + "/pixels.f32",
      root + "/pixels.f32",
    ])
    .output()
    .check()
  }
}
