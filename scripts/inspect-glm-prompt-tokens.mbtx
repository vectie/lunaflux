///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  guard @env.args() is [_, tokenizer] else { fail("TOKENIZER_JSON") }
  let text = @fs.read_file(tokenizer).text()
  guard @json.parse(text)
    is {
      "model": { "vocab": Object(vocabulary), .. },
      "added_tokens": Array(added),
      ..
    } else {
    fail("expected BPE vocabulary")
  }
  for
    token in [
      "[gMASK]", "<sop>", "<|system|>", "<|user|>", "<|assistant|>", "<think>", "</think>",
      "a", "Reasoning", "ĠEffort", ":", "ĠLow",
    ] {
    let mut found = vocabulary.get(token)
    for entry in added {
      if entry is { "content": String(content), "id": id, .. } &&
        content == token {
        found = Some(id)
      }
    }
    println("\{token}=\{Repr(found)}")
  }
  guard @json.parse(text)
    is { "model": { "merges": Array(merges), "ignore_merges": True, .. }, .. } else {
    fail("expected ignore-merges BPE")
  }
  let ranks : Map[(String, String), Int] = Map([])
  for rank, merge in merges {
    guard merge is Array([String(left), String(right)]) else {
      fail("expected pair merge")
    }
    ranks[(left, right)] = rank
  }
  let ids : Array[Int] = []
  // These ordinary segments are the exact ASCII regex pieces of the checkpoint
  // template for user content `a`, reasoning_effort=low and generation=true.
  // This diagnostic is not an arbitrary-text tokenizer implementation.
  for
    segment in [
      "[gMASK]", "<sop>", "<|system|>", "Reasoning", "ĠEffort", ":", "ĠLow", "<|user|>",
      "a", "<|assistant|>", "<think>",
    ] {
    let mut direct = vocabulary.get(segment)
    for entry in added {
      if entry is { "content": String(content), "id": id, .. } &&
        content == segment {
        direct = Some(id)
      }
    }
    if direct is Some(Number(number, ..)) {
      ids.push(number.to_int())
      continue
    }
    let pieces = segment.iter().map(c => c.to_string()).collect()
    while pieces.length() > 1 {
      let mut best = -1
      let mut rank = 2147483647
      for index in 0..<(pieces.length() - 1) {
        if ranks.get((pieces[index], pieces[index + 1])) is Some(candidate) &&
          candidate < rank {
          best = index
          rank = candidate
        }
      }
      if best < 0 {
        break
      }
      pieces[best] = pieces[best] + pieces[best + 1]
      ignore(pieces.remove(best + 1))
    }
    for piece in pieces {
      guard vocabulary.get(piece) is Some(Number(number, ..)) else {
        fail("missing vocabulary piece")
      }
      ids.push(number.to_int())
    }
  }
  println("template_ids=" + ids.map(id => id.to_string()).join(","))
}
