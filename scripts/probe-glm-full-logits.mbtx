///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, root, mode] &&
    root.has_prefix("/tmp/lunaflux-full-logits-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) &&
    mode is ("prepare" | "run" | "sanitize") else {
    fail("NEW_ROOT prepare|run|sanitize")
  }
  let socket = "/tmp/lunaflux-glm179-prefill-20261018.sock"
  let host = "wlc004s@192.168.2.179"
  async fn remote(command : String) -> @shell.Output {
    @shell.Cmd("ssh", ["-S", socket, "-o", "BatchMode=yes", host, command]).output(
      max_output_bytes=1048576,
    )
  }
  async fn record(name : String, output : @shell.Output) -> Unit {
    @fs.write_file(
      root + "/" + name + ".stdout",
      output.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/" + name + ".stderr",
      output.stderr(),
      create_mode=CreateNew,
    )
    output.check()
  }
  if mode == "prepare" {
    @fs.mkdir(root)
    record(
      "export",
      @shell.Cmd("env", [
        "LUNA_VOCAB_LOGITS_HEADER=" + root + "/source.cuh",
        "moon",
        "test",
        "kernels/text_io_execution_cuda_source/logits_transfer_test.mbt",
        "--target",
        "native",
        "--deny-warn",
        "--warn-list",
        "-20-25-29-35-79-92",
      ]).output(max_output_bytes=1048576),
    )
    record("mkdir", remote("mkdir " + root))
    for
      (source, target) in [
        (root + "/source.cuh", "source.cuh"),
        ("tests/packed_moe_execution/full_logits_transfer_probe.cu", "probe.cu"),
      ] {
      @shell.Cmd("scp", [
        "-o",
        "ControlPath=" + socket,
        source,
        host + ":" + root + "/" + target,
      ])
      .output()
      .check()
    }
    record(
      "compile",
      remote(
        "systemd-run --user --wait --pipe --unit=" +
        root[5:].to_owned() +
        "-compile --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=300 /usr/local/cuda-13.0/bin/nvcc -O3 -lineinfo -std=c++17 --generate-code arch=compute_121a,code=sm_121a " +
        root +
        "/probe.cu -o " +
        root +
        "/probe",
      ),
    )
  } else {
    let owners = remote(
      "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    owners.check()
    guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
    record(
      mode + "-reserve",
      remote(
        "awk '/MemAvailable:/ {if ($2<25165824) exit 9; print}' /proc/meminfo",
      ),
    )
    for
      tool in (if mode == "run" {
        ["run"]
      } else {
        ["memcheck", "racecheck", "synccheck", "initcheck"]
      }) {
      let prefix = if tool == "run" {
        ""
      } else {
        "/usr/local/cuda-13.0/bin/compute-sanitizer --error-exitcode 9 --tool " +
        tool +
        (if tool == "memcheck" { " --leak-check full " } else { " " })
      }
      record(
        tool,
        remote(
          "systemd-run --user --wait --pipe --unit=" +
          root[5:].to_owned() +
          "-" +
          tool +
          " --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=300 " +
          prefix +
          root +
          "/probe",
        ),
      )
      println(tool + " complete")
    }
  }
}
