///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn different_bf16(a : Bytes, b : Bytes) -> (Int, Int) raise {
  guard a.length() == b.length() && a.length() % 2 == 0 else {
    fail("frontier geometry differs")
  }
  for i in 0..<(a.length() / 2); count = 0, first = -1 {
    let different = a[2 * i] != b[2 * i] || a[2 * i + 1] != b[2 * i + 1]
    continue count + (if different { 1 } else { 0 }),
      if different && first < 0 {
        i
      } else {
        first
      }
  } nobreak {
    (count, first)
  }
}

///|
fn different_bytes(a : Bytes, b : Bytes, bytes : Int) -> (Int, Int) raise {
  guard bytes >= 0 && bytes <= a.length() && bytes <= b.length() else {
    fail("comparison exceeds captured extent")
  }
  for i in 0..<bytes; count = 0, first = -1 {
    continue count + (if a[i] != b[i] { 1 } else { 0 }),
      if first < 0 && a[i] != b[i] {
        i
      } else {
        first
      }
  } nobreak {
    (count, first)
  }
}

///|
fn u32_at(bytes : Bytes, index : Int) -> UInt {
  let offset = index * 4
  bytes[offset].to_uint() |
  (bytes[offset + 1].to_uint() << 8) |
  (bytes[offset + 2].to_uint() << 16) |
  (bytes[offset + 3].to_uint() << 24)
}

///|
test "retired float reader preserves literal little endian operands" {
  assert_eq(Float::reinterpret_from_uint(u32_at(b"\x00\x00\x80\x3f", 0)), 1.0)
}

///|
test "inactive captured capacity is not part of a live extent comparison" {
  assert_eq(different_bytes(b"\x01\x02\x03", b"\x01\x02\x04", 2), (0, -1))
  assert_eq(different_bytes(b"\x01\x02\x03", b"\x01\x02\x04", 3), (1, 2))
  try different_bytes(b"\x01", b"\x01", 2) catch {
    _ => ()
  } noraise {
    _ => fail("out-of-range live extent accepted")
  }
}

///|
test "frontiers compare literal BF16 values, including high bytes" {
  assert_eq(different_bf16(b"\x00\x01\x00\x02", b"\x00\x01\x00\x03"), (1, 1))
  assert_eq(different_bf16(b"\x00\x01", b"\x00\x01"), (0, -1))
}

///|
async fn main {
  let args = @env.args()
  if args is [_, "f32", ordered, overlap, elements_text, report] {
    let a = @fs.read_file(ordered).binary()
    let b = @fs.read_file(overlap).binary()
    let elements = @string.parse_int(elements_text)
    guard elements >= 0 &&
      elements <= a.length() / 4 &&
      elements <= b.length() / 4 else {
      fail("F32 comparison exceeds captured extent")
    }
    let summary = StringBuilder()
    summary <+ "index\tordered\toverlap\tordered_bits\toverlap_bits\n"
    let count = for index in 0..<elements; count = 0 {
      let left = u32_at(a, index)
      let right = u32_at(b, index)
      if left != right {
        summary <+
          "\{index}\t\{Float::reinterpret_from_uint(left)}\t\{Float::reinterpret_from_uint(right)}\t\{left}\t\{right}\n"
      }
      continue count + (if left != right { 1 } else { 0 })
    } nobreak {
      count
    }
    @fs.write_file(report, summary.to_string(), create_mode=CreateNew)
    println(
      "live_f32=\{elements} differing_f32=\{count}; literal values in \{report}",
    )
    return
  }
  if args is [_, "extent", ordered, overlap, bytes_text, report] {
    let a = @fs.read_file(ordered).binary()
    let b = @fs.read_file(overlap).binary()
    let bytes = @string.parse_int(bytes_text)
    let (count, first) = different_bytes(a, b, bytes)
    let summary = "live_bytes=\{bytes} different_bytes=\{count} first_byte=\{first}\n"
    @fs.write_file(report, summary, create_mode=CreateNew)
    println(summary)
    return
  }
  if args
    is [
      _,
      "selected-leaves",
      ordered,
      overlap,
      prefill_text,
      layer_text,
      report,
    ] {
    let prefill = @string.parse_int(prefill_text)
    let layer = @string.parse_int(layer_text)
    guard prefill >= 0 && prefill < 7 && layer >= 3 && layer < 45 else {
      fail("invalid MoE frontier")
    }
    let directory = "/collected-leaves/prefill-\{prefill}-layer-\{layer}/layer-\{layer}-"
    let summary = StringBuilder()
    summary <+ "leaf\tbytes\tdifferent_bytes\tfirst_byte\n"
    for
      leaf in [
        "router-logits", "router-scores", "router-indices", "router-weights", "routed-activation",
        "routed-weighted", "routed-output", "routed-quantized-input", "routed-quantized-activation",
        "shared-activation", "shared-weighted", "shared-output",
      ] {
      let a = @fs.read_file(ordered + directory + leaf + ".bin").binary()
      let b = @fs.read_file(overlap + directory + leaf + ".bin").binary()
      guard a.length() == b.length() else { fail("geometry mismatch") }
      let (count, first) = different_bytes(a, b, a.length())
      summary <+ "\{leaf}\t\{a.length()}\t\{count}\t\{first}\n"
    }
    @fs.write_file(report, summary.to_string(), create_mode=CreateNew)
    println(summary.to_string())
    println(
      "Raw scratch includes inactive capacity; use extent on known live ranges before attributing a numerical cause.",
    )
    return
  }
  if args is [_, "collect-core", root] &&
    root.has_prefix("/tmp/lunaflux-model-bench-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) {
    let socket = @env.get_env_var("LUNAFLUX_SPARK_179_SOCKET").unwrap_or(
      "/tmp/lunaflux-glm179-prefill-20261018.sock",
    )
    let host = "wlc004s@192.168.2.179"
    let status = @shell.Cmd("ssh", [
      "-S",
      socket,
      host,
      "systemctl --user show " +
      root[5:].to_owned() +
      "-egress.service -p SubState -p ExecMainStatus",
    ]).output()
    status.check()
    guard status.stdout().contains("SubState=exited") &&
      status.stdout().contains("ExecMainStatus=0") else {
      fail("capture has not retired successfully")
    }
    @fs.mkdir(root + "/collected-frontiers")
    let archive = root + "/collected-frontiers/core.tar.gz"
    // GNU tar wildcard matching applies to extraction, not archive creation.
    // The validated root and fixed glob are expanded by the remote shell.
    let result = @shell.Cmd("ssh", [
      "-S",
      socket,
      host,
      "cd " + root + " && tar -czf - frontiers/*/*.bf16",
    ]).output(max_output_bytes=536870912)
    result.check()
    @fs.write_file(archive, result.stdout_bytes(), create_mode=CreateNew)
    @shell.Cmd("tar", ["-xf", archive, "-C", root + "/collected-frontiers"])
    .output()
    .check()
    println("collected core frontiers only; large leaf arrays remain on Spark")
    return
  }
  if args is [_, "collect-leaf", root, prefill_text, layer_text] &&
    root.has_prefix("/tmp/lunaflux-model-bench-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) {
    let prefill = @string.parse_int(prefill_text)
    let layer = @string.parse_int(layer_text)
    guard prefill >= 0 && prefill < 7 && layer >= 0 && layer < 45 else {
      fail("invalid frontier location")
    }
    let socket = @env.get_env_var("LUNAFLUX_SPARK_179_SOCKET").unwrap_or(
      "/tmp/lunaflux-glm179-prefill-20261018.sock",
    )
    let host = "wlc004s@192.168.2.179"
    let local_root = root +
      "/collected-leaves/prefill-\{prefill}-layer-\{layer}"
    // Parent must already exist (created explicitly once by the caller).
    @fs.mkdir(local_root)
    @shell.Cmd("scp", [
      "-o",
      "ControlPath=" + socket,
      host + ":" + root + "/frontiers/prefill-\{prefill}/layer-\{layer}-*.bin",
      local_root + "/",
    ])
    .output()
    .check()
    println("collected selected numerical leaf arrays without overwrite")
    return
  }
  if args is [_, "leaves", ordered, overlap, layer_text, report] {
    let layer = @string.parse_int(layer_text)
    guard layer >= 0 && layer < 45 else { fail("invalid layer") }
    let summary = StringBuilder()
    summary <+ "prefill\tleaf\tbytes\tdifferent_bytes\tfirst_byte\n"
    let leaves = [
      "residual.bf16", "input.bf16", "branch.bf16", "router-logits.bin", "router-scores.bin",
      "router-indices.bin", "router-weights.bin", "routed-activation.bin", "routed-weighted.bin",
      "routed-output.bin", "routed-quantized-input.bin", "routed-quantized-activation.bin",
      "shared-activation.bin", "shared-weighted.bin", "shared-output.bin",
    ]
    for prefill in 0..<7 {
      for leaf in leaves {
        let path = "/collected-frontiers/frontiers/prefill-\{prefill}/layer-\{layer}-" +
          leaf
        let a = @fs.read_file(ordered + path).binary()
        let b = @fs.read_file(overlap + path).binary()
        guard a.length() == b.length() else { fail("geometry mismatch") }
        let (different, first) = for
          i in 0..<a.length()
          different = 0, first = -1 {
          continue different + (if a[i] != b[i] { 1 } else { 0 }),
            if first < 0 && a[i] != b[i] {
              i
            } else {
              first
            }
        } nobreak {
          (different, first)
        }
        summary <+
          "\{prefill}\t\{leaf}\t\{a.length()}\t\{different}\t\{first}\n"
        println(
          "prefill=\{prefill} leaf=\{leaf} bytes=\{a.length()} different_bytes=\{different} first_byte=\{first}",
        )
      }
    }
    @fs.write_file(report, summary.to_string(), create_mode=CreateNew)
    println(
      "Raw scratch includes inactive capacity. Only matching live mathematical extents establish numerical differences.",
    )
    return
  }
  if args is [_, "collect", root] &&
    root.has_prefix("/tmp/lunaflux-model-bench-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) {
    let socket = @env.get_env_var("LUNAFLUX_SPARK_179_SOCKET").unwrap_or(
      "/tmp/lunaflux-glm179-prefill-20261018.sock",
    )
    let host = "wlc004s@192.168.2.179"
    let status = @shell.Cmd("ssh", [
      "-S",
      socket,
      host,
      "systemctl --user show " +
      root[5:].to_owned() +
      "-egress.service -p SubState -p ExecMainStatus",
    ]).output()
    status.check()
    guard status.stdout().contains("SubState=exited") &&
      status.stdout().contains("ExecMainStatus=0") else {
      fail("capture has not retired successfully")
    }
    // mkdir fails on a prior collection, so source evidence is never overwritten.
    @fs.mkdir(root + "/collected-frontiers")
    @shell.Cmd("scp", [
      "-r",
      "-o",
      "ControlPath=" + socket,
      host + ":" + root + "/frontiers",
      root + "/collected-frontiers/",
    ])
    .output()
    .check()
    println("collected literal retired arrays without payload hashes")
    return
  }
  guard args is [_, "compare", ordered, overlap, report] else {
    fail("collect ROOT | compare ORDERED OVERLAP NEW_REPORT")
  }
  let summary = StringBuilder()
  summary <+ "prefill\tlayer\tfrontier\telements\tdifferent\tfirst_index\n"
  for prefill in 0..<7 {
    let mut first_difference = false
    for layer in 0..<45 {
      for boundary in ["residual", "input", "branch"] {
        let leaf = "/collected-frontiers/frontiers/prefill-\{prefill}/layer-\{layer}-\{boundary}.bf16"
        let a = @fs.read_file(ordered + leaf).binary()
        let b = @fs.read_file(overlap + leaf).binary()
        let (count, first) = different_bf16(a, b)
        summary <+
          "\{prefill}\t\{layer}\t\{boundary}\t\{a.length()/2}\t\{count}\t\{first}\n"
        if count > 0 && !first_difference {
          println(
            "prefill=\{prefill} first_difference_layer=\{layer} boundary=\{boundary} different=\{count} first_index=\{first}",
          )
          first_difference = true
        }
      }
    }
    if !first_difference {
      println("prefill=\{prefill} all_retired_frontiers_bitwise=true")
    }
  }
  @fs.write_file(report, summary.to_string(), create_mode=CreateNew)
  println(
    "Downstream drift is propagated; only the first differing frontier is localized. No performance or reference-quality claim.",
  )
}
