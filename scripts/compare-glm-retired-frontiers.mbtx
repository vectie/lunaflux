///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
fn different_bf16(a : Bytes, b : Bytes) -> (Int, Int) raise {
  guard a.length() == b.length() && a.length() % 2 == 0 else { fail("frontier geometry differs") }
  for i in 0..<(a.length() / 2); count = 0, first = -1 {
    let different = a[2*i] != b[2*i] || a[2*i+1] != b[2*i+1]
    continue count + (if different { 1 } else { 0 }), if different && first < 0 { i } else { first }
  } nobreak { (count, first) }
}

///|
test "frontiers compare literal BF16 values, including high bytes" {
  assert_eq(different_bf16(b"\x00\x01\x00\x02", b"\x00\x01\x00\x03"), (1, 1))
  assert_eq(different_bf16(b"\x00\x01", b"\x00\x01"), (0, -1))
}

///|
async fn main {
  let args = @env.args()
  if args is [_, "collect", root] && root.has_prefix("/tmp/lunaflux-model-bench-") && root.iter().all(c => c is ('a'..='z'|'0'..='9'|'/'|'-')) {
    let socket = @env.get_env_var("LUNAFLUX_SPARK_179_SOCKET").unwrap_or("/tmp/lunaflux-glm179-prefill-20261018.sock")
    let host = "wlc004s@192.168.2.179"
    let status = @shell.Cmd("ssh", ["-S", socket, host, "systemctl --user show " + root[5:].to_owned() + "-egress.service -p SubState -p ExecMainStatus"]).output()
    status.check()
    guard status.stdout().contains("SubState=exited") && status.stdout().contains("ExecMainStatus=0") else { fail("capture has not retired successfully") }
    // mkdir fails on a prior collection, so source evidence is never overwritten.
    @fs.mkdir(root + "/collected-frontiers")
    @shell.Cmd("scp", ["-r", "-o", "ControlPath=" + socket, host + ":" + root + "/frontiers", root + "/collected-frontiers/"]).output().check()
    println("collected literal retired arrays without payload hashes")
    return
  }
  guard args is [_, "compare", ordered, overlap, report] else { fail("collect ROOT | compare ORDERED OVERLAP NEW_REPORT") }
  let summary = StringBuilder()
  summary <+ "prefill\tlayer\tfrontier\telements\tdifferent\tfirst_index\n"
  for prefill in 0..<7 {
    let mut first_difference = false
    for layer in 0..<45 {
      for boundary in ["residual", "input", "branch"] {
        let leaf = "/collected-frontiers/frontiers/prefill-\{prefill}/layer-\{layer}-\{boundary}.bf16"
        let a = @fs.read_file(ordered + leaf).binary()
        let b = @fs.read_file(overlap + leaf).binary()
        let (count, first) = different_bf16(a, b)
        summary <+ "\{prefill}\t\{layer}\t\{boundary}\t\{a.length()/2}\t\{count}\t\{first}\n"
        if count > 0 && !first_difference {
          println("prefill=\{prefill} first_difference_layer=\{layer} boundary=\{boundary} different=\{count} first_index=\{first}")
          first_difference = true
        }
      }
    }
    if !first_difference { println("prefill=\{prefill} all_retired_frontiers_bitwise=true") }
  }
  @fs.write_file(report, summary.to_string(), create_mode=CreateNew)
  println("Downstream drift is propagated; only the first differing frontier is localized. No performance or reference-quality claim.")
}
