///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
}

///|
fn fields(line : StringView) -> Array[String] raise {
  guard line.has_prefix("\"") && line.has_suffix("\"") else {
    fail("expected quoted NCU CSV")
  }
  line[1:line.length() - 1].split("\",\"").map(s => s.to_owned()).to_array()
}

///|
test "quoted counter records preserve comma-containing geometry and empty units" {
  assert_eq(fields("\"Kernel Name\",\"Block Size\",\"\"").length(), 3)
  let values = fields("\"gate_up\",\"(128, 1, 1)\",\"\"")
  assert_eq(values[1], "(128, 1, 1)")
  assert_eq(values[2], "")
  try fields("unquoted") catch {
    _ => ()
  } noraise {
    _ => fail("unquoted counter input accepted")
  }
}

///|
async fn main {
  let inputs = match @env.args() {
    [_, root] => [root + "/baseline-raw.csv", root + "/candidate-raw.csv"]
    [_, "--file", path] => [path]
    _ => fail("PAIRED_ROOT | --file MULTI_KERNEL_RAW_CSV")
  }
  for path in inputs {
    let lines = @fs.read_file(path)
      .text()
      .split("\n")
      .filter(s => !s.is_empty())
      .to_array()
    guard lines.length() >= 3 else { fail("expected profiled kernels") }
    let header = fields(lines[0])
    let units = fields(lines[1])
    for line in lines[2:] {
      let values = fields(line)
      guard header.length() == values.length() &&
        units.length() == values.length() else {
        fail("truncated CSV")
      }
      println(path)
      for index, key in header {
        if key == "Kernel Name" ||
          key == "Block Size" ||
          key == "Grid Size" ||
          key == "gpu__time_duration.sum" ||
          key == "smsp__inst_executed.sum" ||
          key == "launch__registers_per_thread" ||
          key == "launch__shared_mem_per_block" ||
          key.has_prefix("launch__occupancy_limit_") ||
          key == "sm__warps_active.avg.pct_of_peak_sustained_active" ||
          key ==
          "sm__pipe_tensor_cycles_active.avg.pct_of_peak_sustained_elapsed" ||
          key ==
          "sm__pipe_tensor_cycles_active.avg.pct_of_peak_sustained_active" ||
          key == "smsp__average_warp_latency_per_inst_issued.ratio" ||
          key.has_prefix("smsp__average_warps_issue_stalled_") ||
          key.has_prefix("smsp__warp_issue_stalled_") ||
          key == "l1tex__data_bank_conflicts_pipe_lsu_mem_shared_op_ld.sum" ||
          key == "l1tex__t_sectors_pipe_lsu_mem_global_op_ld.sum" ||
          key == "dram__bytes_read.sum" ||
          key == "lts__t_sectors_op_read.sum" {
          println("\{key}=\{values[index]} \{units[index]}")
        }
      }
    }
  }
}
