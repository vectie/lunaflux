///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
let node : String = "wlc004s@192.168.2.179"

///|
let socket : String = "/tmp/lunaflux-checkpoint-live179-20261010.sock"

///|
let image : String = "ghcr.nju.edu.cn/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-e3-20260907"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=2097152,
  )
}

///|
async fn record(root : String, label : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + label + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn upload(source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket,
    source,
    node + ":" + destination,
  ])
  .output()
  .check()
}

///|
fn originals(rows : Int) -> Array[(String, Int)] {
  [
    ("input.bf16", rows * 8192),
    ("wq_a.fp8", 4096 * 1024),
    ("wq_a.scale", 32 * 8),
    ("wq_b.fp8", 1024 * 32768),
    ("wq_b.scale", 8 * 256),
    ("wkv.fp8", 4096 * 512),
    ("wkv.scale", 32 * 4),
    ("q_norm.bf16", 2048),
    ("kv_norm.bf16", 1024),
  ]
}

///|
fn stages() -> Array[(String, Int)] {
  [
    ("q-a", 1024),
    ("q-norm", 1024),
    ("q-b", 32768),
    ("q-head", 32768),
    ("kv", 512),
    ("kv-norm", 512),
  ]
}

///|
fn original_submission(options : ArrayView[String]) -> (Int, Bool) raise {
  match options {
    [] => (0, false)
    [layer] | [layer, "--one-row"] => {
      let index = @string.parse_int(layer)
      guard index >= 0 && index < 43 else {
        fail("literal base layer required")
      }
      (index, options.length() == 2)
    }
    _ => fail("LAYER [--one-row]")
  }
}

///|
test "matched query keeps original layer and submission shape explicit" {
  assert_eq(original_submission([]), (0, false))
  assert_eq(original_submission(["3", "--one-row"]), (3, true))
  assert_eq(original_submission(["0"]), (0, false))
  for options in [["43"], ["-1"], ["3", "--prefill"]] {
    try original_submission(options[:]) catch {
      _ => ()
    } noraise {
      _ => fail("invalid original workload accepted")
    }
  }
}

///|
test "original component work keeps full head geometry and independent quantized scales" {
  assert_eq(stages()[2], ("q-b", 32768))
  assert_eq(originals(144)[4], ("wq_b.scale", 2048))
  assert_eq(originals(144)[0], ("input.bf16", 1179648))
}

///|
async fn main {
  guard @env.args() is [_, mode, root, .. extra] &&
    root.has_prefix("/tmp/lunaflux-deepseek-original-query-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
    fail(
      "prepare NEW_ROOT EXACT_ORIGINAL_INPUT_BF16 ROWS [LAYER [--one-row]] | run|sanitize|collect|collect-norm ROOT",
    )
  }
  let tag = root.split("/").last().unwrap().to_owned()
  if mode == "prepare" {
    guard extra is [input, row_text, .. options] else {
      fail("original input and rows required")
    }
    let (layer, one_row) = original_submission(options)
    let rows = @string.parse_int(row_text)
    guard rows >= 1 && rows <= 144 else {
      fail("bounded original rows required")
    }
    let bytes = @fs.read_file(input).binary()
    guard bytes.length() == rows * 8192 else {
      fail("complete literal BF16 rows required")
    }
    @fs.mkdir(root)
    for dir in ["original", "matched", "propagated"] {
      @fs.mkdir(root + "/" + dir)
    }
    @fs.write_file(root + "/input.bf16", bytes, create_mode=CreateNew)
    @fs.write_file(root + "/ROWS.txt", row_text, create_mode=CreateNew)
    @fs.write_file(
      root + "/ORIGINAL_LAYER.txt",
      layer.to_string(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/ORIGINAL_SUBMISSION.txt",
      if one_row {
        "1"
      } else {
        row_text
      },
      create_mode=CreateNew,
    )
    record(
      root,
      "export",
      @shell.Cmd(
        "moon",
        [
          "test", "--target", "native", "--deny-warn", "--warn-list", "-20-25-29-35-79-92",
          "kernels/quantized_query_kv_cuda_source", "--filter", "original DeepSeek query replay exports full-width numerical stages",
        ],
        env={
          "LUNAFLUX_MATCHED_QUERY_SOURCE_OUTPUT": root +
          "/query_matched_kernels.cuh",
        },
      ).output(),
    )
    record(
      root,
      "mkdir",
      remote(
        "mkdir " +
        root +
        " " +
        root +
        "/original " +
        root +
        "/matched " +
        root +
        "/propagated",
      ),
    )
    for file in ["input.bf16", "query_matched_kernels.cuh"] {
      upload(root + "/" + file, root + "/" + file)
    }
    for file in ["query_kv_upstream.cpp", "original_tensor_io.h"] {
      upload(
        "benchmarks/checkpoint_aten_reference/aten/" + file,
        root + "/" + file,
      )
    }
    upload(
      "tests/packed_moe_execution/query_kv_matched_probe.cu",
      root + "/query_kv_matched_probe.cu",
    )
    record(
      root,
      "compile-original",
      remote(
        "docker run --rm --network none --memory 2g --memory-swap 2g -v " +
        root +
        ":/work --entrypoint g++ " +
        image +
        " -O2 -std=c++20 -Wall -Wextra -Werror -I/usr/include/python3.12 /work/query_kv_upstream.cpp -o /work/query-upstream -lpython3.12",
      ),
    )
    record(
      root,
      "compile-native",
      remote(
        "systemd-run --user --wait --pipe --unit=" +
        tag +
        "-compile --property=MemoryMax=2G --property=MemorySwapMax=0 --working-directory=" +
        root +
        " /usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 -arch=sm_121 query_kv_matched_probe.cu -o query-native",
      ),
    )
  } else if mode == "run" {
    guard extra.is_empty() else { fail("unexpected options") }
    let rows = @string.parse_int(@fs.read_file(root + "/ROWS.txt").text())
    let layer = @fs.read_file(root + "/ORIGINAL_LAYER.txt").text() catch {
      _ => "0"
    }
    let one_row = (@fs.read_file(root + "/ORIGINAL_SUBMISSION.txt").text() ==
    "1") catch {
      _ => false
    }
    let owners = remote(
      "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    record(root, "before-owners", owners)
    guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
    record(
      root,
      "original-run",
      remote(
        "systemd-run --user --wait --pipe --unit=" +
        tag +
        "-original --property=MemoryMax=8G --property=MemorySwapMax=0 --property=RuntimeMaxSec=900 docker run --name " +
        tag +
        " --gpus all --network none --user 1000:1000 --memory 8g --memory-swap 8g -e OMP_NUM_THREADS=2 -v " +
        root +
        ":/work -v /tmp/lunaflux-deepseek-real-20261010.ZYa0kMPT/DeepSeek-V4-Flash-DSpark:/model:ro" +
        " -v /tmp/lunaflux-deepseek-upstream-reference-sampler-20261011-v2/spark-inference:/inference:ro" +
        " --entrypoint /work/query-upstream " +
        image +
        " /inference /model /work/input.bf16 /work/original " +
        rows.to_string() +
        " " +
        layer +
        (if one_row { " --one-row" } else { "" }),
      ),
    )
    record(
      root,
      "original-terminal",
      remote("docker inspect --format '{{json .State}}' " + tag),
    )
    for route in ["matched", "propagated"] {
      let owners = remote(
        "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
      )
      owners.check()
      guard owners.stdout().trim().is_empty() else { fail("serialize replays") }
      record(
        root,
        route + "-run",
        remote(
          "systemd-run --user --wait --pipe --unit=" +
          tag +
          "-" +
          route +
          " --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=600 " +
          root +
          "/query-native " +
          root +
          "/original " +
          root +
          "/" +
          route +
          " " +
          rows.to_string() +
          " " +
          route,
        ),
      )
    }
    record(
      root,
      "released",
      remote("nvidia-smi --query-compute-apps=pid --format=csv,noheader"),
    )
  } else if mode == "sanitize" {
    guard extra.is_empty() else { fail("unexpected options") }
    let rows = @string.parse_int(@fs.read_file(root + "/ROWS.txt").text())
    for tool in ["memcheck", "racecheck", "synccheck"] {
      let owners = remote(
        "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
      )
      owners.check()
      guard owners.stdout().trim().is_empty() else {
        fail("serialize sanitizer replays")
      }
      let out = root + "/sanitizer-" + tool
      record(root, "sanitizer-" + tool + "-mkdir", remote("mkdir " + out))
      let leak = if tool == "memcheck" { " --leak-check full" } else { "" }
      record(
        root,
        "sanitizer-" + tool,
        remote(
          "systemd-run --user --wait --pipe --unit=" +
          tag +
          "-" +
          tool +
          " --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1800 " +
          " /usr/local/cuda-13.0/bin/compute-sanitizer --tool " +
          tool +
          leak +
          " --error-exitcode 99 " +
          root +
          "/query-native " +
          root +
          "/original " +
          out +
          " " +
          rows.to_string() +
          " matched",
        ),
      )
    }
  } else if mode == "collect-norm" {
    guard extra.is_empty() else { fail("unexpected norm collection arguments") }
    for dir in ["matched", "propagated"] {
      for name in ["128-4", "256-2", "256-4", "512-1", "512-2", "512-4"] {
        let target = root + "/" + dir + "/q-norm-" + name + ".bf16"
        @fs.write_file(target, b"", create_mode=CreateNew)
        @shell.Cmd("scp", [
          "-o",
          "BatchMode=yes",
          "-o",
          "ControlPath=" + socket,
          node + ":" + target,
          target,
        ])
        .output()
        .check()
      }
    }
  } else if mode == "collect" {
    let rows = @string.parse_int(@fs.read_file(root + "/ROWS.txt").text())
    for dir in ["original", "matched", "propagated"] {
      let files = stages().map(pair => (pair.0 + ".bf16", pair.1 * rows * 2))
      if dir == "original" {
        files.append(originals(rows))
      }
      for (file, expected) in files {
        let target = root + "/" + dir + "/" + file
        @fs.write_file(target, b"", create_mode=CreateNew)
        @shell.Cmd("scp", [
          "-o",
          "BatchMode=yes",
          "-o",
          "ControlPath=" + socket,
          node + ":" + target,
          target,
        ])
        .output()
        .check()
        guard @fs.read_file(target).binary().length() == expected else {
          fail("truncated " + target)
        }
      }
      if dir != "original" {
        for (stage, width) in stages() {
          record(
            root,
            dir + "-" + stage + "-comparison",
            @shell.Cmd("moon", [
              "run",
              "scripts/compare-minimax-encoder-reference.mbtx",
              root + "/" + dir + "/" + stage + ".bf16",
              root + "/original/" + stage + ".bf16",
              root + "/" + dir + "-" + stage + "-comparison.txt",
              "original_deepseek_query_" + dir + "_" + stage,
              width.to_string(),
            ]).output(),
          )
        }
      }
    }
  } else {
    fail("unknown mode")
  }
  println(
    "matched_original_query_" +
    mode +
    " complete; not full-model or tensor-parallel parity",
  )
}
