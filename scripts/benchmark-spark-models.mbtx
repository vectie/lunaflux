///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/core/json",
}

// Offline measurement only. Reuse already built AOT; never hash payloads.

///|
fn host(last : Bool) -> String {
  if last {
    "wlc004s@192.168.2.179"
  } else {
    "wlc003s@192.168.2.178"
  }
}

///|
fn socket(last : Bool) -> String {
  if last {
    @env.get_env_var("LUNAFLUX_SPARK_179_SOCKET").unwrap_or(
      "/tmp/lunaflux-checkpoint-live179-20261010.sock",
    )
  } else {
    @env.get_env_var("LUNAFLUX_SPARK_178_SOCKET").unwrap_or(
      "/tmp/lunaflux-checkpoint-live-20261010.sock",
    )
  }
}

///|
fn model(glm : Bool, last : Bool) -> String {
  if glm {
    (if last {
      "/tmp/lunaflux-glm-real-20261010.ekEYBzqU"
    } else {
      "/tmp/lunaflux-glm-real-20261010.6yIBQN35"
    }) +
    "/GLM-5.3-Flash-NVFP4"
  } else {
    (if last {
      "/tmp/lunaflux-deepseek-real-20261010.ZYa0kMPT"
    } else {
      "/tmp/lunaflux-deepseek-real-20261010.dLryo68E"
    }) +
    "/DeepSeek-V4-Flash-DSpark"
  }
}

///|
fn selected(glm : Bool) -> String {
  if glm {
    "/tmp/lunaflux-glm-sequence-numerical-ir-chat-20261012-v1"
  } else {
    "/tmp/lunaflux-dspark-real-numerical-ir-chat-20261012-v2"
  }
}

///|
fn binary(glm : Bool, runtime : String) -> String {
  runtime +
  (if glm { "/glm_checkpoint.exe" } else { "/deepseek_checkpoint.exe" })
}

///|
fn runtime_selection(glm : Bool, options : ArrayView[String]) -> String raise {
  if options is [.. base, "--low-bit"] {
    return runtime_selection(glm, base)
  }
  if options is [.. base, "--expert-tp"] {
    return runtime_selection(glm, base)
  }
  if options is [.. base, "--tiled-grouped"] {
    return runtime_selection(glm, base)
  }
  if options is [.. base, "--chunk-kda"] {
    return runtime_selection(glm, base)
  }
  if options is ["--runtime", runtime, "--rows", _] {
    return runtime_selection(glm, ["--runtime", runtime])
  }
  if options.is_empty() {
    return selected(glm)
  }
  guard options is ["--runtime", runtime] &&
    runtime.has_prefix("/tmp/lunaflux-") &&
    !runtime.contains("..") &&
    runtime.iter().all(c => c is ('a'..<='z' | '0'..<='9' | '/' | '-')) else {
    fail("expected --runtime /tmp/lunaflux-NEW-RUNTIME")
  }
  runtime
}

///|
fn row_selection(glm : Bool, options : ArrayView[String]) -> Int32 raise {
  if options is [.. base, "--low-bit"] {
    return row_selection(glm, base)
  }
  if options is [.. base, "--expert-tp"] {
    return row_selection(glm, base)
  }
  if options is [.. base, "--tiled-grouped"] {
    return row_selection(glm, base)
  }
  if options is [.. base, "--chunk-kda"] {
    return row_selection(glm, base)
  }
  let rows = if options is ["--runtime", _, "--rows", value] {
    @string.parse_int(value)
  } else if glm {
    1
  } else {
    6
  }
  guard rows > 0 && rows <= (if glm { 64 } else { 256 }) else {
    fail("row capacity exceeds bounded history")
  }
  rows
}

///|
fn template(glm : Bool, prompt : String) -> String {
  if glm {
    "[gMASK]<sop><|system|>Reasoning Effort: Low<|user|>" +
    prompt +
    "<|assistant|><think>"
  } else {
    "<｜begin▁of▁sentence｜><｜User｜>" +
    prompt +
    "<｜Assistant｜></think>"
  }
}

///|
fn corpus(profile : Bool) -> Array[(String, String)] {
  if profile {
    [("profile", "2+2?")]
  } else {
    [
      ("fact", "What is the capital of Japan? Answer briefly."),
      ("arithmetic", "17 plus 25 equals? Answer only the number."),
      ("chinese", "法国的首都是哪里？请简短回答。"),
      ("json", "Return only JSON with key result and value 42."),
      ("code", "Python expression for squares of integers 0 through 3?"),
      (
        "retrieval", "Mira has a red bag. Jon has a blue bag. Who has the blue bag? Answer only the name.",
      ),
    ]
  }
}

///|
// Offline inputs only. Expected answers/scorers are deliberately not consumed
// by the inference executable or compiler.
fn explicit_corpus(text : String) -> Array[(String, String)] raise {
  guard @json.parse(text) is Array(cases) &&
    cases.length() > 0 &&
    cases.length() <= 64 else {
    fail("expected 1..64 explicit cases")
  }
  let seen : Map[String, Bool] = Map([])
  cases.map(value => {
    guard value is { "id": String(id), "prompt": String(prompt), .. } &&
      !id.is_empty() &&
      !prompt.is_empty() &&
      prompt.length() <= 32768 &&
      !seen.contains(id) else {
      fail("case requires unique id and bounded prompt")
    }
    seen[id] = true
    (id, prompt)
  })
}

///|
fn answer_envelope(
  history : Int32,
  maximum : Int32,
  rows : Int32,
) -> Unit raise {
  guard history >= rows && history <= 4096 && maximum > 0 && maximum < history else {
    fail("invalid explicit context/output envelope")
  }
}

///|
test "complete-answer corpus and budgets are explicit, not eight-token defaults" {
  let cases = explicit_corpus(
    "[{\"id\":\"json\",\"prompt\":\"Return a JSON value\",\"expected\":42}]",
  )
  assert_eq(cases, [("json", "Return a JSON value")])
  answer_envelope(1024, 512, 64)
  try answer_envelope(64, 64, 64) catch {
    _ => ()
  } noraise {
    _ => fail("no input reserve")
  }
  try
    explicit_corpus(
      "[{\"id\":\"a\",\"prompt\":\"x\"},{\"id\":\"a\",\"prompt\":\"y\"}]",
    )
  catch {
    _ => ()
  } noraise {
    _ => fail("duplicate ids")
  }
}

///|
async fn remote(last : Bool, command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=10",
    "-S",
    socket(last),
    host(last),
    command,
  ]).output(max_output_bytes=16777216)
}

///|
async fn record(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn copy(last : Bool, source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket(last),
    source,
    destination,
  ])
  .output()
  .check()
}

///|
fn available_kib(text : String) -> Int64 raise {
  for line in text.split("\n") {
    if line.has_prefix("MemAvailable:") {
      let parts = line.split(" ").filter(s => !s.is_empty()).to_array()
      guard parts is [_, value, "kB"] else { fail("memory units") }
      return @string.parse_int64(value)
    }
  }
  fail("missing available memory")
}

///|
fn resident_gpu_mib(text : String) -> Int64 raise {
  let mut total = 0L
  for line in text.split("\n") {
    let value = line.trim()
    if value.is_empty() {
      continue
    }
    let memory = @string.parse_int64(value)
    guard memory >= 0L && memory <= 9223372036854775807L - total else {
      fail("invalid observed GPU memory")
    }
    total += memory
  }
  total
}

///|
test "resident GPU budget counts all observed allocations, not only a process cgroup" {
  assert_eq(resident_gpu_mib(""), 0L)
  assert_eq(resident_gpu_mib("100000\n4096\n"), 104096L)
  try resident_gpu_mib("[Not Supported]") catch {
    _ => ()
  } noraise {
    _ => fail("unavailable GPU measurement treated as zero")
  }
}

///|
fn sample_label(index : Int32, warmup : Bool, prefix : String) -> String {
  if warmup && index == 0 {
    "warmup"
  } else {
    prefix + (index - (if warmup { 1 } else { 0 })).to_string()
  }
}

///|
test "warmup retains original measured prompt and output indices" {
  assert_eq(sample_label(0, true, "input-"), "warmup")
  assert_eq(sample_label(1, true, "input-"), "input-0")
  assert_eq(sample_label(6, true, "output-"), "output-5")
  assert_eq(sample_label(0, false, "input-"), "input-0")
}

///|
test "prompt and memory measurement boundaries" {
  assert_eq(corpus(false).length(), 6)
  assert_eq(corpus(true).length(), 1)
  assert_true(template(false, "a").has_suffix("</think>"))
  assert_eq(available_kib("MemAvailable:   33554432 kB\n"), 33554432L)
}

///|
test "fresh runtime selection is explicit and preserves the retained baseline" {
  assert_eq(row_selection(true, []), 1)
  assert_eq(
    row_selection(true, [
      "--runtime", "/tmp/lunaflux-glm-new-v1", "--rows", "16",
    ]),
    16,
  )
  assert_eq(
    runtime_selection(true, [
      "--runtime", "/tmp/lunaflux-glm-new-v1", "--rows", "16",
    ]),
    "/tmp/lunaflux-glm-new-v1",
  )
  assert_eq(runtime_selection(true, []), selected(true))
  assert_eq(
    runtime_selection(true, [
      "--runtime", "/tmp/lunaflux-tp-v1", "--rows", "16", "--tiled-grouped", "--expert-tp",
    ]),
    "/tmp/lunaflux-tp-v1",
  )
  assert_eq(
    row_selection(true, [
      "--runtime", "/tmp/lunaflux-tp-v1", "--rows", "16", "--tiled-grouped", "--expert-tp",
    ]),
    16,
  )
  assert_eq(
    binary(
      true,
      runtime_selection(true, ["--runtime", "/tmp/lunaflux-glm-new-v1"]),
    ),
    "/tmp/lunaflux-glm-new-v1/glm_checkpoint.exe",
  )
  for
    options in [
      ["--runtime"],
      ["--runtime", "/tmp/lunaflux-../old"],
      ["--runtime", "/tmp/lunaflux-a b"],
    ] {
    try runtime_selection(true, options) catch {
      _ => ()
    } noraise {
      _ => fail("invalid runtime selection accepted")
    }
  }
}

///|
async fn main {
  guard @env.args() is [_, root, family, mode, .. options] &&
    root.has_prefix("/tmp/lunaflux-model-bench-") &&
    !root.contains("..") &&
    root.iter().all(c => c is ('a'..<='z' | '0'..<='9' | '/' | '-')) &&
    family is ("glm" | "deepseek") &&
    mode is ("prepare" | "prepare-profile" | "start" | "watch" | "collect") else {
    fail(
      "NEW_ROOT glm|deepseek prepare|prepare-profile|start|watch|collect [--runtime NEW_RUNTIME]",
    )
  }
  let glm = family == "glm"
  let transport = @env.get_env_var("LUNA_GLM_EXPERT_TRANSPORT").unwrap_or(
    "indexed",
  )
  guard transport
    is ("indexed" | "packed" | "pipeline" | "buffered" | "bulk" | "tiles") &&
    (glm || transport == "indexed") else {
    fail("expert transport")
  }
  let timeline = options.last() is Some("--timeline")
  let options = if timeline { options[:options.length() - 1] } else { options }
  let warmup = options.last() is Some("--warmup")
  let options = if warmup { options[:options.length() - 1] } else { options }
  let shape_aware = options.last() == Some("--shape-aware")
  let buffered = @env.get_env_var("LUNA_GLM_BUFFERED_MATRICES") == Some("1")
  let distributed = @env.get_env_var("LUNA_GLM_DISTRIBUTED_SCALES") == Some("1")
  let initialization_probe = @env.get_env_var("LUNA_GLM_INITCHECK") == Some("1")
  guard !initialization_probe || (glm && !timeline && mode != "prepare-profile") else {
    fail("initcheck is a separate untimed GLM diagnostic")
  }
  let prefill_k = @env.get_env_var("LUNA_GLM_PREFILL_K").unwrap_or("0")
  guard prefill_k is ("0" | "32" | "64" | "128") else { fail("prefill K") }
  let parallel_hc = @env.get_env_var("LUNA_GLM_PARALLEL_HC") == Some("1")
  let shared_columns = @env.get_env_var("LUNA_GLM_SHARED_COLUMNS").unwrap_or(
    "64",
  )
  guard shared_columns is ("16" | "32" | "64") else { fail("shared columns") }
  let overlap_experts = @env.get_env_var("LUNA_GLM_OVERLAP_EXPERTS") ==
    Some("1")
  let fused_hc = @env.get_env_var("LUNA_GLM_FUSED_HC") == Some("1")
  let deferred_hc = @env.get_env_var("LUNA_GLM_DEFERRED_HC") == Some("1")
  let fused_controls = @env.get_env_var("LUNA_GLM_FUSED_CONTROLS") == Some("1")
  let vocab_tp = @env.get_env_var("LUNA_GLM_VOCAB_TP") == Some("1")
  let collective_graph = @env.get_env_var("LUNA_GLM_COLLECTIVE_GRAPH") ==
    Some("1")
  let lookahead = @env.get_env_var("LUNA_GLM_EXPERT_LOOKAHEAD") == Some("1")
  guard !buffered || (glm && shape_aware) else {
    fail("buffered matrices require GLM shape-aware")
  }
  let options = if shape_aware {
    options[:options.length() - 1]
  } else {
    options
  }
  let replay = options.last() is Some("--graph-tp")
  let options = if replay { options[:options.length() - 1] } else { options }
  let queued = options.last() is Some("--queued-tp")
  guard !replay || queued else { fail("graph replay requires queued TP") }
  let options = if queued { options[:options.length() - 1] } else { options }
  let low_bit = options.last() is Some("--low-bit")
  guard !lookahead || (glm && low_bit) else {
    fail("expert lookahead requires GLM low-bit")
  }
  guard transport == "indexed" || low_bit else {
    fail("packed transport requires low-bit")
  }
  let options = if low_bit { options[:options.length() - 1] } else { options }
  let expert_tp = options.last() is Some("--expert-tp")
  let profiles = if expert_tp {
    options[:options.length() - 1]
  } else {
    options
  }
  let chunk = profiles.last() is Some("--chunk-kda")
  let tiled = profiles.last() is Some("--tiled-grouped")
  guard !expert_tp || glm else {
    fail("expert TP is currently bound through GLM")
  }
  guard !queued || expert_tp else { fail("queued mode requires TP") }
  guard (!parallel_hc || glm) &&
    (!collective_graph || (glm && queued && expert_tp)) else {
    fail("HC requires GLM; collective capture requires queued GLM TP")
  }
  guard !tiled || glm else {
    fail("tiled grouped profile currently bound through GLM")
  }
  guard !chunk || glm else { fail("chunk KDA requires a recurrent model") }
  let runtime = runtime_selection(glm, options)
  let executable = binary(glm, runtime)
  let rows = row_selection(glm, options)
  let history = if glm {
    @string.parse_int(@env.get_env_var("LUNA_GLM_HISTORY").unwrap_or("64"))
  } else {
    256
  }
  let output_budget = @string.parse_int(
    @env.get_env_var("LUNA_BENCH_OUTPUT_TOKENS").unwrap_or("8"),
  )
  let stop = @env.get_env_var("LUNA_BENCH_STOP_TOKENS").unwrap_or(
    if glm {
      "154827"
    } else {
      "1"
    },
  )
  guard stop == "-1" ||
    (!stop.is_empty() && stop.iter().all(c => c is ('0'..<='9' | ','))) else {
    fail("stop policy must be explicit token ids or -1")
  }
  answer_envelope(history, output_budget, rows)
  let custom_text = match @env.get_env_var("LUNA_BENCH_CORPUS") {
    Some(path) => Some(@fs.read_file(path).text())
    None => None
  }
  let queue = root + "/queue"
  let aot = runtime + "/aot"
  let cancel_warmup = @env.get_env_var("LUNA_BENCH_CANCEL_WARMUP") == Some("1")
  guard !cancel_warmup || (glm && warmup && custom_text is Some(_)) else {
    fail(
      "cancellation probe requires the unmeasured GLM warmup and literal corpus",
    )
  }
  let selection = "binary=" +
    executable +
    "\naot=" +
    aot +
    (if history != (if glm { 64 } else { 256 }) ||
      output_budget != 8 ||
      custom_text is Some(_) ||
      stop != (if glm { "154827" } else { "1" }) {
      "\nhistory=\{history}\nmaximum_new_tokens=\{output_budget}\nstop_tokens=\{stop}\nexplicit_corpus=" +
      custom_text.unwrap_or("default")
    } else {
      ""
    }) +
    "\nrows=\{rows}\ncomparison_outside_compiler=true\npayload_hashing=false\n" +
    (if transport == "indexed" {
      ""
    } else {
      "expert_transport=\{transport}\n"
    }) +
    (if shape_aware { "matrix_evaluation=shape-aware-f32\n" } else { "" }) +
    (if buffered { "matrix_staging=buffered-k32\n" } else { "" }) +
    (if prefill_k != "0" {
      "sparse_matrix_staging=buffered-k" + prefill_k + "\n"
    } else {
      ""
    }) +
    (if distributed { "expert_scale_partitions=32\n" } else { "" }) +
    (if initialization_probe { "diagnostic=initcheck-untimed\n" } else { "" }) +
    (if @env.get_env_var("LUNA_GLM_CAPTURE_FRONTIERS") == Some("1") {
      "diagnostic=retired-frontiers-untimed\n"
    } else {
      ""
    }) +
    (if lookahead { "expert_fragment_slots=2\n" } else { "" }) +
    (if chunk { "recurrent_evaluation=chunk-triangular-f32\n" } else { "" }) +
    (if tiled && !shape_aware {
      "matrix_evaluation=bf16-matrix-f32-grouped\n"
    } else {
      ""
    }) +
    "expert_tensor_parallel=\{expert_tp}\n" +
    (if low_bit { "expert_scaled_dot=block-scaled-matrix-f32\n" } else { "" }) +
    (if warmup { "warmup_requests=1\n" } else { "" }) +
    (if cancel_warmup { "cancel_warmup_after_steps=1\n" } else { "" }) +
    (if timeline { "timeline=true\n" } else { "" }) +
    (if queued { "tp_submission_queued=true\n" } else { "" }) +
    (if replay { "tp_graph_replay=true\n" } else { "" }) +
    (if parallel_hc {
      "hc_parallel_tree=true\nhc_collapse_norm_fused=true\n"
    } else {
      ""
    }) +
    (if collective_graph { "tp_collective_inclusive_graph=true\n" } else { "" }) +
    (if shared_columns != "64" {
      "shared_matrix_columns=\{shared_columns}\n"
    } else {
      ""
    }) +
    (if overlap_experts { "independent_expert_branches=true\n" } else { "" }) +
    (if fused_hc { "fused_hc_post_square=true\n" } else { "" }) +
    (if deferred_hc { "deferred_hc_post_pre=true\n" } else { "" }) +
    (if fused_controls { "fused_hc_controls=true\n" } else { "" }) +
    (if vocab_tp { "vocabulary_tp=true\n" } else { "" })
  if mode != "prepare" && mode != "prepare-profile" {
    guard @fs.read_file(root + "/selected.txt").text() == selection else {
      fail("runtime must match the explicitly prepared executable and AOT")
    }
  }
  let prefix = root[5:].to_owned()
  if mode == "watch" {
    let observations = StringBuilder()
    for tick in 0..<2200 {
      let mut terminal = 0
      for last in [false, true] {
        let role = if last { "egress" } else { "ingress" }
        let status = remote(
          last,
          "systemctl --user show " +
          prefix +
          "-" +
          role +
          ".service -p LoadState -p SubState -p Result -p ExecMainStatus -p MemoryCurrent -p MemorySwapCurrent",
        )
        status.check()
        let memory = remote(last, "cat /proc/meminfo")
        memory.check()
        let available = available_kib(memory.stdout())
        let device_memory = remote(
          last, "nvidia-smi --query-compute-apps=used_gpu_memory --format=csv,noheader,nounits",
        )
        device_memory.check()
        let gpu_mib = resident_gpu_mib(device_memory.stdout())
        observations <+ "tick=\{tick} role=\{role} available_kib=\{available}\n"
        observations <+ "\{status.stdout()}"
        observations <+ "resident_gpu_mib=\{gpu_mib}\n"
        if @env.get_env_var("LUNA_BENCH_TELEMETRY") == Some("1") {
          let telemetry = remote(
            last, "nvidia-smi --query-gpu=timestamp,clocks.current.sm,clocks.current.memory,temperature.gpu,power.draw,utilization.gpu --format=csv,noheader,nounits",
          )
          observations <+ "gpu_telemetry=\{telemetry.stdout()}"
          observations <+ "gpu_telemetry_stderr=\{telemetry.stderr()}"
        }
        if available < 16777216L || gpu_mib > 102400L {
          for stop_last in [false, true] {
            let stop_role = if stop_last { "egress" } else { "ingress" }
            ignore(
              remote(
                stop_last,
                "systemctl --user stop " + prefix + "-" + stop_role + ".service",
              ),
            )
          }
          @fs.write_file(
            root + "/memory-watch.txt",
            observations.to_string(),
            create_mode=CreateNew,
          )
          fail("stopped experiment: host reserve or 100 GiB GPU limit reached")
        }
        if status.stdout().contains("SubState=failed") {
          // A failed rank cannot make progress with its peer. Retire both
          // owned units before leaving the offline acceptance campaign.
          for stop_last in [false, true] {
            let stop_role = if stop_last { "egress" } else { "ingress" }
            ignore(
              remote(
                stop_last,
                "systemctl --user stop " + prefix + "-" + stop_role + ".service",
              ),
            )
          }
          @fs.write_file(
            root + "/memory-watch.txt",
            observations.to_string(),
            create_mode=CreateNew,
          )
          fail("rank failed: " + role)
        }
        if status.stdout().contains("SubState=exited") {
          terminal += 1
        }
      }
      if terminal == 2 {
        @fs.write_file(
          root + "/memory-watch.txt",
          observations.to_string(),
          create_mode=CreateNew,
        )
        println("both ranks terminal with host reserve retained")
        return
      }
      @async.sleep(5000)
    }
    for stop_last in [false, true] {
      let stop_role = if stop_last { "egress" } else { "ingress" }
      ignore(
        remote(
          stop_last,
          "systemctl --user stop " + prefix + "-" + stop_role + ".service",
        ),
      )
    }
    @fs.write_file(
      root + "/memory-watch.txt",
      observations.to_string(),
      create_mode=CreateNew,
    )
    fail("bounded watch expired; both owned ranks stopped")
  }
  if mode is ("prepare" | "prepare-profile") {
    @fs.mkdir(root)
    let profile = mode == "prepare-profile"
    for last in [false, true] {
      record(
        root,
        if last {
          "179-mkdir"
        } else {
          "178-mkdir"
        },
        remote(last, "mkdir " + root),
      )
    }
    record(root, "queue-mkdir", remote(false, "mkdir " + queue))
    let counts : Array[String] = []
    let samples = []
    let cases = match custom_text {
      Some(text) => explicit_corpus(text)
      None => corpus(profile)
    }
    if custom_text is Some(text) {
      @fs.write_file(root + "/corpus.json", text, create_mode=CreateNew)
    }
    if warmup {
      samples.push(cases[0])
    }
    for sample in cases {
      samples.push(sample)
    }
    for i, (category, prompt) in samples {
      let label = sample_label(i, warmup, "input-")
      let literal = root + "/" + label + ".txt"
      @fs.write_file(literal, template(glm, prompt), create_mode=CreateNew)
      @fs.write_file(
        root + "/category-" + sample_label(i, warmup, "") + ".txt",
        category + "\n",
        create_mode=CreateNew,
      )
      copy(false, literal, host(false) + ":" + literal)
      let output = remote(
        false,
        executable +
        " text-frames " +
        model(glm, false) +
        " \{rows} \{history} " +
        "a".repeat(64) +
        " " +
        literal +
        " " +
        queue +
        "/request-\{i}",
      )
      record(root, "frames-\{i}", output)
      let mut count = 0
      let mut input_tokens = 0
      for word in output.stdout().trim().split(" ") {
        if word.has_prefix("prompt_frames=") {
          count = @string.parse_int(word[14:])
        }
        if word.has_prefix("input_tokens=") {
          input_tokens = @string.parse_int(word[13:])
        }
      }
      guard input_tokens > 0 &&
        count == 1 + (input_tokens - 1) / rows &&
        input_tokens + (if profile { 2 } else { output_budget }) <= history else {
        fail("prompt outside existing AOT envelope")
      }
      counts.push(count.to_string())
      copy(
        false,
        host(false) + ":" + queue + "/request-\{i}/tokens.txt",
        root + "/" + label + "-tokens.txt",
      )
    }
    @fs.write_file(
      root + "/frame-counts.txt",
      counts.join(",") + "\n",
      create_mode=CreateNew,
    )
    copy(
      false,
      root + "/frame-counts.txt",
      host(false) + ":" + queue + "/frame-counts.txt",
    )
    @fs.write_file(
      root + "/profile.txt",
      if profile {
        "true"
      } else {
        "false"
      },
      create_mode=CreateNew,
    )
    @fs.write_file(root + "/selected.txt", selection, create_mode=CreateNew)
    println("prepared " + root)
    return
  }
  let profile = @fs.read_file(root + "/profile.txt").text() == "true"
  let count = (match custom_text {
      Some(text) => explicit_corpus(text).length()
      None => corpus(profile).length()
    }) +
    (if warmup { 1 } else { 0 })
  let maximum = if profile { 2 } else { output_budget }
  if mode == "start" {
    // A closed previous benchmark can leave the listener's accepted socket in
    // TIME_WAIT. Wait for these two benchmark ports; do not change the service
    // socket policy or kill another owner merely to start a measurement.
    let mut ports_free = false
    for attempt in 0..<90 {
      let ports = remote(
        true, "ss -Htan '( sport = :28618 or sport = :28619 )'",
      )
      ports.check()
      if ports.stdout().trim().is_empty() {
        ports_free = true
        break
      }
      if attempt == 0 {
        println("waiting for the previous benchmark sockets to retire")
      }
      @async.sleep(1000)
    }
    guard ports_free else { fail("benchmark ports remain occupied") }
    for last in [false, true] {
      let owners = remote(
        last, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
      )
      record(
        root,
        if last {
          "179-gpu-before"
        } else {
          "178-gpu-before"
        },
        owners,
      )
      guard owners.stdout().trim().is_empty() else { fail("GPU busy") }
      let memory = remote(last, "cat /proc/meminfo")
      record(
        root,
        if last {
          "179-memory-before"
        } else {
          "178-memory-before"
        },
        memory,
      )
      guard available_kib(memory.stdout()) >= 16777216L else {
        fail("host reserve unavailable")
      }
    }
    record(
      root,
      "preflight",
      remote(
        false,
        executable +
        " preflight-generation-sequence " +
        model(glm, false) +
        " \{rows} \{history} \{maximum} \{stop} " +
        queue +
        " \{count} 1048576",
      ),
    )
    for last in [true, false] {
      let role = if last { "egress" } else { "ingress" }
      let unit = prefix + "-" + role + ".service"
      let shards = if glm {
        aot + "/SHARDS.sha256"
      } else {
        (if last {
          "/tmp/lunaflux-deepseek-real-20261010.ZYa0kMPT"
        } else {
          "/tmp/lunaflux-deepseek-real-20261010.dLryo68E"
        }) +
        "/SHARDS.sha256"
      }
      let command = if last {
        if glm {
          "egress"
        } else {
          "egress-dspark"
        }
      } else if glm {
        "generate-sequence"
      } else {
        "generate-sequence-reference-dspark"
      }
      let profile_prefix = if profile || timeline {
        // Whole process: fixed wall-time delays miss inference after loading
        // speed changes. Separate loading copies from model kernels in reports.
        "/usr/local/bin/nsys profile --sample=none --cpuctxsw=none --trace=cuda " +
        // Both profiling modes perturb execution. Graph-level capture omits
        // node events; neither mode supplies an unprofiled latency budget.
        cuda_trace_flags(profile, @env.get_env_var("LUNA_BENCH_GRAPH_TRACE")) +
        "--force-overwrite=false --kill=none --output=" +
        root +
        "/timeline "
      } else if initialization_probe {
        "/usr/local/cuda-13.0/bin/compute-sanitizer --tool initcheck --error-exitcode 9 --print-limit 20 --log-file " +
        root +
        "/initcheck.log "
      } else {
        ""
      }
      let command = command +
        (if chunk {
          "-chunk-kda"
        } else if tiled {
          "-tiled-grouped"
        } else {
          ""
        }) +
        (if expert_tp { "-expert-tp" } else { "" }) +
        (if low_bit { "-low-bit" } else { "" }) +
        (if queued { "-queued-tp" } else { "" }) +
        (if replay { "-graph-tp" } else { "" }) +
        (if shape_aware { "-shape-aware" } else { "" }) +
        (if transport == "tiles" {
          "-tile-experts"
        } else if transport == "bulk" {
          "-bulk-experts"
        } else if transport == "pipeline" {
          "-expert-pipeline"
        } else if transport == "buffered" {
          "-buffered-experts"
        } else if transport == "packed" {
          "-packed-experts"
        } else {
          ""
        }) +
        (if lookahead { "-lookahead-experts" } else { "" }) +
        (if buffered { "-buffered-matrices" } else { "" }) +
        (if prefill_k != "0" { "-prefill-k" + prefill_k } else { "" }) +
        (if distributed { "-distributed-scales" } else { "" }) +
        (if parallel_hc { "-parallel-hc" } else { "" }) +
        (if collective_graph { "-collective-graph" } else { "" }) +
        (if shared_columns != "64" { "-shared" + shared_columns } else { "" }) +
        (if overlap_experts { "-overlap-experts" } else { "" }) +
        (if fused_controls { "-fused-controls" } else { "" }) +
        (if fused_hc { "-fused-hc" } else { "" }) +
        (if deferred_hc { "-deferred-hc" } else { "" }) +
        (if vocab_tp { "-vocab-tp" } else { "" })
      record(
        root,
        role + "-start",
        remote(
          last,
          "systemd-run --user --unit=" +
          unit +
          " --setenv=TMPDIR=" +
          root +
          (if last &&
            @env.get_env_var("LUNA_GLM_CAPTURE_FRONTIERS") == Some("1") {
            " --setenv=LUNA_GLM_RETIRED_FRONTIERS=" +
            root +
            "/frontiers" +
            (match @env.get_env_var("LUNA_GLM_RETIRED_EXPERT_LAYER") {
              Some(value) if value == "all" ||
                (!value.is_empty() && value.iter().all(c => c is ('0'..<='9'))) =>
                " --setenv=LUNA_GLM_RETIRED_EXPERT_LAYER=" + value
              _ => ""
            })
          } else {
            ""
          }) +
          (if expert_tp {
            " --setenv=LD_LIBRARY_PATH=" +
            runtime +
            "/nccl --setenv=NCCL_DEBUG=WARN --setenv=NCCL_SOCKET_IFNAME=" +
            (if last { "enp1s0f0np0" } else { "enp1s0f1np1" }) +
            " --setenv=NCCL_IB_HCA=" +
            (if last { "rocep1s0f0" } else { "rocep1s0f1" })
          } else {
            ""
          }) +
          " --property=RemainAfterExit=yes --property=MemoryMax=" +
          (if expert_tp { "100G" } else { "96G" }) +
          " --property=MemorySwapMax=0 --property=RuntimeMaxSec=10800 " +
          profile_prefix +
          executable +
          " " +
          command +
          " " +
          model(glm, last) +
          " " +
          shards +
          " \{rows} \{history} " +
          (if expert_tp {
            "107374182400 107374182400 "
          } else {
            "103079215104 103079215104 "
          }) +
          (if glm { "2147483648" } else { "4294967296" }) +
          " " +
          aot +
          (if last { " stage-1.cubin" } else { " stage-0.cubin" }) +
          " 192.168.2.179:28618 192.168.2.179:28619" +
          (if last {
            ""
          } else {
            " " +
            queue +
            " \{count} \{maximum} \{stop} " +
            root +
            "/output" +
            (if cancel_warmup {
              " --cancel-request 0 --after-steps 1"
            } else {
              ""
            })
          }),
        ),
      )
      if last {
        let mut ready = false
        for _ in 0..<180 {
          let status = remote(
            true,
            "systemctl --user show " + unit + " -p ActiveState -p SubState",
          )
          status.check()
          guard status.stdout().contains("SubState=running") else {
            fail("egress stopped: " + status.stdout())
          }
          let listeners = remote(true, "ss -ltnp")
          listeners.check()
          if listeners.stdout().contains("192.168.2.179:28618") &&
            listeners.stdout().contains("192.168.2.179:28619") {
            ready = true
            break
          }
          @async.sleep(2000)
        }
        guard ready else { fail("egress not listening") }
      }
    }
    println("started " + prefix + "; both GPUs reserved until both ranks close")
    return
  }
  for last in [false, true] {
    let role = if last { "egress" } else { "ingress" }
    let unit = prefix + "-" + role + ".service"
    let status = remote(
      last,
      "systemctl --user show " +
      unit +
      " -p ActiveState -p SubState -p Result -p ExecMainStatus -p MemoryPeak -p MemorySwapPeak",
    )
    status.check()
    guard status.stdout().contains("SubState=exited") &&
      status.stdout().contains("ExecMainStatus=0") else {
      fail("not normally terminal: " + status.stdout())
    }
    record(root, role + "-terminal", status)
    let journal = remote(last, "journalctl --user -u " + unit + " --no-pager")
    record(root, role + "-journal", journal)
    guard journal.stdout().contains("context_closed=true") else {
      fail("missing explicit release")
    }
    if profile || timeline {
      copy(
        last,
        host(last) + ":" + root + "/timeline.nsys-rep",
        root + "/" + role + ".nsys-rep",
      )
      record(
        root,
        role + "-stats",
        remote(
          last,
          "nsys stats --report cuda_gpu_kern_sum,cuda_api_sum,cuda_gpu_mem_time_sum --format csv " +
          root +
          "/timeline.nsys-rep",
        ),
      )
    }
  }
  for i in 0..<count {
    let label = sample_label(i, warmup, "output-")
    let decoded_label = sample_label(i, warmup, "")
    if cancel_warmup && i == 0 {
      copy(
        false,
        host(false) + ":" + root + "/output/request-0/cancelled.txt",
        root + "/cancelled-warmup.txt",
      )
      guard @fs.read_file(root + "/cancelled-warmup.txt").text() ==
        "request_cancelled=true\n" else {
        fail("missing actual cancellation retirement")
      }
      continue
    }
    let tokens = root + "/" + label + "-tokens.txt"
    copy(
      false,
      host(false) + ":" + root + "/output/request-\{i}/tokens.txt",
      tokens,
    )
    if custom_text is Some(_) {
      copy(
        false,
        host(false) + ":" + root + "/output/request-\{i}/finish.json",
        root + "/finish-" + decoded_label + ".json",
      )
    }
    let ids = @fs.read_file(tokens)
      .text()
      .trim()
      .split("\n")
      .to_array()
      .join(",")
    record(
      root,
      "decode-\{i}",
      remote(
        false,
        executable +
        " decode-tokens " +
        model(glm, false) +
        " " +
        "a".repeat(64) +
        " " +
        ids +
        " " +
        root +
        "/decoded-\{i}.txt",
      ),
    )
    copy(
      false,
      host(false) + ":" + root + "/decoded-\{i}.txt",
      root + "/decoded-" + decoded_label + ".txt",
    )
  }
  println("collected " + root)
}

///|
fn cuda_trace_flags(profile : Bool, level : String?) -> String {
  if level == Some("graph") {
    "--cuda-graph-trace=graph "
  } else if level == Some("node-light") {
    "--cuda-graph-trace=node "
  } else if profile {
    "--cuda-trace-all-apis=true --cuda-graph-trace=node "
  } else {
    ""
  }
}

///|
test "graph-level profiling does not request per-node or all-API events" {
  assert_eq(cuda_trace_flags(true, Some("graph")), "--cuda-graph-trace=graph ")
  assert_true(
    cuda_trace_flags(true, None).contains("--cuda-trace-all-apis=true"),
  )
  assert_eq(cuda_trace_flags(false, None), "")
  assert_eq(
    cuda_trace_flags(true, Some("node-light")),
    "--cuda-graph-trace=node ",
  )
}
