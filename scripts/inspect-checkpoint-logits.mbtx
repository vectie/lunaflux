///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn logits(bytes : Bytes) -> Array[Float] raise {
  guard bytes.length() > 0 && bytes.length() % 4 == 0 else {
    fail("complete little-endian F32 vocabulary row required")
  }
  [
    for i in 0..<(bytes.length() / 4) => {
      let offset = i * 4
      let bits = bytes[offset].to_uint() |
        (bytes[offset + 1].to_uint() << 8) |
        (bytes[offset + 2].to_uint() << 16) |
        (bytes[offset + 3].to_uint() << 24)
      let value = Float::reinterpret_from_uint(bits)
      guard !value.is_nan() && !value.is_inf() else {
        fail("nonfinite native logit")
      }
      value
    }
  ]
}

///|
fn ranked(values : ArrayView[Float], count : Int) -> Array[Int] raise {
  guard count > 0 && count <= values.length() else { fail("top-k extent") }
  let ordered = [ for i in 0..<values.length() => i ]
  ordered.sort_by((a, b) => {
    if values[a] > values[b] { -1 } else if values[a] < values[b] { 1 } else {
      a.compare(b)
    }
  })
  ordered[:count].to_owned()
}

///|
fn bf16_round(value : Float) -> Float {
  let raw = value.reinterpret_as_uint()
  Float::reinterpret_from_uint(
    (raw + 0x7fffU + ((raw >> 16) & 1U)) & 0xffff0000U,
  )
}

///|
fn selected_row(bytes : Bytes, width : Int, row : Int) -> Array[Float] raise {
  guard width > 0 && width <= 1000000 && row >= 0 &&
    bytes.length() % (width * 4) == 0 && row < bytes.length() / (width * 4) else {
    fail("vocabulary row outside physical capture")
  }
  logits(bytes[row * width * 4:(row + 1) * width * 4].to_owned())
}

///|
fn verify_selected(values : ArrayView[Float], token : Int) -> Unit raise {
  guard token >= 0 && token < values.length() && ranked(values, 1)[0] == token else {
    fail("captured row does not reproduce the emitted greedy token")
  }
}

///|
test "native logit analysis retains ties and actual F32 scores" {
  let row = logits(b"\x00\x00\x80\x3f\x00\x00\x00\x40\x00\x00\x00\x40")
  assert_eq(row, [1.0F, 2.0F, 2.0F])
  assert_eq(ranked(row, 3), [1, 2, 0])
  assert_eq(bf16_round(1.00390625F), 1.0F)
  assert_eq(bf16_round(1.01171875F), 1.015625F)
  for bytes in [b"", b"\x00", b"\x00\x00\x80\x7f", b"\x00\x00\xc0\x7f"] {
    try logits(bytes) catch { _ => () } noraise {
      _ => fail("incomplete or nonfinite row accepted")
    }
  }
}

///|
test "selected physical row must reproduce the emitted token" {
  let bytes = b"\x00\x00\x80\x3f\x00\x00\x00\x40\x00\x00\x40\x40\x00\x00\x00\x40"
  let first = selected_row(bytes, 2, 0)
  let last = selected_row(bytes, 2, 1)
  verify_selected(first, 1)
  verify_selected(last, 0)
  try verify_selected(first, 0) catch { _ => () } noraise {
    _ => fail("wrong captured row accepted")
  }
  for (width, row) in [(0, 0), (2, -1), (2, 2), (3, 0)] {
    try selected_row(bytes, width, row) catch { _ => () } noraise {
      _ => fail("invalid row geometry accepted")
    }
  }
}

///|
async fn main {
  guard @env.args() is [_, input, output, width, row, emitted, .. selected] && !selected.is_empty() else {
    fail("NATIVE_LOGITS_F32 NEW_REPORT VOCABULARY_WIDTH PHYSICAL_ROW EMITTED_GREEDY_TOKEN SELECTED_TOKEN_IDS...")
  }
  let width = @string.parse_int(width)
  let row = @string.parse_int(row)
  let emitted = @string.parse_int(emitted)
  let values = selected_row(@fs.read_file(input).binary(), width, row)
  verify_selected(values, emitted)
  let report = StringBuilder()
  report <+ "vocabulary=\{values.length()} physical_row=\{row} emitted_greedy_token=\{emitted}\n"
  for (name, scores) in [
    ("native_f32", values),
    ("rounded_head_bf16_only", values.map(bf16_round)),
  ] {
    let winners = ranked(scores, (5).min(scores.length()))
    for rank, id in winners {
      report <+ "route=\{name} rank=\{rank+1} id=\{id} score=\{scores[id]}\n"
    }
    for token in selected {
      let id = @string.parse_int(token)
      guard id >= 0 && id < scores.length() else { fail("token outside vocabulary") }
      let rank = scores.fold(init=1, (rank, score) => {
        rank + (if score > scores[id] { 1 } else { 0 })
      })
      report <+ "route=\{name} selected=\{id} score=\{scores[id]} rank=\{rank} winner_gap=\{scores[winners[0]]-scores[id]}\n"
    }
  }
  report.write_string(
    "scope=retired_native_row_not_reference_parity\nrounded_head_is_diagnostic_not_a_production_policy_change=true\n",
  )
  @fs.write_file(output, report.to_string(), create_mode=CreateNew)
  println(report.to_string())
}
