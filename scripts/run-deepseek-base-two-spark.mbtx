import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

priv struct Host {
  node : String
  socket : String
  root : String
  model : String
  uuid : String
}

async fn remote(host : Host, command : String) -> String {
  let result = @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
    "-S", host.socket, host.node, command]).output(max_output_bytes=1048576)
  result.check()
  result.stdout()
}

async fn download(host : Host, name : String, destination : String) -> Unit {
  @shell.Cmd("scp", ["-o", "BatchMode=yes", "-o", "ControlPath=" + host.socket,
    host.node + ":" + host.root + "/" + name, destination]).output().check()
}

async fn upload(host : Host, source : String, name : String) -> Unit {
  @shell.Cmd("scp", ["-o", "BatchMode=yes", "-o", "ControlPath=" + host.socket,
    source, host.node + ":" + host.root + "/" + name]).output().check()
}

async fn wait_unit(host : Host, unit : String) -> Unit {
  for ;; {
    let status = remote(host, "systemctl --user show " + unit +
      " --property=ActiveState --property=SubState --property=ExecMainStatus --property=Result")
    if status.contains("ActiveState=failed") ||
      (!status.contains("ExecMainStatus=0\n")) {
      println(remote(host, "journalctl --user -u " + unit + " --no-pager -n 40"))
      fail("terminal user-unit failure: " + unit)
    }
    if status.contains("SubState=exited") && status.contains("Result=success") {
      return
    }
    @async.sleep(10000)
  }
}

async fn start(host : Host, unit : String, memory : String, seconds : Int, command : String) -> Unit {
  println(remote(host, "systemd-run --user --unit=" + unit +
    " --property=RemainAfterExit=yes --property=MemoryMax=" + memory +
    " --property=MemorySwapMax=0 --property=RuntimeMaxSec=" + seconds.to_string() + " " + command))
}

async fn admit_gpu(host : Host) -> Unit {
  let identity = remote(host,
    "nvidia-smi --query-gpu=uuid,pci.bus_id --format=csv,noheader")
  guard identity.trim() == host.uuid + ", 0000000F:01:00.0" else {
    fail("unexpected CUDA device")
  }
  guard remote(host, "nvidia-smi --query-compute-apps=pid --format=csv,noheader").trim().is_empty() else {
    fail("GPU is already in use")
  }
  let tools = remote(host, "sha256sum /usr/local/cuda-13.0/bin/nvcc /usr/local/cuda-13.0/compute-sanitizer/compute-sanitizer")
  guard tools.contains("fbb111f057786ddd10ba723d993cc7dd43abf978b6baa32fedd3c9d806dc79e1  /usr/local/cuda-13.0/bin/nvcc") &&
    tools.contains("7a7fcdefb67042731daf021478176f4919e1843d0b10cb697af28a7d8a3d108b  /usr/local/cuda-13.0/compute-sanitizer/compute-sanitizer") else {
    fail("unexpected CUDA toolchain")
  }
  println(identity.trim())
}

async fn main {
  guard @env.args() is [_, local_root] &&
    local_root.has_prefix("/tmp/lunaflux-deepseek-run-") &&
    local_root.iter().all(c => c is ('a'..='z' | '0'..='9' | '-' | '/' | '.')) &&
    !local_root.contains("..") else { fail("NEW_LOCAL_RESULT_DIRECTORY") }
  @fs.mkdir(local_root)
  let first = Host::{
    node: "wlc003s@192.168.2.178",
    socket: "/tmp/lunaflux-checkpoint-live-20261010.sock",
    root: "/tmp/lunaflux-deepseek-real-20261010.dLryo68E",
    model: "/tmp/lunaflux-deepseek-real-20261010.dLryo68E/DeepSeek-V4-Flash-DSpark",
    uuid: "GPU-9c3d3cf0-439a-5da2-67e9-20414255879f",
  }
  let last = Host::{
    node: "wlc004s@192.168.2.179",
    socket: "/tmp/lunaflux-checkpoint-live179-20261010.sock",
    root: "/tmp/lunaflux-deepseek-real-20261010.ZYa0kMPT",
    model: "/tmp/lunaflux-deepseek-real-20261010.ZYa0kMPT/DeepSeek-V4-Flash-DSpark",
    uuid: "GPU-5b603331-c778-d6ef-7ffa-7c6b774fe4a6",
  }
  // These specific copies were already dispatched. Never restart a live copy.
  for ;; {
    let status = @shell.Cmd("ssh", ["-o", "BatchMode=yes", "lunanexa-management",
      "systemctl --user show lunaflux-deepseek-copy178-20261010-v1.service lunaflux-deepseek-copy179-20261010-v1.service --property=ActiveState --property=ExecMainStatus --property=Result"]
    ).output()
    status.check()
    let value = status.stdout()
    guard !value.contains("ActiveState=failed") &&
      value.split("\n").all(line => !line.has_prefix("ExecMainStatus=") || line == "ExecMainStatus=0") else {
      fail("checkpoint copy failed; preserve the partial directories")
    }
    if !value.contains("ActiveState=active") {
      break
    }
    @async.sleep(10000)
  }
  println("checkpoint copies terminal; inspect exact payloads and placement")
  let executable = "/tmp/lunaflux-checkpoint-build-deepseek-20261010-v1/source/_build/native/release/build/cmd/deepseek_checkpoint/deepseek_checkpoint.exe"
  let expected = "04e6c3a07c8ad5ad5d42bac667a6522d777c756b046d9aebe216052917fd9dd4"
  guard remote(first, "sha256sum " + executable).has_prefix(expected + "  ") &&
    remote(last, "sha256sum " + last.root + "/deepseek_checkpoint.exe").has_prefix(expected + "  ") else {
    fail("checkpoint runner differs from commit 19c8f35a")
  }
  let budgets = " 3 256 103079215104 103079215104 4294967296 "
  let prefix0 = executable + " "
  let args0 = first.model + " " + first.root + "/SHARDS.sha256" + budgets
  let args1 = last.model + " " + last.root + "/SHARDS.sha256" + budgets
  let export_unit = "lunaflux-deepseek-real-export-20261010-v1"
  start(first, export_unit, "4G", 7200, prefix0 + "export " + args0 + first.root + "/aot")
  wait_unit(first, export_unit)
  for file in ["stage-0.cu", "stage-1.cu", "placement.txt"] {
    download(first, "aot/" + file, local_root + "/" + file)
  }
  println(@fs.read_file(local_root + "/placement.txt").text())
  ignore(remote(last, "mkdir " + last.root + "/aot"))
  upload(last, local_root + "/stage-1.cu", "aot/stage-1.cu")
  for (host, ordinal) in [(first, 0), (last, 1)] {
    let unit = "lunaflux-deepseek-real-aot" + ordinal.to_string() + "-20261010-v1"
    start(host, unit, "2G", 1200, "/usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 --cubin -arch=sm_121 " +
      host.root + "/aot/stage-" + ordinal.to_string() + ".cu -o " + host.root + "/aot/stage-" + ordinal.to_string() + ".cubin")
  }
  for (host, ordinal) in [(first, 0), (last, 1)] {
    wait_unit(host, "lunaflux-deepseek-real-aot" + ordinal.to_string() + "-20261010-v1")
    download(host, "aot/stage-" + ordinal.to_string() + ".cubin", local_root + "/stage-" + ordinal.to_string() + ".cubin")
  }
  ignore(remote(first, prefix0 + "token-frames " + first.model + " 3 256 0 " + first.root + "/prompt-bos"))
  admit_gpu(last)
  // CPU/driver/module allocations also live below the per-process ceiling;
  // the pure stage budget separately reserves 4 GiB outside model weights.
  let egress_unit = "lunaflux-deepseek-real-egress-20261010-v1"
  start(last, egress_unit, "96G", 14400, last.root + "/deepseek_checkpoint.exe egress " + args1 +
    last.root + "/aot stage-1.cubin 192.168.2.179:28478 192.168.2.179:28479")
  for ;; {
    let status = remote(last, "systemctl --user show " + egress_unit + " --property=ActiveState --property=SubState")
    guard status.contains("ActiveState=active") && status.contains("SubState=running") else {
      println(remote(last, "journalctl --user -u " + egress_unit + " --no-pager -n 30"))
      fail("egress ended before listening")
    }
    let pid = remote(last, "systemctl --user show " + egress_unit + " --property=MainPID --value").trim().to_owned()
    guard !pid.is_empty() && pid != "0" && pid.iter().all(c => c is ('0'..='9')) else { fail("missing egress PID") }
    let listeners = remote(last, "ss -ltnp")
    let control = listeners.split("\n").any(line => line.contains("192.168.2.179:28478") && line.contains("pid=" + pid + ","))
    let activation = listeners.split("\n").any(line => line.contains("192.168.2.179:28479") && line.contains("pid=" + pid + ","))
    if control && activation { break }
    @async.sleep(10000)
  }
  admit_gpu(first)
  let ingress_unit = "lunaflux-deepseek-real-ingress-20261010-v1"
  start(first, ingress_unit, "96G", 14400, prefix0 + "generate " + args0 +
    first.root + "/aot stage-0.cubin 192.168.2.179:28478 192.168.2.179:28479 " +
    first.root + "/prompt-bos 1 2 -1 " + first.root + "/output-bos")
  wait_unit(first, ingress_unit)
  wait_unit(last, egress_unit)
  download(first, "output-bos/tokens.txt", local_root + "/tokens.txt")
  for (host, name, units) in [
    (first, "178", [export_unit, "lunaflux-deepseek-real-aot0-20261010-v1", ingress_unit]),
    (last, "179", ["lunaflux-deepseek-real-aot1-20261010-v1", egress_unit]),
  ] {
    for unit in units {
      @fs.write_file(local_root + "/" + name + "-" + unit + ".journal.txt",
        remote(host, "journalctl --user -u " + unit + " --no-pager"), create_mode=CreateNew)
    }
  }
  println("base checkpoint smoke terminal; reference correctness and DSpark prediction still require separate tests")
}
