///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

// CPU-only preparation followed by explicitly bounded two-rank execution.
// Export and compile row-one/history-64 AOT from the supplied source-pinned
// executable. Reuse only declared checkpoint labels, never old executable code.
// Never hash copied payloads or overlap another GPU workload.

///|
fn node(last : Bool) -> String {
  if last {
    "wlc004s@192.168.2.179"
  } else {
    "wlc003s@192.168.2.178"
  }
}

///|
fn socket(last : Bool) -> String {
  if last {
    "/tmp/lunaflux-checkpoint-live179-20261010.sock"
  } else {
    "/tmp/lunaflux-checkpoint-live-20261010.sock"
  }
}

///|
fn model(last : Bool) -> String {
  (if last {
    "/tmp/lunaflux-glm-real-20261010.ekEYBzqU"
  } else {
    "/tmp/lunaflux-glm-real-20261010.6yIBQN35"
  }) +
  "/GLM-5.3-Flash-NVFP4"
}

///|
fn declared_shards(last : Bool) -> String {
  if last {
    "/tmp/lunaflux-glm-real-aot-20261010.uvS6YcCC"
  } else {
    "/tmp/lunaflux-glm-real-aot-20261010.qdZHUGIP"
  }
}

///|
async fn remote(last : Bool, command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=10",
    "-S",
    socket(last),
    node(last),
    command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn retain(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn copy(last : Bool, source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket(last),
    source,
    destination,
  ])
  .output()
  .check()
}

///|
async fn collect(root : String, last : Bool, unit : String) -> Unit {
  retain(
    root,
    unit + "-status",
    remote(
      last,
      "systemctl --user show " +
      unit +
      " -p LoadState -p ActiveState -p SubState -p Result -p ExecMainStatus -p MemoryPeak -p MemorySwapPeak",
    ),
  )
  retain(
    root,
    unit + "-journal",
    remote(last, "journalctl --user -u " + unit + " --no-pager"),
  )
}

///|
async fn wait_unit(last : Bool, unit : String) -> Unit {
  for ;; {
    let result = remote(
      last,
      "systemctl --user show " +
      unit +
      " -p LoadState -p ActiveState -p SubState -p Result -p ExecMainStatus",
    )
    result.check()
    let status = result.stdout()
    guard status.contains("LoadState=loaded\n") &&
      !status.contains("ActiveState=failed\n") &&
      status.contains("ExecMainStatus=0\n") else {
      fail("GLM unit missing or failed: " + unit + "\n" + status)
    }
    if status.contains("SubState=exited\n") &&
      status.contains("Result=success\n") {
      return
    }
    @async.sleep(10000)
  }
}

///|
fn frame_count(stdout : String) -> Int raise {
  guard stdout.trim().split(" ").to_array() is [first, ..] &&
    first.has_prefix("prompt_frames=") else {
    fail("missing frame count")
  }
  let count = @string.parse_int(first[14:])
  guard count > 0 && count <= 56 else {
    fail("prompt exceeds generation envelope")
  }
  count
}

///|
fn require_terminal(
  status : String,
  journal : String,
  role : String,
) -> Unit raise {
  guard status.contains("LoadState=loaded\n") &&
    status.contains("SubState=exited\n") &&
    status.contains("Result=success\n") &&
    status.contains("ExecMainStatus=0\n") &&
    status.contains("MemorySwapPeak=0\n") &&
    journal.contains("rank_cleanup: role=" + role + " context_closed=true") else {
    fail("GLM normal exit, release or no-swap boundary not verified")
  }
}

///|
test "GLM literal queue requires a full bounded prefill envelope" {
  assert_eq(frame_count("prompt_frames=13 input_tokens=13\n"), 13)
  assert_eq(frame_count("prompt_frames=56 input_tokens=56\n"), 56)
  for
    input in [
      "", "input_tokens=13", "prompt_frames=0", "prompt_frames=57", "prompt_frames=x",
    ] {
    try frame_count(input) catch {
      _ => ()
    } noraise {
      _ => fail("invalid prepared geometry accepted")
    }
  }
}

///|
test "GLM success requires normal exit, explicit child-free close and no unit swap" {
  let status = "LoadState=loaded\nSubState=exited\nResult=success\nExecMainStatus=0\nMemorySwapPeak=0\n"
  let journal = "rank_cleanup: role=ingress context_closed=true\n"
  require_terminal(status, journal, "ingress")
  for
    invalid in [
      status.replace_all(old="SubState=exited", new="SubState=running"),
      status.replace_all(old="Result=success", new="Result=oom-kill"),
      status.replace_all(old="ExecMainStatus=0", new="ExecMainStatus=1"),
      status.replace_all(old="MemorySwapPeak=0", new="MemorySwapPeak=4096"),
    ] {
    try require_terminal(invalid, journal, "ingress") catch {
      _ => ()
    } noraise {
      _ => fail("unverified terminal state accepted")
    }
  }
  for invalid in ["", "rank_cleanup: role=egress context_closed=true\n"] {
    try require_terminal(status, invalid, "ingress") catch {
      _ => ()
    } noraise {
      _ => fail("missing rank close accepted")
    }
  }
}

///|
fn cancellation_arguments(
  args : ArrayView[String],
) -> (Array[String], Int, Int) raise {
  if args is [.. rest, "--cancel-request", index, "--after-steps", steps] {
    guard !rest.contains("--cancel-request") && !rest.contains("--after-steps") else {
      fail("duplicate cancellation control")
    }
    let index = @string.parse_int(index)
    let steps = @string.parse_int(steps)
    guard index >= 0 && index < 2 && steps > 0 else {
      fail("invalid cancellation selection")
    }
    (rest.to_owned(), index, steps)
  } else {
    guard !args.contains("--cancel-request") && !args.contains("--after-steps") else {
      fail("incomplete cancellation control")
    }
    (args.to_owned(), -1, 0)
  }
}

///|
test "resident queue cancellation is an explicit positive submission count" {
  assert_eq(cancellation_arguments(["run"]).1, -1)
  assert_eq(
    cancellation_arguments([
      "run", "--cancel-request", "0", "--after-steps", "1",
    ]).2,
    1,
  )
  for
    tail in [
      ["--cancel-request", "2", "--after-steps", "1"],
      ["--cancel-request", "0", "--after-steps", "0"],
      ["--cancel-request", "0"],
    ] {
    try cancellation_arguments(tail) catch {
      _ => ()
    } noraise {
      _ => fail("invalid cancellation control accepted")
    }
  }
}

///|
async fn main {
  let (args, cancel_index, cancel_steps) = cancellation_arguments(@env.args())
  guard args is [_, root, suffix, mode, build, commit, input0, input1] &&
    root.has_prefix("/tmp/lunaflux-glm-sequence-") &&
    build.has_prefix("/tmp/lunaflux-checkpoint-build-glm-") &&
    [root, suffix, build].all(path => {
      !path.is_empty() &&
      !path.contains("..") &&
      path.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-'))
    }) &&
    !suffix.contains("/") &&
    commit.length() == 40 &&
    commit.iter().all(c => c is ('0'..='9' | 'a'..='f')) &&
    mode is ("prepare" | "run" | "logits") else {
    fail(
      "NEW_LOCAL_ROOT SUFFIX prepare|run|logits COMMITTED_BUILD COMMIT LITERAL_INPUT0 LITERAL_INPUT1",
    )
  }
  let destination = "/tmp/lunaflux-glm-sequence-" + suffix
  let aot = destination + "/aot"
  let binary = destination + "/glm_checkpoint.exe"
  let queue = destination + "/prompt-sequence"
  let cancellation = if cancel_index < 0 {
    ""
  } else {
    " --cancel-request \{cancel_index} --after-steps \{cancel_steps}"
  }
  let cancellation_metadata = "cancel_request=\{cancel_index}\nafter_steps=\{cancel_steps}\n"
  if mode == "prepare" {
    @fs.mkdir(root)
    let journal = remote(
      false,
      "journalctl --user -u " + build[5:].to_owned() + ".service --no-pager",
    )
    retain(root, "build-journal", journal)
    guard journal.stdout().contains("Finished. moon:") &&
      journal.stdout().contains("now up to date") else {
      fail("build not complete")
    }
    copy(
      false,
      node(false) +
      ":" +
      build +
      "/source/_build/native/release/build/cmd/glm_checkpoint/glm_checkpoint.exe",
      root + "/glm_checkpoint.exe",
    )
    for last in [false, true] {
      retain(
        root,
        if last {
          "179-mkdir"
        } else {
          "178-mkdir"
        },
        remote(last, "mkdir " + destination),
      )
      copy(last, root + "/glm_checkpoint.exe", node(last) + ":" + binary)
    }
    let export_unit = "lunaflux-glm-sequence-" + suffix + "-export.service"
    retain(
      root,
      "export-start",
      remote(
        false,
        "systemd-run --user --unit=" +
        export_unit +
        " --property=RemainAfterExit=yes --property=MemoryMax=4G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1800 " +
        binary +
        " export " +
        model(false) +
        " " +
        declared_shards(false) +
        "/SHARDS.sha256 1 64 103079215104 103079215104 2147483648 " +
        aot,
      ),
    )
    {
      errdefer collect(root, false, export_unit)
      wait_unit(false, export_unit)
    }
    collect(root, false, export_unit)
    retain(root, "179-aot-mkdir", remote(true, "mkdir " + aot))
    for (last, ordinal) in [(false, 0), (true, 1)] {
      let source = "stage-\{ordinal}.cu"
      copy(false, node(false) + ":" + aot + "/" + source, root + "/" + source)
      if last {
        copy(true, root + "/" + source, node(true) + ":" + aot + "/" + source)
      }
      retain(
        root,
        "\{ordinal}-declared-shards",
        remote(
          last,
          "cp -n " +
          declared_shards(last) +
          "/SHARDS.sha256 " +
          aot +
          "/SHARDS.sha256",
        ),
      )
      let unit = "lunaflux-glm-sequence-" +
        suffix +
        "-compile-\{ordinal}.service"
      retain(
        root,
        "\{ordinal}-compile-start",
        remote(
          last,
          "systemd-run --user --unit=" +
          unit +
          " --property=RemainAfterExit=yes --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1800 /usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 --cubin -arch=sm_121 " +
          aot +
          "/" +
          source +
          " -o " +
          aot +
          "/stage-\{ordinal}.cubin",
        ),
      )
      {
        errdefer collect(root, last, unit)
        wait_unit(last, unit)
      }
      collect(root, last, unit)
      copy(
        last,
        node(last) + ":" + aot + "/stage-\{ordinal}.cubin",
        root + "/stage-\{ordinal}.cubin",
      )
    }
    retain(root, "queue-mkdir", remote(false, "mkdir " + queue))
    let counts : Array[Int] = []
    for index, input in [input0, input1] {
      let literal = destination + "/input-\{index}.txt"
      copy(false, input, node(false) + ":" + literal)
      let output = remote(
        false,
        binary +
        " text-frames " +
        model(false) +
        " 1 64 " +
        "a".repeat(64) +
        " " +
        literal +
        " " +
        queue +
        "/request-\{index}",
      )
      retain(root, "request-\{index}-frames", output)
      guard output.stderr().is_empty() else {
        fail("literal preparation stderr")
      }
      let count = frame_count(output.stdout())
      counts.push(count)
      for file in ["tokens.txt", "decoded.txt"] {
        copy(
          false,
          node(false) + ":" + queue + "/request-\{index}/" + file,
          root + "/input-\{index}-" + file,
        )
      }
      assert_eq(
        @fs.read_file(root + "/input-\{index}-decoded.txt").binary(),
        @fs.read_file(input).binary(),
      )
    }
    @fs.write_file(
      root + "/frame-counts.txt",
      "\{counts[0]},\{counts[1]}\n",
      create_mode=CreateNew,
    )
    copy(
      false,
      root + "/frame-counts.txt",
      node(false) + ":" + queue + "/frame-counts.txt",
    )
    retain(
      root,
      "queue-preflight",
      remote(
        false,
        binary +
        " preflight-generation-sequence " +
        model(false) +
        " 1 64 8 -1 " +
        queue +
        " 2 1048576",
      ),
    )
    @fs.write_file(
      root + "/prepared.txt",
      "commit=" +
      commit +
      "\nbuild=" +
      build +
      "\nrows=1\nhistory=64\nmaximum_new_tokens=8\nstop_token=-1\n" +
      cancellation_metadata,
      create_mode=CreateNew,
    )
    println(
      "two literal GLM requests prepared; fresh source-pinned AOT compiled, no payload hashing",
    )
    return
  }
  if cancel_index >= 0 {
    guard @fs.read_file(root + "/prepared.txt")
      .text()
      .contains(cancellation_metadata) else {
      fail("cancellation differs from the prepared request queue")
    }
  }
  guard @fs.read_file(root + "/prepared.txt")
    .text()
    .contains("commit=" + commit + "\n") else {
    fail("wrong prepared source")
  }
  for last in [false, true] {
    let owners = remote(
      last, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    retain(root, if last { "179-gpu-before" } else { "178-gpu-before" }, owners)
    guard owners.stdout().trim().is_empty() else {
      fail("GPU busy; do not overlap workloads")
    }
  }
  let name = "lunaflux-glm-sequence-" + suffix
  let egress = name + "-egress.service"
  let ingress = name + "-ingress.service"
  let peers = " 192.168.2.179:28588 192.168.2.179:28589"
  let common = " 1 64 103079215104 103079215104 2147483648 "
  retain(
    root,
    "egress-start",
    remote(
      true,
      "systemd-run --user --unit=" +
      egress +
      " --property=RemainAfterExit=yes --property=MemoryMax=96G --property=MemorySwapMax=0 --property=RuntimeMaxSec=7200 " +
      binary +
      (if mode == "logits" { " egress-logits " } else { " egress " }) +
      model(true) +
      " " +
      aot +
      "/SHARDS.sha256" +
      common +
      aot +
      " stage-1.cubin" +
      peers +
      (if mode == "logits" { " " + destination + "/retired-head" } else { "" }),
    ),
  )
  for ;; {
    let result = remote(
      true,
      "systemctl --user show " +
      egress +
      " -p MainPID -p SubState -p ActiveState",
    )
    result.check()
    guard result.stdout().contains("SubState=running\n") else {
      collect(root, true, egress)
      fail("egress stopped before listening")
    }
    let pid = remote(
      true,
      "systemctl --user show " + egress + " -p MainPID --value",
    )
    pid.check()
    let owner = pid.stdout().trim().to_owned()
    let listeners = remote(true, "ss -ltnp")
    listeners.check()
    if ["28588", "28589"].all(port => {
        listeners
        .stdout()
        .split("\n")
        .any(line => {
          line.contains("192.168.2.179:" + port) &&
          line.contains("pid=" + owner + ",")
        })
      }) {
      break
    }
    @async.sleep(10000)
  }
  retain(
    root,
    "ingress-start",
    remote(
      false,
      "systemd-run --user --unit=" +
      ingress +
      " --property=RemainAfterExit=yes --property=MemoryMax=96G --property=MemorySwapMax=0 --property=RuntimeMaxSec=7200 " +
      binary +
      " generate-sequence " +
      model(false) +
      " " +
      aot +
      "/SHARDS.sha256" +
      common +
      aot +
      " stage-0.cubin" +
      peers +
      " " +
      queue +
      " 2 8 -1 " +
      destination +
      "/output" +
      cancellation,
    ),
  )
  {
    errdefer {
      collect(root, false, ingress)
      collect(root, true, egress)
    }
    wait_unit(false, ingress)
    wait_unit(true, egress)
  }
  collect(root, false, ingress)
  collect(root, true, egress)
  for
    (last, unit, role) in [
      (false, ingress, "ingress"),
      (true, egress, "egress"),
    ] {
    let status = @fs.read_file(root + "/" + unit + "-status.stdout").text()
    let journal = @fs.read_file(root + "/" + unit + "-journal.stdout").text()
    require_terminal(status, journal, role)
    let owners = remote(
      last, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    retain(root, role + "-gpu-after", owners)
    guard owners.stdout().trim().is_empty() else { fail("GPU owner remains") }
  }
  let journal = @fs.read_file(root + "/" + ingress + "-journal.stdout").text()
  for index in 0..<2 {
    guard journal.contains("request_retired: index=\{index} ") else {
      fail("request did not retire")
    }
    if index == cancel_index {
      retain(
        root,
        "cancelled-output-state",
        remote(
          false,
          "test -f " +
          destination +
          "/output/request-\{index}/cancelled.txt && test ! -e " +
          destination +
          "/output/request-\{index}/tokens.txt",
        ),
      )
      copy(
        false,
        node(false) +
        ":" +
        destination +
        "/output/request-\{index}/cancelled.txt",
        root + "/cancelled-\{index}.txt",
      )
      assert_eq(
        @fs.read_file(root + "/cancelled-\{index}.txt").text(),
        "request_cancelled=true\n",
      )
      guard journal.contains("request_released=true weights_retained=true") else {
        fail("request cancellation did not release while retaining weights")
      }
      continue
    }
    copy(
      false,
      node(false) + ":" + destination + "/output/request-\{index}/tokens.txt",
      root + "/tokens-\{index}.txt",
    )
    let tokens = @fs.read_file(root + "/tokens-\{index}.txt")
      .text()
      .trim()
      .split("\n")
      .to_array()
    assert_eq(tokens.length(), 8)
    for token in tokens {
      guard @string.parse_int(token) >= 0 else { fail("invalid output ID") }
    }
  }
  if mode == "logits" {
    copy(
      true,
      node(true) + ":" + destination + "/retired-head/logits.f32",
      root + "/last-request-final-logits.f32",
    )
    @fs.write_file(
      root + "/logits-scope.txt",
      "request=1\nphysical_selected_row=0\npredicts_generated_token_index=7\nconsumed_generated_prefix_length=7\nraw_model_full_vocabulary=true\n",
      create_mode=CreateNew,
    )
  }
  println(
    "GLM two-request resident queue completed; independent numerical and concurrent serving parity remain unverified",
  )
}
