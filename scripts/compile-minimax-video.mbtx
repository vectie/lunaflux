///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o", "BatchMode=yes", "-S", "/tmp/lunaflux-checkpoint-live-20261010.sock", "wlc003s@192.168.2.178",
    command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn record(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn main {
  guard @env.args() is [_, config, root, suffix] &&
    config.has_prefix("/tmp/lunaflux-minimax-video-config-") &&
    root.has_prefix("/tmp/lunaflux-minimax-video-aot-") &&
    [config, root, suffix].all(s => {
      !s.is_empty() &&
      !s.contains("..") &&
      s.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-'))
    }) &&
    !suffix.contains("/") else {
    fail("existing local config/export, new output root, unique suffix")
  }
  @fs.mkdir(root)
  record(root, "mkdir", remote("mkdir " + root))
  record(root, "tool", remote("sha256sum /usr/local/cuda-13.0/bin/nvcc"))
  guard @fs.read_file(root + "/tool.stdout")
    .text()
    .has_prefix(
      "fbb111f057786ddd10ba723d993cc7dd43abf978b6baa32fedd3c9d806dc79e1  ",
    ) else {
    fail("different AOT compiler")
  }
  let source = config + "/aot/video_decode.cu"
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=/tmp/lunaflux-checkpoint-live-20261010.sock",
    source,
    "wlc003s@192.168.2.178:" + root + "/video_decode.cu",
  ])
  .output()
  .check()
  record(
    root,
    "source-remote",
    remote("sha256sum " + root + "/video_decode.cu"),
  )
  record(
    root,
    "source-local",
    @shell.Cmd("shasum", ["-a", "256", source]).output(),
  )
  guard @fs.read_file(root + "/source-remote.stdout").text().split(" ").next() ==
    @fs.read_file(root + "/source-local.stdout").text().split(" ").next() else {
    fail("source upload differs")
  }
  // CPU-only compilation can overlap checkpoint loading; it performs no CUDA
  // admission or execution and stays within its own 2-GiB/no-swap cgroup.
  record(
    root,
    "compile",
    remote(
      "systemd-run --user --wait --pipe --unit=lunaflux-minimax-video-aot-" +
      suffix +
      " --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1800 /usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 --cubin -arch=sm_121 " +
      root +
      "/video_decode.cu -o " +
      root +
      "/video_decode.cubin",
    ),
  )
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=/tmp/lunaflux-checkpoint-live-20261010.sock",
    "wlc003s@192.168.2.178:" + root + "/video_decode.cubin",
    root + "/video_decode.cubin",
  ])
  .output()
  .check()
  record(
    root,
    "binary-remote",
    remote("sha256sum " + root + "/video_decode.cubin"),
  )
  record(
    root,
    "binary-local",
    @shell.Cmd("shasum", ["-a", "256", root + "/video_decode.cubin"]).output(),
  )
  guard @fs.read_file(root + "/binary-remote.stdout").text().split(" ").next() ==
    @fs.read_file(root + "/binary-local.stdout").text().split(" ").next() else {
    fail("cubin download differs")
  }
  println(
    "shared whole-request VideoVAE AOT compiled; no decoder execution claimed",
  )
}
