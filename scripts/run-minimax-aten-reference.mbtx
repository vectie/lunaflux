///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

// Offline, sequential reference diagnostic. Never part of model startup.

///|
let image : String = "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/h3-runtime-serving:20260923-arm64-r2"

///|
let socket178 : String = "/tmp/lunaflux-checkpoint-live-20261010.sock"

///|
let socket179 : String = "/tmp/lunaflux-checkpoint-live179-20261010.sock"

///|
async fn remote(
  node : String,
  socket : String,
  command : String,
) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-S", socket, node, command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn copy(socket : String, from : String, to : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket,
    from,
    to,
  ])
  .output()
  .check()
}

///|
async fn save_output(
  root : String,
  name : String,
  result : @shell.Output,
) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
}

///|
async fn record(root : String, name : String, result : @shell.Output) -> Unit {
  save_output(root, name, result)
  result.check()
}

///|
fn safe(path : String) -> Bool {
  !path.contains("..") &&
  path
  .iter()
  .all(c => c is ('a'..='z' | 'A'..='Z' | '0'..='9' | '/' | '-' | '_' | '.'))
}

///|
fn needs_native_inputs(mode : String) -> Bool {
  mode == "replay-operators" ||
  mode == "replay-full-reduction" ||
  mode == "projection-oracle" ||
  mode == "replay-down-reduction"
}

///|
fn needs_gpu(mode : String) -> Bool {
  mode != "self-test" && mode != "replay-down-reduction"
}

///|
fn reference_arguments(
  mode : String,
  ids? : String = "32,2518,8251",
) -> String raise {
  let prefix = " " + mode + " /work/libreference.so /model "
  match mode {
    "self-test" => " self-test /work/libreference.so /work/self-test"
    "projection-oracle" => prefix + "/native /work/projection-oracle"
    "replay-down-reduction" => prefix + "/native /oracle"
    "replay-operators" | "replay-full-reduction" =>
      prefix + ids + " /work/" + mode + " /native"
    "encode" | "encode-full-reduction" | "encode-wide-attention"
    | "encode-wide-projection" | "encode-wide-linear-attention" =>
      prefix + ids + " /work/" + mode + " 50"
    "encode-operators" => prefix + ids + " /work/encode-operators 1"
    _ => fail("not a reference execution mode")
  }
}

///|
fn text_ids(source : String) -> String raise {
  let ids : Array[Int] = []
  for value in source.trim().split(",") {
    ids.push(@string.parse_int(value))
  }
  guard ids.length() > 0 &&
    ids.length() <= 1024 &&
    ids.all(id => id >= 0 && id < 151936) else {
    fail("reference text IDs exceed diagnostic row/vocabulary capacity")
  }
  ids.map(id => id.to_string()).join(",")
}

///|
test "matched replay stays distinct from a fifty-layer reference" {
  assert_eq(text_ids("32,2518,8251\n"), "32,2518,8251")
  assert_true(
    reference_arguments("encode", ids="1,2").contains(" 1,2 /work/encode 50"),
  )
  for mode in ["replay-operators", "replay-full-reduction"] {
    assert_true(needs_native_inputs(mode))
    assert_true(reference_arguments(mode).has_suffix(" /native"))
    assert_true(reference_arguments(mode).contains("/work/" + mode))
    let long_ids = "1,".repeat(139) + "2"
    assert_true(
      reference_arguments(mode, ids=long_ids).contains(
        " /model " + long_ids + " ",
      ),
    )
  }
  assert_true(reference_arguments("encode-full-reduction").has_suffix(" 50"))
  assert_false(needs_native_inputs("encode-full-reduction"))
  assert_true(reference_arguments("encode-wide-attention").has_suffix(" 50"))
  assert_false(needs_native_inputs("encode-wide-attention"))
  for mode in ["encode-wide-projection", "encode-wide-linear-attention"] {
    assert_true(reference_arguments(mode).has_suffix(" 50"))
    assert_false(needs_native_inputs(mode))
  }
  assert_true(reference_arguments("encode-operators").has_suffix(" 1"))
  assert_true(needs_native_inputs("projection-oracle"))
  assert_true(needs_native_inputs("replay-down-reduction"))
  assert_false(needs_gpu("replay-down-reduction"))
  assert_eq(
    reference_arguments("replay-down-reduction"),
    " replay-down-reduction /work/libreference.so /model /native /oracle",
  )
  assert_eq(
    reference_arguments("projection-oracle"),
    " projection-oracle /work/libreference.so /model /native /work/projection-oracle",
  )
  try reference_arguments("collect") catch {
    _ => ()
  } noraise {
    _ => fail("collector became an execution mode")
  }
}

///|
test "reference text rejects empty, invalid vocabulary and oversized rows" {
  for source in ["", "-1", "151936", "1,", "1,".repeat(1024) + "1"] {
    try text_ids(source) catch {
      _ => ()
    } noraise {
      _ => fail("invalid reference input accepted")
    }
  }
}

///|
async fn main {
  guard @env.args() is [_, mode, root, .. extra] &&
    (
      extra is [] ||
      ((needs_native_inputs(mode) || mode.has_prefix("encode")) && extra is [_]) ||
      (
        (
          mode == "replay-down-reduction" ||
          mode == "replay-operators" ||
          mode == "replay-full-reduction"
        ) &&
        extra is [_, _]
      )
    ) &&
    root.has_prefix("/tmp/lunaflux-minimax-aten-reference-") &&
    safe(root) else {
    fail(
      "stage|self-test|asan|encode|encode-operators|encode-full-reduction|replay-operators|replay-full-reduction|projection-oracle|replay-down-reduction|collect|collect-full-reduction|collect-operators|collect-replay|collect-full-replay|collect-oracle EVIDENCE_ROOT [ENCODE_TOKEN_IDS_TXT | NATIVE_OPERATOR_DIRECTORY [PRECISION_ORACLE_DIRECTORY]]",
    )
  }
  let first = "wlc003s@192.168.2.178"
  let second = "wlc004s@192.168.2.179"
  let tools = "/tmp/lunaflux-glm-arm-build-20261010.WGAwEo3b/toolchain"
  let source = root + "/source"
  let tag = root.split("/").to_array().last().unwrap().to_owned()
  if mode == "stage" {
    @fs.mkdir(root)
    @shell.Cmd("env", [
      "COPYFILE_DISABLE=1",
      "tar",
      "-czf",
      root + "/source.tar.gz",
      "-C",
      "benchmarks/checkpoint_aten_reference",
      "--exclude=_build",
      "--exclude=.mooncakes",
      "--exclude=._*",
      ".",
    ])
    .output()
    .check()
    record(root, "mkdir178", remote(first, socket178, "mkdir -m 755 " + root))
    record(
      root,
      "mkdir-source178",
      remote(first, socket178, "mkdir -m 755 " + source),
    )
    copy(
      socket178,
      root + "/source.tar.gz",
      first + ":" + root + "/source.tar.gz",
    )
    record(
      root,
      "unpack178",
      remote(
        first,
        socket178,
        "tar -xf " + root + "/source.tar.gz -C " + source,
      ),
    )
    record(
      root,
      "driver-build",
      remote(
        first,
        socket178,
        "systemd-run --user --wait --pipe --unit=" +
        tag +
        "-driver-build --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1200 --working-directory=" +
        source +
        " /usr/bin/env MOON_HOME=" +
        tools +
        " PATH=" +
        tools +
        "/bin:/usr/bin:/bin MOON_CC=gcc " +
        tools +
        "/bin/moon build driver --release --target native --deny-warn -j 2",
      ),
    )
    copy(
      socket178,
      first + ":" + source + "/_build/native/release/build/driver/driver.exe",
      root + "/driver.exe",
    )
    record(root, "mkdir179", remote(second, socket179, "mkdir -m 755 " + root))
    copy(socket179, root + "/driver.exe", second + ":" + root + "/driver.exe")
    copy(
      socket179,
      "benchmarks/checkpoint_aten_reference/aten/ops.cpp",
      second + ":" + root + "/ops.cpp",
    )
    record(
      root,
      "aten-build",
      remote(
        second,
        socket179,
        "systemd-run --user --wait --pipe --unit=" +
        tag +
        "-sdk-build --property=MemoryMax=4G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1200 docker run --rm --name " +
        tag +
        "-build --network none --user 1000:1000 --memory 4g --memory-swap 4g --pids-limit 256 --cpuset-cpus 0-3 -v " +
        root +
        ":/work --entrypoint /usr/bin/g++ " +
        image +
        " -O2 -std=c++17 -shared -fPIC /work/ops.cpp -I/usr/local/lib/python3.12/dist-packages/torch/include -L/usr/local/lib/python3.12/dist-packages/torch/lib -Wl,-rpath,/usr/local/lib/python3.12/dist-packages/torch/lib -Wl,--no-as-needed -ltorch_cuda -ltorch_cpu -lc10_cuda -lc10 -o /work/libreference.so",
      ),
    )
    println(
      "separate MoonBit reference driver and installed ATen bridge built; no GPU inference started",
    )
  } else if mode == "asan" {
    @fs.mkdir(root + "/asan")
    record(
      root,
      "asan-mkdir",
      remote(second, socket179, "mkdir -m 755 " + root + "/asan"),
    )
    copy(
      socket179,
      "benchmarks/checkpoint_aten_reference/aten/ownership_probe.cpp",
      second + ":" + root + "/ownership_probe.cpp",
    )
    let common = " --network none --user 1000:1000 --memory 4g --memory-swap 4g --pids-limit 256 --cpuset-cpus 0-3 -v " +
      root +
      ":/work"
    record(
      root,
      "asan-build",
      remote(
        second,
        socket179,
        "docker run --rm --name " +
        tag +
        "-asan-build" +
        common +
        " --entrypoint /usr/bin/g++ " +
        image +
        " -O1 -g -std=c++17 -fsanitize=address -fno-omit-frame-pointer /work/ops.cpp /work/ownership_probe.cpp -I/usr/local/lib/python3.12/dist-packages/torch/include -L/usr/local/lib/python3.12/dist-packages/torch/lib -Wl,-rpath,/usr/local/lib/python3.12/dist-packages/torch/lib -ltorch_cpu -lc10 -o /work/ownership_probe.exe",
      ),
    )
    record(
      root,
      "asan",
      remote(
        second,
        socket179,
        "docker run --name " +
        tag +
        "-asan" +
        common +
        " -e ASAN_OPTIONS=detect_leaks=1:fast_unwind_on_malloc=0 --entrypoint /work/ownership_probe.exe " +
        image +
        " /work/asan",
      ),
    )
    println("independent ATen ownership probe passed ASan and LSan")
  } else if mode == "self-test" ||
    mode == "encode" ||
    mode == "encode-operators" ||
    mode == "encode-full-reduction" ||
    mode == "encode-wide-attention" ||
    mode == "encode-wide-projection" ||
    mode == "encode-wide-linear-attention" ||
    mode == "replay-operators" ||
    mode == "replay-full-reduction" ||
    mode == "replay-down-reduction" ||
    mode == "projection-oracle" {
    let name = tag + "-" + mode
    let output = root + "/" + mode
    @fs.mkdir(output)
    record(
      root,
      mode + "-mkdir",
      remote(second, socket179, "mkdir -m 755 " + output),
    )
    let model = "/tmp/lunaflux-minimax-text-upload-20261010-v2-179/FL2VA/text_encoder"
    if needs_gpu(mode) {
      let owners = remote(
        second, socket179, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
      )
      record(root, "before-" + mode + "-owners", owners)
      guard owners.stdout().trim().is_empty() else {
        fail("GPU has an existing owner; reference not started")
      }
    }
    let device = if needs_gpu(mode) { " --gpus all" } else { "" }
    let replay = match extra {
      [_] if mode.has_prefix("encode") => ""
      [input, ..] if safe(input) &&
        input.has_prefix("/tmp/lunaflux-minimax-text-encoder-operators-") =>
        input
      [] => ""
      _ => fail("invalid native operator directory")
    }
    guard !needs_native_inputs(mode) || !replay.is_empty() else {
      fail("matched-input diagnostic needs native operator directory")
    }
    let oracle = match extra {
      [_, precision] if mode == "replay-down-reduction" &&
        safe(precision) &&
        precision.has_prefix("/tmp/lunaflux-minimax-aten-reference-") =>
        " -v " + precision + ":/oracle:ro"
      _ if mode == "replay-down-reduction" =>
        fail("down replay needs precision oracle")
      _ => ""
    }
    let ids = match extra {
      [path] if mode.has_prefix("encode") =>
        text_ids(@fs.read_file(path).text())
      [_, path] if mode == "replay-operators" || mode == "replay-full-reduction" =>
        text_ids(@fs.read_file(path).text())
      _ => "32,2518,8251"
    }
    let arguments = reference_arguments(mode, ids~)
    let execution = remote(
      second,
      socket179,
      "systemd-run --user --wait --pipe --unit=" +
      name +
      " --property=MemoryMax=8G --property=MemorySwapMax=0 --property=RuntimeMaxSec=5400 docker run --name " +
      name +
      device +
      " --network none --user 1000:1000 --memory 8g --memory-swap 8g --pids-limit 256 --cpuset-cpus 0-3 -e OMP_NUM_THREADS=2 -e OPENBLAS_NUM_THREADS=2 -v " +
      root +
      ":/work -v " +
      model +
      ":/model:ro" +
      (if replay.is_empty() { "" } else { " -v " + replay + ":/native:ro" }) +
      oracle +
      " --entrypoint /work/driver.exe " +
      image +
      arguments,
    )
    // Preserve the actual terminal state even when the diagnostic fails.
    // Checking the execution status first used to discard its Docker receipt.
    save_output(root, mode, execution)
    record(
      root,
      mode + "-terminal",
      remote(
        second,
        socket179,
        "docker inspect --format '{{json .State}}' " + name,
      ),
    )
    record(
      root,
      mode + "-journal",
      remote(second, socket179, "journalctl --user -u " + name + " --no-pager"),
    )
    if needs_gpu(mode) {
      record(
        root,
        mode + "-released",
        remote(
          second, socket179, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
        ),
      )
    }
    execution.check()
    println("reference " + mode + " terminated; collect original outputs next")
  } else if mode == "collect-oracle" {
    for name in ["q", "k", "v", "output", "gate", "up", "down"] {
      for precision in ["bf16", "bf16-full", "f32", "f64"] {
        let path = root +
          "/projection-oracle/" +
          name +
          "-" +
          precision +
          ".bf16"
        @fs.write_file(path, b"", create_mode=CreateNew)
        copy(socket179, second + ":" + path, path)
      }
    }
    record(
      root,
      "after-oracle-owners",
      remote(
        second, socket179, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
      ),
    )
    println("matched-input precision probe outputs collected")
  } else if mode == "collect-operators" ||
    mode == "collect-replay" ||
    mode == "collect-full-replay" {
    let directory = if mode == "collect-replay" {
      "replay-operators"
    } else if mode == "collect-full-replay" {
      "replay-full-reduction"
    } else {
      "encode-operators"
    }
    for
      name in [
        "embedding", "norm-input", "q", "k", "v", "q-norm", "k-norm", "q-rotary",
        "k-rotary", "attention", "output", "residual-attn", "norm-mlp", "activation",
        "down", "residual-mlp",
      ] {
      let path = root + "/" + directory + "/" + name + ".bf16"
      @fs.write_file(path, b"", create_mode=CreateNew)
      copy(socket179, second + ":" + path, path)
    }
    record(
      root,
      "after-" + directory + "-owners",
      remote(
        second, socket179, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
      ),
    )
    println("first-layer independent operator outputs collected")
  } else if mode == "collect" ||
    mode == "collect-full-reduction" ||
    mode == "collect-wide-attention" ||
    mode == "collect-wide-projection" ||
    mode == "collect-wide-linear-attention" {
    let directory = if mode == "collect-full-reduction" {
      "encode-full-reduction"
    } else if mode == "collect-wide-attention" {
      "encode-wide-attention"
    } else if mode == "collect-wide-projection" {
      "encode-wide-projection"
    } else if mode == "collect-wide-linear-attention" {
      "encode-wide-linear-attention"
    } else {
      "encode"
    }
    for layer in 0..<=50 {
      @fs.write_file(
        root + "/" + directory + "/hidden-\{layer}.bf16",
        b"",
        create_mode=CreateNew,
      )
      copy(
        socket179,
        second + ":" + root + "/" + directory + "/hidden-\{layer}.bf16",
        root + "/" + directory + "/hidden-\{layer}.bf16",
      )
    }
    record(
      root,
      "after-" + directory + "-owners",
      remote(
        second, socket179, "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
      ),
    )
    record(
      root,
      directory + "-collected-journal",
      remote(
        second,
        socket179,
        "journalctl --user -u " + tag + "-" + directory + " --no-pager",
      ),
    )
    println("all independent layer outputs collected without overwrite")
  } else {
    fail("unknown reference runner mode")
  }
}
