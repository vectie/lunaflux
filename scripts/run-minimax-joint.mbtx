///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o", "BatchMode=yes", "-S", "/tmp/lunaflux-checkpoint-live-20261010.sock", "wlc003s@192.168.2.178",
    command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn record(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
fn encoded_rows(bytes : Int) -> Int raise {
  // hidden_states[50] has 5,120 BF16 lanes per row in the actual checkpoint.
  guard bytes > 0 && bytes % 10240 == 0 else {
    fail("encoder output must contain complete 5,120-lane BF16 rows")
  }
  bytes / 10240
}

///|
test "joint request derives conditioning rows from actual encoder output" {
  assert_eq(encoded_rows(30720), 3)
  assert_eq(encoded_rows(10240), 1)
  for bytes in [0, 30719, 30721] {
    try encoded_rows(bytes) catch {
      _ => ()
    } noraise {
      _ => fail("incomplete conditioning accepted")
    }
  }
}

///|
fn cancellation_arguments(
  args : ArrayView[String],
) -> (ArrayView[String], Int) raise {
  if args is [.. rest, "--cancel-request", "0", "--after-steps", steps] {
    guard !rest.contains("--cancel-request") && !rest.contains("--after-steps") else {
      fail("duplicate cancellation control")
    }
    let count = @string.parse_int(steps)
    guard count > 0 else { fail("invalid cancellation frame count") }
    (rest, count)
  } else {
    guard !args.contains("--cancel-request") && !args.contains("--after-steps") else {
      fail(
        "joint cancellation requires request zero and a positive frame count",
      )
    }
    (args, 0)
  }
}

///|
test "joint runner preserves default execution and explicit frame cancellation" {
  let base = ["script", "root", "suffix", "build", "aot", "encoded"]
  assert_eq(cancellation_arguments(base).1, 0)
  let selected = base.copy()
  selected.append(["--cancel-request", "0", "--after-steps", "2"])
  let (plain, count) = cancellation_arguments(selected)
  assert_eq(plain.to_owned(), base)
  assert_eq(count, 2)
  for
    suffix in [
      ["--cancel-request", "1", "--after-steps", "2"],
      ["--cancel-request", "0", "--after-steps", "0"],
      ["--cancel-request", "0", "--after-steps", "x"],
      ["--after-steps", "2"],
    ] {
    let bad = base.copy()
    bad.append(suffix)
    try cancellation_arguments(bad) catch {
      _ => ()
    } noraise {
      _ => fail("invalid joint cancellation accepted")
    }
  }
}

///|
fn seed_arguments(args : ArrayView[String]) -> (ArrayView[String], Int64) raise {
  if args is [.. rest, "--seed", value] {
    guard !rest.contains("--seed") else { fail("duplicate seed") }
    (rest, @string.parse_int64(value))
  } else {
    guard !args.contains("--seed") else {
      fail("--seed requires a final signed I64 value")
    }
    (args, 17L)
  }
}

///|
test "joint replay supplies an explicit seed without changing default controls" {
  let base = ["script", "root", "suffix", "build", "aot", "encoded"]
  assert_eq(seed_arguments(base).1, 17L)
  let explicit = base.copy()
  explicit.append(["--seed", "-5814885994241873734"])
  let (plain, seed) = seed_arguments(explicit)
  assert_eq(plain.to_owned(), base)
  assert_eq(seed, -5814885994241873734L)
  for suffix in [["--seed"], ["--seed", "x"], ["--seed", "17", "--seed", "18"]] {
    let bad = base.copy()
    bad.append(suffix)
    try seed_arguments(bad) catch {
      _ => ()
    } noraise {
      _ => fail("bad seed accepted")
    }
  }
}

///|
fn capture_arguments(
  args : ArrayView[String],
) -> (ArrayView[String], Bool) raise {
  if args is [.. rest, "--capture-final-latents"] {
    guard !rest.contains("--capture-final-latents") else {
      fail("duplicate capture option")
    }
    (rest, true)
  } else {
    guard !args.contains("--capture-final-latents") else {
      fail("capture option must be final")
    }
    (args, false)
  }
}

///|
test "latent readback is diagnostic opt-in and retains other controls" {
  let base = [
    "script", "root", "suffix", "build", "aot", "encoded", "--seed", "17",
  ]
  assert_false(capture_arguments(base).1)
  let captured = base.copy()
  captured.push("--capture-final-latents")
  let (plain, enabled) = capture_arguments(captured)
  assert_true(enabled)
  assert_eq(plain.to_owned(), base)
  for
    args in [
      ["--capture-final-latents", "unexpected"],
      ["--capture-final-latents", "--capture-final-latents"],
    ] {
    try capture_arguments(args) catch {
      _ => ()
    } noraise {
      _ => fail("invalid capture controls")
    }
  }
}

///|
// Only experiment geometry changes. The checkpoint planner still owns latent
// cadence, sigma semantics, complete workspace sizing and the device budget.
fn geometry_arguments(
  args : ArrayView[String],
) -> (ArrayView[String], String) raise {
  if args is [.. rest, "--geometry", width, height, frames, points] {
    guard !rest.contains("--geometry") else { fail("duplicate geometry") }
    let values = [width, height, frames, points].map(value => {
      @string.parse_int(value)
    })
    guard values.all(value => value > 0) && values[3] >= 2 else {
      fail(
        "positive geometry and at least two inclusive-zero sigma points required",
      )
    }
    (rest, "\{values[1]} \{values[0]} \{values[2]} \{values[3]}")
  } else {
    guard !args.contains("--geometry") else {
      fail("--geometry requires four values")
    }
    (args, "32 32 120 5")
  }
}

///|
test "media quality geometry is explicit rather than the tiny smoke default" {
  let base = ["script", "root", "suffix", "build", "aot", "encoded"]
  assert_eq(geometry_arguments(base).1, "32 32 120 5")
  let quality = base.copy()
  quality.append(["--geometry", "128", "128", "120", "21"])
  let (plain, selected) = geometry_arguments(quality)
  assert_eq(plain.to_owned(), base)
  assert_eq(selected, "128 128 120 21")
  assert_eq(
    geometry_arguments(["--geometry", "128", "64", "120", "21"]).1,
    "64 128 120 21",
  )
  for
    suffix in [
      ["--geometry", "128", "128", "16", "1"],
      ["--geometry", "0", "128", "16", "21"],
      ["--geometry", "128", "128", "16"],
    ] {
    let invalid = base.copy()
    invalid.append(suffix)
    try geometry_arguments(invalid) catch {
      _ => ()
    } noraise {
      _ => fail("invalid media experiment geometry accepted")
    }
  }
}

///|
fn runtime_arguments(
  args : ArrayView[String],
) -> (ArrayView[String], Int) raise {
  if args is [.. rest, "--runtime-seconds", seconds] {
    let value = @string.parse_int(seconds)
    guard value > 0 && !rest.contains("--runtime-seconds") else {
      fail("one positive experiment runtime required")
    }
    (rest, value)
  } else {
    guard !args.contains("--runtime-seconds") else {
      fail("--runtime-seconds requires a final positive value")
    }
    (args, 5400)
  }
}

///|
test "long quality campaigns have an explicit non-default time budget" {
  assert_eq(runtime_arguments(["script"]).1, 5400)
  assert_eq(
    runtime_arguments(["script", "--runtime-seconds", "21600"]).1,
    21600,
  )
  try runtime_arguments(["script", "--runtime-seconds", "0"]) catch {
    _ => ()
  } noraise {
    _ => fail("zero runtime accepted")
  }
}

///|
// Offline process I/O only: progress must be visible while a long media request
// computes. This does not change the runtime, kernels or request semantics.
fn diagnostic_process(binary : String, capture_latents : Bool, capture_prefix : Bool, full_prefix? : Bool = false) -> String {
  " /usr/bin/stdbuf -oL -eL " +
  binary +
  (if full_prefix { " run-joint-prefix-full " } else if capture_prefix { " run-joint-prefix " } else if capture_latents { " run-joint-latents " } else { " run-joint " })
}

///|
test "long media diagnostics publish progress without changing execution mode" {
  assert_eq(
    diagnostic_process("/tmp/media.exe", false, false),
    " /usr/bin/stdbuf -oL -eL /tmp/media.exe run-joint ",
  )
  assert_eq(
    diagnostic_process("/tmp/media.exe", true, false),
    " /usr/bin/stdbuf -oL -eL /tmp/media.exe run-joint-latents ",
  )
  assert_eq(diagnostic_process("/tmp/media.exe", false, true), " /usr/bin/stdbuf -oL -eL /tmp/media.exe run-joint-prefix ")
  assert_eq(diagnostic_process("/tmp/media.exe", false, true, full_prefix=true), " /usr/bin/stdbuf -oL -eL /tmp/media.exe run-joint-prefix-full ")
}

///|
fn prefix_arguments(args : ArrayView[String]) -> (ArrayView[String], Bool) raise {
  if args is [.. rest, "--capture-prefix"] {
    guard !rest.contains("--capture-prefix") && !rest.contains("--capture-final-latents") && !rest.contains("--cancel-request") else {
      fail("prefix capture is separate from media or cancellation execution")
    }
    (rest, true)
  } else {
    guard !args.contains("--capture-prefix") else { fail("prefix option must be final") }
    (args, false)
  }
}

///|
test "prefix capture cannot silently replace a media run" {
  assert_false(prefix_arguments(["script"]).1)
  assert_true(prefix_arguments(["script", "--capture-prefix"]).1)
  for args in [["--capture-prefix", "x"], ["--capture-prefix", "--capture-prefix"], ["--capture-final-latents", "--capture-prefix"], ["--cancel-request", "0", "--after-steps", "1", "--capture-prefix"]] {
    try prefix_arguments(args) catch { _ => () } noraise { _ => fail("ambiguous run accepted") }
  }
}

///|
async fn main {
  let raw = @env.args()
  let full_prefix = raw.last() == Some("--capture-prefix-full")
  let prefix_selected = if full_prefix {
    let selected = raw[:raw.length()-1].to_owned()
    selected.push("--capture-prefix")
    selected
  } else { raw }
  let (prefix_args, capture_prefix) = prefix_arguments(prefix_selected)
  let (runtime_args, runtime_seconds) = runtime_arguments(prefix_args)
  let (capture_args, capture_latents) = capture_arguments(runtime_args)
  let (seed_args, seed) = seed_arguments(capture_args)
  let (cancel_args, cancel_after_frames) = cancellation_arguments(seed_args)
  let (args, geometry) = geometry_arguments(cancel_args)
  guard args is [_, root, suffix, build, aot, encoded] &&
    root.has_prefix("/tmp/lunaflux-minimax-joint-") &&
    build.has_prefix("/tmp/lunaflux-checkpoint-build-") &&
    aot.has_prefix("/tmp/lunaflux-minimax-request-aot-") &&
    encoded.has_prefix("/tmp/lunaflux-") &&
    encoded.has_suffix(".bf16") &&
    [root, suffix, build, aot, encoded].all(s => {
      !s.is_empty() &&
      !s.contains("..") &&
      s.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-' | '_' | '.'))
    }) &&
    !suffix.contains("/") else {
    fail(
      "NEW_LOCAL_AND_REMOTE_ROOT UNIQUE_SUFFIX COMMIT_BUILD_ROOT EXISTING_REQUEST_AOT ACTUAL_ENCODER_BF16 [--cancel-request 0 --after-steps COMPLETED_FRAMES] [--seed SIGNED_I64]",
    )
  }
  let rows = encoded_rows(@fs.read_file(encoded).binary().length())
  @fs.mkdir(root)
  let node = "wlc003s@192.168.2.178"
  let socket = "/tmp/lunaflux-checkpoint-live-20261010.sock"
  let variant = root + "/FL2VA"
  let binary = root + "/minimax_checkpoint.exe"
  record(root, "mkdir", remote("mkdir " + root))
  // Hard links add a read-only view without copying 76 GB or changing any
  // existing checkpoint bytes. Never upload over one of these linked files.
  for
    (name, command) in [
      (
        "denoiser-view",
        "cp -al /tmp/lunaflux-minimax-denoiser-upload-20261010-v1/FL2VA " +
        variant,
      ),
      (
        "video-view",
        "cp -al /tmp/lunaflux-minimax-video-upload-20261010-v1/FL2VA/video_vae " +
        variant +
        "/video_vae",
      ),
      (
        "video-inventory",
        "cp /tmp/lunaflux-minimax-video-upload-20261010-v1/FL2VA/VIDEO.sha256 " +
        variant +
        "/VIDEO.sha256",
      ),
      ("audio-directory", "mkdir " + variant + "/audio_vae"),
      (
        "audio-view",
        "ln /tmp/lunaflux-minimax-joint-quality128-20261011-v1/FL2VA/audio_vae/model.safetensors " +
        variant + "/audio_vae/model.safetensors",
      ),
      (
        "binary",
        "cp " +
        build +
        "/source/_build/native/release/build/cmd/minimax_checkpoint/minimax_checkpoint.exe " +
        binary,
      ),
    ] {
    record(root, name, remote(command))
  }
  for
    (source, destination) in [
      (
        "/tmp/lunaflux-minimax-audio-20261010-v1/FL2VA/AUDIO.sha256", "AUDIO.sha256",
      ),
      (
        "/tmp/lunaflux-minimax-request-config-20261010-v1/audio_vae/config.json",
        "audio_vae/config.json",
      ),
      (
        "/tmp/lunaflux-minimax-request-config-20261010-v1/audio_vae/metadata.json",
        "audio_vae/metadata.json",
      ),
      (
        "/tmp/lunaflux-minimax-request-config-20261010-v1/audio_vae/config.yaml",
        "audio_vae/config.yaml",
      ),
      (encoded, "encoded.bf16"),
      (
        "/tmp/lunaflux-minimax-rotary-20261010-v1/rope.inv_freq.f32", "rope.inv_freq.f32",
      ),
    ] {
    @shell.Cmd("scp", [
      "-o",
      "BatchMode=yes",
      "-o",
      "ControlPath=" + socket,
      source,
      node + ":" + variant + "/" + destination,
    ])
    .output()
    .check()
  }
  let identity = remote(
    "nvidia-smi --query-gpu=uuid,pci.bus_id --format=csv,noheader",
  )
  record(root, "device", identity)
  guard identity.stdout().trim() ==
    "GPU-9c3d3cf0-439a-5da2-67e9-20414255879f, 0000000F:01:00.0" else {
    fail("unexpected execution GPU")
  }
  let occupied = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  record(root, "occupied", occupied)
  guard occupied.stdout().trim().is_empty() else {
    fail("GPU occupied; no overlapping workload")
  }
  let memory = remote("awk '/MemAvailable:/ {print $2}' /proc/meminfo")
  record(root, "memory", memory)
  guard @string.parse_int64(memory.stdout().trim()) >= 109051904L else {
    fail("less than 104 GiB available; refusing unified-memory pressure")
  }
  let unit = "lunaflux-minimax-joint-" + suffix
  let command = "systemd-run --user --unit=" +
    unit +
    " --property=MemoryMax=96G --property=MemorySwapMax=0 --property=RuntimeMaxSec=\{runtime_seconds} --property=RemainAfterExit=yes" +
    " --property=StandardOutput=file:" +
    root +
    "/run.stdout" +
    " --property=StandardError=file:" +
    root +
    "/run.stderr" +
    diagnostic_process(binary, capture_latents, capture_prefix, full_prefix~) +
    variant +
    " " +
    geometry +
    " " +
    rows.to_string() +
    " encoded.bf16 rope.inv_freq.f32 " +
    aot +
    " DENOISER.inventory AUDIO.sha256 VIDEO.sha256 256 64 4096 8589934592 103079215104 " +
    seed.to_string() +
    " " +
    root +
    "/output" +
    (if cancel_after_frames == 0 {
      ""
    } else {
      " --cancel-request 0 --after-steps \{cancel_after_frames}"
    })
  record(root, "start", remote(command))
  @fs.write_file(
    root + "/RUN.txt",
    "unit=" +
    unit +
    "\nremote_root=" +
    root +
    "\nbuild=" +
    build +
    "\nencoded_source=" +
    encoded +
    "\nencoded_rows=" +
    rows.to_string() +
    "\ngeometry_height_width_frames_sigma_points=" +
    geometry +
    "\ncancel_after_frames=" +
    cancel_after_frames.to_string() +
    "\nseed=" +
    seed.to_string() +
    "\nterminal_latent_capture=" +
    capture_latents.to_string() +
    "\ninitial_prefix_capture=" + capture_prefix.to_string() +
    "\nruntime_seconds=" +
    runtime_seconds.to_string() +
    "\nmaximum_device_bytes=103079215104\npayload_hashing=false\nstatus=dispatched-not-complete\n",
    create_mode=CreateNew,
  )
  println(
    "joint request dispatched: " +
    unit +
    "; inspect this exact user unit before any further GPU work",
  )
}
