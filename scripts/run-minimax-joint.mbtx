///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o", "BatchMode=yes", "-S", "/tmp/lunaflux-checkpoint-live-20261010.sock", "wlc003s@192.168.2.178",
    command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn record(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
fn encoded_rows(bytes : Int) -> Int raise {
  // hidden_states[50] has 5,120 BF16 lanes per row in the actual checkpoint.
  guard bytes > 0 && bytes % 10240 == 0 else {
    fail("encoder output must contain complete 5,120-lane BF16 rows")
  }
  bytes / 10240
}

///|
test "joint request derives conditioning rows from actual encoder output" {
  assert_eq(encoded_rows(30720), 3)
  assert_eq(encoded_rows(10240), 1)
  for bytes in [0, 30719, 30721] {
    try encoded_rows(bytes) catch {
      _ => ()
    } noraise {
      _ => fail("incomplete conditioning accepted")
    }
  }
}

///|
fn cancellation_arguments(
  args : ArrayView[String],
) -> (ArrayView[String], Int) raise {
  if args is [.. rest, "--cancel-request", "0", "--after-steps", steps] {
    guard !rest.contains("--cancel-request") && !rest.contains("--after-steps") else {
      fail("duplicate cancellation control")
    }
    let count = @string.parse_int(steps)
    guard count > 0 else { fail("invalid cancellation frame count") }
    (rest, count)
  } else {
    guard !args.contains("--cancel-request") && !args.contains("--after-steps") else {
      fail(
        "joint cancellation requires request zero and a positive frame count",
      )
    }
    (args, 0)
  }
}

///|
test "joint runner preserves default execution and explicit frame cancellation" {
  let base = ["script", "root", "suffix", "build", "aot", "encoded"]
  assert_eq(cancellation_arguments(base).1, 0)
  let selected = base.copy()
  selected.append(["--cancel-request", "0", "--after-steps", "2"])
  let (plain, count) = cancellation_arguments(selected)
  assert_eq(plain.to_owned(), base)
  assert_eq(count, 2)
  for
    suffix in [
      ["--cancel-request", "1", "--after-steps", "2"],
      ["--cancel-request", "0", "--after-steps", "0"],
      ["--cancel-request", "0", "--after-steps", "x"],
      ["--after-steps", "2"],
    ] {
    let bad = base.copy()
    bad.append(suffix)
    try cancellation_arguments(bad) catch {
      _ => ()
    } noraise {
      _ => fail("invalid joint cancellation accepted")
    }
  }
}

///|
async fn main {
  let (args, cancel_after_frames) = cancellation_arguments(@env.args())
  guard args is [_, root, suffix, build, aot, encoded] &&
    root.has_prefix("/tmp/lunaflux-minimax-joint-") &&
    build.has_prefix("/tmp/lunaflux-checkpoint-build-") &&
    aot.has_prefix("/tmp/lunaflux-minimax-request-aot-") &&
    encoded.has_prefix("/tmp/lunaflux-") &&
    encoded.has_suffix(".bf16") &&
    [root, suffix, build, aot, encoded].all(s => {
      !s.is_empty() &&
      !s.contains("..") &&
      s.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-' | '_' | '.'))
    }) &&
    !suffix.contains("/") else {
    fail(
      "NEW_LOCAL_AND_REMOTE_ROOT UNIQUE_SUFFIX COMMIT_BUILD_ROOT EXISTING_REQUEST_AOT ACTUAL_ENCODER_BF16 [--cancel-request 0 --after-steps COMPLETED_FRAMES]",
    )
  }
  let rows = encoded_rows(@fs.read_file(encoded).binary().length())
  @fs.mkdir(root)
  let node = "wlc003s@192.168.2.178"
  let socket = "/tmp/lunaflux-checkpoint-live-20261010.sock"
  let variant = root + "/FL2VA"
  let binary = root + "/minimax_checkpoint.exe"
  record(root, "mkdir", remote("mkdir " + root))
  // Hard links add a read-only view without copying 76 GB or changing any
  // existing checkpoint bytes. Never upload over one of these linked files.
  for
    (name, command) in [
      (
        "denoiser-view",
        "cp -al /tmp/lunaflux-minimax-denoiser-upload-20261010-v1/FL2VA " +
        variant,
      ),
      (
        "video-view",
        "cp -al /tmp/lunaflux-minimax-video-upload-20261010-v1/FL2VA/video_vae " +
        variant +
        "/video_vae",
      ),
      (
        "video-inventory",
        "cp /tmp/lunaflux-minimax-video-upload-20261010-v1/FL2VA/VIDEO.sha256 " +
        variant +
        "/VIDEO.sha256",
      ),
      ("audio-directory", "mkdir " + variant + "/audio_vae"),
      (
        "binary",
        "cp " +
        build +
        "/source/_build/native/release/build/cmd/minimax_checkpoint/minimax_checkpoint.exe " +
        binary,
      ),
    ] {
    record(root, name, remote(command))
  }
  for
    (source, destination) in [
      (
        "/tmp/lunaflux-minimax-audio-20261010-v1/FL2VA/audio_vae/model.safetensors",
        "audio_vae/model.safetensors",
      ),
      (
        "/tmp/lunaflux-minimax-audio-20261010-v1/FL2VA/AUDIO.sha256", "AUDIO.sha256",
      ),
      (
        "/tmp/lunaflux-minimax-request-config-20261010-v1/audio_vae/config.json",
        "audio_vae/config.json",
      ),
      (
        "/tmp/lunaflux-minimax-request-config-20261010-v1/audio_vae/metadata.json",
        "audio_vae/metadata.json",
      ),
      (
        "/tmp/lunaflux-minimax-request-config-20261010-v1/audio_vae/config.yaml",
        "audio_vae/config.yaml",
      ),
      (encoded, "encoded.bf16"),
      (
        "/tmp/lunaflux-minimax-rotary-20261010-v1/rope.inv_freq.f32", "rope.inv_freq.f32",
      ),
    ] {
    @shell.Cmd("scp", [
      "-o",
      "BatchMode=yes",
      "-o",
      "ControlPath=" + socket,
      source,
      node + ":" + variant + "/" + destination,
    ])
    .output()
    .check()
  }
  let identity = remote(
    "nvidia-smi --query-gpu=uuid,pci.bus_id --format=csv,noheader",
  )
  record(root, "device", identity)
  guard identity.stdout().trim() ==
    "GPU-9c3d3cf0-439a-5da2-67e9-20414255879f, 0000000F:01:00.0" else {
    fail("unexpected execution GPU")
  }
  let occupied = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  record(root, "occupied", occupied)
  guard occupied.stdout().trim().is_empty() else {
    fail("GPU occupied; no overlapping workload")
  }
  let memory = remote("awk '/MemAvailable:/ {print $2}' /proc/meminfo")
  record(root, "memory", memory)
  guard @string.parse_int64(memory.stdout().trim()) >= 109051904L else {
    fail("less than 104 GiB available; refusing unified-memory pressure")
  }
  let unit = "lunaflux-minimax-joint-" + suffix
  let command = "systemd-run --user --unit=" +
    unit +
    " --property=MemoryMax=96G --property=MemorySwapMax=0 --property=RuntimeMaxSec=5400 --property=RemainAfterExit=yes" +
    " --property=StandardOutput=file:" +
    root +
    "/run.stdout" +
    " --property=StandardError=file:" +
    root +
    "/run.stderr " +
    binary +
    " run-joint " +
    variant +
    " 32 32 120 5 " +
    rows.to_string() +
    " encoded.bf16 rope.inv_freq.f32 " +
    aot +
    " DENOISER.inventory AUDIO.sha256 VIDEO.sha256 256 64 4096 8589934592 103079215104 17 " +
    root +
    "/output" +
    (if cancel_after_frames == 0 {
      ""
    } else {
      " --cancel-request 0 --after-steps \{cancel_after_frames}"
    })
  record(root, "start", remote(command))
  @fs.write_file(
    root + "/RUN.txt",
    "unit=" +
    unit +
    "\nremote_root=" +
    root +
    "\nbuild=" +
    build +
    "\nencoded_source=" +
    encoded +
    "\nencoded_rows=" +
    rows.to_string() +
    "\ncancel_after_frames=" +
    cancel_after_frames.to_string() +
    "\nmaximum_device_bytes=103079215104\npayload_hashing=false\nstatus=dispatched-not-complete\n",
    create_mode=CreateNew,
  )
  println(
    "joint request dispatched: " +
    unit +
    "; inspect this exact user unit before any further GPU work",
  )
}
