///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

// Independent offline arithmetic diagnosis. Not a production startup gate.

///|
let socket : String = "/tmp/lunaflux-checkpoint-live179-20261010.sock"

///|
let node : String = "wlc004s@192.168.2.179"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=4194304,
  )
}

///|
async fn save(root : String, name : String, result : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
}

///|
fn projection_outputs(rows : Int, layer : Int) -> Array[(String, Int)] raise {
  guard rows > 0 && rows <= 1024 && layer > 0 && layer <= 50 else {
    fail("bounded rows and hidden-state frontier required")
  }
  let files : Array[(String, Int)] = []
  for
    (name, width) in [
      ("q", 8192),
      ("k", 1024),
      ("v", 1024),
      ("output", 5120),
      ("gate", 25600),
      ("up", 25600),
      ("down", 5120),
    ] {
    for precision in ["bf16", "bf16-full", "f32", "f64"] {
      files.push((name + "-" + precision + ".bf16", rows * width * 2))
    }
  }
  files
}

///|
test "layer probe includes each MLP operand at the requested row geometry" {
  let outputs = projection_outputs(140, 7)
  assert_eq(outputs.length(), 28)
  assert_true(outputs.contains(("gate-f64.bf16", 7168000)))
  assert_true(outputs.contains(("up-bf16.bf16", 7168000)))
  assert_true(outputs.contains(("down-f32.bf16", 1433600)))
  for (rows, layer) in [(0, 7), (1025, 7), (140, 0), (140, 51)] {
    try projection_outputs(rows, layer) catch {
      _ => ()
    } noraise {
      _ => fail("invalid projection geometry accepted")
    }
  }
}

///|
fn probe_label(label : String) -> String raise {
  guard !label.is_empty() &&
    label.length() <= 40 &&
    label.iter().all(c => c is ('a'..='z' | '0'..='9' | '-')) else {
    fail("probe label must be a short nonempty lowercase name")
  }
  label
}

///|
fn activation_outputs(rows : Int, width : Int) -> Array[(String, Int)] raise {
  guard rows > 0 && rows <= 1024 && width > 0 && width <= 65536 else {
    fail("bounded activation geometry required")
  }
  let files : Array[(String, Int)] = []
  for
    name in [
      "first-input", "second-input", "gate-first-up-second", "gate-second-up-first",
    ] {
    for precision in ["bf16", "f64"] {
      files.push((name + "-" + precision + ".bf16", rows * width * 2))
    }
  }
  files
}

///|
test "activation reuses the same bounded output collection without weight-layer semantics" {
  let outputs = activation_outputs(140, 25600)
  assert_eq(outputs.length(), 8)
  assert_true(outputs.contains(("gate-first-up-second-f64.bf16", 7168000)))
  for (rows, width) in [(0, 25600), (1025, 25600), (140, 0), (140, 65537)] {
    try activation_outputs(rows, width) catch {
      _ => ()
    } noraise {
      _ => fail("invalid activation output shape accepted")
    }
  }
}

///|
test "different layer inputs cannot silently reuse a probe output" {
  assert_eq(probe_label("native-input"), "native-input")
  assert_eq(probe_label("prefix-input"), "prefix-input")
  for label in ["", "../old", "x".repeat(41)] {
    try probe_label(label) catch {
      _ => ()
    } noraise {
      _ => fail("invalid output label accepted")
    }
  }
}

///|
async fn cpu_gate_probe(
  root : String,
  first : String,
  second : String,
  layer : Int,
  row : Int,
  channel : Int,
  label : String,
) -> Unit {
  for path in [root, first, second] {
    guard path.has_prefix("/tmp/lunaflux-minimax-aten-reference-") &&
      !path.contains("..") &&
      path.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-' | '_' | '.')) else {
      fail("bounded reference diagnostic directory required")
    }
  }
  guard layer >= 1 &&
    layer <= 50 &&
    row >= 0 &&
    row < 1024 &&
    channel >= 0 &&
    channel < 25600 else {
    fail("gate replay requires model layer, row and channel")
  }
  let label = probe_label(label)
  let output = root + "/gate-input-" + label
  @fs.mkdir(output)
  let name = root.split("/").last().unwrap().to_owned() + "-gate-input-" + label
  let image = "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/h3-runtime-serving:20260923-arm64-r2"
  let result = remote(
    "systemd-run --user --wait --pipe --unit=" +
    name +
    " --property=MemoryMax=1G --property=MemorySwapMax=0 --property=RuntimeMaxSec=300 docker run --name " +
    name +
    " --network none --user 1000:1000 --memory 1g --memory-swap 1g --pids-limit 128 --cpuset-cpus 0-1 -v " +
    root +
    ":/work:ro -v " +
    first +
    ":/first:ro -v " +
    second +
    ":/second:ro -v /tmp/lunaflux-minimax-text-upload-20261010-v2-179/FL2VA/text_encoder:/model:ro --entrypoint /work/driver.exe " +
    image +
    " replay-gate-input /work/libreference.so /model \{layer} \{row} \{channel} /first /second",
  )
  save(output, "execute", result)
  let terminal = remote("docker inspect --format '{{json .State}}' " + name)
  save(output, "terminal", terminal)
  terminal.check()
  result.check()
  guard result.stdout().contains("retained_bytes=0") &&
    result
    .stdout()
    .contains("scope=one_original_gate_row_cpu_only_not_full_model_acceptance") else {
    fail("gate-input CPU replay incomplete")
  }
  println(result.stdout())
}

///|
async fn main {
  if @env.args() is [_, "gate", root, first, second, layer, row, channel, label] {
    cpu_gate_probe(
      root,
      first,
      second,
      @string.parse_int(layer),
      @string.parse_int(row),
      @string.parse_int(channel),
      label,
    )
    return
  }
  let (root, input, second, rows, parameter, label, activation) = match
    @env.args() {
    [_, "activation", root, input, second, rows, width, label] =>
      (root, input, Some(second), rows, width, label, true)
    [_, root, input, rows, layer, label] =>
      (root, input, None, rows, layer, label, false)
    _ =>
      fail(
        "BUILT_REFERENCE_ROOT INPUT_OPERATOR_DIRECTORY ROWS NEXT_HIDDEN_INDEX NEW_LABEL | activation BUILT_REFERENCE_ROOT FIRST_PROJECTIONS SECOND_PROJECTIONS ROWS WIDTH NEW_LABEL",
      )
  }
  guard root.has_prefix("/tmp/lunaflux-minimax-aten-reference-") &&
    (
      input.has_prefix("/tmp/lunaflux-minimax-text-encoder-") ||
      input.has_prefix("/tmp/lunaflux-minimax-aten-reference-")
    ) &&
    [root, input].all(path => {
      !path.contains("..") &&
      path.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-' | '_' | '.'))
    }) else {
    fail(
      "BUILT_REFERENCE_ROOT INPUT_OPERATOR_DIRECTORY ROWS NEXT_HIDDEN_INDEX NEW_LABEL",
    )
  }
  if second is Some(path) {
    guard path.has_prefix("/tmp/lunaflux-minimax-aten-reference-") &&
      !path.contains("..") &&
      path.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-' | '_' | '.')) else {
      fail("second projection directory required")
    }
  }
  let rows = @string.parse_int(rows)
  let parameter = @string.parse_int(parameter)
  let files = if activation {
    activation_outputs(rows, parameter)
  } else {
    projection_outputs(rows, parameter)
  }
  let label = probe_label(label)
  let kind = if activation { "activation" } else { "projection" }
  let output = root + "/" + kind + "-" + label
  @fs.mkdir(output)
  let mkdir = remote("mkdir " + output)
  save(output, "mkdir", mkdir)
  mkdir.check()
  let owners = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  save(output, "before-owners", owners)
  owners.check()
  guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
  let name = root.split("/").last().unwrap().to_owned() +
    "-" +
    kind +
    "-" +
    label
  let image = "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/h3-runtime-serving:20260923-arm64-r2"
  let inputs = if second is Some(path) {
    " -v " + path + ":/second:ro"
  } else {
    " -v /tmp/lunaflux-minimax-text-upload-20261010-v2-179/FL2VA/text_encoder:/model:ro"
  }
  let arguments = if activation {
    " activation-factorization /work/libreference.so \{rows} \{parameter} /native /second /work/activation-" +
    label
  } else {
    " layer-projection-oracle /work/libreference.so /model \{rows} \{parameter} /native /work/projection-" +
    label
  }
  let execution = remote(
    "systemd-run --user --wait --pipe --unit=" +
    name +
    " --property=MemoryMax=8G --property=MemorySwapMax=0 --property=RuntimeMaxSec=900 docker run --name " +
    name +
    " --gpus all --network none --user 1000:1000 --memory 8g --memory-swap 8g --pids-limit 256 --cpuset-cpus 0-3 -e OMP_NUM_THREADS=2 -v " +
    root +
    ":/work -v " +
    input +
    ":/native:ro" +
    inputs +
    " --entrypoint /work/driver.exe " +
    image +
    arguments,
  )
  save(output, "execute", execution)
  let terminal = remote("docker inspect --format '{{json .State}}' " + name)
  save(output, "terminal", terminal)
  terminal.check()
  let released = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  save(output, "released", released)
  released.check()
  execution.check()
  let complete = if activation {
    "activation_factorization_complete retained_bytes=0"
  } else {
    "projection_oracle_complete retained_bytes=0"
  }
  guard released.stdout().trim().is_empty() &&
    execution.stdout().contains(complete) else {
    fail("projection probe did not release its owners")
  }
  for (name, expected) in files {
    let path = output + "/" + name
    @fs.write_file(path, b"", create_mode=CreateNew)
    @shell.Cmd("scp", [
      "-o",
      "BatchMode=yes",
      "-o",
      "ControlPath=" + socket,
      node + ":" + path,
      path,
    ])
    .output()
    .check()
    guard @fs.read_file(path).binary().length() == expected else {
      fail("incomplete projection output: " + name)
    }
  }
  println(kind + " outputs collected; not full-model parity or throughput")
}
