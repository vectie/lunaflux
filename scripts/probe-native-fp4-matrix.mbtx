///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, root, .. args] &&
    (args is [] || args is ["--grouped"]) &&
    root.has_prefix("/tmp/lunaflux-native-fp4-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
    fail("NEW_ROOT")
  }
  @fs.mkdir(root)
  let node = "wlc004s@192.168.2.179"
  let socket = "/tmp/lunaflux-checkpoint-live179-20261010.sock"
  async fn remote(command : String) -> @shell.Output {
    @shell.Cmd("ssh", ["-S", socket, "-o", "BatchMode=yes", node, command]).output(
      max_output_bytes=4194304,
    )
  }
  async fn record(name : String, result : @shell.Output) -> Unit {
    @fs.write_file(
      root + "/" + name + ".stdout",
      result.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/" + name + ".stderr",
      result.stderr(),
      create_mode=CreateNew,
    )
    result.check()
  }
  let exported = @shell.Cmd("env", [
    "LUNA_EXPORT_FP4_MATRIX=1", "moon", "test", "--target", "native", "--deny-warn",
    "--warn-list", "-20-25-29-35-79-92", "kernels/selected_expert_mlp_cuda_source/fp4_matrix_test.mbt",
  ]).output()
  record("export", exported)
  let parts = exported
    .stdout()
    .split("LUNA_SOURCE_BEGIN fp4-matrix\n")
    .to_array()
  assert_eq(parts.length(), 2, msg=exported.stdout())
  let source = parts[1].split("LUNA_SOURCE_END").to_array()[0].to_owned()
  @fs.write_file(root + "/matrix.cuh", source, create_mode=CreateNew)
  record("mkdir", remote("mkdir " + root))
  let harness = if args.is_empty() {
    "fp4_matrix_probe.cu"
  } else {
    "fp4_grouped_probe.cu"
  }
  for
    (from, to) in [
      (root + "/matrix.cuh", root + "/matrix.cuh"),
      ("tests/packed_moe_execution/" + harness, root + "/probe.cu"),
    ] {
    @shell.Cmd("scp", ["-o", "ControlPath=" + socket, from, node + ":" + to])
    .output()
    .check()
  }
  let bounded = "systemd-run --user --wait --pipe --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=120 --unit=" +
    root[5:].to_owned()
  record(
    "compile",
    remote(
      bounded +
      "-compile /usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 --generate-code arch=compute_121a,code=sm_121a " +
      root +
      "/probe.cu -o " +
      root +
      "/probe",
    ),
  )
  let owners = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  owners.check()
  guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
  record("run", remote(bounded + "-run " + root + "/probe"))
  for mode in ["memcheck", "racecheck", "synccheck"] {
    record(
      mode,
      remote(
        bounded +
        "-" +
        mode +
        " /usr/local/cuda-13.0/bin/compute-sanitizer --tool " +
        mode +
        (if mode == "memcheck" { " --leak-check full" } else { "" }) +
        " --error-exitcode 9 " +
        root +
        "/probe",
      ),
    )
  }
  println("FP4 matrix correctness and sanitizer probe complete")
}
