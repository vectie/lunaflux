///|
import {
  "moonbitlang/async@0.20.3",
  "moonbitlang/async@0.20.3/process",
  "moonbitlang/core/env",
}

// Keep the established entry point, but never delegate to the historical
// checksum-enforcing shell packager. One MoonBit implementation handles every
// profile and fused-runtime version without an intermediate model copy.

///|
async fn main {
  let (code, out, err) = @process.collect_output(
    "moon",
    [
      "run",
      "scripts/materialize-qwen3-bf16-launch-core.mbtx",
      ..@env.args()[1:],
    ],
  )
  guard code == 0 else { fail(out.text() + err.text()) }
  println(out.text())
}
