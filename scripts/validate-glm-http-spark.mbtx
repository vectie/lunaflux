///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

// External service acceptance. Never part of the compiler or model runtime.

///|
let node = "wlc003s@192.168.2.178"

///|
let socket = "/tmp/lunaflux-glm178-prefill-20261018.sock"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-S", socket, node, command,
  ]).output(max_output_bytes=4194304)
}

///|
async fn transfer(from : String, to : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket,
    from,
    to,
  ])
  .output()
  .check()
}

///|
fn chat(prompt : String, stream : Bool, tokens : Int) -> Json {
  {
    "model": "glm-5.3",
    "messages": [{ "role": "user", "content": prompt }],
    "stream": stream,
    "temperature": 0,
    "max_tokens": tokens,
  }
}

///|
fn answer(body : String, streaming : Bool) -> String raise {
  if !streaming {
    let value = @json.parse(body)
    if value
      is {
        "choices": Array([{ "message": { "content": String(text), .. }, .. }]),
        ..
      } {
      return text
    }
    fail("missing chat answer: " + body)
  }
  let mut text = ""
  let mut finished = false
  for line in body.split("\n") {
    let line = line.trim()
    if line == "data: [DONE]" {
      finished = true
    } else if line.has_prefix("data: ") {
      let value = @json.parse(line[6:])
      if value is { "choices": Array(choices), .. } {
        for choice in choices {
          if choice is { "delta": { "content": String(delta), .. }, .. } {
            text += delta
          }
        }
      }
    }
  }
  guard finished else { fail("SSE missing terminal DONE") }
  text
}

///|
async fn request(
  root : String,
  name : String,
  route : String,
  body : Json,
  timeout~ : Int = 1800,
  cancel~ : Bool = false,
  capacity_probe~ : Bool = false,
  expected_status~ : Int = 200,
) -> String {
  let prefix = root + "/" + name
  @fs.write_file(
    prefix + ".request.json",
    body.stringify(),
    create_mode=CreateNew,
  )
  let local_forward = @env.get_env_var("LUNAFLUX_GLM_HTTP_LOCAL_FORWARD") ==
    Some("1")
  let result = if local_forward {
    // One loopback SSH forwarding channel avoids consuming a remote SSH
    // session per HTTP client (sshd's session limit is not service capacity).
    @shell.Cmd("curl", [
      "--silent",
      "--show-error",
      "--no-buffer",
      "--max-time",
      timeout.to_string(),
      "--dump-header",
      prefix + ".headers",
      "--output",
      prefix + ".body",
      "--write-out",
      "%{http_code} %{time_total}\n",
      "-H",
      "Authorization: Bearer lunaflux-acceptance",
      "-H",
      "Content-Type: application/json",
      "--data-binary",
      "@" + prefix + ".request.json",
      "http://127.0.0.1:18889" + route,
    ]).output(max_output_bytes=4194304)
  } else {
    transfer(prefix + ".request.json", node + ":" + prefix + ".request.json")
    remote(
      "curl --silent --show-error --no-buffer --max-time \{timeout} --dump-header " +
      prefix +
      ".headers --output " +
      prefix +
      ".body --write-out '%{http_code} %{time_total}\n' -H 'Authorization: Bearer lunaflux-acceptance' -H 'Content-Type: application/json' --data-binary @" +
      prefix +
      ".request.json http://127.0.0.1:18888" +
      route,
    )
  }
  @fs.write_file(
    prefix + ".client.txt",
    result.stdout() + result.stderr(),
    create_mode=CreateNew,
  )
  if !local_forward {
    transfer(node + ":" + prefix + ".headers", prefix + ".headers")
    // curl may not create a body if cancellation happens before response headers.
    let collected = remote("test -f " + prefix + ".body")
    if collected.exit_code() == 0 {
      transfer(node + ":" + prefix + ".body", prefix + ".body")
    }
  }
  if cancel {
    guard result.exit_code() == 28 else {
      fail("disconnect probe did not time out as intended")
    }
    return "cancelled"
  }
  result.check()
  if capacity_probe && result.stdout().has_prefix("429 ") {
    return "capacity-rejected"
  }
  guard result.stdout().has_prefix("\{expected_status} ") else {
    fail("HTTP failure " + name + ": " + result.stdout())
  }
  @fs.read_file(prefix + ".body").text()
}

///|
async fn main {
  guard @env.args() is [_, root, mode] &&
    root.has_prefix("/tmp/lunaflux-glm-http-") &&
    !root.contains("..") &&
    root
    .iter()
    .all(c => c is ('a'..<='z' | 'A'..<='Z' | '0'..<='9' | '/' | '-' | '_')) &&
    mode
    is ("smoke"
    | "answers"
    | "concurrent"
    | "sampling"
    | "cancel"
    | "capacity"
    | "protocol"
    | "controls") else {
    fail(
      "NEW_EVIDENCE_ROOT smoke|answers|concurrent|sampling|cancel|capacity|controls|protocol",
    )
  }
  @fs.mkdir(root)
  remote("mkdir " + root).check()
  if mode == "smoke" {
    let prompt = "What is 17 multiplied by 19? Give only the integer."
    let a = answer(
      request(root, "json", "/v1/chat/completions", chat(prompt, false, 128)),
      false,
    )
    println("JSON: " + a)
    let b = answer(
      request(root, "sse", "/v1/chat/completions", chat(prompt, true, 128)),
      true,
    )
    println("SSE: " + b)
    guard a == b && a.trim() == "323" else {
      fail("JSON/SSE or arithmetic failure")
    }
    let response = request(root, "responses", "/v1/responses", {
      "model": "glm-5.3",
      "input": "Give the capital of France in one word.",
      "max_output_tokens": 128,
      "temperature": 0,
    })
    println("Responses: " + response)
    guard @json.parse(response)
      is {
        "output": Array(
          [{ "content": Array([{ "text": String(text), .. }]), .. }]
        ),
        ..
      } &&
      text.trim() == "Paris" else {
      fail("Responses semantic or framing failure")
    }
  } else if mode == "answers" {
    let output_tokens = match
      @env.get_env_var("LUNAFLUX_GLM_HTTP_ANSWER_TOKENS") {
      None => 512
      Some(text) => {
        guard @json.parse(text) is Number(n, ..) &&
          n > 0.0 &&
          n <= 65536.0 &&
          n.to_int().to_double() == n else {
          fail("invalid answer token budget")
        }
        n.to_int()
      }
    }
    let incomplete : Array[Int] = []
    let prompts = [
      "Explain why 0.1 + 0.2 is not exactly 0.3 in binary floating-point. Give a practical comparison method.",
      "用中文解释银行转账为何需要事务，给出一个失败后回滚的例子。",
      "Write a Python function merge_sorted(a, b) that merges two already sorted integer lists. Include empty inputs and explain complexity.",
      "For sales(customer_id, amount), write SQL returning the three customers with the highest total amount. Break ties by customer_id ascending.",
      "Translate into English: 尽管火车晚点了，我们仍然准时到达会议现场。",
      "A box contains 3 red and 2 blue balls. Draw two without replacement. Explain the probability that both are red.",
      "Summarize in two sentences: A town replaced its diesel buses with electric buses. Air pollution declined, but charging delays initially reduced service. A redesigned timetable and overnight charging restored reliability.",
      "Return only JSON with keys name, count, active for a fictional project named Luna, count 3, and active true.",
      "A farmer has chickens and rabbits, with 10 heads and 28 legs in total. How many of each? Show the equations.",
      "List three limitations of using accuracy alone to evaluate a classifier on an imbalanced dataset.",
      "Explain the difference between concurrency and parallelism with an example of each.",
      "Give an example of a stable sorting algorithm and an unstable one. Explain what stable means without claiming all sorting algorithms are stable.",
    ]
    for i, prompt in prompts {
      let body = request(
        root,
        "answer-\{i}",
        "/v1/chat/completions",
        chat(prompt, false, output_tokens),
      )
      let text = answer(body, false)
      guard !text.trim().is_empty() else { fail("empty answer") }
      let j = @json.parse(body)
      if j
        is { "choices": Array([{ "finish_reason": String(reason), .. }]), .. } {
        if reason != "stop" {
          incomplete.push(i)
          println("INCOMPLETE answer \{i}: " + reason)
        }
      } else {
        fail("missing finish reason")
      }
      println("\{i}: " + text)
    }
    guard incomplete.is_empty() else {
      fail(
        "incomplete answers at output budget \{output_tokens}: \{Repr(incomplete)}",
      )
    }
  } else if mode == "concurrent" {
    @async.with_task_group(group => {
      for i in 0..<4 {
        group.spawn_bg(() => {
          let body = request(
            root,
            "concurrent-\{i}",
            "/v1/chat/completions",
            chat(
              "Explain photosynthesis in three complete sentences.",
              i % 2 == 0,
              256,
            ),
          )
          let text = answer(body, i % 2 == 0)
          guard !text.trim().is_empty() else { fail("empty concurrent answer") }
          println("\{i}: " + text)
        })
      }
    })
  } else if mode == "sampling" {
    for i in 0..<3 {
      let payload : Json = {
        "model": "glm-5.3",
        "messages": [
          {
            "role": "user",
            "content": "Write a short creative sentence about the moon.",
          },
        ],
        "max_tokens": 256,
        "temperature": 0.7,
        "top_k": 32,
        "top_p": 0.9,
        "seed": 12345,
      }
      let body = request(root, "sample-\{i}", "/v1/chat/completions", payload)
      let text = answer(body, false)
      println("\{i}: " + text)
      if i > 0 {
        let first = answer(@fs.read_file(root + "/sample-0.body").text(), false)
        guard text == first else { fail("same-seed replay changed") }
      }
    }
  } else if mode == "capacity" {
    let rejected = FixedArray::make(9, false)
    @async.with_task_group(group => {
      for i in 0..<9 {
        group.spawn_bg(() => {
          let body = request(
            root,
            "capacity-\{i}",
            "/v1/chat/completions",
            chat(
              "Write a detailed story about a lighthouse in a storm. Use several complete paragraphs.",
              false, 512,
            ),
            capacity_probe=true,
          )
          rejected[i] = body == "capacity-rejected"
          if !rejected[i] {
            guard !answer(body, false).trim().is_empty() else {
              fail("empty accepted answer")
            }
          }
        })
      }
    })
    let count = rejected.iter().filter(x => x).count()
    guard count > 0 && count < 9 else {
      fail("capacity probe did not exercise both admission and rejection")
    }
    println("capacity rejections: \{count}/9")
    let body = request(
      root,
      "after-capacity",
      "/v1/chat/completions",
      chat("What is 2 plus 2? Answer only the number.", false, 128),
    )
    guard answer(body, false).contains("4") else { fail("capacity recovery") }
  } else if mode == "protocol" {
    // External admission checks, followed by useful inference on the same
    // resident service. These are not compiler constraints or integrity scans.
    ignore(
      request(
        root,
        "unknown-model",
        "/v1/chat/completions",
        {
          "model": "not-the-served-model",
          "messages": [{ "role": "user", "content": "Hello" }],
          "max_tokens": 64,
        },
        expected_status=400,
      ),
    )
    ignore(
      request(
        root,
        "over-output-limit",
        "/v1/chat/completions",
        chat("Hello", false, 65536),
        expected_status=400,
      ),
    )
    ignore(
      request(
        root,
        "invalid-sampling",
        "/v1/chat/completions",
        {
          "model": "glm-5.3",
          "messages": [{ "role": "user", "content": "Hello" }],
          "top_p": 1.5,
        },
        expected_status=400,
      ),
    )
    let response = request(root, "responses-sse", "/v1/responses", {
      "model": "glm-5.3",
      "input": "Give the capital of France in one word.",
      "stream": true,
      "max_output_tokens": 128,
      "temperature": 0,
    })
    guard response.contains("response.completed") &&
      response.contains("data: [DONE]") &&
      response.contains("Paris") else {
      fail("Responses SSE completion or answer missing")
    }
    println("admission errors and Responses SSE completed")
  } else if mode == "controls" {
    let body = request(root, "multiturn", "/v1/chat/completions", {
      "model": "glm-5.3",
      "messages": [
        { "role": "user", "content": "Remember the project code: ORCHID-37." },
        { "role": "assistant", "content": "I will remember ORCHID-37." },
        {
          "role": "user",
          "content": "What project code did I give you? Reply only with that code.",
        },
      ],
      "temperature": 0,
      "max_tokens": 128,
    })
    guard answer(body, false).contains("ORCHID-37") else {
      fail("multi-turn context")
    }
    let stopped = request(root, "stop", "/v1/chat/completions", {
      "model": "glm-5.3",
      "messages": [
        {
          "role": "user",
          "content": "Copy exactly these three words: red green blue",
        },
      ],
      "temperature": 0,
      "stop": ["green"],
      "max_tokens": 128,
    })
    let text = answer(stopped, false)
    guard text.contains("red") &&
      !text.contains("green") &&
      !text.contains("blue") else {
      fail("stop-string publication")
    }
    let limited = request(
      root,
      "length",
      "/v1/chat/completions",
      chat("Write a detailed story about a lighthouse in a storm.", false, 4),
    )
    guard @json.parse(limited)
      is {
        "choices": Array([{ "finish_reason": "length", .. }]),
        "usage": { "completion_tokens": 4, .. },
        ..
      } else {
      fail("output-token budget")
    }
  } else {
    for i in 0..<6 {
      ignore(
        request(
          root,
          "disconnect-\{i}",
          "/v1/chat/completions",
          chat(
            "Write a detailed story about a lighthouse in a storm.", true, 512,
          ),
          timeout=1,
          cancel=true,
        ),
      )
      @async.sleep(3000)
      let body = request(
        root,
        "reuse-\{i}",
        "/v1/chat/completions",
        chat("What is 2 plus 2? Answer only the number.", false, 128),
      )
      guard answer(body, false).contains("4") else {
        fail("slot reuse correctness")
      }
    }
  }
  @fs.write_file(
    root + "/COMPLETE.txt",
    mode + " completed; human answer review remains separate\n",
    create_mode=CreateNew,
  )
}

///|
test "SSE concatenation and terminal marker" {
  assert_eq(
    answer(
      "data: {\"choices\":[{\"delta\":{\"content\":\"hi\"}}]}\n\ndata: [DONE]\n",
      true,
    ),
    "hi",
  )
  try ignore(answer("data: {\"choices\":[]}\n", true)) catch {
    _ => ()
  } noraise {
    _ => fail("accepted incomplete SSE")
  }
}
