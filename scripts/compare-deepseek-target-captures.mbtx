///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
// DSpark already stores [physical row, target layer, hidden] means. Select
// the actual prompt frontier, not padding or a later generated-token frontier.
fn segment(
  payload : BytesView,
  rows : Int,
  row : Int,
  index : Int,
  segments : Int,
  width : Int,
) -> BytesView raise {
  guard rows > 0 &&
    rows <= 1024 &&
    row >= 0 &&
    row < rows &&
    segments > 0 &&
    segments <= 256 &&
    index >= 0 &&
    index < segments &&
    width > 0 &&
    width <= 65536 &&
    payload.length().to_int64() ==
    rows.to_int64() * segments.to_int64() * width.to_int64() * 2L else {
    fail("incomplete segmented BF16 capture")
  }
  let offset = (row * segments + index) * width * 2
  payload[offset:offset + width * 2]
}

///|
test "target layer extraction preserves row-major segment order" {
  let payload = b"abcdefghijklmnopqrstuvwx"
  assert_eq(segment(payload, 2, 0, 1, 3, 2), b"efgh"[:])
  assert_eq(segment(payload, 2, 1, 0, 3, 2), b"mnop"[:])
  assert_eq(segment(payload, 2, 1, 2, 3, 2), b"uvwx"[:])
  for
    (rows, row, index, segments, width) in [
      (2, 2, 0, 3, 2),
      (2, 0, 3, 3, 2),
      (1, 0, 0, 3, 2),
      (2, -1, 0, 3, 2),
      (2, 0, 0, 3, 0),
    ] {
    try segment(payload, rows, row, index, segments, width) catch {
      _ => ()
    } noraise {
      _ => fail("invalid target capture accepted")
    }
  }
}

///|
async fn main {
  guard @env.args() is [_, native_root, original_root, output, rows, row] else {
    fail(
      "NATIVE_CAPTURE_ROOT ORIGINAL_CAPTURE_ROOT NEW_REPORT_ROOT PHYSICAL_ROWS ACTIVE_ROW",
    )
  }
  let payload = @fs.read_file(native_root + "/prediction-inputs.bf16").binary()
  let rows = @string.parse_int(rows)
  let row = @string.parse_int(row)
  @fs.mkdir(output)
  let summary = StringBuilder()
  for index, layer in [40, 41, 42] {
    let native = output + "/native-layer-\{layer}.bf16"
    let reference = original_root +
      "/prefill-logits-rank0.f32.layer-\{layer}.bf16"
    @fs.write_file(
      native,
      segment(payload, rows, row, index, 3, 4096).to_owned(),
      create_mode=CreateNew,
    )
    let result = @shell.Cmd("moon", [
      "run",
      "scripts/compare-minimax-encoder-reference.mbtx",
      native,
      reference,
      output + "/layer-\{layer}.txt",
      "matched_original_dspark_target_\{layer}",
      "4096",
    ]).output(max_output_bytes=65536)
    result.check()
    summary.write_string("layer=\{layer}\n" + result.stdout())
  }
  @fs.write_file(
    output + "/SUMMARY.txt",
    summary.to_string(),
    create_mode=CreateNew,
  )
  println(summary.to_string())
}
