///|
import {
  "moonbitlang/async@0.20.3",
  "moonbitlang/async@0.20.3/fs",
  "moonbitlang/async@0.20.3/process",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn field(recipe : String, key : String) -> String raise {
  let values = recipe
    .split("\n")
    .filter(x => x.has_prefix(key + "="))
    .to_array()
  guard values is [value] else {
    fail("missing/duplicate recipe field: " + key)
  }
  value[key.length() + 1:].to_owned()
}

///|
async fn checked(program : String, args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output(program, args)
  guard code == 0 else { fail(out.text() + err.text()) }
  out.text()
}

///|
/// Compile exact recipe-bound sources twice. Each numerical family supplies
/// its own complete module; V8 already includes its V3 merge entries and must
/// not be concatenated with the incompatible V7 partial-reduction source.
async fn compile_module(
  nvcc : String,
  candidate : String,
  directory : String,
  destination : String,
) -> Unit {
  let recipe = @fs.read_file(candidate + "/" + directory + "/kernel.recipe").text()
  let source_path = candidate + "/" + directory + "/kernel.cu"
  assert_eq(
    checked("sha256sum", [source_path]).split(" ").to_array()[0].to_owned(),
    field(recipe, "source_sha256"),
  )
  let mut source = @fs.read_file(source_path).text()
  if directory == "reusable-qwen-decode-attention" &&
    !recipe.contains("partition_numeric_law=blockwise-f32-probability-v1\n") {
    let split = candidate + "/reusable-qwen-decode-split-attention"
    let split_recipe = @fs.read_file(split + "/kernel.recipe").text()
    assert_eq(
      checked("sha256sum", [split + "/kernel.cu"]).split(" ").to_array()[0].to_owned(),
      field(split_recipe, "source_sha256"),
    )
    source += "\n#undef LF_BLOCK_THREADS\n" +
      @fs.read_file(split + "/kernel.cu").text()
  }
  @fs.mkdir(destination)
  let flags = [
    "--cubin",
    "--std=c++14",
    "-arch=" + field(recipe, "target"),
    "-O" + field(recipe, "optimization"),
    "--fmad=" + field(recipe, "fmad"),
    "--ftz=false",
    "--prec-div=true",
    "--prec-sqrt=true",
    "--maxrregcount=" + field(recipe, "max_registers"),
    "--Werror",
    "all-warnings",
  ]
  for name in ["first", "second"] {
    let path = destination + "/" + name
    @fs.mkdir(path)
    @fs.write_file(path + "/kernel.cu", source, create_mode=CreateNew)
    ignore(
      checked(nvcc, flags + [path + "/kernel.cu", "-o", path + "/kernel.cubin"]),
    )
  }
  ignore(
    checked("cmp", [
      destination + "/first/kernel.cubin",
      destination + "/second/kernel.cubin",
    ]),
  )
}

///|
async fn main {
  guard @env.args()
    is [
      _,
      nvcc,
      toolchain,
      candidate,
      model,
      plan,
      exporter_identity,
      output,
      .. options,
    ] else {
    fail(
      "usage: NVCC TOOLCHAIN#sha256=HEX CANDIDATE MODEL_SHA PLAN_SHA EXPORTER#sha256=HEX NEW_OUTPUT",
    )
  }
  let (options, routes) = match options {
    [.. rest, "--attention-buckets", path] => (rest, Some(path))
    _ => (options, None)
  }
  let (options, comparison) = match options {
    [.. rest, "--ingress-pair", full, partial, samples] => {
      let a = @string.parse_int64(full)
      let b = @string.parse_int64(partial)
      let n = @string.parse_int(samples)
      guard a > 0L && b > 0L && n > 0 else {
        fail("positive measured full-chain observations required")
      }
      (rest, Some((a, b, n)))
    }
    _ => (options, None)
  }
  let explicit_choice = match options {
    [] | ["--ingress-mode", "full"] => "full"
    ["--ingress-mode", "partial"] => "partial"
    _ =>
      fail("optional --ingress-mode full|partial and --attention-buckets FILE")
  }
  guard comparison is None || options.is_empty() else {
    fail("measured and explicit ingress selection are mutually exclusive")
  }
  let choice = match comparison {
    Some((full, partial, _)) => if full <= partial { "full" } else { "partial" }
    None => explicit_choice
  }
  guard exporter_identity.split("#sha256=").to_array() is [exporter, _] else {
    fail("exporter identity required")
  }
  // The existing producer retains deterministic compilation and toolchain
  // validation. Its legacy bundle is intermediate only, never our published
  // bundle. Rebind from the same recipes with the explicit metadata ABI.
  // Run from the source root; release archives deliberately have no .git.
  let repo = checked("pwd", []).trim().to_owned()
  let attention_dirs = [
    "reusable-qwen-prefill-attention", "reusable-qwen-prefill-wide-query-attention",
    "reusable-qwen-prefill-partitioned-attention", "reusable-qwen-prefill-partitioned-attention-p8",
  ]
  let versions : Array[String] = []
  let tiles : Array[String] = []
  for directory in attention_dirs {
    let recipe = @fs.read_file(candidate + "/" + directory + "/kernel.recipe").text()
    versions.push(field(recipe, "query_metadata_version"))
    tiles.push(field(recipe, "query_tile_rows"))
  }
  guard versions.all(v => v == versions[0]) &&
    (versions[0] == "0" || versions[0] == "1") else {
    fail("mixed/unsupported prefill metadata ABIs")
  }
  @fs.mkdir(output)
  let intermediate = output + "/compiled"
  guard toolchain.split("#sha256=").to_array()
    is [toolchain_path, toolchain_hash] else {
    fail("toolchain identity")
  }
  assert_eq(
    checked("sha256sum", [toolchain_path.to_owned()]).split(" ").to_array()[0].to_owned(),
    toolchain_hash.to_owned(),
  )
  let driver = checked(repo + "/scripts/inspect-luna-cuda-aot-driver.sh", [nvcc])
  assert_eq(
    field(driver, "driver_identity_sha256"),
    field(
      @fs.read_file(toolchain_path.to_owned()).text(),
      "driver_identity_sha256",
    ),
  )
  @fs.mkdir(intermediate)
  let args = [model, plan]
  let modules = [
    ("residual", "reusable-fused-residual", "residual_operation_id", ""),
    ("ingress", "reusable-qwen-full-ingress", "qkv_operation_id", ""),
    ("prefill", attention_dirs[0], "model_operation_id", ""),
    ("prefill_wide", attention_dirs[1], "model_operation_id", ""),
    ("prefill_partial", attention_dirs[2], "model_operation_id", "partial_"),
    ("prefill_merge", attention_dirs[2], "model_operation_id", "merge_"),
    (
      "prefill_partitioned8_partial",
      attention_dirs[3],
      "model_operation_id",
      "partial_",
    ),
    (
      "prefill_partitioned8_merge",
      attention_dirs[3],
      "model_operation_id",
      "merge_",
    ),
    ("attention", "reusable-qwen-decode-attention", "model_operation_id", ""),
  ]
  let mut hashes = ""
  for (name, directory, operation, prefix) in modules {
    let recipe = @fs.read_file(candidate + "/" + directory + "/kernel.recipe").text()
    assert_eq(field(recipe, "toolchain_sha256"), toolchain_hash.to_owned())
    let compile_root = intermediate + "/" + name
    compile_module(nvcc, candidate, directory, compile_root)
    args.push(field(recipe, operation))
    let grid = field(recipe, prefix + "grid").split(",").to_array()
    guard grid.length() == 3 else { fail("invalid grid") }
    for axis in grid {
      args.push(axis.to_owned())
    }
    args.push(field(recipe, "block").split(",").to_array()[0].to_owned())
    args.push(field(recipe, prefix + "shared_memory_bytes"))
    if name == "prefill_wide" {
      args.push(field(recipe, "function_symbol"))
    }
    let filename = name + ".cubin"
    let path = output + "/" + filename
    @fs.write_file(
      path,
      @fs.read_file(compile_root + "/first/kernel.cubin"),
      create_mode=CreateNew,
      permission=0o444,
    )
    args.push(path)
    let digest = checked("sha256sum", [path]).split(" ").to_array()[0].to_owned()
    hashes += digest + "  " + filename + "\n"
  }
  for tile in tiles {
    args.push(tile)
  }
  let bundle = "reusable-fused-runtime-bundle.v3"
  args.push(output + "/" + bundle)
  // This helper compiles the full-ingress runtime. The metadata rebind must
  // retain that explicit route: the exporter's conservative default omits
  // both ingress and attention modules, not merely the metadata annotation.
  if choice == "partial" || comparison is Some(_) {
    let directory = candidate + "/reusable-qwen-ingress"
    let recipe = @fs.read_file(directory + "/kernel.recipe").text()
    let digest = checked("sha256sum", [directory + "/kernel.cu"])
    .split(" ")
    .to_array()[0].to_owned()
    assert_eq(digest, field(recipe, "source_sha256"))
    let flags = [
      "-O" + field(recipe, "optimization"),
      "-arch=" + field(recipe, "target"),
      "--std=c++14",
      "--fmad=" + field(recipe, "fmad"),
      "--ftz=false",
      "--prec-div=true",
      "--prec-sqrt=true",
      "--Werror",
      "all-warnings",
      "--maxrregcount=" + field(recipe, "max_registers"),
      "-cubin",
      directory + "/kernel.cu",
      "-o",
    ]
    for name in ["ingress-partial-first.cubin", "ingress-partial-second.cubin"] {
      ignore(checked(nvcc, flags + [output + "/" + name]))
    }
    ignore(
      checked("cmp", [
        output + "/ingress-partial-first.cubin",
        output + "/ingress-partial-second.cubin",
      ]),
    )
    match comparison {
      Some((full, partial, samples)) =>
        args.append([
          "--ingress-pair",
          full.to_string(),
          partial.to_string(),
          samples.to_string(),
        ])
      None => args.append(["--ingress-evaluate", "partial"])
    }
    args.append(
      field(recipe, "grid").split(",").map(x => x.to_owned()).to_array(),
    )
    args.append([
      field(recipe, "block").split(",").to_array()[0].to_owned(),
      field(recipe, "shared_memory_bytes"),
      output + "/ingress-partial-first.cubin",
    ])
    hashes += checked("sha256sum", [output + "/ingress-partial-first.cubin"])
      .split(" ")
      .to_array()[0].to_owned() +
      "  ingress-partial-first.cubin\n"
  } else {
    args.append(["--ingress-evaluate", "full"])
  }
  let ingress_recipe = @fs.read_file(
    candidate + "/reusable-qwen-full-ingress/kernel.recipe",
  ).text()
  if choice == "full" {
    args.append([
      "--ingress-query-tile",
      field(ingress_recipe, "query_tile_rows"),
    ])
  }
  // Older one-head recipes remain supported; new ownership must survive both
  // export passes just like the compiler-selected token tile.
  if choice == "full" && ingress_recipe.contains("\nheads_per_cta=") {
    args.append([
      "--ingress-heads-per-cta",
      field(ingress_recipe, "heads_per_cta"),
    ])
  }
  let decode_recipe = @fs.read_file(
    candidate + "/reusable-qwen-decode-attention/kernel.recipe",
  ).text()
  if field(decode_recipe, "function_symbol") ==
    "lunaflux_attention_decode_tile_compiler_v1_blockwise_f32_v1" {
    guard field(decode_recipe, "numeric_law") == "blockwise-f32-probability-v1" else {
      fail("blockwise decode numerical contract mismatch")
    }
    args.push("--decode-blockwise-f32-v1")
  } else if field(decode_recipe, "function_symbol") !=
    "lunaflux_attention_decode_tile_compiler_v1" {
    fail("unsupported decode numerical entry point")
  }
  if versions[0] == "1" {
    args.push("--query-metadata-v1")
  }
  if routes is Some(path) {
    args.append([
      "--attention-buckets",
      path,
      checked("sha256sum", [path]).split(" ").to_array()[0].to_owned(),
    ])
  }
  @fs.write_file(
    output + "/export.arguments",
    args.join("\n") + "\n",
    create_mode=CreateNew,
  )
  let report = checked(exporter.to_owned(), args)
  guard field(report, "ingress_schedule") ==
    (if choice == "partial" { "producer-separated" } else { "full" }) else {
    fail("ingress cut was lost during metadata rebind")
  }
  @fs.write_file(output + "/export.stdout", report, create_mode=CreateNew)
  let digest = checked("sha256sum", [output + "/" + bundle])
  .split(" ")
  .to_array()[0].to_owned()
  hashes += digest + "  " + bundle + "\n"
  @fs.write_file(
    output + "/FILES.sha256",
    hashes,
    create_mode=CreateNew,
    permission=0o444,
  )
  println(report)
}
