///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

// External timeline attribution. A collective span includes rank arrival.
// Never use these observations to choose runtime compiler semantics.

///|
struct Event {
  start : Int64
  end : Int64
  stream : Int64
  name : String
}

///|
fn sites() -> Array[(Int32, String)] {
  let values = []
  for layer in 0..<45 {
    values.push((layer, if layer % 4 == 3 { "sparse" } else { "recurrent" }))
    if layer < 3 {
      values.push((layer, "dense"))
    }
  }
  values
}

///|
fn marker(layer : Int32, kind : String) -> String {
  match kind {
    "dense" => "glm_dense_ffn_\{layer}_down"
    "sparse" => "glm_sparse_\{layer}_output"
    _ => "glm_recurrent_\{layer}_15"
  }
}

///|
fn publication_marker(layer : Int32, kind : String) -> String {
  match kind {
    "dense" => "glm_dense_ffn_\{layer}_publish"
    "sparse" => "glm_sparse_\{layer}_output_publish"
    _ => "glm_recurrent_\{layer}_16"
  }
}

///|
test "projection sites include attention and early dense but exclude MoE and head" {
  let values = sites()
  assert_eq(values.length(), 48)
  assert_eq(values.filter(x => x.1 == "recurrent").length(), 34)
  assert_eq(values.filter(x => x.1 == "sparse").length(), 11)
  assert_eq(values.filter(x => x.1 == "dense").length(), 3)
  assert_eq(values[1], (0, "dense"))
  assert_eq(values[47], (44, "recurrent"))
  assert_eq(publication_marker(0, "dense"), "glm_dense_ffn_0_publish")
  assert_eq(publication_marker(3, "sparse"), "glm_sparse_3_output_publish")
  assert_eq(publication_marker(4, "recurrent"), "glm_recurrent_4_16")
}

///|
async fn main {
  guard @env.args() is [_, db, output, mode, first, last] &&
    mode is ("native" | "vllm") else {
    fail("SQLITE NEW_OUTPUT native|vllm START_NS END_NS")
  }
  let begin = @string.parse_int64(first)
  let end = @string.parse_int64(last)
  guard begin >= 0 && end > begin else { fail("window") }
  let r = @shell.Cmd("sqlite3", [
    "-readonly",
    "-json",
    db,
    "SELECT k.start,k.end,k.streamId stream,s.value name FROM CUPTI_ACTIVITY_KIND_KERNEL k JOIN StringIds s ON s.id=k.shortName WHERE k.start>=\{begin} AND k.end<=\{end} ORDER BY k.start;",
  ]).output(max_output_bytes=16777216)
  r.check()
  guard @json.parse(r.stdout()) is Array(rows) else { fail("events") }
  let events = rows.map(row => {
    guard row
      is {
        "start": Number(a, ..),
        "end": Number(b, ..),
        "stream": Number(s, ..),
        "name": String(name),
        ..
      } else {
      fail("fields")
    }
    Event::{
      start: a.to_int64(),
      end: b.to_int64(),
      stream: s.to_int64(),
      name,
    }
  })
  let expected = sites()
  let reports : Array[Json] = []
  let totals : Map[String, Int64] = {
    "recurrent": 0L,
    "sparse": 0L,
    "dense": 0L,
  }
  let mut publication_ns = 0L
  let mut projection_ns = 0L
  let mut all_collective_ns = 0L
  for i, event in events {
    if !event.name.contains("nccl") {
      continue
    }
    all_collective_ns += event.end - event.start
    let mut prior = -1
    for j = i - 1; j >= 0; j = j - 1 {
      if events[j].stream == event.stream {
        prior = j
        break
      }
    }
    guard prior >= 0 else { continue }
    let producer = events[prior]
    let matched = if mode == "native" {
      expected.any(x => marker(x.0, x.1) == producer.name)
    } else {
      producer.name.has_prefix("nvjet_") && event.name.contains("AllReduce")
    }
    if !matched {
      continue
    }
    guard reports.length() < 48 else { fail("too many projection sites") }
    let (layer, kind) = expected[reports.length()]
    if mode == "native" && producer.name != marker(layer, kind) {
      fail("unexpected projection order: " + producer.name)
    }
    guard event.name.contains("AllReduce") else {
      fail("projection has no reduction")
    }
    totals[kind] += event.end - event.start
    projection_ns += producer.end - producer.start
    let mut publication = 0L
    for j in (i + 1)..<events.length() {
      let next = events[j]
      if next.stream != event.stream {
        continue
      }
      if next.name == publication_marker(layer, kind) {
        publication = next.end - next.start
      }
      break
    }
    publication_ns += publication
    reports.push({
      "layer": layer,
      "kind": kind,
      "producer": producer.name,
      "producer_start_ns": Json(producer.start),
      "producer_end_ns": Json(producer.end),
      "collective": event.name,
      "start_ns": Json(event.start),
      "end_ns": Json(event.end),
      "duration_ms": Json((event.end - event.start).to_double() / 1000000.0),
      "publication_ms": Json(publication.to_double() / 1000000.0),
    })
  }
  guard reports.length() == 48 else { fail("missing projection sites") }
  let total = totals["recurrent"] + totals["sparse"] + totals["dense"]
  let result : Json = {
    "mode": mode,
    "begin_ns": Json(begin),
    "end_ns": Json(end),
    "projection_sites": 48,
    "projection_collective_ms": Json(total.to_double() / 1000000.0),
    "projection_kernel_ms": Json(projection_ns.to_double() / 1000000.0),
    "post_collective_publication_ms": Json(
      publication_ns.to_double() / 1000000.0,
    ),
    "all_collective_ms": Json(all_collective_ns.to_double() / 1000000.0),
    "recurrent_ms": Json(totals["recurrent"].to_double() / 1000000.0),
    "sparse_ms": Json(totals["sparse"].to_double() / 1000000.0),
    "dense_ms": Json(totals["dense"].to_double() / 1000000.0),
    "peer_arrival_not_separated": true,
    "sites": reports,
  }
  @fs.write_file(output, result.stringify(indent=2), create_mode=CreateNew)
  println(
    "\{mode}: 48 projection reductions \{total.to_double()/1000000.0} ms; post-publication \{publication_ns.to_double()/1000000.0} ms",
  )
}
