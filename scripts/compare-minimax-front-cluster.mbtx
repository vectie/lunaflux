///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
let node : String = "wlc003s@192.168.2.178"

///|
let socket : String = "/tmp/lunaflux-checkpoint-live-20261010.sock"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=1048576,
  )
}

///|
async fn record(root : String, label : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + label + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + label + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
fn stages() -> Array[(String, Int, Int)] {
  [
    ("norm1", 5376, 1),
    ("attention-input", 5376, 1),
    ("qkv", 7168, 3),
    ("qk-norm", 7168, 3),
    ("norm2", 5376, 1),
    ("mlp-input", 5376, 1),
    ("attention-residual", 5376, 1),
    ("residual", 5376, 1),
  ]
}

///|
test "front comparison retains all QKV planes and both residual frontiers" {
  assert_eq(stages()[2], ("qkv", 7168, 3))
  assert_eq(stages()[3], ("qk-norm", 7168, 3))
  assert_eq(stages().last().unwrap(), ("residual", 5376, 1))
}

///|
async fn run_report(
  root : String,
  build : String,
  tools : String,
  label : String,
  stage : String,
  width : Int,
  planes : Int,
  plane? : Int,
  operator? : Bool = true,
) -> Unit {
  let file = label + "-modalities.tsv"
  let selection = match plane {
    Some(index) => " --plane " + index.to_string()
    None => ""
  }
  record(
    root,
    label,
    remote(
      "systemd-run --user --wait --pipe --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=600 --working-directory=" +
      build +
      "/source --unit=" +
      root[5:].to_owned() +
      "-" +
      label +
      " /usr/bin/env MOON_HOME=" +
      tools +
      " PATH=" +
      tools +
      "/bin:/usr/bin:/bin MOON_CC=gcc " +
      tools +
      "/bin/moon run --target native " +
      root +
      "/compare-native.mbtx " +
      root +
      " " +
      root +
      "/" +
      file +
      (if operator {
        " --operator " +
        stage +
        " " +
        width.to_string() +
        " --planes " +
        planes.to_string() +
        selection
      } else {
        ""
      }),
    ),
  )
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket,
    node + ":" + root + "/" + file,
    root + "/" + file,
  ])
  .output()
  .check()
  println("stage=" + label)
  println(@fs.read_file(root + "/" + file).text())
}

///|
async fn main {
  guard @env.args() is [_, mode, root, original, capture, build] &&
    mode is ("prepare" | "run" | "parameters" | "prepare-full" | "run-full") &&
    root.has_prefix("/tmp/lunaflux-minimax-front-comparison-") &&
    [root, original, capture, build].all(path => {
      path.has_prefix("/tmp/lunaflux-") &&
      !path.contains("..") &&
      path.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-' | '.'))
    }) else {
    fail(
      "prepare[-full]|run[-full]|parameters NEW_COMPARISON_ROOT ORIGINAL_ROOT RETIRED_NATIVE_ROOT EXISTING_ARM_BUILD",
    )
  }
  let original_tools = "/tmp/lunaflux-glm-arm-build-20261010.WGAwEo3b/toolchain"
  let tools = root + "/tools"
  let full = mode.has_suffix("-full")
  if mode == "prepare" || mode == "prepare-full" {
    @fs.mkdir(root)
    record(
      root,
      "mkdir",
      remote("mkdir " + root + " " + root + "/input " + root + "/output"),
    )
    // The old SDK's dependency cache uses a different format. Preserve it and
    // copy only SDK/runtime assets; this task owns a fresh dependency cache.
    record(root, "mkdir-tools", remote("mkdir " + tools))
    for directory in ["bin", "lib", "include", "share", "registry"] {
      record(
        root,
        "tools-" + directory,
        remote("cp -a " + original_tools + "/" + directory + " " + tools),
      )
    }
    @shell.Cmd("scp", [
      "-o",
      "BatchMode=yes",
      "-o",
      "ControlPath=" + socket,
      "scripts/compare-minimax-block-modalities.mbtx",
      node + ":" + root + "/compare-native.mbtx",
    ])
    .output()
    .check()
    for name in ["combined.i32", "documents.i32"] {
      record(
        root,
        "link-" + name,
        remote(
          "ln -s " + capture + "/output/" + name + " " + root + "/input/" + name,
        ),
      )
    }
    for (stage, _, _) in (if full { [] } else { stages() }) {
      let name = "block-0-" + stage + ".bf16"
      let native_name = if stage == "residual" { "block-0.bf16" } else { name }
      record(
        root,
        "link-" + stage,
        remote(
          "ln -s " +
          capture +
          "/output/" +
          native_name +
          " " +
          root +
          "/input/" +
          name,
        ),
      )
      record(
        root,
        "copy-" + stage,
        remote(
          "scp -o BatchMode=yes wlc004s@192.168.2.179:" +
          original +
          "/output/" +
          name +
          " " +
          root +
          "/output/" +
          name,
        ),
      )
    }
    if full {
      // Full-series comparator reports these same checkpoints independently
      // for matched native predecessors and propagated original predecessors.
      for block in [0, 1, 10, 20, 30, 40, 49] {
        let name = "block-\{block}.bf16"
        record(
          root,
          "link-block-\{block}",
          remote(
            "ln -s " +
            capture +
            "/output/" +
            name +
            " " +
            root +
            "/input/" +
            name,
          ),
        )
        for predecessor in ["matched", "propagated"] {
          let output = "\{predecessor}-" + name
          record(
            root,
            "copy-\{predecessor}-block-\{block}",
            remote(
              "scp -o BatchMode=yes wlc004s@192.168.2.179:" +
              original +
              "/output/" +
              output +
              " " +
              root +
              "/output/" +
              output,
            ),
          )
        }
      }
    }
    record(
      root,
      "script-tests",
      remote(
        "systemd-run --user --wait --pipe --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=600 --working-directory=" +
        build +
        "/source --unit=" +
        root[5:].to_owned() +
        "-script-tests /usr/bin/env MOON_HOME=" +
        tools +
        " PATH=" +
        tools +
        "/bin:/usr/bin:/bin MOON_CC=gcc " +
        tools +
        "/bin/moon test " +
        root +
        "/compare-native.mbtx --target native",
      ),
    )
  } else if mode == "parameters" {
    for
      (host, control, source, name) in [
        (
          node,
          socket,
          capture + "/output/block-0-parameters.bf16",
          "native-parameters.bf16",
        ),
        (
          "wlc004s@192.168.2.179",
          "/tmp/lunaflux-checkpoint-live179-20261010.sock",
          original + "/output/block-0-parameters.bf16",
          "original-parameters.bf16",
        ),
      ] {
      guard !@fs.exists(root + "/" + name) else {
        fail("previous parameter capture preserved")
      }
      @shell.Cmd("scp", [
        "-o",
        "BatchMode=yes",
        "-o",
        "ControlPath=" + control,
        host + ":" + source,
        root + "/" + name,
      ])
      .output()
      .check()
    }
    let compared = @shell.Cmd("moon", [
      "run",
      "scripts/compare-minimax-encoder-reference.mbtx",
      root + "/native-parameters.bf16",
      root + "/original-parameters.bf16",
      root + "/parameters-comparison.txt",
      "literal_native_timestep_original_adaln_projection",
      "5376",
    ]).output(max_output_bytes=65536)
    compared.check()
    println(compared.stdout())
  } else {
    guard @fs.exists(root) else { fail("prepare the comparison root first") }
    remote("test -d " + tools + "/lib").check()
    if full {
      run_report(root, build, tools, "full-series", "", 5376, 1, operator=false)
      return
    }
    for (stage, width, planes) in stages() {
      run_report(root, build, tools, stage, stage, width, planes)
      if planes == 3 {
        for plane, component in ["query", "key", "value"] {
          run_report(
            root,
            build,
            tools,
            stage + "-" + component,
            stage,
            width,
            planes,
            plane~,
          )
        }
      }
    }
  }
  println(
    "matched_front_comparison " +
    mode +
    " large_payloads_retained_on_cluster=true quality_not_claimed=true",
  )
}
