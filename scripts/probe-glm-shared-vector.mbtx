///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, root, mode] &&
    root.has_prefix("/tmp/lunaflux-glm-shared-vector-") &&
    mode is ("old" | "next" | "prepare" | "run" | "profile" | "sanitize") else {
    fail("ROOT old|next|prepare|run|profile|sanitize")
  }
  let host = "wlc004s@192.168.2.179"
  let socket = "/tmp/lunaflux-glm179-cutlass-20261017b.sock"
  let unit = root[5:].to_owned()
  async fn remote(cmd : String) -> @shell.Output {
    @shell.Cmd("ssh", ["-S", socket, "-o", "BatchMode=yes", host, cmd]).output(
      max_output_bytes=16777216,
    )
  }
  async fn record(name : String, out : @shell.Output) -> Unit {
    @fs.write_file(
      root + "/" + name + ".stdout",
      out.stdout(),
      create_mode=CreateNew,
    )
    @fs.write_file(
      root + "/" + name + ".stderr",
      out.stderr(),
      create_mode=CreateNew,
    )
    out.check()
  }
  if mode is ("old" | "next") {
    if mode == "old" {
      @fs.mkdir(root)
    }
    let out = @shell.Cmd(
      "moon",
      [
        "test", "kernels/selected_expert_mlp_cuda_source/shared_vector_test.mbt",
        "--target", "native", "--deny-warn", "--warn-list", "-20-25-29-35-79-92",
      ],
      env={ "LUNA_EXPORT_SHARED_VECTOR": mode },
    ).output(max_output_bytes=16777216)
    record("export-" + mode, out)
    guard out.stdout().split("LUNA_SOURCE_BEGIN\n").to_array() is [_, tail] else {
      fail("source absent")
    }
    @fs.write_file(
      root + "/" + mode + ".cuh",
      tail.split("LUNA_SOURCE_END").to_array()[0].to_owned(),
      create_mode=CreateNew,
    )
    return
  }
  if mode == "prepare" {
    record("mkdir", remote("mkdir " + root))
    for
      (path, name) in [
        (root + "/old.cuh", "old.cuh"),
        (root + "/next.cuh", "next.cuh"),
        ("tests/packed_moe_execution/shared_vector_probe.cu", "probe.cu"),
      ] {
      @shell.Cmd("scp", [
        "-o",
        "ControlPath=" + socket,
        path,
        host + ":" + root + "/" + name,
      ])
      .output()
      .check()
    }
    record(
      "compile",
      remote(
        "systemd-run --user --wait --pipe --unit=" +
        unit +
        "-compile --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=300 /usr/local/cuda-13.0/bin/nvcc -O3 -lineinfo -arch=sm_121 -std=c++17 " +
        root +
        "/probe.cu -o " +
        root +
        "/probe",
      ),
    )
    return
  }
  let owners = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  owners.check()
  guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
  record(
    mode + "-reserve",
    remote(
      "awk '/MemAvailable:/ {if ($2 < 29360128) exit 9; print}' /proc/meminfo",
    ),
  )
  if mode == "profile" {
    let ncu = "/opt/nvidia/nsight-compute/2025.3.1/ncu"
    record(
      "profile",
      remote(
        "systemd-run --user --wait --pipe --unit=" +
        unit +
        "-profile --property=RuntimeMaxSec=600 docker run --name " +
        unit +
        "-profile --gpus all --network none --memory=12g --memory-swap=12g --cap-add SYS_ADMIN --security-opt seccomp=unconfined -v " +
        root +
        ":" +
        root +
        " -v /opt/nvidia:/opt/nvidia:ro --entrypoint " +
        ncu +
        " ghcr.nju.edu.cn/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-e3-20260907 --config-file off --clock-control none --cache-control none --kernel-name-base demangled --kernel-name 'regex:(old|next)_(gate_up|down)' --launch-count 4 --metrics gpu__time_duration.sum,smsp__inst_executed.sum,sm__warps_active.avg.pct_of_peak_sustained_active,smsp__warp_issue_stalled_barrier_per_warp_active.pct,smsp__warp_issue_stalled_long_scoreboard_per_warp_active.pct,lts__t_sectors_op_read.sum,sm__pipe_tensor_cycles_active.avg.pct_of_peak_sustained_active,launch__registers_per_thread,launch__shared_mem_per_block_static --export " +
        root +
        "/matrix " +
        root +
        "/probe profile",
      ),
    )
    @shell.Cmd("scp", [
      "-o",
      "ControlPath=" + socket,
      host + ":" + root + "/matrix.ncu-rep",
      root + "/matrix.ncu-rep",
    ])
    .output()
    .check()
    record(
      "matrix-raw",
      remote(ncu + " --import " + root + "/matrix.ncu-rep --page raw --csv"),
    )
  } else if mode == "run" {
    record(
      "timing",
      remote(
        "systemd-run --user --wait --pipe --unit=" +
        unit +
        "-timing --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=180 " +
        root +
        "/probe",
      ),
    )
  } else {
    for tool in ["memcheck", "racecheck", "synccheck"] {
      record(
        tool,
        remote(
          "systemd-run --user --wait --pipe --unit=" +
          unit +
          "-" +
          tool +
          " --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=900 /usr/local/cuda-13.0/bin/compute-sanitizer --error-exitcode 97 --tool " +
          tool +
          (if tool == "memcheck" { " --leak-check full" } else { "" }) +
          " " +
          root +
          "/probe sanitizer",
        ),
      )
    }
  }
}
