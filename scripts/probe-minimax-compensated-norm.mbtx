///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

// Offline AOT experiment. No production policy, weights or launch geometry change.

///|
fn compensated_norm(
  source : String,
  row_only? : Bool = false,
  head_only? : Bool = false,
) -> String raise {
  let update = "sum=__fadd_rn(sum,__fmul_rn(v,v));"
  guard source.split(update).count() == 3 &&
    source.split("float sum=0.0f;").count() == 3 else {
    fail(
      "experiment requires exactly the row and head normalization reductions",
    )
  }
  let helper =
    #|#include <cuda_bf16.h>
    #|__device__ __forceinline__ void luna_norm_compensated_square(float value, float &sum, float &correction) {
    #|  const float square = __fmul_rn(value, value);
    #|  const float adjusted = __fsub_rn(square, correction);
    #|  const float next = __fadd_rn(sum, adjusted);
    #|  correction = __fsub_rn(__fsub_rn(next, sum), adjusted);
    #|  sum = next;
    #|}
    #|
  guard !(row_only && head_only) else {
    fail("one intervention scope required")
  }
  let rendered = if head_only {
    let init = source.split("float sum=0.0f;").collect()
    let selected = init[0].to_owned() +
      "float sum=0.0f;" +
      init[1].to_owned() +
      "float sum=0.0f, correction=0.0f;" +
      init[2].to_owned()
    let parts = selected.split(update).collect()
    parts[0].to_owned() +
    update +
    parts[1].to_owned() +
    "luna_norm_compensated_square(v,sum,correction);" +
    parts[2].to_owned()
  } else if row_only {
    source
    .replace(old="float sum=0.0f;", new="float sum=0.0f, correction=0.0f;")
    .replace(old=update, new="luna_norm_compensated_square(v,sum,correction);")
  } else {
    source
    .replace_all(old="float sum=0.0f;", new="float sum=0.0f, correction=0.0f;")
    .replace_all(
      old=update,
      new="luna_norm_compensated_square(v,sum,correction);",
    )
  }
  helper + rendered
}

///|
test "compensation retains small square contributions without widening BF16 boundaries" {
  let source = "float sum=0.0f; sum=__fadd_rn(sum,__fmul_rn(v,v));\n".repeat(2)
  let rendered = compensated_norm(source)
  assert_eq(
    rendered.split("luna_norm_compensated_square(v,sum,correction);").count(),
    3,
  )
  let (ordered, compensated) = for
    _ in 0..<5120
    ordered = 16777216.0F, sum = 16777216.0F, correction = 0.0F {
    let adjusted = Float::from_double(1.0 - correction.to_double())
    let next = Float::from_double(sum.to_double() + adjusted.to_double())
    let residue = Float::from_double(
      Float::from_double(next.to_double() - sum.to_double()).to_double() -
      adjusted.to_double(),
    )
    continue Float::from_double(ordered.to_double() + 1.0), next, residue
  } nobreak {
    (ordered, sum)
  }
  assert_eq(ordered, 16777216.0F)
  assert_eq(compensated, 16782336.0F)
  let row = compensated_norm(source, row_only=true)
  assert_eq(
    row.split("luna_norm_compensated_square(v,sum,correction);").count(),
    2,
  )
  assert_eq(row.split("sum=__fadd_rn(sum,__fmul_rn(v,v));").count(), 2)
  let head = compensated_norm(source, head_only=true)
  assert_true(
    head.has_suffix(
      "float sum=0.0f, correction=0.0f; luna_norm_compensated_square(v,sum,correction);\n",
    ),
  )
  assert_eq(
    head.split("luna_norm_compensated_square(v,sum,correction);").count(),
    2,
  )
}

///|
async fn main {
  guard @env.args() is [_, input, manifest, output, .. policy] &&
    (policy is [] || policy is ["row-only"] || policy is ["head-only"]) &&
    output.has_prefix("/tmp/lunaflux-minimax-request-aot-") else {
    fail(
      "ORIGINAL_TEXT_CUDA ORIGINAL_SOURCES_MANIFEST NEW_EXPERIMENT_AOT_DIRECTORY",
    )
  }
  let row_only = policy is ["row-only"]
  let head_only = policy is ["head-only"]
  let source = compensated_norm(
    @fs.read_file(input).text(),
    row_only~,
    head_only~,
  )
  @fs.mkdir(output)
  @fs.write_file(output + "/text.cu", source, create_mode=CreateNew)
  @fs.write_file(
    output + "/SOURCES.v1",
    @fs.read_file(manifest).binary(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    output + "/EXPERIMENT.txt",
    "scope=offline_compensated_norm_only\nrow_only=\{row_only}\nhead_only=\{head_only}\noriginal_launch_geometry=true\noriginal_weights_and_bf16_boundaries=true\nproduction_selection_changed=false\n",
    create_mode=CreateNew,
  )
  let socket = "/tmp/lunaflux-checkpoint-live179-20261010.sock"
  let node = "wlc004s@192.168.2.179"
  @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-S",
    socket,
    node,
    "mkdir " + output,
  ])
  .output()
  .check()
  for name in ["text.cu", "SOURCES.v1", "EXPERIMENT.txt"] {
    @shell.Cmd("scp", [
      "-o",
      "BatchMode=yes",
      "-o",
      "ControlPath=" + socket,
      output + "/" + name,
      node + ":" + output + "/" + name,
    ])
    .output()
    .check()
  }
  let result = @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-S",
    socket,
    node,
    "systemd-run --user --wait --pipe --unit=" +
    output.split("/").last().unwrap().to_owned() +
    " --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=600 /usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 --cubin -arch=sm_121 " +
    output +
    "/text.cu -o " +
    output +
    "/text.cubin",
  ]).output()
  @fs.write_file(
    output + "/compile.stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    output + "/compile.stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  println(
    "separate compensated-norm AOT compiled; not a model correctness or production-selection claim",
  )
}
