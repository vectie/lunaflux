///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn node(last : Bool) -> String {
  if last {
    "wlc004s@192.168.2.179"
  } else {
    "wlc003s@192.168.2.178"
  }
}

///|
fn socket(last : Bool) -> String {
  if last {
    "/tmp/lunaflux-checkpoint-live179-20261010.sock"
  } else {
    "/tmp/lunaflux-checkpoint-live-20261010.sock"
  }
}

///|
async fn remote(last : Bool, command : String) -> @shell.Output {
  @shell.Cmd("ssh", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=10",
    "-S",
    socket(last),
    node(last),
    command,
  ]).output(max_output_bytes=16777216)
}

///|
async fn record(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn copy(last : Bool, source : String, target : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket(last),
    source,
    target,
  ])
  .output()
  .check()
}

///|
async fn wait_unit(
  root : String,
  last : Bool,
  unit : String,
  name : String,
) -> Unit {
  for _ in 0..<900 {
    let status = remote(
      last,
      "systemctl --user show " +
      unit +
      " -p SubState -p Result -p ExecMainStatus -p MemoryPeak -p MemorySwapPeak",
    )
    status.check()
    if !status.stdout().contains("SubState=running") {
      record(root, name + "-status", status)
      record(
        root,
        name + "-journal",
        remote(last, "journalctl --user -u " + unit + " --no-pager"),
      )
      guard status.stdout().contains("Result=success") &&
        status.stdout().contains("ExecMainStatus=0") else {
        fail("unit failed: " + unit)
      }
      return
    }
    @async.sleep(1000)
  }
  fail("bounded CPU preparation expired")
}

///|
async fn main {
  guard @env.args() is [_, build, row_text, .. options] &&
    build.has_prefix("/tmp/lunaflux-checkpoint-build-glm-") &&
    !build.contains("..") &&
    build.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
    fail("NEW_COMPLETED_BUILD_ROOT ROWS")
  }
  guard options.is_empty() || options is ["--chunk-kda"] else {
    fail("unknown arithmetic option")
  }
  let chunk = !options.is_empty()
  let rows = @string.parse_int(row_text)
  guard rows > 0 && rows <= 32 else { fail("bounded row capacity required") }
  let name = build[5:].to_owned()
  wait_unit(build, false, name + ".service", "build")
  let executable = build + "/glm_checkpoint.exe"
  copy(
    false,
    node(false) +
    ":" +
    build +
    "/source/_build/native/release/build/cmd/glm_checkpoint/glm_checkpoint.exe",
    executable,
  )
  record(build, "179-mkdir", remote(true, "mkdir " + build))
  for last in [false, true] {
    record(
      build,
      "binary-target-\{last}",
      remote(last, "test ! -e " + executable),
    )
    copy(last, executable, node(last) + ":" + executable)
  }
  let aot = build + "/aot"
  let original = "/tmp/lunaflux-checkpoint-build-glm-sparse-retained-20261013-v1/aot"
  let export_unit = name + "-export.service"
  record(
    build,
    "export-start",
    remote(
      false,
      "systemd-run --user --unit=" +
      export_unit +
      " --property=RemainAfterExit=yes --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1200 " +
      executable +
      (if chunk { " export-chunk-kda " } else { " export " }) +
      "/tmp/lunaflux-glm-real-20261010.6yIBQN35/GLM-5.3-Flash-NVFP4 " +
      original +
      "/SHARDS.sha256 \{rows} 64 103079215104 103079215104 2147483648 " +
      aot,
    ),
  )
  wait_unit(build, false, export_unit, "export")
  @fs.mkdir(aot)
  record(build, "179-aot", remote(true, "mkdir " + aot))
  for (last, ordinal) in [(false, 0), (true, 1)] {
    let source = aot + "/stage-\{ordinal}.cu"
    copy(false, node(false) + ":" + source, source)
    guard @fs.read_file(source).text().contains("_project_ordered_tiles_v1") else {
      fail("selected control source missing")
    }
    if chunk {
      let text = @fs.read_file(source).text()
      guard text.contains("_delta_prepare") &&
        text.contains("_delta_solve") &&
        text.contains("_delta_publish") else {
        fail("chunk stages did not reach AOT")
      }
    }
    if last {
      copy(true, source, node(true) + ":" + source)
    }
    record(
      build,
      "labels-\{ordinal}",
      remote(
        last,
        "cp -n " + original + "/SHARDS.sha256 " + aot + "/SHARDS.sha256",
      ),
    )
    let unit = name + "-cubin-\{ordinal}.service"
    record(
      build,
      "compile-\{ordinal}-start",
      remote(
        last,
        "systemd-run --user --unit=" +
        unit +
        " --property=RemainAfterExit=yes --property=MemoryMax=2G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1200 /usr/local/cuda-13.0/bin/nvcc -O3 -std=c++17 --cubin -arch=sm_121 " +
        source +
        " -o " +
        aot +
        "/stage-\{ordinal}.cubin",
      ),
    )
    wait_unit(build, last, unit, "compile-\{ordinal}")
    copy(
      last,
      node(last) + ":" + aot + "/stage-\{ordinal}.cubin",
      aot + "/stage-\{ordinal}.cubin",
    )
  }
  @fs.write_file(
    build + "/geometry.txt",
    "rows=\{rows}\nhistory=64\npayload_hashing=false\n",
    create_mode=CreateNew,
  )
  println("prepared committed runtime rows=\{rows}: " + build)
}
