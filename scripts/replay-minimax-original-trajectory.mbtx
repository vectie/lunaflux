///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
let node : String = "wlc004s@192.168.2.179"

///|
let socket : String = "/tmp/lunaflux-checkpoint-live179-20261010.sock"

///|
let image : String = "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/h3-runtime-serving:20260923-arm64-r2"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=2097152,
  )
}

///|
async fn copy(source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket,
    source,
    destination,
  ])
  .output()
  .check()
}

///|
async fn record(root : String, name : String, result : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
}

///|
fn model_shards(index : String) -> Array[String] raise {
  guard @json.parse(index) is { "weight_map": Object(fields), .. } else {
    fail("checkpoint index required")
  }
  let shards : Map[String, Unit] = Map([])
  for _, value in fields {
    guard value is String(shard) else { fail("checkpoint shard required") }
    shards[shard] = ()
  }
  let result = shards.keys().to_array()
  result.sort()
  guard !result.is_empty() else { fail("empty model") }
  result
}

///|
test "trajectory retains the full model, deduplicating shard storage only" {
  assert_eq(
    model_shards(
      "{\"weight_map\":{\"proj_in.weight\":\"a\",\"transformer_blocks.49.norm1.weight\":\"b\",\"token_refiner.final_norm.weight\":\"a\"}}",
    ),
    ["a", "b"],
  )
}

///|
fn schedule_control(args : ArrayView[String]) -> (ArrayView[String], Int) raise {
  match args {
    [.. rest, "--original-points", value] => {
      let points = @string.parse_int(value)
      guard points >= 2 && points <= 50 && !rest.contains("--original-points") else {
        fail("bounded original schedule requires 2..50 points")
      }
      (rest, points)
    }
    _ => {
      guard !args.contains("--original-points") else {
        fail("original schedule must be explicit and final")
      }
      (args, 0)
    }
  }
}

///|
test "quality schedule control does not silently alter a matched replay" {
  assert_eq(schedule_control(["a", "b"]).1, 0)
  assert_eq(schedule_control(["a", "--original-points", "50"]).1, 50)
  for
    args in [
      ["--original-points", "1"],
      ["--original-points", "51"],
      ["--original-points"],
      ["--original-points", "20", "x"],
    ] {
    try schedule_control(args) catch {
      _ => ()
    } noraise {
      _ => fail("invalid control admitted")
    }
  }
}

///|
async fn original_points(root : String) -> Int {
  let path = root + "/ORIGINAL_POINTS.txt"
  if @fs.exists(path) {
    @string.parse_int(@fs.read_file(path).text())
  } else {
    0
  }
}

///|
fn quality_geometry(
  args : ArrayView[String],
) -> (ArrayView[String], (Int, Int)?) raise {
  match args {
    [.. rest, "--quality-geometry", height, width] => {
      let h = @string.parse_int(height)
      let w = @string.parse_int(width)
      guard h >= 32 &&
        h <= 256 &&
        h % 32 == 0 &&
        w >= 32 &&
        w <= 256 &&
        w % 32 == 0 &&
        !rest.contains("--quality-geometry") else {
        fail(
          "bounded original-only canvas requires 32..256 pixel multiples of 32",
        )
      }
      (rest, Some((h, w)))
    }
    _ => {
      guard !args.contains("--quality-geometry") else {
        fail("quality geometry must be an explicit final control")
      }
      (args, None)
    }
  }
}

///|
test "original RNG geometry control is distinct from matched native replay" {
  assert_eq(quality_geometry(["literal-input"]).1, None)
  assert_eq(
    quality_geometry(["--quality-geometry", "256", "128"]).1,
    Some((256, 128)),
  )
  for
    args in [
      ["--quality-geometry", "512", "256"],
      ["--quality-geometry", "33", "128"],
      ["--quality-geometry", "128"],
    ] {
    try quality_geometry(args) catch {
      _ => ()
    } noraise {
      _ => fail("unbounded or malformed quality canvas admitted")
    }
  }
}

///|
async fn prepared_geometry(root : String) -> (Int, Int)? {
  let path = root + "/QUALITY_GEOMETRY.txt"
  if @fs.exists(path) {
    let fields = @fs.read_file(path).text().split(" ").to_array()
    guard fields is [height, width] else {
      fail("prepared quality geometry differs")
    }
    Some((@string.parse_int(height), @string.parse_int(width)))
  } else {
    None
  }
}

///|
async fn main {
  guard @env.args() is [_, mode, root, .. extra] &&
    root.has_prefix("/tmp/lunaflux-minimax-original-trajectory-") else {
    fail(
      "prepare NEW_ROOT ORIGINAL_FULL_BLOCK_ROOT NATIVE_HEAD_CAPTURE ENCODED_BF16 [--original-points N] [--quality-geometry H W] | run ROOT | collect ROOT NATIVE_TERMINAL_OUTPUT | collect-quality ROOT",
    )
  }
  let tag = root[5:].to_owned()
  if mode == "prepare" {
    let (schedule_args, geometry) = quality_geometry(extra)
    let (operands, points) = schedule_control(schedule_args)
    guard geometry is None || points > 0 else {
      fail(
        "changed-geometry original RNG control requires an explicit original schedule",
      )
    }
    guard operands is [previous, capture, encoded] else {
      fail("literal trajectory inputs required")
    }
    @fs.mkdir(root)
    @fs.write_file(
      root + "/ORIGINAL_POINTS.txt",
      "\{points}",
      create_mode=CreateNew,
    )
    if geometry is Some((height, width)) {
      @fs.write_file(
        root + "/QUALITY_GEOMETRY.txt",
        "\{height} \{width}",
        create_mode=CreateNew,
      )
    }
    for directory in ["model", "input", "output"] {
      @fs.mkdir(root + "/" + directory)
    }
    record(
      root,
      "mkdir",
      remote(
        "mkdir " +
        root +
        " " +
        root +
        "/model " +
        root +
        "/input " +
        root +
        "/output",
      ),
    )
    for
      file in ["config.json", "diffusion_pytorch_model.safetensors.index.json"] {
      @fs.write_file(
        root + "/model/" + file,
        @fs.read_file(previous + "/model/" + file).binary(),
        create_mode=CreateNew,
      )
      copy(root + "/model/" + file, node + ":" + root + "/model/" + file)
    }
    // The earlier replay retained its checkpoint rotary buffer on the host,
    // not in its small desktop metadata copy. Reuse that exact original table.
    copy(
      node + ":" + previous + "/model/rope.inv_freq.f32",
      root + "/model/rope.inv_freq.f32",
    )
    copy(
      root + "/model/rope.inv_freq.f32",
      node + ":" + root + "/model/rope.inv_freq.f32",
    )
    for
      shard in model_shards(
        @fs.read_file(
          root + "/model/diffusion_pytorch_model.safetensors.index.json",
        ).text(),
      ) {
      record(
        root,
        "link-" + shard,
        remote(
          "ln " + previous + "/model/" + shard + " " + root + "/model/" + shard,
        ),
      )
    }
    for
      (file, source) in [
        ("video-state.f32", capture + "/video-state.f32"),
        ("audio-state.f32", capture + "/audio-state.f32"),
        ("flow-table.f32", capture + "/flow-table.f32"),
        ("combined.i32", capture + "/combined.i32"),
        ("documents.i32", capture + "/documents.i32"),
        ("positions.f32", previous + "/input/positions.f32"),
        ("encoded.bf16", encoded),
      ] {
      @fs.write_file(
        root + "/input/" + file,
        @fs.read_file(source).binary(),
        create_mode=CreateNew,
      )
      copy(root + "/input/" + file, node + ":" + root + "/input/" + file)
    }
    for
      file in [
        "trajectory_upstream.cpp", "original_h3_loading.h", "original_tensor_io.h",
      ] {
      copy(
        "benchmarks/checkpoint_aten_reference/aten/" + file,
        node + ":" + root + "/" + file,
      )
    }
    record(
      root,
      "compile",
      remote(
        "docker run --rm --pull=never --user 1000:1000 --network none --memory 2g --memory-swap 2g -v " +
        root +
        ":/work --entrypoint g++ " +
        image +
        " -O2 -std=c++20 -Wall -Wextra -Werror -I/usr/include/python3.12 /work/trajectory_upstream.cpp -o /work/original-trajectory -lpython3.12",
      ),
    )
  } else if mode == "run" {
    guard extra.is_empty() else { fail("unexpected trajectory arguments") }
    let points = original_points(root)
    let geometry = prepared_geometry(root)
    let owners = remote(
      "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    owners.check()
    guard owners.stdout().trim().is_empty() else {
      fail("serialize GPU replay")
    }
    let available = remote("awk '/^MemAvailable:/ {print $2}' /proc/meminfo")
    available.check()
    guard @string.parse_int64(available.stdout().trim()) >= 104L * 1024L * 1024L else {
      fail("trajectory requires 104 GiB available before its 96 GiB budget")
    }
    record(
      root,
      "start",
      remote(
        "systemd-run --user --unit=" +
        tag +
        " --property=MemoryMax=96G --property=MemorySwapMax=0 --property=RuntimeMaxSec=7200 --property=RemainAfterExit=yes --property=StandardOutput=append:" +
        root +
        "/stdout.log --property=StandardError=append:" +
        root +
        "/stderr.log docker run --rm --pull=never --gpus all --user 1000:1000 --network none --memory 96g --memory-swap 96g -e OMP_NUM_THREADS=2 -e LOGNAME=wlc004s -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True -v " +
        root +
        ":/work --entrypoint /work/original-trajectory " +
        image +
        " /work/model /work/input /work/output" +
        (if points == 0 { "" } else { " \{points}" }) +
        (match geometry {
          None => ""
          Some((height, width)) => " --quality-geometry \{height} \{width}"
        }),
      ),
    )
  } else if mode == "collect-quality" {
    guard extra.is_empty() && prepared_geometry(root) is Some((height, width)) else {
      fail("collect-quality requires a prepared original-only geometry control")
    }
    let points = original_points(root)
    let terminal = remote(
      "systemctl --user show " +
      tag +
      ".service -p SubState -p Result -p ExecMainStatus -p MemoryPeak -p MemorySwapPeak",
    )
    terminal.check()
    guard terminal.stdout().contains("SubState=exited") &&
      terminal.stdout().contains("ExecMainStatus=0\n") &&
      terminal.stdout().contains("Result=success") else {
      fail("original-only trajectory not successfully terminal")
    }
    record(root, "terminal", terminal)
    for file in ["stdout.log", "stderr.log"] {
      copy(node + ":" + root + "/" + file, root + "/" + file)
    }
    guard @fs.read_file(root + "/stdout.log")
      .text()
      .contains(
        "original_trajectory_terminal updates=\{points - 1} video_latent=1,24,37,\{height / 16},\{width / 16}",
      ) else {
      fail("missing literal terminal geometry")
    }
    // Keep all step captures on the host. Download only canonical latents and
    // exact original RNG inputs; do not compare different canvases as parity.
    for
      (file, bytes) in [
        ("video-latent.f32", 24 * 37 * (height / 16) * (width / 16) * 4),
        ("audio-latent.f32", 2 * 32 * 207 * 4),
        ("initial-video-rows.f32", 37 * (height / 32) * (width / 32) * 96 * 4),
        ("initial-audio-rows.f32", 414 * 32 * 4),
      ] {
      let path = root + "/output/" + file
      guard !@fs.exists(path) else {
        fail("existing collected output preserved")
      }
      copy(node + ":" + path, path)
      guard @fs.read_file(path).binary().length() == bytes else {
        fail("literal quality tensor geometry differs: " + file)
      }
    }
    println(
      "original_only_control_collected canvas=\{height}x\{width} original_noise=true native_parity=false media_quality=unassessed",
    )
  } else if mode == "collect" {
    guard prepared_geometry(root) is None else {
      fail(
        "changed geometry/noise requires collect-quality, not a native parity comparison",
      )
    }
    guard extra is [native, .. options] else {
      fail("native terminal output directory required")
    }
    let base_scope = match options {
      [] =>
        "original_full_trajectory_same_native_noise_caption_geometry_and_sigma_points"
      ["--original-caption"] =>
        "original_full_trajectory_original_encoder_caption_same_noise_geometry_sigma_points_changed_caption_control"
      _ => fail("[--original-caption] required for changed-caption control")
    }
    let points = original_points(root)
    let updates = if points == 0 { 20 } else { points - 1 }
    let scope = base_scope +
      (if points == 0 {
        ""
      } else {
        "_changed_original_\{points}_point_schedule_not_matched_trajectory"
      })
    let terminal = remote(
      "systemctl --user show " +
      tag +
      ".service -p SubState -p Result -p ExecMainStatus -p MemoryPeak -p MemorySwapPeak",
    )
    terminal.check()
    guard terminal.stdout().contains("SubState=exited") &&
      terminal.stdout().contains("ExecMainStatus=0\n") &&
      terminal.stdout().contains("Result=success") else {
      fail("original trajectory not successfully terminal")
    }
    record(root, "terminal", terminal)
    for file in ["stdout.log", "stderr.log"] {
      copy(node + ":" + root + "/" + file, root + "/" + file)
    }
    for label in ["video", "audio"] {
      for step in 0..<updates {
        let file = label + "-step-\{step}.f32"
        copy(node + ":" + root + "/output/" + file, root + "/output/" + file)
      }
      let file = label + "-latent.f32"
      copy(node + ":" + root + "/output/" + file, root + "/output/" + file)
      record(
        root,
        "compare-" + label + "-terminal",
        @shell.Cmd("moon", [
          "run",
          "scripts/compare-f32-tensors.mbtx",
          native + "/" + file,
          root + "/output/" + file,
          root + "/" + label + "-terminal.txt",
          scope,
        ]).output(),
      )
    }
  } else {
    fail("unknown replay stage")
  }
}
