///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn main {
  guard @env.args() is [_, directory] else { fail("NEW_OUTPUT_DIRECTORY") }
  @fs.mkdir(directory)
  let result = @shell.Cmd("env", [
    "LUNA_EXPORT_QUANTIZED_QUERY_KV=1", "moon", "test", "kernels/quantized_query_kv_cuda_source/source_test.mbt",
    "--target", "native", "--release", "--warn-list", "-79",
  ]).output(max_output_bytes=1048576)
  @fs.write_file(
    directory + "/export.stdout",
    result.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    directory + "/export.stderr",
    result.stderr(),
    create_mode=CreateNew,
  )
  result.check()
  guard result.stdout().split("LUNA_QUERY_KV_SOURCE_BEGIN\n").to_array()
    is [_, after] else {
    fail("missing or duplicate source begin")
  }
  guard after.split("LUNA_QUERY_KV_SOURCE_END").to_array() is [source, _] else {
    fail("missing or duplicate source end")
  }
  @fs.write_file(
    directory + "/query_kv_kernels.cuh",
    source,
    create_mode=CreateNew,
  )
  @fs.write_file(
    directory + "/query_kv_probe.cu",
    @fs.read_file("tests/packed_moe_execution/quantized_query_kv_probe.cu"),
    create_mode=CreateNew,
  )
  println(directory)
}
