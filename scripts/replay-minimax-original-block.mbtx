///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
let node : String = "wlc004s@192.168.2.179"

///|
let socket : String = "/tmp/lunaflux-checkpoint-live179-20261010.sock"

///|
let image : String = "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/h3-runtime-serving:20260923-arm64-r2"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=4194304,
  )
}

///|
async fn record(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn copy(source : String, destination : String) -> Unit {
  @shell.Cmd("scp", [
    "-o",
    "BatchMode=yes",
    "-o",
    "ControlPath=" + socket,
    source,
    destination,
  ])
  .output()
  .check()
}

///|
fn block_shards(
  index : String,
  blocks? : Int = 1,
  raw? : Bool = false,
) -> Array[String] raise {
  guard @json.parse(index) is { "weight_map": Object(fields), .. } else {
    fail("original index required")
  }
  let shards : Map[String, Unit] = Map([])
  let prefixes = Array::makei(blocks, i => {
    (if raw { "blocks." } else { "transformer_blocks." }) + i.to_string() + "."
  })
  for name, entry in fields {
    if prefixes.any(prefix => name.has_prefix(prefix)) ||
      name == "rope.inv_freq" {
      guard entry is String(shard) else { fail("original shard name required") }
      shards[shard] = ()
    }
  }
  let names = shards.keys().to_array()
  names.sort()
  guard !names.is_empty() else { fail("no original first-block tensors") }
  names
}

///|
test "only literal first-block and rotary shards are staged" {
  assert_eq(
    block_shards(
      "{\"weight_map\":{\"transformer_blocks.0.attn.to_q.weight\":\"a\",\"transformer_blocks.1.attn.to_q.weight\":\"b\",\"rope.inv_freq\":\"a\"}}",
    ),
    ["a"],
  )
  assert_eq(
    block_shards(
      "{\"weight_map\":{\"blocks.0.attn.qkv_proj.weight\":\"raw-a\",\"blocks.1.attn.qkv_proj.weight\":\"raw-b\"}}",
      raw=true,
    ),
    ["raw-a"],
  )
}

///|
fn primary_document_rows(boundaries : Bytes) -> Int raise {
  guard boundaries.length() == 12 && boundaries[:4] == b"\x00\x00\x00\x00" else {
    fail("literal primary and padding documents required")
  }
  let rows = (boundaries[4].to_uint() |
  (boundaries[5].to_uint() << 8) |
  (boundaries[6].to_uint() << 16) |
  (boundaries[7].to_uint() << 24)).reinterpret_as_int()
  guard rows > 0 && rows <= packed_document_rows(boundaries) else {
    fail("captured primary document extent differs")
  }
  rows
}

///|
fn packed_document_rows(boundaries : Bytes) -> Int raise {
  guard boundaries.length() == 12 else {
    fail("literal primary and padding documents required")
  }
  let rows = (boundaries[8].to_uint() |
  (boundaries[9].to_uint() << 8) |
  (boundaries[10].to_uint() << 16) |
  (boundaries[11].to_uint() << 24)).reinterpret_as_int()
  guard rows > 0 && rows <= 4096 else {
    fail("bounded packed document extent required")
  }
  rows
}

///|
test "primary document excludes only the explicit padding document" {
  assert_eq(
    primary_document_rows(b"\x00\x00\x00\x00\xf1\x03\x00\x00\x00\x04\x00\x00"),
    1009,
  )
  let larger = b"\x00\x00\x00\x00\xe1\x0a\x00\x00\x00\x0b\x00\x00"
  assert_eq(primary_document_rows(larger), 2785)
  assert_eq(packed_document_rows(larger), 2816)
}

///|
async fn main {
  guard @env.args() is [_, mode, root, .. extra] &&
    root.has_prefix("/tmp/lunaflux-minimax-upstream-block-") else {
    fail(
      "prepare NEW_ROOT | finish-prepare|compile ROOT | inputs|inputs-operators ROOT REMOTE_NATIVE_ROOT | inputs-local ROOT LOCAL_NATIVE_CAPTURE | run|run-operators|collect|collect-operators ROOT",
    )
  }
  let tag = root[5:].to_owned()
  let full = mode.has_suffix("-full")
  let raw = mode.has_suffix("-raw")
  let stage = if full {
    mode[:mode.length() - 5].to_owned()
  } else if raw {
    mode[:mode.length() - 4].to_owned()
  } else {
    mode
  }
  let source = if raw {
    "/data/models/MiniMax/MiniMax-H3/FL2VA/transformer/"
  } else {
    "/data/models/MiniMax/MiniMax-H3/transformer/"
  }
  let index_name = if raw {
    "model.safetensors.index.json"
  } else {
    "diffusion_pytorch_model.safetensors.index.json"
  }
  if stage == "reuse" {
    guard full &&
      extra is [previous] &&
      previous.has_prefix("/tmp/lunaflux-minimax-upstream-block-") &&
      previous.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
      fail("reuse-full NEW_ROOT PREVIOUS_CANONICAL_ROOT")
    }
    @fs.mkdir(root)
    @fs.mkdir(root + "/model")
    record(
      root,
      "mkdir",
      remote(
        "mkdir " +
        root +
        " " +
        root +
        "/model " +
        root +
        "/input " +
        root +
        "/output",
      ),
    )
    // Each replay owns its metadata and outputs; only immutable weight payloads
    // are referenced. Uploading the rotary table cannot mutate a prior replay.
    for name in ["config.json", index_name] {
      @fs.write_file(
        root + "/model/" + name,
        @fs.read_file(previous + "/model/" + name).binary(),
        create_mode=CreateNew,
      )
      copy(root + "/model/" + name, node + ":" + root + "/model/" + name)
    }
    for
      shard in block_shards(
        @fs.read_file(root + "/model/" + index_name).text(),
        blocks=50,
      ) {
      record(
        root,
        "reuse-" + shard,
        remote(
          "ln " + previous + "/model/" + shard + " " + root + "/model/" + shard,
        ),
      )
    }
  }
  if stage == "repair-links" {
    guard full &&
      extra is [previous] &&
      previous.has_prefix("/tmp/lunaflux-minimax-upstream-block-") &&
      previous.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
      fail("repair-links-full ROOT PREVIOUS_ROOT")
    }
    for
      shard in block_shards(
        @fs.read_file(root + "/model/" + index_name).text(),
        blocks=50,
      ) {
      let path = root + "/model/" + shard
      record(
        root,
        "repair-" + shard,
        remote(
          "mv -n " +
          path +
          " " +
          path +
          ".host-symlink; ln " +
          previous +
          "/model/" +
          shard +
          " " +
          path,
        ),
      )
    }
    println(
      "host-path symlinks retained separately; container-readable hard links created",
    )
    return
  }
  if stage == "prepare" {
    @fs.mkdir(root)
    @fs.mkdir(root + "/model")
    for
      (original, name) in [
        (
          "/data/models/MiniMax/MiniMax-H3/FL2VA/transformer/config.json", "config.json",
        ),
        (source + index_name, index_name),
      ] {
      @shell.Cmd("scp", [
        "-o",
        "BatchMode=yes",
        "lunanexa-management:" + original,
        root + "/model/" + name,
      ])
      .output()
      .check()
    }
    record(
      root,
      "mkdir",
      remote(
        "mkdir " +
        root +
        " " +
        root +
        "/model " +
        root +
        "/input " +
        root +
        "/output",
      ),
    )
    for name in ["config.json", index_name] {
      copy(root + "/model/" + name, node + ":" + root + "/model/" + name)
    }
  }
  if stage == "prepare" || mode == "finish-prepare" {
    for
      shard in block_shards(
        @fs.read_file(root + "/model/" + index_name).text(),
        blocks=if full { 50 } else { 1 },
        raw~,
      ) {
      println("staging original shard over cluster-local link " + shard)
      // Retain an interrupted desktop copy separately when resuming.
      record(
        root,
        "preserve-" + shard,
        remote(
          "if test -e " +
          root +
          "/model/" +
          shard +
          "; then mv -n " +
          root +
          "/model/" +
          shard +
          " " +
          root +
          "/model/" +
          shard +
          ".partial-desktop; fi; test ! -e " +
          root +
          "/model/" +
          shard,
        ),
      )
      record(
        root,
        "stage-" + shard,
        @shell.Cmd("ssh", [
          "-o",
          "BatchMode=yes",
          "lunanexa-management",
          "scp -o BatchMode=yes " +
          source +
          shard +
          " " +
          node +
          ":" +
          root +
          "/model/" +
          shard,
        ]).output(),
      )
    }
  }
  if stage == "prepare" ||
    stage == "reuse" ||
    mode == "finish-prepare" ||
    mode.has_prefix("compile") {
    copy(
      "/tmp/lunaflux-minimax-rotary-20261010-v1/rope.inv_freq.f32",
      node + ":" + root + "/model/rope.inv_freq.f32",
    )
    for
      file in [
        "dit_block_upstream.cpp", "original_tensor_io.h", "original_h3_loading.h",
        "dit_operator_upstream.h", "refiner_operator_upstream.h", "dit_front_operator_upstream.h",
      ] {
      copy(
        "benchmarks/checkpoint_aten_reference/aten/" + file,
        node + ":" + root + "/" + file,
      )
    }
    record(
      root,
      if mode.has_prefix("compile") {
        mode
      } else {
        "compile"
      },
      remote(
        "docker run --rm --pull=never --user 1000:1000 --network none --memory 2g --memory-swap 2g -v " +
        root +
        ":/work --entrypoint g++ " +
        image +
        " -O2 -std=c++20 -Wall -Wextra -Werror -I/usr/include/python3.12 /work/dit_block_upstream.cpp -o /work/original-block -lpython3.12",
      ),
    )
  } else if mode == "inputs-front-cluster" {
    guard extra is [capture] &&
      capture.has_prefix("/tmp/lunaflux-minimax-joint-") &&
      !capture.contains("..") &&
      capture.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
      fail("inputs-front-cluster ROOT RETIRED_NATIVE_ROOT")
    }
    let producer_node = "wlc003s@192.168.2.178"
    let producer_socket = "/tmp/lunaflux-checkpoint-live-20261010.sock"
    let terminal = @shell.Cmd("ssh", [
      "-o",
      "BatchMode=yes",
      "-S",
      producer_socket,
      producer_node,
      "systemctl --user show " +
      capture[5:].to_owned() +
      ".service -p SubState -p Result -p ExecMainStatus",
    ]).output()
    terminal.check()
    guard terminal.stdout().contains("SubState=exited") &&
      terminal.stdout().contains("Result=success") &&
      terminal.stdout().contains("ExecMainStatus=0\n") else {
      fail("native frontiers must be successfully terminal")
    }
    for
      file in [
        "packed-input.bf16", "timestep.f32", "positions.f32", "combined.i32", "documents.i32",
        "PREFIX.txt", "block-0.bf16", "block-0-parameters.bf16", "block-0-norm1.bf16",
        "block-0-attention-input.bf16", "block-0-qkv.bf16", "block-0-qk-norm.bf16",
        "block-0-projection.bf16", "block-0-attention-residual.bf16", "block-0-norm2.bf16",
        "block-0-mlp-input.bf16", "block-0-down.bf16",
      ] {
      record(
        root,
        "absent-" + file,
        remote("test ! -e " + root + "/input/" + file),
      )
      record(
        root,
        "cluster-" + file,
        @shell.Cmd("ssh", [
          "-o",
          "BatchMode=yes",
          "-S",
          producer_socket,
          producer_node,
          "scp -o BatchMode=yes " +
          capture +
          "/output/" +
          file +
          " " +
          node +
          ":" +
          root +
          "/input/" +
          file,
        ]).output(),
      )
    }
  } else if stage == "inputs" ||
    mode == "inputs-local" ||
    mode == "inputs-operators" ||
    mode == "inputs-operator-outputs" {
    guard extra is [capture] else { fail("literal native output required") }
    if !@fs.exists(root + "/input") {
      @fs.mkdir(root + "/input")
    }
    let files = if mode == "inputs-operator-outputs" {
      ["block-0-projection.bf16", "block-0-down.bf16"]
    } else {
      [
        "packed-input.bf16", "timestep.f32", "positions.f32", "combined.i32", "documents.i32",
        "PREFIX.txt",
      ]
    }
    if mode != "inputs-operator-outputs" {
      for i in 0..<(if full { 50 } else { 1 }) {
        files.push("block-\{i}.bf16")
      }
    }
    if mode == "inputs-operators" {
      files.append([
        "block-0-qk-norm.bf16", "block-0-attention.bf16", "block-0-mlp-input.bf16",
        "block-0-gate-up.bf16",
      ])
    }
    for file in files {
      let target = root + "/input/" + file
      guard !@fs.exists(target) else {
        fail("existing input capture preserved: " + target)
      }
      if mode == "inputs-local" {
        @fs.write_file(
          target,
          @fs.read_file(capture + "/" + file).binary(),
          create_mode=CreateNew,
        )
      } else {
        @shell.Cmd("scp", [
          "-o",
          "BatchMode=yes",
          "-o",
          "ControlPath=/tmp/lunaflux-checkpoint-live-20261010.sock",
          "wlc003s@192.168.2.178:" + capture + "/output/" + file,
          target,
        ])
        .output()
        .check()
      }
      copy(root + "/input/" + file, node + ":" + root + "/input/" + file)
    }
  } else if stage == "audit" {
    guard raw &&
      extra is [canonical] &&
      canonical.has_prefix("/tmp/lunaflux-minimax-upstream-block-") else {
      fail("audit-raw ROOT CANONICAL_ROOT")
    }
    let owners = remote(
      "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    owners.check()
    guard owners.stdout().trim().is_empty() else {
      fail("serialize GPU replays")
    }
    record(
      root,
      "audit-refiners",
      remote(
        "docker run --rm --gpus all --user 1000:1000 --network none --memory 12g --memory-swap 12g -e OMP_NUM_THREADS=2 -e LOGNAME=wlc004s -v " +
        root +
        ":/work -v " +
        canonical +
        "/model:/canonical:ro --entrypoint /work/original-block " +
        image +
        " /work/model /work/input /work/output 1 raw /canonical",
      ),
    )
    copy(
      node + ":" + root + "/output/weight-layout-with-refiners.tsv",
      root + "/weight-layout-with-refiners.tsv",
    )
  } else if stage == "run" ||
    mode.has_prefix("run-retry") ||
    mode == "run-operators" ||
    mode == "run-front-operators" {
    let owners = remote(
      "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
    )
    owners.check()
    guard owners.stdout().trim().is_empty() else {
      fail("serialize GPU replays")
    }
    let invocation = if mode == "run" { tag } else { tag + "-" + mode }
    record(
      root,
      mode,
      remote(
        "systemd-run --user --wait --pipe --unit=" +
        invocation +
        " --property=MemoryMax=12G --property=MemorySwapMax=0 --property=RuntimeMaxSec=1800 docker run --name " +
        invocation +
        " --gpus all --user 1000:1000 --network none --memory 12g --memory-swap 12g -e OMP_NUM_THREADS=2 -e LOGNAME=wlc004s -v " +
        root +
        ":/work --entrypoint /work/original-block " +
        image +
        " /work/model /work/input /work/output" +
        (if mode == "run-front-operators" {
          " 1 front-operators"
        } else if mode == "run-operators" {
          " 1 operators"
        } else if full {
          " 50"
        } else if raw {
          " 1 raw"
        } else {
          ""
        }),
      ),
    )
    record(
      root,
      "terminal",
      remote("docker inspect --format '{{json .State}}' " + invocation),
    )
    record(
      root,
      "released",
      remote("nvidia-smi --query-compute-apps=pid --format=csv,noheader"),
    )
  } else if mode == "collect-operators" {
    if !@fs.exists(root + "/output") {
      @fs.mkdir(root + "/output")
    }
    for stage in ["attention", "projection", "gate-up", "down"] {
      let file = "block-0-" + stage + ".bf16"
      guard !@fs.exists(root + "/output/" + file) else {
        fail("prior operator output preserved")
      }
      copy(node + ":" + root + "/output/" + file, root + "/output/" + file)
    }
  } else if mode == "compare-used" {
    let boundaries = @fs.read_file(root + "/input/documents.i32").binary()
    let rows = primary_document_rows(boundaries)
    let packed_rows = packed_document_rows(boundaries)
    for
      (label, source) in [
        ("native", "/input/block-0.bf16"),
        ("original", "/output/block-0.bf16"),
      ] {
      let data = @fs.read_file(root + source).binary()
      guard data.length() == packed_rows * 5376 * 2 else {
        fail("complete packed comparison required")
      }
      @fs.write_file(
        root + "/used-" + label + ".bf16",
        data[:rows * 5376 * 2],
        create_mode=CreateNew,
      )
    }
    record(
      root,
      "comparison-used",
      @shell.Cmd("moon", [
        "run",
        "scripts/compare-minimax-encoder-reference.mbtx",
        root + "/used-native.bf16",
        root + "/used-original.bf16",
        root + "/comparison-used.txt",
        "matched_original_first_dit_block_primary_document_padding_report_retained_separately",
        "5376",
      ]).output(),
    )
  } else if mode == "collect-full" ||
    mode == "collect-retry-full" ||
    mode == "collect-range-full" {
    if mode == "collect-full" {
      @fs.mkdir(root + "/output")
    }
    let first = if mode == "collect-range-full" {
      guard extra is [first] else {
        fail("collect-range-full ROOT FIRST_BLOCK")
      }
      @string.parse_int(first)
    } else {
      0
    }
    guard first >= 0 && first < 50 else {
      fail("block range outside full model")
    }
    let boundaries = @fs.read_file(root + "/input/documents.i32").binary()
    let real = primary_document_rows(boundaries)
    let packed_rows = packed_document_rows(boundaries)
    let summary = StringBuilder()
    summary.write_string("block\tpredecessor\treal_rows\treport\n")
    for i in first..<50 {
      let npath = root + "/input/block-\{i}.bf16"
      guard @fs.read_file(npath).binary().length() == packed_rows * 5376 * 2 else {
        fail("complete native capture required")
      }
      for predecessor in ["matched", "propagated"] {
        let file = "\{predecessor}-block-\{i}.bf16"
        copy(node + ":" + root + "/output/" + file, root + "/output/" + file)
        let opath = root + "/output/" + file
        let report = root + "/output/\{predecessor}-block-\{i}.txt"
        @shell.Cmd("moon", [
          "run",
          "scripts/compare-minimax-encoder-reference.mbtx",
          npath,
          opath,
          report,
          "literal_original_dit_\{predecessor}_block_\{i}_primary_document",
          "5376",
          real.to_string(),
        ])
        .output()
        .check()
        summary.write_string("\{i}\t\{predecessor}\t\{real}\t\{report}\n")
      }
    }
    @fs.write_file(
      root +
      (if first == 0 {
        "/block-reports.tsv"
      } else {
        "/block-reports-from-\{first}.tsv"
      }),
      summary.to_string(),
      create_mode=CreateNew,
    )
  } else if mode == "collect" {
    @fs.mkdir(root + "/output")
    copy(
      node + ":" + root + "/output/block-0.bf16",
      root + "/output/block-0.bf16",
    )
    record(
      root,
      "comparison",
      @shell.Cmd("moon", [
        "run",
        "scripts/compare-minimax-encoder-reference.mbtx",
        root + "/input/block-0.bf16",
        root + "/output/block-0.bf16",
        root + "/comparison.txt",
        "matched_original_first_dit_block",
        "5376",
      ]).output(),
    )
  } else {
    fail("unknown mode")
  }
  println("original block " + mode + " complete; not a media quality pass")
}
