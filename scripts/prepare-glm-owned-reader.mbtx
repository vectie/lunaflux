///|
// Offline alternative: each yielded tensor owns a separate copy-on-write file
// mapping. Retained or mutated tensors never alias the following tensor. Clean
// pages remain file-backed instead of duplicating a full tensor in anonymous RAM.
fn mapped_reader() -> String {
  let begin = "                    _lf_raw = torch.empty"
  let end = "                    if _lf_large:\n                        _lf_snapshot(\"before_consumer\""
  let source = owned_reader().replace(
    old="    import json as _lf_json",
    new="    import mmap as _lf_mmap\n    import json as _lf_json",
  )
  let parts = source.split(begin).to_array()
  let tail = parts[1].split(end).to_array()
  let mapping =
    #|                    _lf_size = _lf_end-_lf_begin
    #|                    if _lf_size:
    #|                        _lf_offset = 8+_lf_length+_lf_begin
    #|                        _lf_base = _lf_offset//_lf_mmap.ALLOCATIONGRANULARITY*_lf_mmap.ALLOCATIONGRANULARITY
    #|                        _lf_raw = _lf_mmap.mmap(_lf_file.fileno(), _lf_offset-_lf_base+_lf_size,
    #|                            access=_lf_mmap.ACCESS_COPY, offset=_lf_base)
    #|                        _lf_view = memoryview(_lf_raw)[_lf_offset-_lf_base:]
    #|                        tensor = torch.frombuffer(_lf_view, dtype=_getdtype(_lf_meta["dtype"])).reshape(_lf_meta["shape"])
    #|                    else:
    #|                        _lf_raw = None; _lf_view = None
    #|                        tensor = torch.empty(_lf_meta["shape"], dtype=_getdtype(_lf_meta["dtype"]), device="cpu")
  parts[0].to_owned() + mapping + "\n" + end + tail[1].to_owned()
}

///|
test "mapped tensors have independent copy-on-write lifetime" {
  let source = mapped_reader()
  assert_true(source.contains("access=_lf_mmap.ACCESS_COPY"))
  assert_true(source.contains("torch.frombuffer(_lf_view"))
  assert_false(source.contains("readinto("))
  assert_false(source.contains("_lf_raw.close()"))
  assert_true(source.contains("yield name, tensor"))
}

///|
test "owned reader keeps retained tensors independent without double staging" {
  let source = owned_reader()
  assert_true(source.contains("readinto(_lf_view[_lf_read:])"))
  assert_true(source.contains("yield name, tensor"))
  assert_true(source.contains("_getdtype(_lf_meta[\"dtype\"])"))
  assert_false(source.contains("clone()"))
  assert_false(source.contains("empty_cache"))
  assert_false(source.contains("hashlib"))
}

///|
fn replace_iterator(original : String, mapped~ : Bool = false) -> String raise {
  let marker = "def runai_safetensors_weights_iterator("
  guard original.split(marker).to_array() is [before, after] else {
    fail("iterator")
  }
  guard after.split("\ndef fastsafetensors_weights_iterator(").to_array()
    is [body, rest] else {
    fail("next function")
  }
  guard body.split("    with SafetensorsStreamer() as streamer:").to_array()
    is [signature, _] else {
    fail("body")
  }
  before.to_owned() +
  marker +
  signature.to_owned() +
  (if mapped { mapped_reader() } else { owned_reader() }) +
  "\n\n\ndef fastsafetensors_weights_iterator(" +
  rest.to_owned()
}

///|
test "only the installed Runai iterator body is replaced" {
  let source = "PREAMBLE\ndef runai_safetensors_weights_iterator(args):\n    with SafetensorsStreamer() as streamer:\n        old_body()\n\ndef fastsafetensors_weights_iterator(args):\n    unchanged()\n"
  let result = replace_iterator(source)
  assert_true(
    result.has_prefix(
      "PREAMBLE\ndef runai_safetensors_weights_iterator(args):\n",
    ),
  )
  assert_true(
    result.has_suffix(
      "def fastsafetensors_weights_iterator(args):\n    unchanged()\n",
    ),
  )
  assert_false(result.contains("old_body()"))
}

///|
async fn main {
  guard @env.args() is [_, root, original_path, .. options] &&
    root.has_prefix("/tmp/lunaflux-loader-observer-") else {
    fail("NEW_ROOT INSTALLED_WEIGHT_UTILS_SOURCE [--mapped]")
  }
  guard options.is_empty() || options == ["--mapped"] else {
    fail("unknown option")
  }
  let original = @fs.read_file(original_path).text()
  let replaced = replace_iterator(original, mapped=options == ["--mapped"])
  @fs.mkdir(root)
  @fs.write_file(root + "/original.py", original, create_mode=CreateNew)
  @fs.write_file(root + "/weight_utils.py", replaced, create_mode=CreateNew)
  for rank in 0..<2 {
    let socket = "/tmp/lunaflux-glm\{178+rank}-context-20261019.sock"
    let host = if rank == 0 {
      "wlc003s@192.168.2.178"
    } else {
      "wlc004s@192.168.2.179"
    }
    @shell.Cmd("ssh", [
      "-S",
      socket,
      "-o",
      "BatchMode=yes",
      host,
      "mkdir " + root,
    ])
    .output()
    .check()
    @shell.Cmd("scp", [
      "-o",
      "ControlPath=" + socket,
      root + "/weight_utils.py",
      host + ":" + root + "/weight_utils.py",
    ])
    .output()
    .check()
  }
}
