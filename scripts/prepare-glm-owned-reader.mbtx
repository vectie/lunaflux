  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

// External reference loading experiment only, not a production loader. The
// full-model startup still hits the reserve guard during graph warmup. Independent storage
// permits consumers to retain tensors; no integrity scan or inference math.

