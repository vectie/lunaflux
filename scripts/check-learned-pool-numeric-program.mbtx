///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
let node = "wlc004s@192.168.2.179"

///|
let socket = "/tmp/lunaflux-checkpoint-live179-20261010.sock"

///|
async fn remote(command : String) -> @shell.Output {
  @shell.Cmd("ssh", ["-o", "BatchMode=yes", "-S", socket, node, command]).output(
    max_output_bytes=1048576,
  )
}

///|
async fn save(root : String, name : String, output : @shell.Output) -> Unit {
  @fs.write_file(
    root + "/" + name + ".stdout",
    output.stdout(),
    create_mode=CreateNew,
  )
  @fs.write_file(
    root + "/" + name + ".stderr",
    output.stderr(),
    create_mode=CreateNew,
  )
  output.check()
}

///|
async fn main {
  guard @env.args() is [_, root] &&
    root.has_prefix("/tmp/lunaflux-numeric-program-") &&
    root.iter().all(c => c is ('a'..='z' | '0'..='9' | '/' | '-')) else {
    fail(
      "usage: NEW_/tmp/lunaflux-numeric-program-NAME; reserves idle179 serially",
    )
  }
  let owners = remote(
    "nvidia-smi --query-compute-apps=pid --format=csv,noheader",
  )
  owners.check()
  guard owners.stdout().trim().is_empty() else { fail("GPU occupied") }
  @fs.mkdir(root)
  remote("mkdir " + root).check()
  for mode in ["ordered", "fma"] {
    let path = root + "/" + mode
    @fs.mkdir(path)
    remote("mkdir " + path).check()
    save(
      path,
      "export",
      @shell.Cmd("env", [
        "LUNA_GATED_POOL_FIXTURE_SOURCE_OUTPUT=" + path + "/pool_kernels.cuh",
        "LUNA_GATED_POOL_FIXTURE_FMA=" + (if mode == "fma" { "1" } else { "0" }),
        "moon",
        "test",
        "kernels/learned_gated_pool_cuda_source",
        "--target",
        "native",
        "--deny-warn",
        "--warn-list",
        "-20-25-29-35-79-92",
      ]).output(),
    )
    for
      source in [
        path + "/pool_kernels.cuh",
        "tests/packed_moe_execution/learned_gated_pool_probe.cu",
      ] {
      @shell.Cmd("scp", [
        "-o",
        "BatchMode=yes",
        "-o",
        "ControlPath=" + socket,
        source,
        node + ":" + path + "/",
      ])
      .output()
      .check()
    }
    let prefix = "systemd-run --user --wait --collect --pipe -p MemoryMax=2G -p MemorySwapMax=0 -p RuntimeMaxSec=300 "
    save(
      path,
      "compile",
      remote(
        prefix +
        "/usr/local/cuda-13.0/bin/nvcc -O3 --fmad=false -std=c++17 -arch=sm_121 -I" +
        path +
        " " +
        path +
        "/learned_gated_pool_probe.cu -o " +
        path +
        "/probe",
      ),
    )
    save(path, "numerical-state", remote(prefix + path + "/probe"))
    for tool in ["memcheck", "racecheck", "synccheck"] {
      let leak = if tool == "memcheck" { " --leak-check full" } else { "" }
      save(
        path,
        tool,
        remote(
          prefix +
          "/usr/local/cuda-13.0/bin/compute-sanitizer --tool " +
          tool +
          leak +
          " --error-exitcode 86 " +
          path +
          "/probe",
        ),
      )
    }
    println("\{mode}: fixture and three sanitizers completed")
  }
  @fs.write_file(
    root + "/COMPLETE.txt",
    "fixture-only; no model quality or throughput claim\n",
    create_mode=CreateNew,
  )
}
