///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
}

// Local developer regression only: never a model-startup prerequisite.

///|
async fn main {
  for path in [
    "cmd/deepseek_checkpoint/startup.mbt", "cmd/glm_checkpoint/startup.mbt", "cmd/glm_checkpoint/text_prompt.mbt",
  ] {
    let source = @fs.read_file(path).text()
    guard !source.contains("@crypto") && !source.contains("ContentDigest") else {
      fail("unused configuration hashing reintroduced: " + path)
    }
  }
  let minimax = @fs.read_file("cmd/minimax_checkpoint/main.mbt").text()
  guard !minimax.contains("@crypto") else {
    fail("MiniMax checkpoint configuration hashing reintroduced")
  }
  let minimax_label = @fs.read_file("cmd/minimax_checkpoint/source_label.mbt").text()
  guard !minimax_label.contains("@crypto") &&
    !minimax_label.contains("read_immutable_snapshot") else {
    fail("MiniMax declared label must not scan config or inventory payloads")
  }
  for path in ["tokenizer/json_file/load.mbt", "model/artifact/read.mbt"] {
    let source = @fs.read_file(path).text()
    guard !source.contains("@crypto") else {
      fail("payload authentication scan reintroduced: " + path)
    }
  }
  let h3_materializer = @fs.read_file(
    "model/minimax_h3_host_materialization/materialize.mbt",
  ).text()
  guard !h3_materializer.contains("canonical_manifest_digest(") &&
    !h3_materializer.contains("@crypto") else {
    fail("MiniMax materialization manifest rehash reintroduced")
  }
  for path in [
    "model/deepseek_v4_host_materialization/materialize.mbt",
    "model/segmented_device_materialize/prepare_core.mbt",
    "model/segmented_device_materialize/borrowed_source.mbt",
    "model/segmented_device_materialize/streamed_source.mbt",
    "cmd/lunaflux_qwen3_bf16_candidate_export/model_prepare.mbt",
    "cmd/lunaflux_qwen3_bf16_release_bind/model.mbt",
  ] {
    let source = @fs.read_file(path).text()
    guard !source.contains("@crypto") &&
      !source.contains("canonical_manifest_digest(") &&
      !source.contains("recompute_layout_digest(") else {
      fail("repeated loading/preparation hashing reintroduced: " + path)
    }
  }
  let runners = [
    "build-glm-current-spark", "build-model-checkpoint-spark", "capture-checkpoint-index-gpu",
    "compile-dspark-composed-heads", "resume-dspark-preparation", "run-deepseek-dspark-two-spark",
    "run-deepseek-base-two-spark", "run-deepseek-base-two-spark-resume", "capture-deepseek-block-builds",
    "stage-minimax-denoiser-checkpoint", "stage-minimax-text-checkpoint", "stage-minimax-video-checkpoint",
    "run-minimax-audio-decode", "run-minimax-video-decode", "run-minimax-joint",
    "run-minimax-text-encoder", "run-cache-coordinate-probes", "run-stream-mean-capture-probe",
    "run-committed-draft-probe", "run-row-projection-norm-probe", "run-sequential-markov-probe",
    "capture-precision-transform-probes", "capture-compressed-attention-run", "capture-hyper-f32-run",
    "capture-learned-text-laws", "assemble-luna-kernel-root",
  ]
  for runner in runners {
    let source = @fs.read_file("scripts/" + runner + ".mbtx").text()
    for command in ["sha256sum", "shasum", "download-sha256", "hash-verified"] {
      guard !source.contains(command) else {
        fail("payload hashing reintroduced in " + runner)
      }
    }
  }
  let builder = @fs.read_file("scripts/build-qwen3-reusable-fused-runtime.mbtx").text()
  for
    removed in [
      "source_sha256", "checked(\"cmp\"", "second/kernel.cubin", "ingress-partial-second.cubin",
      "inspect-luna-cuda-aot-driver.sh", "sha256sum", "shasum", "FILES.sha256",
    ] {
    guard !builder.contains(removed) else {
      fail("redundant Qwen build hardening reintroduced: " + removed)
    }
  }
  let converter = @fs.read_file("cmd/lunaflux_qwen3_weight_convert/run.mbt").text()
  let source_reader = @fs.read_file("model/qwen3_weights/source_file.mbt").text()
  for removed in ["qwen3_ranges_equal", "limits.compare_chunk_bytes", "redundant_lm_head_byte_equal"] {
    guard !source_reader.contains(removed) else {
      fail("redundant tied-weight payload scan reintroduced: " + removed)
    }
  }
  let bootstrap_decoder = @fs.read_file("engine/worker_wire/bootstrap_source_decode.mbt").text()
  guard !bootstrap_decoder.contains("bootstrap_source_digest_of(") else {
    fail("worker bootstrap receive must not rehash its source payload")
  }
  let i8_codec = @fs.read_file("engine/worker_wire/bootstrap_source_i8_codec.mbt").text()
  guard !i8_codec.contains("let expected = i8_source_digest_of(") else {
    fail("I8 worker bootstrap receive must not rehash its source payload")
  }
  for name in [
    "decode", "i8_codec", "qwen3_codec", "mistral_codec", "fp8_codec",
    "tensor_parallel", "tensor_parallel_v8", "owned_decode",
  ] {
    let path = "engine/worker_wire/bootstrap_source_" + name + ".mbt"
    let source = @fs.read_file(path).text()
    for removed in ["let canonical = admit_", "canonical.storage[index] != source[index]"] {
      guard !source.contains(removed) else {
        fail("bootstrap receive re-encoding/byte comparison reintroduced: " + path)
      }
    }
  }
  for
    removed in ["hash_approved_file", "SHA256::new", "crypto.sha256(document)"] {
    guard !converter.contains(removed) else {
      fail("weight conversion checksum scan reintroduced: " + removed)
    }
  }
  guard converter.split("inspect_source_safetensors_file(").to_array().length() ==
    2 else {
    fail("weight conversion must inspect its source exactly once")
  }
  let materializer = @fs.read_file(
    "scripts/materialize-qwen3-bf16-v12-launch.mbtx",
  ).text()
  for directory in [
    "cmd/lunaflux_qwen3_bf16_release_bind", "cmd/lunaflux_bf16_release_bind",
    "release/projection_tuning_file", "kernels/luna_kernel_bundle",
  ] {
    for name in @fs.readdir(directory) {
      if name.has_suffix(".mbt") && !name.has_suffix("test.mbt") {
        let source = @fs.read_file(directory + "/" + name).text()
        guard !source.contains("@crypto") &&
          !source.contains("bind_sha256(") &&
          !source.contains("kernel_bundle_sha256(") else {
          fail("release assembly payload rehash reintroduced: " + directory + "/" + name)
        }
      }
    }
  }
  let producer = @fs.read_file("kernels/luna_bf16_kernel_producer/produce.mbt").text()
  guard !producer.contains("sha256_bytes(compilation.") else {
    fail("BF16 producer CUBIN rehash reintroduced")
  }
  for
    removed in [".sh", "assert_eq(sha(", "inventory(output", "validate-release"] {
    guard !materializer.contains(removed) else {
      fail("Qwen materializer legacy hardening reintroduced: " + removed)
    }
  }
  for
    name in [
      "materialize-qwen3-bf16-v12-launch", "build-qwen3-reusable-fused-runtime",
    ] {
    let launcher = @fs.read_file("scripts/" + name + ".sh").text()
    guard launcher.contains("exec moon run") else {
      fail("legacy Qwen entry point bypasses MoonBit: " + name)
    }
    for
      removed in [
        "sha256sum", "shasum", "lbf_sha256_file", "bundle_require_digest", "for pass",
        "verify-luna-kernel-root",
      ] {
      guard !launcher.contains(removed) else {
        fail("legacy Qwen hardening reintroduced: " + name + ": " + removed)
      }
    }
  }
  let core = @fs.read_file("scripts/materialize-qwen3-bf16-launch-core.mbtx").text()
  for
    removed in [
      "sha256sum", "shasum", "validate-release", "bundle.files.sha256", ".base",
      "verify-luna-kernel-root",
    ] {
    guard !core.contains(removed) else {
      fail(
        "Qwen packaging payload scan/copy/preflight reintroduced: " + removed,
      )
    }
  }
  println(
    "checkpoint runner no-hashing regression passed: \{runners.length()} scripts",
  )
}
