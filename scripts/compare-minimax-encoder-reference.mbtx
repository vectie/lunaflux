///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
fn bf16(bytes : Bytes, i : Int) -> Double {
  let bits = bytes[i * 2].to_uint() | (bytes[i * 2 + 1].to_uint() << 8)
  Float::reinterpret_from_uint(bits << 16).to_double()
}

///|
fn relative_error(error : Double, reference : Double) -> Double {
  if reference > 0.0 {
    error / reference
  } else if error == 0.0 {
    0.0
  } else {
    0x7FF0000000000000L.reinterpret_as_double()
  }
}

///|
test "nonzero error against a zero reference cannot report parity" {
  assert_eq(relative_error(0.0, 0.0), 0.0)
  assert_true(relative_error(1.0, 0.0).is_inf())
  assert_eq(relative_error(1.0, 4.0), 0.25)
  assert_eq(relative_error(1.0, 4.0).sqrt(), 0.5)
}

///|
async test "1024-row reports remain complete under bounded console capture" {
  let temporary = @shell.Cmd("mktemp", [
    "-d", "/tmp/lunaflux-encoder-report-XXXXXX",
  ]).output()
  temporary.check()
  let root = temporary.stdout().trim().to_owned()
  let input = root + "/zeros.bf16"
  let report_path = root + "/comparison.txt"
  @fs.write_file(input, Bytes::make(1024 * 5120 * 2, 0), create_mode=CreateNew)
  let workspace = @env.get_env_var("PWD").unwrap_or_else(() => {
    fail("test requires the invoking project directory")
  })
  let output = @shell.Cmd("moon", [
    "run",
    workspace + "/scripts/compare-minimax-encoder-reference.mbtx",
    input,
    input,
    report_path,
    "diagnostic_console_capacity",
  ]).output(max_output_bytes=65536)
  guard output.exit_code() == 0 else {
    fail("bounded report process failed: " + output.stderr())
  }
  let report = @fs.read_file(report_path).text()
  assert_eq(report.split("\n").filter(s => s.has_prefix("row=")).count(), 1024)
  assert_true(report.contains("elements=5242880\nexact_bf16=5242880\n"))
  assert_true(report.contains("row=1023 rmse=0 "))
  assert_true(!output.stdout().contains("row="))
  let limited = root + "/primary.txt"
  @shell.Cmd("moon", [
    "run",
    workspace + "/scripts/compare-minimax-encoder-reference.mbtx",
    input,
    input,
    limited,
    "explicit_primary_document",
    "5120",
    "1009",
  ])
  .output()
  .check()
  let primary = @fs.read_file(limited).text()
  assert_eq(primary.split("\n").filter(s => s.has_prefix("row=")).count(), 1009)
  assert_true(
    primary.contains("captured_elements=5242880\ncompared_rows=1009\n"),
  )
  assert_eq(@fs.read_file(input).binary().length(), 1024 * 5120 * 2)
}

///|
async fn main {
  guard @env.args() is [_, native_path, reference_path, output, .. scope_args] &&
    (
      scope_args is [] ||
      scope_args is [_] ||
      scope_args is [_, _] ||
      scope_args is [_, _, _]
    ) else {
    fail(
      "NATIVE_BF16 REFERENCE_BF16 NEW_REPORT [SCOPE [ROW_WIDTH [PRIMARY_ROWS]]]",
    )
  }
  let scope = match scope_args {
    [scope, ..] => scope
    _ => "original_caption_text_encoder_hidden_states_50"
  }
  let width = match scope_args {
    [_, width, ..] => @string.parse_int(width)
    _ => 5120
  }
  guard width > 0 else { fail("positive tensor row width required") }
  let native = @fs.read_file(native_path).binary()
  let reference = @fs.read_file(reference_path).binary()
  guard native.length() > 0 &&
    native.length() % 2 == 0 &&
    native.length() == reference.length() else {
    fail("BF16 tensor extents differ")
  }
  let captured_elements = native.length() / 2
  let n = match scope_args {
    [_, _, rows] =>
      comparison_elements(captured_elements, width, @string.parse_int(rows))
    _ => captured_elements
  }
  let mut exact = 0
  let mut nonfinite = 0
  let mut squared_error = 0.0
  let mut squared_native = 0.0
  let mut squared_reference = 0.0
  let mut dot = 0.0
  let mut abs_error = 0.0
  let mut abs_reference = 0.0
  let errors : Array[Double] = []
  let magnitudes : Array[Double] = []
  let mut max_error = 0.0
  let mut native_max = 0.0
  let mut reference_max = 0.0
  let mut largest = -1
  for i in 0..<n {
    let a = bf16(native, i)
    let b = bf16(reference, i)
    if a.is_nan() || a.is_inf() || b.is_nan() || b.is_inf() {
      nonfinite += 1
    } else {
      let delta = (a - b).abs()
      if delta > max_error {
        max_error = delta
        largest = i
      }
      if a.abs() > native_max {
        native_max = a.abs()
      }
      if b.abs() > reference_max {
        reference_max = b.abs()
      }
      abs_error += delta
      abs_reference += b.abs()
      errors.push(delta)
      magnitudes.push(b.abs())
      squared_error += delta * delta
      squared_native += a * a
      squared_reference += b * b
      dot += a * b
    }
    if native[i * 2] == reference[i * 2] &&
      native[i * 2 + 1] == reference[i * 2 + 1] {
      exact += 1
    }
  }
  let rmse = (squared_error / n.to_double()).sqrt()
  let relative_l2 = relative_error(squared_error, squared_reference).sqrt()
  let cosine = if squared_native > 0.0 && squared_reference > 0.0 {
    dot / (squared_native * squared_reference).sqrt()
  } else {
    0.0
  }
  let largest_native = if largest >= 0 { bf16(native, largest) } else { 0.0 }
  let largest_reference = if largest >= 0 {
    bf16(reference, largest)
  } else {
    0.0
  }
  errors.sort()
  magnitudes.sort()
  guard nonfinite == 0 else {
    fail("nonfinite reference/native tensor; no finite-error summary")
  }
  let relative_l1 = relative_error(abs_error, abs_reference)
  let per_row = StringBuilder()
  guard n % width == 0 else {
    fail("tensor extent is not a whole number of rows")
  }
  for row in 0..<(n / width) {
    let mut a2 = 0.0
    let mut b2 = 0.0
    let mut ab = 0.0
    let mut e2 = 0.0
    let mut e1 = 0.0
    let mut b1 = 0.0
    for column in 0..<width {
      let a = bf16(native, row * width + column)
      let b = bf16(reference, row * width + column)
      a2 += a * a
      b2 += b * b
      ab += a * b
      e2 += (a - b) * (a - b)
      e1 += (a - b).abs()
      b1 += b.abs()
    }
    let row_cosine = if a2 > 0.0 && b2 > 0.0 {
      ab / (a2 * b2).sqrt()
    } else {
      0.0
    }
    let row_l1 = relative_error(e1, b1)
    let row_l2 = relative_error(e2, b2).sqrt()
    per_row <+
      "row=\{row} rmse=\{(e2 / width.to_double()).sqrt()} relative_l1=\{row_l1} relative_l2=\{row_l2} cosine=\{row_cosine}\n"
  }
  let report =
    $|scope=\{scope}
    $|native=\{native_path}
    $|reference=\{reference_path}
    $|captured_elements=\{captured_elements}
    $|compared_rows=\{n / width}
    $|elements=\{n}
    $|exact_bf16=\{exact}
    $|nonfinite=\{nonfinite}
    $|native_max_abs=\{native_max}
    $|reference_max_abs=\{reference_max}
    $|mean_absolute_error=\{abs_error / n.to_double()}
    $|relative_l1=\{relative_l1}
    $|absolute_error_p50=\{errors[n / 2]}
    $|absolute_error_p95=\{errors[(n - 1) * 95 / 100]}
    $|absolute_error_p99=\{errors[(n - 1) * 99 / 100]}
    $|reference_abs_p50=\{magnitudes[n / 2]}
    $|reference_abs_p99=\{magnitudes[(n - 1) * 99 / 100]}
    $|rmse=\{rmse}
    $|relative_l2=\{relative_l2}
    $|cosine_similarity=\{cosine}
    $|max_absolute_error=\{max_error}
    $|largest_error_index=\{largest}
    $|largest_error_native=\{largest_native}
    $|largest_error_reference=\{largest_reference}
    $|claim=measured_difference_not_automatic_parity_or_performance
  let complete = report + "\n" + per_row.to_string()
  @fs.write_file(output, complete, create_mode=CreateNew)
  // Full per-token diagnostics stay in the report file. Printing them again
  // can exceed the caller's bounded console capture at supported wider shapes.
  println(report)
}

///|
fn comparison_elements(total : Int, width : Int, rows : Int) -> Int raise {
  guard width > 0 && total % width == 0 && rows > 0 && rows <= total / width else {
    fail("requested primary rows exceed complete captured tensor")
  }
  rows * width
}

///|
test "row-limited comparison retains raw padding without making slice copies" {
  assert_eq(comparison_elements(1024 * 5376, 5376, 1009), 1009 * 5376)
  for rows in [0, 1025] {
    try comparison_elements(1024 * 5376, 5376, rows) catch {
      _ => ()
    } noraise {
      _ => fail("invalid row extent accepted")
    }
  }
}
