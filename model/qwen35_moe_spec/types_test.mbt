///|
test "pinned Qwen3.5-MoE profile preserves hybrid and MoE geometry" {
  let spec = @qwen35_moe_spec.Qwen35MoeTextSpec::pinned_35b_a3b_fp8_text_only()
  assert_eq(spec.vocabulary_size(), 248320)
  assert_eq(spec.hidden_size(), 2048)
  assert_eq(spec.layer_count(), 40)
  assert_eq(spec.attention_head_count(), 16)
  assert_eq(spec.kv_head_count(), 2)
  assert_eq(spec.head_dimension(), 256)
  assert_eq(spec.context_length(), 262144)
  assert_eq(spec.layer_kind(0), Some(GatedDeltaLinearAttention))
  assert_eq(spec.layer_kind(2), Some(GatedDeltaLinearAttention))
  assert_eq(spec.layer_kind(3), Some(FullAttention))
  assert_eq(spec.layer_kind(39), Some(FullAttention))
  assert_eq(spec.layer_kind(40), None)
  assert_true(spec.attention_output_gate())
  assert_eq(spec.linear_key_head_count(), 16)
  assert_eq(spec.linear_value_head_count(), 32)
  assert_eq(spec.linear_convolution_width(), 4)
  assert_eq(spec.recurrent_state_dtype(), Float32)
  assert_eq(spec.routed_expert_count(), 256)
  assert_eq(spec.experts_per_token(), 8)
  assert_eq(spec.expert_intermediate_size(), 512)
  assert_eq(spec.shared_expert_intermediate_size(), 512)
  assert_true(spec.has_learned_shared_expert_gate())
}

///|
test "pinned profile is block-FP8 text-only without MTP authority" {
  let spec = @qwen35_moe_spec.Qwen35MoeTextSpec::pinned_35b_a3b_fp8_text_only()
  assert_eq(spec.rope_theta(), 10000000.0)
  assert_eq(spec.partial_rotary_factor(), 0.25)
  assert_eq(spec.mrope_section(0), Some(11))
  assert_eq(spec.mrope_section(1), Some(11))
  assert_eq(spec.mrope_section(2), Some(10))
  assert_eq(spec.mrope_section(3), None)
  assert_true(spec.mrope_interleaved())
  assert_eq(spec.matrix_dtype(), Fp8E4M3)
  assert_eq(spec.inverse_scale_dtype(), BFloat16)
  assert_eq(spec.fp8_block_rows(), 128)
  assert_eq(spec.fp8_block_columns(), 128)
  assert_true(spec.uses_dynamic_activation_scaling())
  assert_false(spec.tied_embeddings())
  assert_eq(spec.source_mtp_layer_count(), 1)
  assert_false(spec.mtp_execution_enabled())
  assert_false(spec.vision_execution_enabled())
}
