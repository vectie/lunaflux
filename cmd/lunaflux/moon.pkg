import {
  "moonbitlang/async",
  "vectie/lunaflux/cmd/lunaflux_plan",
  "vectie/lunaflux/contracts",
  "vectie/lunaflux/device" @hardware,
  "vectie/lunaflux/engine/reference",
  "vectie/lunaflux/kernels/reference" @refkernels,
  "vectie/lunaflux/kernels/luna_capability_manifest",
  "vectie/lunaflux/model/artifact",
  "vectie/lunaflux/model/llama_admission",
  "vectie/lunaflux/model/materialize",
  "vectie/lunaflux/model/safetensors",
  "vectie/lunaflux/ops/kernel_inspection",
  "vectie/lunaflux/ops/model_startup",
  "vectie/lunaflux/ops/runtime_report",
  "vectie/lunaflux/ops/runtime_instance",
  "vectie/lunaflux/release/deployment_bundle",
  "vectie/lunaflux/deploy/launch_file",
  "vectie/lunaflux/deploy/worker_executable_file",
  "vectie/lunaflux/runtime/approved_fs",
  "vectie/lunaflux/runtime/descriptor_file",
  "vectie/lunaflux/runtime/instance_policy_file",
  "vectie/lunaflux/runtime/inherited_drain",
  "vectie/lunaflux/runtime/inference_credential",
  "vectie/lunaflux/sampling",
  "vectie/lunaflux/tokenizer",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/strconv",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-pthread" } },
)
