import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/buffer",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
  "vectie/lunaflux/runtime/approved_fs",
  "vectie/lunaflux/model/spec",
  "vectie/lunaflux/model/minimax_h3_config" @config,
  "vectie/lunaflux/model/minimax_h3",
  "vectie/lunaflux/model/minimax_h3_spec" @h3,
  "vectie/lunaflux/model/minimax_h3_weights" @weights,
  "vectie/lunaflux/model/checkpoint_inventory" @inventory,
  "vectie/lunaflux/integration/minimax_h3_checkpoint" @checkpoint,
  "vectie/lunaflux/integration/minimax_h3_weight_startup" @startup,
  "vectie/lunaflux/device",
  "vectie/lunaflux/engine/joint_diffusion_loop" @loop,
  "vectie/lunaflux/integration/minimax_h3_source_export" @export,
  "vectie/lunaflux/integration/minimax_h3_block_source" @source,
  "vectie/lunaflux/integration/minimax_h3_block_program" @program,
  "vectie/lunaflux/integration/minimax_h3_audio_checkpoint" @audio,
  "vectie/lunaflux/integration/minimax_h3_video_decode" @video,
  "vectie/lunaflux/model/minimax_h3_vae_reference" @vae,
  "vectie/lunaflux/model/joint_diffusion_plan" @joint,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-pthread -ldl" } },
)
